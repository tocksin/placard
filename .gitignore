# Vivado project: made by build/create_project.bat (build/tcl/create_project.tcl)
/project/

# Vivado logs and journals started from the repository root
vivado*.log
vivado*.jou
vivado*.str
.Xil/

# memory images, made by src/scripts/gen_video_ram.tcl (ram.mem) and
# src/scripts/gen_rom.tcl (rom.mem) on every build
/src/hdl/ram.mem
/src/hdl/rom.mem
/src/hdl/video_ram.mem

# IP output products, Vivado writes them next to the .xci
/src/ip/*
!/src/ip/*.xci

# EDA (schematic and PCB) backups, autosaves, locks and caches
# KiCad
*-backups/
_autosave-*
*.kicad_sch-bak
*.kicad_pcb-bak
*.sch-bak
*.bak
*.lck
~*.lck
fp-info-cache
*.kicad_prl
# Eagle / Fusion Electronics
*.s#?
*.b#?
*.l#?
eagle.epf
# Altium
History/
__Previews/
Project Logs for */
*.PcbDoc.htm
# DipTrace / EasyEDA / generic
*.~*
*.tmp
# fabrication zips made from the Gerbers (keep the Gerbers themselves)
/pcb/fab/*.zip
