10 REM ETCH: DRAW WITH THE ARROW KEYS, 1-3 COLOR, C CLEARS, Q QUITS
20 MODE 2,2,2:X=160:Y=100:C=3
30 PRINT "ARROWS MOVE, 1-3 COLOR, C CLEAR, Q QUIT"
40 PLOT X,Y,C
50 GET K:IF K=0 THEN 50
60 IF K=17 AND Y>0 THEN Y=Y-1
70 IF K=18 AND Y<231 THEN Y=Y+1
80 IF K=19 AND X>0 THEN X=X-1
90 IF K=20 AND X<319 THEN X=X+1
100 IF K>=49 AND K<=51 THEN C=K-48
110 IF K=67 OR K=99 THEN CLS:GOTO 30
120 IF K=81 OR K=113 THEN TEXT 60:END
130 GOTO 40
