10 REM GUESS THE NUMBER
20 PRINT "I'M THINKING OF A NUMBER FROM 1 TO 100."
30 N=RND(100)+1:T=0
40 INPUT "YOUR GUESS";G
50 T=T+1
60 IF G<N THEN PRINT "HIGHER":GOTO 40
70 IF G>N THEN PRINT "LOWER":GOTO 40
80 PRINT "YES! YOU GOT IT IN";T;"TRIES."
90 BEEP 81
100 INPUT "AGAIN (Y/N)";A$
110 IF LEFT$(A$,1)="Y" THEN 20
120 END
