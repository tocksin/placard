Name     ALU4;
PartNo   00;
Date     10/15/2026;
Revision 05;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* =========================================================
   ATF22V10C 4-BIT ALU   (WinCUPL, device g22v10)

   FUNCTION SELECT

       S2 S1 S0
       --------
       0  0  0     PASS B
       0  0  1     AND
       0  1  0     OR
       0  1  1     XOR
       1  0  0     ADD
       1  0  1     SUB
       1  1  0     SHIFT RIGHT
       1  1  1     PASS A

   SUBTRACTION:  A - B - CIN = A + !B + !CIN
       CIN = 1 means borrow in, COUT = 1 means borrow out.
       COUT carries the raw borrow (not the adder's
       no-borrow carry) so the low chip's COUT can drive the
       high chip's CIN directly for both ADD and SUB, with no
       inverter or XOR gate between the chips.

   PASS A:  F = A.  B and CIN are ignored and COUT = 0.
       Used by the branch/jump opcode (I7:I5 = 111): Z of each
       chip is then the zero flag of that nibble of the
       accumulator, and F3 of the high chip is the accumulator
       sign bit.  Because CIN is ignored, the zero flag of the
       high chip does not depend on the low chip.

   SHIFT RIGHT:
       F3 = SHIFT_RIGHT_IN, F2 = A3, F1 = A2, F0 = A1, COUT = A0

   WHY THERE ARE EXTRA OUTPUT PINS (D1, D2, D3)
   ---------------------------------------------
   The 22V10 allows only 8 to 16 product terms per output and
   has no buried nodes.  A flat 4-bit ripple-carry adder needs
   over 100 terms on F3, so the carry chain is split into
   small pieces.  D1..D3 are internal carry nodes that are
   brought out on spare I/O pins and fed back into the array.
   Leave D1..D3 unconnected on the board (or use them as test
   points).

   ADD and SUB share one carry chain.  With S0 = 0 for ADD and
   S0 = 1 for SUB, the adder computes

       A + (B xor S0) + (CIN xor S0)

   The nodes hold the carry XORed with S0 ("D = carry xor S0"),
   which makes every sum bit a plain 3-input XOR:

       Fi  = Ai xor Bi xor Di        (D0 = CIN)
       D(i+1) = MAJ( Ai xor S0, Bi, Di )
       D4 = carry out for ADD, borrow out for SUB  (= COUT)

   LOOKAHEAD (revision 05)
   D2 and COUT each look ahead two bits, using intermediate
   carries C1 and C3 that are not pins (WinCUPL expands them
   into the equations).  The carry passes through two pins in
   the low chip (B -> D2 -> COUT) and three in the high chip
   (CIN -> D2 -> D3 -> F3), so the 8-bit add or subtract is
   five array passes (37.5 ns with the -7), down from eight.
   D1 and D3 are still pins because F1 and F3 use them.

   Product terms (minimised) and the pins chosen for them:
       D2 13 -> pin 19 (16)      COUT 14 -> pin 18 (16)
       F0, F1 10 -> 17, 20 (14)  F2, F3 10 -> 16, 21 (12)
       D1 5 -> 15 (10)           D3 5 -> 22 (10)
       Z 1 -> 14 (8)
   F0..F3 are at most 12 terms even unminimised.
   ========================================================= */


/* =========================================================
   PIN ASSIGNMENTS
   (pin 12 = GND, pin 24 = VCC on the ATF22V10C)
   ========================================================= */

PIN 1   = A0;
PIN 2   = A1;
PIN 3   = A2;
PIN 4   = A3;

PIN 5   = B0;
PIN 6   = B1;
PIN 7   = B2;
PIN 8   = B3;

PIN 9   = S0;
PIN 10  = S1;
PIN 11  = S2;

PIN 13  = CIN;
PIN 23  = SHIFT_RIGHT_IN;   /* input only, uses an I/O pin */

PIN 17  = F0;
PIN 20  = F1;
PIN 16  = F2;
PIN 21  = F3;
PIN 18  = COUT;
PIN 14  = Z;

PIN 15  = D1;   /* internal carry node, no external connection */
PIN 19  = D2;   /* internal carry node, no external connection */
PIN 22  = D3;   /* internal carry node, no external connection */


/* =========================================================
   FUNCTION SELECT TERMS
   ========================================================= */

PASS_SEL  = !S2 & !S1 & !S0;
AND_SEL   = !S2 & !S1 &  S0;
OR_SEL    = !S2 &  S1 & !S0;
XOR_SEL   = !S2 &  S1 &  S0;
SHR_SEL   =  S2 &  S1 & !S0;
PASSA_SEL =  S2 &  S1 &  S0;
ARITH_SEL =  S2 & !S1;         /* ADD (S0=0) or SUB (S0=1) */


/* =========================================================
   CARRY NODES   (D = carry xor S0)
   ========================================================= */

D1 = ((A0 $ S0) & B0) # ((A0 $ S0) & CIN) # (B0 & CIN);

/* C1 is the same carry as D1, but as an intermediate (not a
   pin) so D2 is computed straight from the inputs. */
C1 = ((A0 $ S0) & B0) # ((A0 $ S0) & CIN) # (B0 & CIN);

D2 = ((A1 $ S0) & B1) # ((A1 $ S0) & C1)  # (B1 & C1);

D3 = ((A2 $ S0) & B2) # ((A2 $ S0) & D2)  # (B2 & D2);

/* C3 is the same carry as D3, as an intermediate, so COUT is
   two bits of lookahead from the D2 pin. */
C3 = ((A2 $ S0) & B2) # ((A2 $ S0) & D2)  # (B2 & D2);

/* carry out of bit 3: carry for ADD, borrow for SUB */
D4 = ((A3 $ S0) & B3) # ((A3 $ S0) & C3) # (B3 & C3);


/* =========================================================
   FUNCTION OUTPUTS
   ========================================================= */

F0 =
      (PASS_SEL  & B0)
    # (OR_SEL    & (A0 # B0))
    # (XOR_SEL   & (A0 $ B0))
    # (SHR_SEL   & A1)
    # (ARITH_SEL & (A0 $ B0 $ CIN))
    # (AND_SEL   & (A0 & B0))
    # (PASSA_SEL & A0);

F1 =
      (PASS_SEL  & B1)
    # (OR_SEL    & (A1 # B1))
    # (XOR_SEL   & (A1 $ B1))
    # (SHR_SEL   & A2)
    # (ARITH_SEL & (A1 $ B1 $ D1))
    # (AND_SEL   & (A1 & B1))
    # (PASSA_SEL & A1);

F2 =
      (PASS_SEL  & B2)
    # (OR_SEL    & (A2 # B2))
    # (XOR_SEL   & (A2 $ B2))
    # (SHR_SEL   & A3)
    # (ARITH_SEL & (A2 $ B2 $ D2))
    # (AND_SEL   & (A2 & B2))
    # (PASSA_SEL & A2);

F3 =
      (PASS_SEL  & B3)
    # (OR_SEL    & (A3 # B3))
    # (XOR_SEL   & (A3 $ B3))
    # (SHR_SEL   & SHIFT_RIGHT_IN)
    # (ARITH_SEL & (A3 $ B3 $ D3))
    # (AND_SEL   & (A3 & B3))
    # (PASSA_SEL & A3);


/* =========================================================
   CARRY OUTPUT
   ADD/SUB : carry / borrow   (matches what CIN expects)
   SHR     : A0 is the bit shifted out
   PASS A  : 0
   ========================================================= */

COUT =
      (ARITH_SEL & D4)
    # (SHR_SEL   & A0);


/* =========================================================
   ZERO FLAG   Z = 1 when F3..F0 are all zero
   ========================================================= */

Z = !F0 & !F1 & !F2 & !F3;


/* =========================================================
   END
   ========================================================= */
