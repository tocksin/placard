Name     ALU4;
PartNo   00;
Date     10/07/2026;
Revision 02;
Designer ;
Company  ;
Assembly ;
Location ;
Device   f22v10;


/* =========================================================
   ATF22V10C 4-BIT ALU   (WinCUPL, device f22v10)

   FUNCTION SELECT

       S2 S1 S0
       --------
       0  0  0     PASS B
       0  0  1     AND
       0  1  0     OR
       0  1  1     XOR
       1  0  0     ADD
       1  0  1     SUB
       1  1  0     SHIFT RIGHT
       1  1  1     NEG A (2s complement of A)

   SUBTRACTION:  A - B - CIN = A + !B + !CIN
       COUT = 1 means no borrow, COUT = 0 means borrow

   NEG A:  F = 0 - A - CIN  (4-bit 2s complement of A when CIN = 0)
       Same borrow convention as SUB: CIN = 1 is a borrow in,
       COUT = 1 means no borrow, so COUT = 1 only when A = 0 and
       CIN = 0.  Chain it exactly like SUB (borrow = !COUT of the
       lower chip) to negate a number wider than 4 bits.
       Bit i:  Fi = Ai xor Bi_in,  borrow out = Ai or Bi_in
       F0 = A0 xor CIN
       F1 = A1 xor (A0 or CIN)
       F2 = A2 xor (A1 or A0 or CIN)
       F3 = A3 xor (A2 or A1 or A0 or CIN)

   SHIFT RIGHT:
       F3 = SHIFT_RIGHT_IN, F2 = A3, F1 = A2, F0 = A1, COUT = A0

   WHY THERE ARE EXTRA OUTPUT PINS (D1, D2, D3)
   ---------------------------------------------
   The 22V10 allows only 8 to 16 product terms per output and
   has no buried nodes.  A flat 4-bit ripple-carry adder needs
   over 100 terms on F3, so the carry chain is split into
   small pieces.  D1..D3 are internal carry nodes that are
   brought out on spare I/O pins and fed back into the array.
   Leave D1..D3 unconnected on the board (or use them as test
   points).

   ADD and SUB share one carry chain.  With S0 = 0 for ADD and
   S0 = 1 for SUB, the adder computes

       A + (B xor S0) + (CIN xor S0)

   The nodes hold the carry XORed with S0 ("D = carry xor S0"),
   which makes every sum bit a plain 3-input XOR:

       Fi  = Ai xor Bi xor Di        (D0 = CIN)
       D(i+1) = MAJ( Ai xor S0, Bi, Di )
       true carry out = D4 xor S0

   Timing: the carry passes through D1, D2, D3, then F3/COUT,
   so allow roughly four pin-to-pin delays for the worst path.
   ========================================================= */


/* =========================================================
   PIN ASSIGNMENTS
   (pin 12 = GND, pin 24 = VCC on the ATF22V10C)
   ========================================================= */

PIN 1   = A0;
PIN 2   = A1;
PIN 3   = A2;
PIN 4   = A3;

PIN 5   = B0;
PIN 6   = B1;
PIN 7   = B2;
PIN 8   = B3;

PIN 9   = S0;
PIN 10  = S1;
PIN 11  = S2;

PIN 13  = CIN;
PIN 23  = SHIFT_RIGHT_IN;   /* input only, uses an I/O pin */

PIN 20  = F0;
PIN 17  = F1;
PIN 18  = F2;
PIN 19  = F3;
PIN 15  = COUT;
PIN 14  = Z;

PIN 22  = D1;   /* internal carry node, no external connection */
PIN 21  = D2;   /* internal carry node, no external connection */
PIN 16  = D3;   /* internal carry node, no external connection */


/* =========================================================
   FUNCTION SELECT TERMS
   ========================================================= */

PASS_SEL = !S2 & !S1 & !S0;
AND_SEL  = !S2 & !S1 &  S0;
OR_SEL   = !S2 &  S1 & !S0;
XOR_SEL  = !S2 &  S1 &  S0;
SHR_SEL  =  S2 &  S1 & !S0;
NEG_SEL  =  S2 &  S1 &  S0;
ARITH_SEL = S2 & !S1;           /* ADD (S0=0) or SUB (S0=1) */


/* =========================================================
   CARRY NODES   (D = carry xor S0)
   ========================================================= */

D1 = ((A0 $ S0) & B0) # ((A0 $ S0) & CIN) # (B0 & CIN);

D2 = ((A1 $ S0) & B1) # ((A1 $ S0) & D1)  # (B1 & D1);

D3 = ((A2 $ S0) & B2) # ((A2 $ S0) & D2)  # (B2 & D2);

/* true carry out of bit 3 (carry for ADD, no-borrow for SUB) */
C4 = ( ((A3 $ S0) & B3) # ((A3 $ S0) & D3) # (B3 & D3) ) $ S0;


/* =========================================================
   FUNCTION OUTPUTS
   ========================================================= */

F0 =
      (PASS_SEL  & B0)
    # (OR_SEL    & (A0 # B0))
    # (XOR_SEL   & (A0 $ B0))
    # (SHR_SEL   & A1)
    # (ARITH_SEL & (A0 $ B0 $ CIN))
    # (AND_SEL   & (A0 & B0))
    # (NEG_SEL   & (A0 $ CIN));

F1 =
      (PASS_SEL  & B1)
    # (OR_SEL    & (A1 # B1))
    # (XOR_SEL   & (A1 $ B1))
    # (SHR_SEL   & A2)
    # (ARITH_SEL & (A1 $ B1 $ D1))
    # (AND_SEL   & (A1 & B1))
    # (NEG_SEL   & (A1 $ (A0 # CIN)));

F2 =
      (PASS_SEL  & B2)
    # (OR_SEL    & (A2 # B2))
    # (XOR_SEL   & (A2 $ B2))
    # (SHR_SEL   & A3)
    # (ARITH_SEL & (A2 $ B2 $ D2))
    # (AND_SEL   & (A2 & B2))
    # (NEG_SEL   & (A2 $ (A1 # A0 # CIN)));

F3 =
      (PASS_SEL  & B3)
    # (OR_SEL    & (A3 # B3))
    # (XOR_SEL   & (A3 $ B3))
    # (SHR_SEL   & SHIFT_RIGHT_IN)
    # (ARITH_SEL & (A3 $ B3 $ D3))
    # (AND_SEL   & (A3 & B3))
    # (NEG_SEL   & (A3 $ (A2 # A1 # A0 # CIN)));


/* =========================================================
   CARRY OUTPUT
   ADD/SUB : carry / no-borrow
   SHR     : A0 is the bit shifted out
   NEG     : 1 (no borrow) only when A = 0 and CIN = 0
   ========================================================= */

COUT =
      (ARITH_SEL & C4)
    # (SHR_SEL   & A0)
    # (NEG_SEL   & !A3 & !A2 & !A1 & !A0 & !CIN);


/* =========================================================
   ZERO FLAG   Z = 1 when F3..F0 are all zero
   ========================================================= */

Z = !F0 & !F1 & !F2 & !F3;


/* =========================================================
   END
   ========================================================= */
