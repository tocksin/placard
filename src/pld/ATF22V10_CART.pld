Name     CART;
PartNo   00;
Date     10/20/2026;
Revision 01;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   ROM CARTRIDGE LOADER   (ATF22V10C, DIP-24, on the cartridge)
   ============================================================

   The cartridge's ROM, as the CPU sees it, is two AS7C256C 15 ns
   SRAMs, which lose their contents at power-off.  Two AT28C256
   EEPROMs on the same address lines hold the image.  At power-up
   this PLD holds the main board's clock, steps the CPU through the
   whole 64K while it copies each EEPROM byte into the SRAM, then
   lets the board run from x0000.  See docs/ROM.md, "Loading the
   cartridge".

   HOW IT WORKS
      The main board's clock is CLK = OSC OR HOLD (a 74AC32 gate).
      HOLD is high from power-up, so no clock edge reaches the board
      and every main-board PLD stays in its power-up state: FETCH,
      PC = x0000.  The memory control PLD keeps /ROM_OE high while
      RUN is low, so the SRAM never drives the bus, and RUN holds the
      map register clear (all ROM) and the expansion cards in reset.

      The PLD lets the board have one clock at a time (RELEASE high
      for one OSC cycle, so CLK goes low for that cycle's low half).
      One OSC cycle after each board edge (DECIDE) it looks at the
      clock the CPU is now in:

        - A CPU read (PIXEL_ENABLE low, /SRC_EN high, which during
          the load is always a FETCH): the address on the bus is
          the PC.  The EEPROM drives its byte for that address, the
          SRAM is written, the EEPROM lets go, and the 74AC541
          (inputs wired to 02h) drives the opcode 02h, `ld ac, ac`,
          for the CPU to fetch.  02h is one byte, two clocks, and
          changes nothing, so the PC steps through every address.
        - Anything else (EXEC, a video read): release at once.

      The SRAM is written at every address the PC reaches, the I/O
      window too (its bytes are not used).  When the PC wraps from
      xFFFF to x0000 (A15 goes from 1 to 0 between two CPU reads),
      every address has been written: the PLD raises RUN and
      RELEASE together in that x0000 fetch, so its low half reads
      the SRAM, and the CPU starts at x0000 as at a power-up.

   OSC CYCLES OF ONE CPU READ (c0 = the board's clock edge)
      c0   edge                           RELEASE 1 -> 0
      c1   DECIDE: read, no wrap          EE_OE on, CNT = 1
      c5   CNT 4 (EEPROM valid by c4+17)  SR_WE on  (/WE low c5-c6)
      c6   CNT 5                          SR_WE off
      c7   CNT 6                          EE_OE off (floats by c8+16)
      c9   CNT 8                          BUF_OE on, RELEASE on
      c10  edge (CLK was low c9.5-c10)    BUF_OE off, RELEASE off
      A read takes 10 OSC cycles, any other clock 2.  02h is a FETCH
      and an EXEC, so one sweep of the 64K is about 64K x 12 x
      39.7 ns = 31 ms, plus video read clocks.

   TIMING
      The board edge is OSC plus the 74AC32 (up to about 7.5 ns).
      The address is settled 21 ns after it and /SRC_EN 13 ns after
      it, so 28.5 ns after the OSC edge, before DECIDE at 39.7 ns
      (-10 grade input setup about 7 ns).  AT28C256-15: tACC 150 ns
      from c0 + 28.5, tOE 70 ns from c1 + tCO, data by c5 with
      about 20 ns to spare; tDF 50 ns, so it lets go by c8 + 16.
      The 74AC541 turns on at c9 + tCO + about 8 ns and off by about
      the same after c10: after the CPU latched it (IR hold 0 ns)
      and before an EXEC's source F541 turns on (22 ns after the
      board edge).  HOLD changes only while OSC is high, so CLK
      never has a short pulse.

   POWER-UP
      The ATF22V10C clears every register at power-up, so RELEASE,
      RUN, EE_OE, SR_WE and BUF_OE are all 0: HOLD (pin 23, active
      low output of RELEASE) is high, /EE_OE, /SR_WE and /BUF_OE are
      high, RUN is low.  The main board's pull-up on HOLD and
      pull-down on RUN hold the board the same way before this PLD
      is powered up, or when no cartridge is in.

   PIN BUDGET
      Inputs (4):  OSC (pin 1), A15 (= /CE_LO), PIXEL_ENABLE, /SRC_EN
      Outputs (10, every cell): HOLD, RUN, /EE_OE, /SR_WE, /BUF_OE,
                   PREV15, CNT3:CNT0
      Unused: pins 5-11, 13.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = OSC;          /* 25.175 MHz oscillator, before the main board's CLK gate */
PIN 2  = A15;          /* /CE_LO from the main board: the address mux's A15 */
PIN 3  = PIXEL_ENABLE; /* Sync PLD pin 19: video read, the CPU is stalled */
PIN 4  = !SRC_EN;      /* branch PLD pin 16, low in EXEC (the source F541s drive the bus) */


/* ---------------- OUTPUTS ---------------- */

PIN 14 = CNT0;         /* step counter: no external connection */
PIN 15 = CNT1;         /* no external connection */
PIN 16 = CNT2;         /* no external connection */
PIN 17 = CNT3;         /* no external connection */
PIN 18 = PREV15;       /* A15 at the last CPU read: no external connection */
PIN 19 = !SR_WE;       /* /WE of both cartridge SRAMs */
PIN 20 = !EE_OE;       /* /OE of both EEPROMs */
PIN 21 = !BUF_OE;      /* /OE1 and /OE2 of the 74AC541 (inputs wired to 02h) */
PIN 22 = RUN;          /* to the main board: memory control pin 17, map /MR, card /RESET */
PIN 23 = !RELEASE;     /* HOLD to the main board's clock gate, high = clock held */


/* ---------------- DECODE ---------------- */

FIELD CNT = [CNT3..CNT0];

DECIDE = !RUN & !RELEASE & CNT:0;          /* one OSC cycle after a board edge, or at power-up */
READ   = !PIXEL_ENABLE & !SRC_EN;          /* a CPU read (a FETCH while loading) */
WRAP   = !A15 & PREV15;                    /* the PC went from xFFFF to x0000 */
COPY   = DECIDE & READ & !WRAP;            /* start a copy and feed */
HANDOFF = DECIDE & READ & WRAP;            /* the 64K is loaded */


/* ---------------- EQUATIONS ---------------- */

RELEASE.D = RUN
          # DECIDE & !READ
          # HANDOFF
          # !RUN & CNT:8;

RUN.D = RUN
      # HANDOFF;

/* CNT: 0 -> (COPY) 1 -> 2 -> ... -> 8 -> 0 */
CNT0.D = COPY
       # !CNT3 & !CNT0 & CNT1          /* 2 -> 3, 6 -> 7 */
       # !CNT3 & !CNT0 & CNT2;         /* 4 -> 5, 6 -> 7 */
CNT1.D = !CNT3 &  CNT1 & !CNT0         /* 2 -> 3, 6 -> 7 */
       # !CNT3 & !CNT1 &  CNT0;        /* 1 -> 2, 5 -> 6 */
CNT2.D = !CNT3 & !CNT2 & CNT1 & CNT0   /* 3 -> 4 */
       # !CNT3 &  CNT2 & !CNT1         /* 4 -> 5, 5 -> 6 */
       # !CNT3 &  CNT2 & !CNT0;        /* 4 -> 5, 6 -> 7 */
CNT3.D = !CNT3 &  CNT2 & CNT1 & CNT0;  /* 7 -> 8 */

PREV15.D = COPY & A15
         # !DECIDE & PREV15
         # !READ & PREV15;

EE_OE.D = COPY
        # EE_OE & !CNT:6;

SR_WE.D = CNT:4;

BUF_OE.D = !RUN & CNT:8;

[CNT3..CNT0, PREV15, SR_WE, EE_OE, BUF_OE, RUN, RELEASE].AR = 'b'0;
[CNT3..CNT0, PREV15, SR_WE, EE_OE, BUF_OE, RUN, RELEASE].SP = 'b'0;
