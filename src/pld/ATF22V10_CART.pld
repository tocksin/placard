Name     CART;
PartNo   00;
Date     10/21/2026;
Revision 04;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   ROM CARTRIDGE LOADER   (ATF22V10C-7, DIP-24, on the cartridge)
   ============================================================

   The cartridge's ROM, as the CPU sees it, is two AS7C256C 15 ns
   SRAMs, which lose their contents at power-off.  Two AT28C256
   EEPROMs on the same address lines hold the image.  At power-up
   this PLD stalls the CPU at each address the PC reaches, copies
   that EEPROM byte into the SRAM, lets the CPU take one step, and
   when the PC has wrapped to x0000 lets the board run from the
   SRAM.  See docs/ROM.md, "Loading the cartridge".

   REVISION 04 (2026-10-21): no clock gating and no 74AC541.  The
   board clock runs free from power-up (the 74AC32 clock gate is
   gone).  Instead of holding the clock, this PLD holds the CPU's
   STALL line, the one video reads use: the Branch PLD's STALL
   comes in on STALL_IN and goes back to the State and PC PLDs as

      STALL_OUT = STALL_IN # !RUN & PC_ENABLE & !RELEASE

   While STALL_OUT is high the State PLD holds its state and every
   load strobe is off, the PC holds, and the source F541s are off
   (they only drive in EXEC), so the address bus shows the PC and
   only the EEPROM drives the data bus.  The instruction register
   (ATF22V10_IR.pld) holds 02h, `ld ac, ac`, while RUN is low, so
   whatever byte the CPU fetches, it runs 02h: nothing is written,
   only D and AC are loaded.  The byte on the bus still steers the
   State PLD (FETCH -> LOAD_IMM, LOAD_MEM or EXEC), so the CPU
   walks the image the way it would run it, 1- and 2-byte
   instructions alike.  The PC is on the address bus in FETCH and
   LOAD_IMM (PC_ENABLE high), and it steps by one in each, so every
   address is a FETCH or a LOAD_IMM read once: this PLD stalls and
   copies in both.  LOAD_MEM and EXEC are let through at once.

   VIDEO KEEPS RUNNING
      A video read (PIXEL_ENABLE) takes one clock in eight, always
      at the same place in the 8-clock group.  G2:G0 count the
      clocks of the group (Gray code, phase K0-K7) and restart at
      K0 after each video read, so K7 is the only clock a video read
      can come in.  A copy uses K0-K6 of one group:

      K0   the CPU is stalled at the PC (address valid by 20.5 ns)
      e1   START (sampled at the end of K0): COPY on, EEPROM /OE on
      K4   /SR_WE low (data valid by K0 + 178 ns, /WE rises at
           K5 + 5.5 ns = 204 ns)
      K5   /EE_OE high with /WE, so the EEPROM is off by K5 + 55.5
           = K6 + 15.8 ns
      K6   RELEASE: STALL_OUT low, the CPU takes one step at the
           end of K6.  If that step is a LOAD_IMM read in the I/O
           window, an I/O device drives from K6 + 37.5 ns (STALL_OUT,
           State strobe, I/O decode, F541): 21.7 ns after the
           EEPROM let go
      K7   a video read (the main RAM drives in the low half of the
           clock) or the CPU's next state

      The State PLD reads the bus (bits 4:0) at the end of K6 for
      the next state: that is the EEPROM byte, still held on the
      bus by its capacitance (the 10k pull-ups take microseconds).
      Until the first video read is seen (SYNCED) no copy starts.

   HAND-OFF
      PREV15 is A15 at the last copy.  When a copy would start with
      A15 = 0 and PREV15 = 1, the PC has wrapped from xFFFF to
      x0000 and every address has been copied: RUN goes high
      instead (HANDOFF), STALL_OUT follows STALL_IN only, /ROM_OE
      works, the IR stops holding 02h, and the CPU reads x0000 from
      the SRAM.  The CPU is then in FETCH or in LOAD_IMM at x0000,
      depending on how the image's last instruction ended, so the
      image keeps a 1-byte `nop` (02h) at x0000: fetched, it does
      nothing; read as an operand, it is skipped.  Either way the
      next fetch is at x0001.

   POWER-UP
      Every register is 0: RUN low, COPY off, /EE_OE and /SR_WE
      high, STALL_OUT = STALL_IN # PC_ENABLE, so the CPU (in FETCH
      at power-up) stays stalled.  The main board pulls STALL_OUT up
      and RUN down, so it stays stalled with no cartridge too (or a
      bring-up jumper joins STALL_IN to STALL_OUT and RUN to +5 V).

   TIMING (ATF22V10C-7: tPD 7.5, tCO 5.5, tS 3.5 ns)
      STALL_IN -> STALL_OUT -> State LOAD strobe -> F377 /E:
      5.5 + 7.5 + 7.5 + 7.5 + 4.5 = 32.5 ns (+7.2).
      PC_ENABLE -> STALL_OUT -> State and PC setup: 5.5 + 7.5 + 3.5
      = 16.5 ns.  A15 is settled 20.5 ns after the edge (+15.7 to
      the setup at the end of K0).

   PIN BUDGET
      Inputs (5):  CLK (pin 1), A15 (= /CE_LO), PIXEL_ENABLE,
                   PC_ENABLE, STALL_IN
      Outputs (10, every cell): STALL_OUT, RUN, /EE_OE, /SR_WE,
                   COPY, PREV15, SYNCED, G2:G0
      Unused: pins 6-11, 13.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = CLK;          /* the board clock (the oscillator, ungated) */
PIN 2  = A15;          /* /CE_LO from the main board: the address mux's A15 */
PIN 3  = PIXEL_ENABLE; /* Sync PLD pin 19: a video read this clock */
PIN 4  = PC_ENABLE;    /* State PLD pin 15: FETCH or LOAD_IMM, the PC is on the address bus */
PIN 5  = STALL_IN;     /* Branch PLD pin 19: video read or ALU wait */


/* ---------------- OUTPUTS ---------------- */

PIN 14 = G0;           /* group phase, Gray code: no external connection */
PIN 15 = G1;           /* no external connection */
PIN 16 = G2;           /* no external connection */
PIN 17 = COPY;         /* a copy is running (K1-K6): no external connection */
PIN 18 = PREV15;       /* A15 at the last copy: no external connection */
PIN 19 = !SR_WE;       /* /WE of both cartridge SRAMs */
PIN 20 = !EE_OE;       /* /OE of both EEPROMs */
PIN 21 = SYNCED;       /* a video read has been seen: no external connection */
PIN 22 = RUN;          /* to the main board: memory control pin 17, IR PLD pin 11, map /MR, card /RESET */
PIN 23 = STALL_OUT;    /* to the State PLD pin 2 and both PC PLDs pin 14 (combinational) */


/* ---------------- DECODE ---------------- */

/* phase K0-K7 in Gray code: 000 001 011 010 110 111 101 100 */
K0 = !G2 & !G1 & !G0;
K3 = !G2 &  G1 & !G0;
K6 =  G2 & !G1 &  G0;

/* a stalled CPU read at the PC in K0 */
READY   = SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0;
WRAP    = !A15 & PREV15;                  /* the PC went from xFFFF to x0000 */
START   = READY & !WRAP;                  /* copy this address */
HANDOFF = READY & WRAP;                   /* the 64K is loaded */


/* ---------------- EQUATIONS ---------------- */

/* phase: K0 after a video read, else the next phase */
G0.D = !PIXEL_ENABLE & !G2 & !G1
     # !PIXEL_ENABLE &  G2 &  G1;
G1.D = !PIXEL_ENABLE & !G2 &  G0
     # !PIXEL_ENABLE & !G2 &  G1
     # !PIXEL_ENABLE &  G1 & !G0;
G2.D = !PIXEL_ENABLE &  G1 & !G0
     # !PIXEL_ENABLE &  G2 &  G0;

SYNCED.D = SYNCED
         # PIXEL_ENABLE;

/* COPY: on from the end of K0 to the end of K6 */
COPY.D = SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & A15
       # SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & !PREV15
       # COPY & !G2
       # COPY &  G1
       # COPY & !G0;

/* PREV15 only ever goes from 0 to 1: a copy at A15 = 1 */
PREV15.D = PREV15
         # SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & A15;

RUN.D = RUN
      # SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & !A15 & PREV15;

/* SRAM /WE low for K4 */
SR_WE.D = COPY & K3;

/* EEPROM /OE low for K1-K4: on with COPY, off with /WE */
EE_OE.D = SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & A15
        # SYNCED & !RUN & PC_ENABLE & !PIXEL_ENABLE & K0 & !PREV15
        # COPY & !G2 &  G0
        # COPY & !G2 &  G1;

/* hold the CPU at the PC, except in K6 of a copy (RELEASE = COPY & K6) */
STALL_OUT = STALL_IN
          # !RUN & PC_ENABLE & !COPY
          # !RUN & PC_ENABLE & !G2
          # !RUN & PC_ENABLE &  G1
          # !RUN & PC_ENABLE & !G0;

[G2..G0, COPY, PREV15, SR_WE, EE_OE, SYNCED, RUN].AR = 'b'0;
[G2..G0, COPY, PREV15, SR_WE, EE_OE, SYNCED, RUN].SP = 'b'0;
