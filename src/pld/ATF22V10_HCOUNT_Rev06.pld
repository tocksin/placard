Name     VGA_RELOAD_COUNTER;
PartNo   ATF22V10C;
Date     2026-09-11;
Revision 1.0;
Designer OpenAI;
Company  "";
Assembly "";
Location "";
Device   f22v10;


/*
 * ============================================================
 * 10-BIT RELOADABLE DOWN COUNTER
 * ============================================================
 *
 * Operation:
 *
 *     RESET asserted:
 *         COUNT = 0
 *
 *     After reset:
 *         COUNT counts downward
 *
 *         LOAD, LOAD-1, LOAD-2, ... 1, 0,
 *         LOAD, LOAD-1, ...
 *
 * Example:
 *
 *     LOAD = 799
 *     799,798,...,1,0,799,798,...
 *
 *     LOAD = 524
 *     524,523,...,1,0,524,523,...
 *
 * /RESET is asynchronous.
 *
 */


/* ============================================================ */
/* INPUTS                                                        */
/* ============================================================ */

PIN 1  = /RESET;

PIN 2  = LOAD0;
PIN 3  = LOAD1;
PIN 4  = LOAD2;
PIN 5  = LOAD3;
PIN 6  = LOAD4;
PIN 7  = LOAD5;
PIN 8  = LOAD6;
PIN 9  = LOAD7;
PIN 10 = LOAD8;
PIN 11 = LOAD9;

PIN 13 = CLK;


/* ============================================================ */
/* OUTPUTS                                                       */
/* ============================================================ */

PIN 14 = COUNT0;
PIN 15 = COUNT1;
PIN 16 = COUNT2;
PIN 17 = COUNT3;
PIN 18 = COUNT4;
PIN 19 = COUNT5;
PIN 20 = COUNT6;
PIN 21 = COUNT7;
PIN 22 = COUNT8;
PIN 23 = COUNT9;


/* ============================================================ */
/* ZERO DETECTION                                                */
/* ============================================================ */

ZERO =
    !COUNT9 &
    !COUNT8 &
    !COUNT7 &
    !COUNT6 &
    !COUNT5 &
    !COUNT4 &
    !COUNT3 &
    !COUNT2 &
    !COUNT1 &
    !COUNT0;


/* ============================================================ */
/* BORROW TERMS FOR BINARY DECREMENT                             */
/* ============================================================ */

/*
 * To subtract one:
 *
 * bit 0 always toggles
 *
 * bit 1 toggles when bit 0 is zero
 *
 * bit 2 toggles when bits 1:0 are zero
 *
 * etc.
 */

B1 = !COUNT0;

B2 = !COUNT1 & !COUNT0;

B3 = !COUNT2 & !COUNT1 & !COUNT0;

B4 = !COUNT3 & !COUNT2 & !COUNT1 & !COUNT0;

B5 = !COUNT4 & !COUNT3 & !COUNT2 & !COUNT1 & !COUNT0;

B6 = !COUNT5 & !COUNT4 & !COUNT3 & !COUNT2 &
     !COUNT1 & !COUNT0;

B7 = !COUNT6 & !COUNT5 & !COUNT4 & !COUNT3 &
     !COUNT2 & !COUNT1 & !COUNT0;

B8 = !COUNT7 & !COUNT6 & !COUNT5 & !COUNT4 &
     !COUNT3 & !COUNT2 & !COUNT1 & !COUNT0;

B9 = !COUNT8 & !COUNT7 & !COUNT6 & !COUNT5 &
     !COUNT4 & !COUNT3 & !COUNT2 & !COUNT1 & !COUNT0;


/* ============================================================ */
/* NEXT STATE                                                    */
/* ============================================================ */

/*
 * When ZERO is true:
 *
 *     COUNT(next) = LOAD
 *
 * Otherwise:
 *
 *     COUNT(next) = COUNT - 1
 */


/* Bit 0 */

COUNT0.D =
      (ZERO & LOAD0)
    # (!ZERO & !COUNT0);


/* Bit 1 */

COUNT1.D =
      (ZERO & LOAD1)
    # (!ZERO & (COUNT1 $ B1));


/* Bit 2 */

COUNT2.D =
      (ZERO & LOAD2)
    # (!ZERO & (COUNT2 $ B2));


/* Bit 3 */

COUNT3.D =
      (ZERO & LOAD3)
    # (!ZERO & (COUNT3 $ B3));


/* Bit 4 */

COUNT4.D =
      (ZERO & LOAD4)
    # (!ZERO & (COUNT4 $ B4));


/* Bit 5 */

COUNT5.D =
      (ZERO & LOAD5)
    # (!ZERO & (COUNT5 $ B5));


/* Bit 6 */

COUNT6.D =
      (ZERO & LOAD6)
    # (!ZERO & (COUNT6 $ B6));


/* Bit 7 */

COUNT7.D =
      (ZERO & LOAD7)
    # (!ZERO & (COUNT7 $ B7));


/* Bit 8 */

COUNT8.D =
      (ZERO & LOAD8)
    # (!ZERO & (COUNT8 $ B8));


/* Bit 9 */

COUNT9.D =
      (ZERO & LOAD9)
    # (!ZERO & (COUNT9 $ B9));


/* ============================================================ */
/* CLOCK                                                         */
/* ============================================================ */

COUNT0.C = CLK;
COUNT1.C = CLK;
COUNT2.C = CLK;
COUNT3.C = CLK;
COUNT4.C = CLK;
COUNT5.C = CLK;
COUNT6.C = CLK;
COUNT7.C = CLK;
COUNT8.C = CLK;
COUNT9.C = CLK;


/* ============================================================ */
/* ASYNCHRONOUS RESET                                            */
/* ============================================================ */

COUNT0.AR = !RESET;
COUNT1.AR = !RESET;
COUNT2.AR = !RESET;
COUNT3.AR = !RESET;
COUNT4.AR = !RESET;
COUNT5.AR = !RESET;
COUNT6.AR = !RESET;
COUNT7.AR = !RESET;
COUNT8.AR = !RESET;
COUNT9.AR = !RESET;
