Name     ATF22V10_ALU;
PartNo   00;
Date     09/10/2026;
Revision 07;
Designer;
Company;
Assembly;
Location;
Device   g22v10;

/*
 * 4-bit ALU slice, designed for cascading into wider ALUs.
 *
 * M=0:
 *   S1 S0 = 00  A AND B
 *   S1 S0 = 01  A OR B
 *   S1 S0 = 10  A XOR B
 *   S1 S0 = 11  NOT A
 *
 * M=1:
 *   S1 S0 = 00  A + B + CIN
 *   S1 S0 = 01  A - B - CIN
 *   S1 S0 = 10  A + CIN
 *                    CIN=0 -> A
 *                    CIN=1 -> A+1
 *   S1 S0 = 11  A - CIN
 *                    CIN=0 -> A
 *                    CIN=1 -> A-1
 *
 * C1-C4 are RAW arithmetic carry/borrow signals:
 *   ADD/INC: 1 = carry out
 *   SUB/DEC: 1 = borrow out
 *
 * Therefore C4 can connect directly to CIN of the next 4-bit ALU.
 *
 * CPU conventional carry flag:
 *   CPU_C = C4 XOR (M & S0)
 *   (not generated as a pin on this 4-bit slice)
 *
 * N = F3.
 * Z = 1 when F = 0.
 * V = signed arithmetic overflow.
 */

PIN 1  = A0;
PIN 2  = A1;
PIN 3  = A2;
PIN 4  = A3;
PIN 5  = B0;
PIN 6  = B1;
PIN 7  = B2;
PIN 8  = B3;
PIN 9  = S0;
PIN 10 = S1;
PIN 11 = M;
PIN 13 = CIN;

PIN 18 = F0;
PIN 19 = F1;
PIN 17 = F2;
PIN 20 = F3;

PIN 14 = C1;
PIN 23 = C2;
PIN 15 = C3;
PIN 22 = C4;

PIN 16 = Z;
PIN 21 = V;

/*
 * BIT 0
 *
 * This equation is intentionally different from the higher-bit
 * equations. In particular, INC/DEC use CIN at bit 0.
 */

F0 =
      (A0 & B0 & CIN & !S1)
    # (A0 & M & S1 & !CIN)
    # (CIN & M & S1 & !A0)
    # (A0 & B0 & !M & !S1)
    # (A0 & M & !B0 & !CIN)
    # (A0 & S0 & !M & !S1)
    # (B0 & S0 & !A0 & !M)
    # (B0 & S1 & !A0 & !M)
    # (CIN & M & !A0 & !B0)
    # (S0 & S1 & !A0 & !M)
    # (A0 & S1 & !B0 & !M & !S0)
    # (B0 & M & !A0 & !CIN & !S1);

C1 =
      (A0 & B0 & M & !S0)
    # (A0 & CIN & M & !S0)
    # (A0 & CIN & M & S1 & !S0)
    # (B0 & CIN & M & !S1)
    # (B0 & M & S0 & !A0)
    # (CIN & M & S0 & !A0);

/* BIT 1 */

F1 =
      (A1 & B1 & C1 & !S1)
    # (A1 & M & S1 & !C1)
    # (C1 & M & S1 & !A1)
    # (A1 & B1 & !M & !S1)
    # (A1 & M & !B1 & !C1)
    # (A1 & S0 & !M & !S1)
    # (B1 & S0 & !A1 & !M)
    # (B1 & S1 & !A1 & !M)
    # (C1 & M & !A1 & !B1)
    # (S0 & S1 & !A1 & !M)
    # (A1 & S1 & !B1 & !M & !S0)
    # (B1 & M & !A1 & !C1 & !S1);

C2 =
      (A1 & C1 & M & !S0)
    # (B1 & C1 & M & !S1)
    # (C1 & M & S0 & !A1)
    # (A1 & B1 & M & !S0 & !S1)
    # (B1 & M & S0 & !A1 & !S1);

/* BIT 2 */

F2 =
      (A2 & B2 & C2 & !S1)
    # (A2 & M & S1 & !C2)
    # (C2 & M & S1 & !A2)
    # (A2 & B2 & !M & !S1)
    # (A2 & M & !B2 & !C2)
    # (A2 & S0 & !M & !S1)
    # (B2 & S0 & !A2 & !M)
    # (B2 & S1 & !A2 & !M)
    # (C2 & M & !A2 & !B2)
    # (S0 & S1 & !A2 & !M)
    # (A2 & S1 & !B2 & !M & !S0)
    # (B2 & M & !A2 & !C2 & !S1);

C3 =
      (A2 & C2 & M & !S0)
    # (B2 & C2 & M & !S1)
    # (C2 & M & S0 & !A2)
    # (A2 & B2 & M & !S0 & !S1)
    # (B2 & M & S0 & !A2 & !S1);

/* BIT 3 */

F3 =
      (A3 & B3 & C3 & !S1)
    # (A3 & M & S1 & !C3)
    # (C3 & M & S1 & !A3)
    # (A3 & B3 & !M & !S1)
    # (A3 & M & !B3 & !C3)
    # (A3 & S0 & !M & !S1)
    # (B3 & S0 & !A3 & !M)
    # (B3 & S1 & !A3 & !M)
    # (C3 & M & !A3 & !B3)
    # (S0 & S1 & !A3 & !M)
    # (A3 & S1 & !B3 & !M & !S0)
    # (B3 & M & !A3 & !C3 & !S1);

C4 =
      (A3 & C3 & M & !S0)
    # (B3 & C3 & M & !S1)
    # (C3 & M & S0 & !A3)
    # (A3 & B3 & M & !S0 & !S1)
    # (B3 & M & S0 & !A3 & !S1);

/* FLAGS */

Z =
      (!F3 & !F2 & !F1 & !F0);

V =
      (A3 & C3 & M & S0 & S1)
    # (A3 & C3 & M & S0 & !B3)
    # (C3 & M & S1 & !A3 & !S0)
    # (C3 & M & !A3 & !B3 & !S0)
    # (A3 & B3 & M & !C3 & !S0 & !S1)
    # (B3 & M & S0 & !A3 & !C3 & !S1);
