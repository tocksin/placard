Name     IO_DECODE;
PartNo   00;
Date     10/15/2026;
Revision 01;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   I/O DECODE AND UPPER RAM CHIP SELECT
   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   Two jobs, both decoded in one array pass (see TIMING_FIXES.md):

   1. /CE_HI, the chip enable of the upper 32K RAM (and ROM) chip.
      It is !A15, but A15 is rebuilt here from the high-byte
      address mux's own selects and sources instead of from the
      mux output, so it is valid at the same time as the mux
      output (20.5 ns) and needs no '04.  The lower chip's /CE is
      the mux's A15 output directly.  With both chip enables
      settled before /WE can go low (22.1 ns), a store to one chip
      can no longer also write the other.

          ADDR_SEL ADDR_SEL_HI   high byte   A15
              0        0          00h        0
              0        1          Y          Y7
              1        0          video      H9 (video address bit 15)
              1        1          PC         PC15

   2. The I/O strobes for 5000h - 5FFFh, one 256-byte page per
      device, as in FEATURE_PLAN.md:

          page  address      strobe(s)
           0    5000h-50FFh  /MAP_WR (ROM/RAM map), /LINE_RD
           1    5100h-51FFh  /SND_WR
           2    5200h-52FFh  /PORT_WR, /PORT_RD
           5    5500h-55FFh  /EXP1  (address only)
           6    5600h-56FFh  /EXP2  (address only)

      A11 is not decoded, so 5800h - 5FFFh repeats 5000h - 57FFh.
      A15 is the rebuilt A15 above.

      Writes:  /xx_WR is low while /WE is low on a store to the
               page, so a device latches on its rising edge at the
               end of the write.  Latch from the source bus, which
               holds the data past the end of the write.
      Reads:   /xx_RD is low on a read that the CPU latches into D
               (LOAD_IMM strobe from the State PLD, which already
               excludes stall clocks).  The ROM/RAM select PLD keeps
               both memories off the bus for the whole I/O window.

   PIN BUDGET
      Inputs (14): /WE, ADDR_SEL, ADDR_SEL_HI, PC15, H9, Y7,
                   A14, A13, A12, A10, A9, A8, RW, LOAD_IMM
      Outputs (8): /CE_HI, /MAP_WR, /LINE_RD, /SND_WR, /PORT_WR,
                   /PORT_RD, /EXP1, /EXP2
      WinCUPL fits each strobe in 7 product terms (the rebuilt
      !A15 expands to several terms; EXP2 on pin 22 is 7 of 10)
      and CE_HI in 3.  Every output is one array pass.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = WE_N;         /* RAM /WE (RW | CLK), low = write pulse   */

PIN 2  = ADDR_SEL;     /* Sync PLD pin 20, mux S1 */
PIN 3  = ADDR_SEL_HI;  /* Sync PLD pin 21, high-byte mux S0 */
PIN 4  = PC15;         /* PC high PLD, bit 7 */
PIN 5  = H9;           /* video address bit 15 (H counter H9) */
PIN 6  = Y7;           /* Y register bit 7 */

PIN 7  = A14;
PIN 8  = A13;
PIN 9  = A12;
PIN 10 = A10;
PIN 11 = A9;
PIN 13 = A8;

PIN 14 = RW;           /* 1 = read, 0 = write (I/O pin used as input) */
PIN 23 = LOAD_IMM;     /* State PLD D-register strobe (I/O pin used as input) */


/* ---------------- OUTPUTS ---------------- */

PIN 15 = !CE_HI;       /* low when A15 = 1: upper 32K chip enable */

PIN 16 = !MAP_WR;
PIN 17 = !LINE_RD;
PIN 18 = !SND_WR;
PIN 19 = !PORT_WR;
PIN 20 = !PORT_RD;
PIN 21 = !EXP1;
PIN 22 = !EXP2;


/* ---------------- A15, REBUILT FROM THE MUX INPUTS ---------------- */

A15 = (!ADDR_SEL &  ADDR_SEL_HI & Y7)
    # ( ADDR_SEL & !ADDR_SEL_HI & H9)
    # ( ADDR_SEL &  ADDR_SEL_HI & PC15);


/* ---------------- I/O WINDOW AND PAGES ---------------- */

IO    = !A15 & A14 & !A13 & A12;       /* 5000h - 5FFFh */

PAGE0 = !A10 & !A9 & !A8;
PAGE1 = !A10 & !A9 &  A8;
PAGE2 = !A10 &  A9 & !A8;
PAGE5 =  A10 & !A9 &  A8;
PAGE6 =  A10 &  A9 & !A8;

WR    = IO & !WE_N;
RD    = IO & RW & LOAD_IMM;


/* ---------------- EQUATIONS ---------------- */

CE_HI   = A15;

MAP_WR  = WR & PAGE0;
LINE_RD = RD & PAGE0;
SND_WR  = WR & PAGE1;
PORT_WR = WR & PAGE2;
PORT_RD = RD & PAGE2;
EXP1    = IO & PAGE5;
EXP2    = IO & PAGE6;
