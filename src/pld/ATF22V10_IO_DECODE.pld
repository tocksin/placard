Name     IO_DECODE;
PartNo   00;
Date     10/27/2026;
Revision 05;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   I/O DECODE AND UPPER RAM CHIP SELECT
   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   Two jobs, both decoded in one array pass (see docs/TIMING_FIXES.md):

   1. /CE_HI, the chip enable of the upper 32K RAM (and ROM) chip.
      It is !A15, but A15 is rebuilt here from the high-byte
      address mux's own selects and sources instead of from the
      mux output, so it is valid at the same time as the mux
      output (13 ns since revision 05, 20.5 before) and needs no
      '04.  The lower chip's /CE is the mux's A15 output directly.
      With both chip enables settled before /WE can go low, a
      store to one chip can no longer also write the other.

      Revision 05 (docs/FETCH_TIMING.md, option B): the mux PLDs
      (QUAD_4TO1_MUX revision 02) take PIXEL_ENABLE, PC_ENABLE and
      Y_ENABLE as their selects directly, so this PLD takes the
      same three (pins 2, 3 and 14) in place of ADDR_SEL,
      ADDR_SEL_HI and RW, with the same priority:

          PIXEL_ENABLE PC_ENABLE Y_ENABLE   high byte   A15
               1           x        x       video       H9 (video address bit 15)
               0           1        x       PC          PC15
               0           0        1       Y           Y7
               0           0        0       00h         0

   2. The I/O strobes for 5000h - 53FFh, one 256-byte page per
      device, as in docs/TIMING_FIXES.md:

          page  address      strobe(s)
           0    5000h-50FFh  /MAP_WR (ROM/RAM map register), /LINE_RD
           1    5100h-51FFh  /EXP1  (address only)
           2    5200h-52FFh  /PORT_WR, /PORT_RD
           3    5300h-53FFh  /EXP2  (address only)

      Since revision 03 the window is 5000h - 53FFh (A11 = A10 = 0),
      and 5400h - 5FFFh is memory (the mode bytes and the audio
      buffer are there, see docs/VIDEO.md).  Pin 18 was /SND_WR, which
      nothing used once the audio came from RAM; it is now the A11
      input.  EXP1 and EXP2 moved from pages 5 and 6 to pages 1
      and 3.  Before, A11 was not decoded, so 5800h - 5FFFh repeated
      5000h - 57FFh.
      A15 is the rebuilt A15 above.

      Writes:  /xx_WR is low while /WE is low on a store to the
               page, so a device latches on its rising edge at the
               end of the write.  Latch from the source bus, which
               holds the data past the end of the write.
      Reads:   /xx_RD is low on a read that the CPU latches into D
               (LOAD_IMM strobe from the State PLD, which already
               excludes stall clocks).  The memory control PLD keeps
               both memories off the bus for the whole I/O window.

   ROM/RAM MAP (revision 02)
      /MAP_WR clocks the map register, a 74ACT273 (write only; it
      replaced the map registers of the ROM/RAM select PLD).  Its
      rising edge, at the end of the write, loads the source bus
      into the register.  The equations did not change in revision
      02; only these notes did.

   READ STROBE WITHOUT RW (revision 05)
      RD = IO & LOAD_IMM.  The RW input went to make room for
      Y_ENABLE.  LOAD_IMM is low only in the LOAD_IMM and LOAD_MEM
      states, where RW is always 1 (a write needs EXEC), so the
      strobe is the same.  /WE now comes from the Sync PLD
      (revision 10), not the memory control PLD.

   PIN BUDGET
      Inputs (15): /WE, PIXEL_ENABLE, PC_ENABLE, Y_ENABLE, PC15, H9,
                   Y7, A14, A13, A12, A11, A10, A9, A8, LOAD_IMM
      Outputs (7): /CE_HI, /MAP_WR, /LINE_RD, /PORT_WR,
                   /PORT_RD, /EXP1, /EXP2
      WinCUPL fits each strobe in 7 product terms (the rebuilt
      !A15 expands to several terms; EXP2 on pin 22 is 7 of 10)
      and CE_HI in 3.  Every output is one array pass.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = WE_N;         /* RAM /WE from the Sync PLD (revision 05; memory control PLD before), low = write pulse */

PIN 2  = PIXEL_ENABLE; /* Sync PLD pin 19: video read (revision 05; was ADDR_SEL) */
PIN 3  = PC_ENABLE;    /* State PLD: program counter (revision 05; was ADDR_SEL_HI) */
PIN 4  = PC15;         /* PC high PLD, bit 7 */
PIN 5  = H9;           /* video address bit 15 (H counter H9) */
PIN 6  = Y7;           /* Y register bit 7 */

PIN 7  = A14;
PIN 8  = A13;
PIN 9  = A12;
PIN 10 = A10;
PIN 11 = A9;
PIN 13 = A8;

PIN 14 = Y_ENABLE;     /* State PLD: Y register (I/O pin used as input; revision 05, was RW) */
PIN 18 = A11;          /* I/O pin used as input (revision 03; was /SND_WR) */
PIN 23 = !LOAD_IMM;    /* State PLD pin 19, D-register strobe, low = load (I/O pin used as input).
                          Revision 04: active low, as the State PLD (revision 13) now drives it;
                          the equations still use LOAD_IMM as logical true. */


/* ---------------- OUTPUTS ---------------- */

PIN 15 = !CE_HI;       /* low when A15 = 1: upper 32K chip enable */

PIN 16 = !MAP_WR;
PIN 17 = !LINE_RD;
PIN 19 = !PORT_WR;
PIN 20 = !PORT_RD;
PIN 21 = !EXP1;
PIN 22 = !EXP2;


/* ---------------- A15, REBUILT FROM THE MUX INPUTS ---------------- */

A15 = ( PIXEL_ENABLE & H9)
    # (!PIXEL_ENABLE &  PC_ENABLE & PC15)
    # (!PIXEL_ENABLE & !PC_ENABLE & Y_ENABLE & Y7);


/* ---------------- I/O WINDOW AND PAGES ---------------- */

IO    = !A15 & A14 & !A13 & A12 & !A11 & !A10;   /* 5000h - 53FFh */

PAGE0 = !A10 & !A9 & !A8;
PAGE1 = !A10 & !A9 &  A8;
PAGE2 = !A10 &  A9 & !A8;
PAGE3 = !A10 &  A9 &  A8;

WR    = IO & !WE_N;
RD    = IO & LOAD_IMM;      /* revision 05: RW dropped, see above */


/* ---------------- EQUATIONS ---------------- */

CE_HI   = A15;

MAP_WR  = WR & PAGE0;
LINE_RD = RD & PAGE0;
PORT_WR = WR & PAGE2;
PORT_RD = RD & PAGE2;
EXP1    = IO & PAGE1;
EXP2    = IO & PAGE3;
