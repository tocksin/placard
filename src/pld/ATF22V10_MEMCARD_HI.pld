Name     MEMCARD_HI;
PartNo   00;
Date     11/17/2026;
Revision 02;
Designer Justin;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   MEMORY CARD: REGISTER DECODE AND PAGE HIGH   (ATF22V10C)
   ============================================================

   One of the two page register PLDs of the 512K memory expansion
   card (docs/architecture/MEMCARD.md).  The card is these two
   PLDs and one AS7C4096A-12 SRAM (512K x 8, 12 ns), and it works
   in any expansion slot.

   The slot gives a card 128 addresses (A6:A0).  The SRAM is wired
   as the plain card of EXPANSION.md, straight to the slot:
        SRAM /CE = /EXP    /OE = Q0    /WE = /WE
        SRAM address pins = slot A6:A0 and the page, I/O = D7:D0
        (which address or I/O pin takes which line is the
        board layout's choice: any order works the same)
   and the two PLDs hold the SRAM's upper address, A18:A7, as a
   12-bit page number: 4096 pages of 128 bytes.  Neither PLD is in
   a read or write path of the SRAM.

   The page number is written to the card's last two addresses:
        offset 7Eh   page bits 7:0    (ATF22V10_MEMCARD_LO.pld)
        offset 7Fh   page bits 11:8   (this PLD, from D3:D0)

   THIS PLD
      - decodes the two register addresses from /EXP and A6:A0;
      - gives the other PLD its select, /PGLO (low for an access
        to offset 7Eh), so the address lines and /EXP have one PLD
        input each;
      - holds page bits 11:8.  Pin 1 is /WE: the registers clock
        on the rising edge of every /WE, the end of the write, and
        load D3:D0 only when the write is to offset 7Fh; on every
        other /WE each one loads its own value back (a hold term),
        as the shared port PLD does (ATF22V10_PORT.pld, rev 05).

      The SRAM is selected by /EXP alone, so a write that sets the
      page also stores its byte in the SRAM, at the same offset of
      the page being left.  Offsets 7Eh and 7Fh of every page are
      therefore reserved; 00h-7Dh (126 bytes a page, 516096 in
      all) are the card's memory.  The page outputs change one
      clock-to-output time (2 to 5.5 ns) after /WE has risen,
      after the SRAM's write has ended (its address hold is 0 ns);
      if they ever moved early, the byte would land at the same
      reserved offset of the new page.

      The registers clear at power-up, so the card starts at page
      0.  They cannot be read back; software keeps a copy.

   TIMING
      Setup 3.5 ns and hold 0 ns at the /WE edge for D3:D0, /EXP
      and A6:A0, inside the card budget (data 9 ns before /WE
      rises, the select 13 ns before, hold up to 2 ns after).
      /PGLO is valid 7.5 ns after /EXP and A6:A0.

   PIN BUDGET
      Inputs (13): /WE (clock), /EXP, A0-A6, D0-D3; A1 and D3 are
                   on I/O pins 15 and 14
      Outputs (5):  PG8-PG11 (registered), /PGLO (combinational)
      Spare: input pin 2, I/O pins 21, 22, 23 (three cells).  Each
      register is nine product terms, so they are on pins 17-20
      (14 or 16 terms each); /PGLO is one.

   REVISIONS
      02 (11/17/2026): pins assigned for the board layout (PCB
         PLC-1004 rev A, pin swaps from the router tools).  No
         equation changed.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = !WE;          /* slot B24, the write pulse: clocks the registers on its rising edge */
PIN 3  = A5;           /* slot address: A6:A1 = 111111 is the page register, A0 picks its half */
PIN 4  = A4;
PIN 5  = A6;
PIN 6  = A2;
PIN 7  = A3;
PIN 8  = !EXP;         /* slot A16, this slot's select, low for any access to the card */
PIN 9  = A0;
PIN 10 = D1;           /* data bus, written to page bits 11:8 */
PIN 11 = D0;
PIN 13 = D2;
PIN 14 = D3;           /* I/O pin used as input */
PIN 15 = A1;           /* I/O pin used as input */


/* ---------------- OUTPUTS ---------------- */

PIN 16 = !PGLO;        /* to the page low PLD's pin 15: low for an access to offset 7Eh */
PIN 17 = PG8;          /* page bit 8 */
PIN 18 = PG9;          /* page bit 9 */
PIN 19 = PG10;         /* page bit 10 */
PIN 20 = PG11;         /* page bit 11 */


/* ---------------- EQUATIONS ---------------- */

/* The card's offsets 7Eh and 7Fh. */
PAGE_REG = EXP & A6 & A5 & A4 & A3 & A2 & A1;

PGLO = PAGE_REG & !A0;
PGHI = PAGE_REG &  A0;

/* Page bits 11:8: load the data bus on a write to offset 7Fh, and
   hold on every other /WE. */
PG8.D  =  PGHI & D0  #  !PGHI & PG8;
PG9.D  =  PGHI & D1  #  !PGHI & PG9;
PG10.D =  PGHI & D2  #  !PGHI & PG10;
PG11.D =  PGHI & D3  #  !PGHI & PG11;
