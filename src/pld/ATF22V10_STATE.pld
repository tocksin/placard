Name     STATE_CTRL;
PartNo   00;
Date     2026-10-14;
Revision 08;
Designer Justin;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   CPU STATE CONTROL   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   States (binary, Q1 Q0):
       00  FETCH      instruction -> instruction FF, PC increments
       01  LOAD_IMM   operand byte (PC address) -> D FF, PC increments
                      (immediate value, or zero-page address)
       10  LOAD_MEM   memory ([Y/0,X/D] address) -> D FF, PC holds
       11  EXEC       data bus (D or ACC or X) -> ACC / X / Y / RAM

   SOURCE FIELD (instruction bits 1:0)
       00  immediate (D)      01  RAM/ROM      10  ACC      11  X

   ZERO-PAGE ([0,D]) MEMORY MODES  (MEM2:0 = 000, 011, 100, 101)
   The address is an operand byte after the opcode.  It is loaded
   into D by LOAD_IMM first, then the memory read uses D as address.

   FETCH -> LOAD_IMM   source 00 (immediate)
         -> LOAD_IMM   source 01 and [0,D] mode (000, 011, 100)
                       (fetch the zero-page address, then LOAD_MEM)
         -> LOAD_MEM   source 01 and [0,X] / [Y,X] mode (001, 010,
                       110, 111)
         -> LOAD_IMM   source 1x and MEM = 101 and not a branch
                       (store to zero page, fetch the address into D)
         -> EXEC       source 1x otherwise, including a branch with
                       MEM = 101 (BGE with an AC or X target)
   LOAD_IMM -> LOAD_MEM  if SRC0 = 1 and MEM != 101 (zero-page read)
            -> EXEC      otherwise
              (In LOAD_IMM the source is 00, 01, or 1x with MEM = 101.
               MEM = 101 is always a zero-page store, so it goes to
               EXEC.  Otherwise SRC0 = 1 means source 01 = read.
               SRC1 is therefore not needed.)
   LOAD_MEM -> EXEC
   EXEC     -> FETCH

   Clocks: register op 2, immediate 3, [x]/[y,x] read 3,
           zero-page store 3, zero-page read 4.

   Limits of this encoding
     - Source 01 with MEM = 101 (read-modify-write of a zero-page
       location) is not supported: D holds the address, but the read
       overwrites D with the data.  Treated like [0,X] (illegal).
     - BGE with a memory target (I7:I5 = 111, MEM = 101, source 01)
       is not supported.  Fetching the zero-page address would need
       BRANCH_BLOCK in the LOAD_IMM decision too, and Q0 has no
       product term left.  BGE with an immediate, AC or X target works.
     - Source 00 with MEM = 101 is illegal (D can't be value and
       address).

   Every state advances only on a clock where PIXEL_ENABLE = 0
   (PIXEL_ENABLE comes from the Sync PLD).  When it
   is 1 the video owns the bus, the state holds, and every bus
   strobe is forced inactive (memory write is forced to READ).

   BRANCH_BLOCK (from the Branch PLD pin 23, active high) has two
   uses:
     - In EXEC (PIXEL_ENABLE = 0, taken or not) it is 1 while a
       branch/jump executes.  It forces LOAD_AC, LOAD_X, LOAD_Y and
       MEM_WR inactive so a branch opcode cannot also write a
       register or RAM.
     - In FETCH it is 1 when the opcode on the data bus is a branch
       (I7:I5 = 111, decoded by block B of the Branch PLD).  MEM = 101
       is a zero-page store for an ALU op, but BGE for a branch, so
       a branch with source 1x skips LOAD_IMM and goes to EXEC.

   MACROCELL BUDGET
      Requested outputs: PC Increment, PC Enable, X Enable,
      Y Enable, Load Instruction, Load Immediate, Load X,
      Load Y, Load AC, Memory R/W = 10, plus 2 state bits = 12.
      The 22V10 has 10 macrocells.  Two things make it fit:
        - Q1 is brought out on pin 15 as PC_ENABLE (PC_ENABLE
          = !Q1), so one pin is both a state bit and an output.
        - PC_INC is NOT generated here.  Make it outside the
          PLD with one gate:
              PC_INC = PC_ENABLE & !PIXEL_ENABLE
          (identical to the PC_INC equation in the old revision).

   PRODUCT TERMS
      Q0 (pin 14):  8 used, 8 available.  FULL - do not add terms.
      Q1 (pin 15):  10 used, 10 available.  FULL - do not add terms.
      The terms are reduced using the illegal MEM combinations as
      don't-cares (see the limits above).

   DATABUS SOURCE (instruction bits 1:0)
       00  Immediate (D register)  -> LOAD_IMM
       01  RAM/ROM                 -> LOAD_MEM (via LOAD_IMM if [0,D])
       10  Accumulator             -> EXEC (no load)
       11  X register              -> EXEC (no load)

   MEMORY SOURCE / DESTINATION (MEM2:MEM0, from instruction FF)
       000  [0,D]  load AC           100  [0,D]  load Y
       001  [0,X]  load AC           101  [0,D]  store to RAM
       010  [Y,X]  load AC           110  [0,X]  store to RAM
       011  [0,D]  load X            111  [Y,X]  store to RAM
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = CLK;

/* Pixel enable from the Sync PLD: 1 = video owns the bus. */
PIN 2  = PIXEL_ENABLE;

/* Source and memory fields of the instruction BEING FETCHED.
   These must come straight from the data bus bits, NOT from the
   instruction FF: the instruction FF is only loaded at the end
   of the FETCH clock, the same edge at which this PLD picks its
   next state.  Only used in FETCH on a clock where
   PIXEL_ENABLE = 0.
       DB_SRC1:DB_SRC0            = data bus bits 1:0
       DB_MEM2:DB_MEM1:DB_MEM0    = data bus bits 4:2 */
PIN 3  = DB_SRC1;
PIN 4  = DB_SRC0;

/* Memory source / destination field, from the instruction FF
   (valid from LOAD_IMM onward). */
PIN 5  = MEM2;
PIN 6  = MEM1;
PIN 7  = MEM0;

/* Branch block from the Branch PLD (pin 23).
   In EXEC:  1 = a branch/jump is executing, so inhibit LOAD_AC,
             LOAD_X, LOAD_Y and MEM_WR.
   In FETCH: 1 = the opcode on the data bus is a branch, so
             source 1x with MEM = 101 (BGE) goes to EXEC, not LOAD_IMM. */
PIN 8  = BRANCH_BLOCK;

/* Memory field of the instruction being fetched (data bus 4:2). */
PIN 9  = DB_MEM1;      /* data bus bit 3 */
PIN 10 = DB_MEM0;      /* data bus bit 2 */
PIN 11 = DB_MEM2;      /* data bus bit 4 */

/* Source field bit 0, from the instruction FF (valid from LOAD_IMM
   onward).  Used in LOAD_IMM, together with MEM2:0, to tell a
   zero-page read (source 01) from everything else. */
PIN 13 = SRC0;


/* ---------------- OUTPUTS ---------------- */

/* State bit 0 (registered). */
PIN 14 = Q0;

/* State bit 1 (registered).  The pin is declared inverted, so the
   pin level is !Q1 = PC_ENABLE:  high in FETCH and LOAD_IMM,
   low in LOAD_MEM and EXEC.  The register powers up to Q1 = 0,
   so the machine starts in FETCH. */
PIN 15 = !Q1;

/* Address-source selects to the Sync PLD (pure decode of the
   memory field, no state or PIXEL_ENABLE term).  The Sync PLD
   gives priority to video and PC_ENABLE, so these only take
   effect in LOAD_MEM and EXEC. */
PIN 16 = X_ENABLE;
PIN 17 = Y_ENABLE;

/* Bus-cycle strobes.  Each includes !PIXEL_ENABLE, so it is only
   active on a clock where the CPU really owns the bus. */
PIN 18 = LOAD_INSTR;   /* load instruction FF                          */
PIN 19 = LOAD_IMM;     /* load D FF (LOAD_IMM and LOAD_MEM states)     */
PIN 20 = LOAD_X;       /* load X register                              */
PIN 21 = LOAD_Y;       /* load Y register                              */
PIN 22 = LOAD_AC;      /* load accumulator                             */

/* Memory R/W.  Pin level: 1 = read, 0 = write (same sense as the
   ROM/RAM select PLD).  Declared inverted so the equation below
   is the write condition.  Forced to read while PIXEL_ENABLE = 1
   or BRANCH_BLOCK = 1. */
PIN 23 = !MEM_WR;


/* ---------------- STATE DECODE ---------------- */

S_FETCH = !Q1 & !Q0;
S_LIMM  = !Q1 &  Q0;
S_LMEM  =  Q1 & !Q0;
S_EXEC  =  Q1 &  Q0;


/* ---------------- STATE MACHINE ----------------

   Next state from FETCH, using the data bus fields (DS = source,
   DM = memory field):

     to LOAD_IMM (Q1'=0, Q0'=1):
         DS = 00
         DS = 01 and DM = 000, 100 (!DM1 & !DM0) or 011
         DS = 1x and DM = 101 and not BRANCH_BLOCK
     to LOAD_MEM (Q1'=1, Q0'=0):
         DS = 01 and DM = 001, 101(x), 010, 110, 111
     to EXEC (Q1'=1, Q0'=1):
         DS = 1x and (DM != 101 or BRANCH_BLOCK)

   Next state from LOAD_IMM:
         SRC0 = 1 and MEM != 101  -> LOAD_MEM (Q1'=1, Q0'=0)
         else                     -> EXEC     (Q1'=1, Q0'=1)

   Q0' (8 terms)
       hold
       FETCH: DB_SRC1 # !DB_SRC0 # DM=x00-type or 011
       LOAD_IMM: !SRC0 # (MEM = 101)
       LOAD_MEM -> EXEC
   Q1' (10 terms)
       hold
       FETCH, DS = 01: DM = !M1&M0 (001,101), M2&M1 (110,111), 010
       FETCH, DS = 1x: DM != 101  (!M2 # M1 # !M0), or BRANCH_BLOCK
       LOAD_IMM, LOAD_MEM -> 1
*/

Q0.D = (Q0 & PIXEL_ENABLE)
     # (S_FETCH & !PIXEL_ENABLE & DB_SRC1)
     # (S_FETCH & !PIXEL_ENABLE & !DB_SRC0)
     # (S_FETCH & !PIXEL_ENABLE & !DB_MEM1 & !DB_MEM0)
     # (S_FETCH & !PIXEL_ENABLE & !DB_MEM2 & DB_MEM1 & DB_MEM0)
     # (S_LIMM  & !PIXEL_ENABLE & !SRC0)
     # (S_LIMM  & !PIXEL_ENABLE & MEM2 & !MEM1 & MEM0)
     # (S_LMEM  & !PIXEL_ENABLE);

Q1.D = (Q1 & PIXEL_ENABLE)
     # (S_FETCH & !PIXEL_ENABLE & !DB_SRC1 & DB_SRC0 & !DB_MEM1 & DB_MEM0)
     # (S_FETCH & !PIXEL_ENABLE & !DB_SRC1 & DB_SRC0 & DB_MEM2 & DB_MEM1)
     # (S_FETCH & !PIXEL_ENABLE & !DB_SRC1 & DB_SRC0 & !DB_MEM2 & DB_MEM1 & !DB_MEM0)
     # (S_FETCH & !PIXEL_ENABLE & DB_SRC1 & !DB_MEM2)
     # (S_FETCH & !PIXEL_ENABLE & DB_SRC1 & DB_MEM1)
     # (S_FETCH & !PIXEL_ENABLE & DB_SRC1 & !DB_MEM0)
     # (S_FETCH & !PIXEL_ENABLE & DB_SRC1 & BRANCH_BLOCK)
     # (S_LIMM  & !PIXEL_ENABLE)
     # (S_LMEM  & !PIXEL_ENABLE);


/* ---------------- MEMORY FIELD DECODE ---------------- */

/* Memory-mode address selects */
X_ENABLE = (!MEM2 & !MEM1 &  MEM0)      /* 001 [0,X] */
         # (!MEM2 &  MEM1 & !MEM0)      /* 010 [Y,X] */
         # ( MEM2 &  MEM1 & !MEM0)      /* 110 [0,X] */
         # ( MEM2 &  MEM1 &  MEM0);     /* 111 [Y,X] */

Y_ENABLE = (!MEM2 &  MEM1 & !MEM0)      /* 010 [Y,X] */
         # ( MEM2 &  MEM1 &  MEM0);     /* 111 [Y,X] */

/* Destination decode */
DEST_AC = (!MEM2 & !MEM1 & !MEM0)       /* 000 */
        # (!MEM2 & !MEM1 &  MEM0)       /* 001 */
        # (!MEM2 &  MEM1 & !MEM0);      /* 010 */

DEST_X  =  !MEM2 &  MEM1 &  MEM0;       /* 011 */

DEST_Y  =   MEM2 & !MEM1 & !MEM0;       /* 100 */

DEST_RAM = ( MEM2 & !MEM1 &  MEM0)      /* 101 */
         # ( MEM2 &  MEM1 & !MEM0)      /* 110 */
         # ( MEM2 &  MEM1 &  MEM0);     /* 111 */


/* ---------------- STROBES ---------------- */

LOAD_INSTR = S_FETCH & !PIXEL_ENABLE;

LOAD_IMM   = (S_LIMM & !PIXEL_ENABLE)
           # (S_LMEM & !PIXEL_ENABLE);

LOAD_AC    = S_EXEC & !PIXEL_ENABLE & !BRANCH_BLOCK & DEST_AC;

LOAD_X     = S_EXEC & !PIXEL_ENABLE & !BRANCH_BLOCK & DEST_X;

LOAD_Y     = S_EXEC & !PIXEL_ENABLE & !BRANCH_BLOCK & DEST_Y;

/* Write only in EXEC, only on a clock the CPU owns the bus,
   and never during a branch/jump. */
MEM_WR     = S_EXEC & !PIXEL_ENABLE & !BRANCH_BLOCK & DEST_RAM;
