Name     QUAD_4TO1_MUX;
PartNo   ATF22V10C;
Date     24/09/2026;
Revision 01;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* =========================================================
   INPUT PINS
   ========================================================= */

/* MUX 0 */
PIN 1  = A0;
PIN 2  = B0;
PIN 3  = C0;
PIN 4  = D0;

/* MUX 1 */
PIN 5  = A1;
PIN 6  = B1;
PIN 7  = C1;
PIN 8  = D1;

/* Common select */
PIN 9  = S0;
PIN 10 = S1;

/* MUX 2 */
PIN 11 = A2;
PIN 13 = B2;
PIN 14 = C2;
PIN 15 = D2;

/* MUX 3 */
PIN 16 = A3;
PIN 17 = B3;
PIN 18 = C3;
PIN 19 = D3;


/* =========================================================
   OUTPUT PINS
   ========================================================= */

PIN 20 = Y0;
PIN 21 = Y1;
PIN 22 = Y2;
PIN 23 = Y3;


/* =========================================================
   QUAD 4:1 MULTIPLEXER
   ========================================================= */

/*
   S1 S0
    0  0  -> A
    0  1  -> B
    1  0  -> C
    1  1  -> D
*/


/* MUX 0 */
Y0 = !S1 & !S0 & A0
   # !S1 &  S0 & B0
   #  S1 & !S0 & C0
   #  S1 &  S0 & D0;


/* MUX 1 */
Y1 = !S1 & !S0 & A1
   # !S1 &  S0 & B1
   #  S1 & !S0 & C1
   #  S1 &  S0 & D1;


/* MUX 2 */
Y2 = !S1 & !S0 & A2
   # !S1 &  S0 & B2
   #  S1 & !S0 & C2
   #  S1 &  S0 & D2;


/* MUX 3 */
Y3 = !S1 & !S0 & A3
   # !S1 &  S0 & B3
   #  S1 & !S0 & C3
   #  S1 &  S0 & D3;
