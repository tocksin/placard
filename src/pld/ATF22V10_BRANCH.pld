Name     BRANCH_CTRL;
PartNo   00;
Date     10/18/2026;
Revision 10;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   BRANCH / JUMP CONTROL   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   ALU field I7:I5 = 111 selects branch/jump.  The ALU performs
   PASS A for this opcode, so each ALU Z output is the zero flag
   of one nibble of the accumulator.
   Memory-mode field M2:M0 (instruction bits 4:2) selects type:

       000 JMP  always, 16-bit load (PC low + PC high)
       001 BGT  AC > 0
       010 BLT  AC < 0
       011 BNE  AC <> 0
       100 BEQ  AC = 0
       101 BGE  AC >= 0
       110 BLE  AC <= 0
       111 BRA  always, 8-bit load (PC low only)

   Z_LOW  = low  ALU nibble is zero  (AC3:AC0 = 0)
   Z_HIGH = high ALU nibble is zero  (AC7:AC4 = 0)
   AC = 0 is   Z_LOW & Z_HIGH
   AC <> 0 is  !Z_LOW # !Z_HIGH
   NEG = accumulator MSB (negative)
   AC = 0 and NEG are never both true.

   PIXEL_ENABLE = 1 means video owns the bus.

   EXEC STATE
   The State PLD has no EXEC output, but EXEC = Q1 & Q0.
   Q0 is State PLD pin 18 (true polarity).  State PLD pin 15
   is declared !Q1, so its pin level is PC_ENABLE = !Q1.
       EXEC = Q0 & !PC_ENABLE
   Wire State PLD pin 18 to Q0 and State PLD pin 15 to PC_ENABLE.

   LOAD_PC_LOW and LOAD_PC_HIGH are active only in EXEC with
   PIXEL_ENABLE = 0.  That keeps a stale branch opcode in the
   instruction register from acting during FETCH, LOAD_IMM or
   LOAD_MEM.

   BRANCH DECODE
   I7:I5 from the instruction register, valid from LOAD_IMM
   onward.  Active in EXEC only.
       BRANCH_A = I7 & I6 & I5 & EXEC & !PIXEL_ENABLE
   It drives LOAD_PC_LOW and LOAD_PC_HIGH.

   BRANCH_BLOCK = I7 & I6 & I5 goes to State PLD pin 8 (revision
   09).  It is high whenever the instruction register holds a
   branch/jump.  The State PLD only uses it in EXEC, where it
   inhibits LOAD_AC, LOAD_X, LOAD_Y and MEM_WR.  (PC_INC is already
   low in EXEC because PC_ENABLE = 0 there.)  Revision 08 and
   earlier used BRANCH_A, which also has EXEC and !PIXEL_ENABLE.
   That made it valid only 13 ns into the EXEC clock, so the State
   PLD's MEM_WR showed a write for up to 20.5 ns at the start of
   every BGE, BLE or BRA (memory field 101, 110, 111).  The memory
   control PLD gates the write with the clock, so MEM_WR has to be
   settled before the clock falls; from the instruction register
   it is (see TIMING_FIXES.md, end-of-write contention).
   Active high.  For an active-low pin declare
   PIN 23 = !BRANCH_BLOCK;  (the equation is unchanged).

   Revision 08 removed a second decode of the opcode on the data
   bus (DB7:DB5, pins 14-16) during FETCH.  The State PLD used it to
   send BGE with an AC or X target straight to EXEC, but that path
   was too slow (TIMING_FIXES.md); BGE with an AC or X target now
   has a pad byte and goes through LOAD_IMM like a zero-page store.
   Pins 14-16 are unused.

   ALU WAIT CLOCK (revisions 06 and 07)
   ADD and SUB need two clocks for the carry to ripple through
   both ALU PLDs at 25.175 MHz (see ALU_TIMING.md).  The first
   EXEC clock of an ADD/SUB with an AC, X or Y destination is a
   stall clock, so the result is loaded at the end of the second:

       STALL = PIXEL_ENABLE
             # EXEC & ADDSUB_REG & !ALU_DONE

       ALU_DONE.D = EXEC & !PIXEL_ENABLE & ADDSUB_REG & !ALU_DONE
                  # ALU_DONE & PIXEL_ENABLE

   ALU_DONE is set by the first EXEC clock the CPU owns and holds
   through a video stall, so the second ALU clock can be delayed by
   the video without adding another wait.  It clears on the clock
   that loads the result.

   (Revision 06 set the register on the first EXEC clock and used it
   to stall the second one, but the State PLD had already loaded AC
   and left EXEC at the end of the first, so the wait clock came
   after the load.)

   STALL goes to the State PLD (pin 2) and both PC PLDs (pin 14) in
   place of PIXEL_ENABLE, so the CPU holds EXEC with all loads
   blocked.  The video side (Sync PLD, address mux, pixel buffer)
   keeps the real PIXEL_ENABLE, so a wait clock never takes the bus.
   A store (destination RAM) writes the source bus, not the ALU
   result, so it does not wait.

   Pin 1 is now the register clock, so I7 moved to pin 17.

   SOURCE BUS ENABLE (revision 10)
   The RAM write-data buffer is gone: the source bus and the memory
   data bus are one bus.  The source F541s drive it only in EXEC
   with PIXEL_ENABLE = 0 (the source '138's enables take Q0,
   PC_ENABLE and PIXEL_ENABLE straight from their pins).  SRC_EN is
   the same condition for the memory control PLD, which blocks CPU
   memory reads while the source drivers own the bus.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = CLK;             /* CPU clock, for ALU_DONE */

PIN 17 = I7;              /* I/O pin used as an input */
PIN 2  = I6;
PIN 3  = I5;

PIN 4  = M2;
PIN 5  = M1;
PIN 6  = M0;

PIN 7  = Z_LOW;           /* low  ALU nibble zero flag */
PIN 8  = NEG;

PIN 9  = PIXEL_ENABLE;    /* 1 = video owns the bus */

PIN 10 = Q0;              /* State PLD pin 18, state bit 0 */
PIN 11 = PC_ENABLE;       /* State PLD pin 15, = !Q1 */

PIN 13 = Z_HIGH;          /* high ALU nibble zero flag */


/* ---------------- OUTPUTS ---------------- */

PIN 21 = LOAD_PC_LOW;     /* 12 product terms, pin has 12 */
PIN 22 = LOAD_PC_HIGH;    /*  1 product term,  pin has 10 */
PIN 23 = BRANCH_BLOCK;    /*  1 product term,  pin has  8 */

PIN 18 = ALU_DONE;        /* registered, 3 product terms */
PIN 19 = STALL;           /* 3 product terms, pin has 16 */
PIN 16 = SRC_EN;          /* 1 product term, to memory control PLD pin 22 */


/* ---------------- COMMON TERMS ---------------- */

EXEC   = Q0 & !PC_ENABLE;

/* Opcode in the instruction register, EXEC state. */
BRANCH_A = I7 & I6 & I5 & EXEC & !PIXEL_ENABLE;

/* ADD (100) or SUB (101) with destination AC, X or Y
   (M = 000, 001, 010, 011, 100; not 101, 110, 111 = RAM). */
ADDSUB_REG = I7 & !I6 & !(M2 & (M1 # M0));


/* ---------------- EQUATIONS ---------------- */

ALU_DONE.D = EXEC & !PIXEL_ENABLE & ADDSUB_REG & !ALU_DONE
           # ALU_DONE & PIXEL_ENABLE;

STALL = PIXEL_ENABLE
      # EXEC & ADDSUB_REG & !ALU_DONE;

BRANCH_BLOCK = I7 & I6 & I5;

SRC_EN = EXEC & !PIXEL_ENABLE;

LOAD_PC_HIGH = BRANCH_A & !M2 & !M1 & !M0;                       /* JMP */

LOAD_PC_LOW =
      BRANCH_A & !M2 & !M1 & !M0                                 /* JMP */
    # BRANCH_A & !M2 & !M1 &  M0 & !Z_LOW  & !NEG                /* BGT, low nibble <> 0  */
    # BRANCH_A & !M2 & !M1 &  M0 & !Z_HIGH & !NEG                /* BGT, high nibble <> 0 */
    # BRANCH_A & !M2 &  M1 & !M0 & !Z_LOW  &  NEG                /* BLT, low nibble <> 0  */
    # BRANCH_A & !M2 &  M1 & !M0 & !Z_HIGH &  NEG                /* BLT, high nibble <> 0 */
    # BRANCH_A & !M2 &  M1 &  M0 & !Z_LOW                        /* BNE, low nibble <> 0  */
    # BRANCH_A & !M2 &  M1 &  M0 & !Z_HIGH                       /* BNE, high nibble <> 0 */
    # BRANCH_A &  M2 & !M1 & !M0 &  Z_LOW & Z_HIGH               /* BEQ */
    # BRANCH_A &  M2 & !M1 &  M0 & !NEG                          /* BGE */
    # BRANCH_A &  M2 &  M1 & !M0 &  Z_LOW & Z_HIGH               /* BLE, AC=0 */
    # BRANCH_A &  M2 &  M1 & !M0 &  NEG                          /* BLE, AC<0 */
    # BRANCH_A &  M2 &  M1 &  M0;                                /* BRA */
