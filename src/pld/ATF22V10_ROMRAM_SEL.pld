Name     ROMRAM_SEL;
PartNo   00;
Date     10/15/2026;
Revision 04;
Designer ;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   ROM / RAM SECTION SELECT   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   The 64K address space is split into 8 sections of 8K.
   The section is chosen by the top three address bits
   A15:A13.

   A 7-bit map is stored in seven on-chip registers.  Each
   map bit picks ROM or RAM for one section:

       RAMSELn = 0  ->  section n is ROM
       RAMSELn = 1  ->  section n is RAM

   Section 2 (4000h - 5FFFh) has no map bit (revision 03): its
   lower half, 4000h - 4FFFh, is always RAM, and its upper half,
   5000h - 5FFFh, is the I/O window, where neither the ROM nor the
   RAM drives the bus on a read.  Bit 2 of a map write is ignored.

   Section   A15 A14 A13    Address range
      0       0   0   0     0000h - 1FFFh
      1       0   0   1     2000h - 3FFFh
      2       0   1   0     4000h - 5FFFh   RAM / I/O (fixed)
      3       0   1   1     6000h - 7FFFh
      4       1   0   0     8000h - 9FFFh
      5       1   0   1     A000h - BFFFh
      6       1   1   0     C000h - DFFFh
      7       1   1   1     E000h - FFFFh

   READ ENABLES (revision 04)
      Revision 03 decoded ROM_OE and RAM_OE here from A15:A12 and
      RW.  Revision 04 moves them to the memory control PLD, which
      also has the clock, so that a read never drives the data bus
      while the write buffer may still be on (TIMING_FIXES.md,
      end-of-write contention).  This PLD now only holds the map;
      its RAMSEL outputs go to the memory control PLD.

   LOADING THE MAP
      D7:D0 come from the CPU's source bus (not the RAM data
      bus), which holds the store data until well after the
      write ends.  They are latched on the RISING edge of WR_CLK,
      which is /MAP_WR from the I/O decode PLD: low for the write
      pulse of a store to 5000h - 50FFh, so its rising edge comes
      at the end of the write.  Bit n is the map bit for section
      n (bit 2 unused).

   POWER-UP
      The ATF22V10C clears its registers at power-up, so all
      RAMSEL bits start at 0 and every mapped section is ROM.

   PIN BUDGET
      Inputs: WR_CLK, D0, D1, D3:D7.  Outputs: 7 map registers.
      Pins 2-5, 14, 15 and 23 are unused (revision 04).
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = WR_CLK;     /* /MAP_WR from the I/O decode PLD, rising edge loads */

/* source bus bits (D2 is not used) */
PIN 6  = D0;
PIN 7  = D1;
PIN 8  = D3;
PIN 9  = D4;
PIN 10 = D5;
PIN 11 = D6;
PIN 13 = D7;


/* ---------------- OUTPUTS ---------------- */

/* stored map, 1 = RAM, 0 = ROM */
PIN 16 = RAMSEL0;
PIN 17 = RAMSEL1;
PIN 18 = RAMSEL3;
PIN 19 = RAMSEL4;
PIN 20 = RAMSEL5;
PIN 21 = RAMSEL6;
PIN 22 = RAMSEL7;


/* ---------------- STORED MAP ---------------- */

RAMSEL0.D = D0;
RAMSEL1.D = D1;
RAMSEL3.D = D3;
RAMSEL4.D = D4;
RAMSEL5.D = D5;
RAMSEL6.D = D6;
RAMSEL7.D = D7;
