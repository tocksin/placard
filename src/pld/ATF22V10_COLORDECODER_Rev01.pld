Name     COLOR_DECODER;
PartNo   00;
Date     09/15/2026;
Revision 01;
Designer "Justin Davis";
Company  "";
Assembly "";
Location "";
Device   g22v10;


/* ============================================================
   8-BIT VGA COLOR DECODER
   ============================================================

   MODE1 MODE0

      00 = 1-bit color
      01 = 2-bit color
      10 = 4-bit color
      11 = 8-bit color


   INPUT DATA

      D0-D7 = 8-bit pixel data


   SELECT

      SEL2 SEL1 SEL0

      1-bit mode:
          selects D0-D7

      2-bit mode:
          00 = D1:D0
          01 = D3:D2
          10 = D5:D4
          11 = D7:D6

      4-bit mode:
          SEL0 = 0 -> D3:D0
          SEL0 = 1 -> D7:D4

      8-bit mode:
          all eight D bits are used


   VGA OUTPUTS

      OUT0 = VGA_RED(1)
      OUT1 = VGA_RED(2)
      OUT2 = VGA_RED(3)

      OUT3 = VGA_BLUE(2)
      OUT4 = VGA_BLUE(3)

      OUT5 = VGA_GREEN(1)
      OUT6 = VGA_GREEN(2)
      OUT7 = VGA_GREEN(3)


   ============================================================ */


/* ------------------------------------------------------------
   INPUT PINS
   ------------------------------------------------------------ */

D0      PIN 2;
D1      PIN 3;
D2      PIN 4;
D3      PIN 5;
D4      PIN 6;
D5      PIN 7;
D6      PIN 8;
D7      PIN 9;

MODE0   PIN 10;
MODE1   PIN 11;

SEL0    PIN 13;
SEL1    PIN 22;
SEL2    PIN 23;


/* ------------------------------------------------------------
   OUTPUT PINS
   ------------------------------------------------------------ */

OUT0    PIN 14;
OUT1    PIN 15;
OUT2    PIN 16;

OUT3    PIN 17;
OUT4    PIN 18;

OUT5    PIN 19;
OUT6    PIN 20;
OUT7    PIN 21;


/* ============================================================
   MODE DECODING
   ============================================================ */

M1 = !MODE1 & !MODE0;
M2 = !MODE1 &  MODE0;
M4 =  MODE1 & !MODE0;
M8 =  MODE1 &  MODE0;


/* ============================================================
   1-BIT MODE
   ============================================================

   SEL2:SEL0 selects one of D0-D7.
   The selected bit is replicated onto all eight outputs.

   000 = D0
   001 = D1
   010 = D2
   011 = D3
   100 = D4
   101 = D5
   110 = D6
   111 = D7
   ============================================================ */

SEL_D1 =
      D0 & !SEL2 & !SEL1 & !SEL0
    # D1 & !SEL2 & !SEL1 &  SEL0
    # D2 & !SEL2 &  SEL1 & !SEL0
    # D3 & !SEL2 &  SEL1 &  SEL0
    # D4 &  SEL2 & !SEL1 & !SEL0
    # D5 &  SEL2 & !SEL1 &  SEL0
    # D6 &  SEL2 &  SEL1 & !SEL0
    # D7 &  SEL2 &  SEL1 &  SEL0;


/* ============================================================
   2-BIT MODE
   ============================================================

   SEL1:SEL0 selects one of four 2-bit values.

       SEL = 00 -> D1:D0
       SEL = 01 -> D3:D2
       SEL = 10 -> D5:D4
       SEL = 11 -> D7:D6

   C1:C0:

       00 = BLACK
       01 = BLUE
       10 = GREEN
       11 = WHITE
   ============================================================ */

C0 =
      D0 & !SEL1 & !SEL0
    # D2 & !SEL1 &  SEL0
    # D4 &  SEL1 & !SEL0
    # D6 &  SEL1 &  SEL0;

C1 =
      D1 & !SEL1 & !SEL0
    # D3 & !SEL1 &  SEL0
    # D5 &  SEL1 & !SEL0
    # D7 &  SEL1 &  SEL0;


/* ============================================================
   4-BIT MODE
   ============================================================

   SEL0 selects which nibble is used.

       SEL0 = 0 -> D3:D0
       SEL0 = 1 -> D7:D4

   X3:X0 is the selected 4-bit color index.
   ============================================================ */

X0 =
      D0 & !SEL0
    # D4 &  SEL0;

X1 =
      D1 & !SEL0
    # D5 &  SEL0;

X2 =
      D2 & !SEL0
    # D6 &  SEL0;

X3 =
      D3 & !SEL0
    # D7 &  SEL0;


/* ============================================================
   4-BIT PALETTE
   ============================================================

   Index    Color

     0      Black
     1      Blue
     2      Green
     3      Cyan
     4      Red
     5      Magenta
     6      Brown
     7      Light Gray
     8      Dark Gray
     9      Bright Blue
     A      Bright Green
     B      Bright Cyan
     C      Bright Red
     D      Bright Magenta
     E      Yellow
     F      White


   Output bit equations:

      R1 = X2
      R2 = X3 + X2*!X1
      R3 = X2

      B2 = X0*X3 + X0*!X1 + X0*!X2
      B3 = X0 + X3*!X1*!X2

      G1 = X1
      G2 = X1 + X3
      G3 = X1*X3 + X1*!X2

   ============================================================ */


/* RED */

R1_4 = X2;

R2_4 =
      X3
    # X2 & !X1;

R3_4 = X2;


/* BLUE */

B2_4 =
      X0 & X3
    # X0 & !X1
    # X0 & !X2;

B3_4 =
      X0
    # X3 & !X1 & !X2;


/* GREEN */

G1_4 = X1;

G2_4 =
      X1
    # X3;

G3_4 =
      X1 & X3
    # X1 & !X2;


/* ============================================================
   FINAL VGA OUTPUTS
   ============================================================ */


/* ------------------------------------------------------------
   OUT0 = VGA_RED(1)
   ------------------------------------------------------------ */

OUT0 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & R1_4
    # M8 & D0;


/* ------------------------------------------------------------
   OUT1 = VGA_RED(2)
   ------------------------------------------------------------ */

OUT1 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & R2_4
    # M8 & D1;


/* ------------------------------------------------------------
   OUT2 = VGA_RED(3)
   ------------------------------------------------------------ */

OUT2 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & R3_4
    # M8 & D2;


/* ------------------------------------------------------------
   OUT3 = VGA_BLUE(2)
   ------------------------------------------------------------ */

OUT3 =
      M1 & SEL_D1
    # M2 & C0
    # M4 & B2_4
    # M8 & D3;


/* ------------------------------------------------------------
   OUT4 = VGA_BLUE(3)
   ------------------------------------------------------------ */

OUT4 =
      M1 & SEL_D1
    # M2 & C0
    # M4 & B3_4
    # M8 & D4;


/* ------------------------------------------------------------
   OUT5 = VGA_GREEN(1)
   ------------------------------------------------------------ */

OUT5 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & G1_4
    # M8 & D5;


/* ------------------------------------------------------------
   OUT6 = VGA_GREEN(2)
   ------------------------------------------------------------ */

OUT6 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & G2_4
    # M8 & D6;


/* ------------------------------------------------------------
   OUT7 = VGA_GREEN(3)
   ------------------------------------------------------------ */

OUT7 =
      M1 & SEL_D1
    # M2 & C1
    # M4 & G3_4
    # M8 & D7;