Name     PORT;
PartNo   00;
Date     10/22/2026;
Revision 02;
Designer Justin;
Company  ;
Assembly ;
Location ;
Device   g22v10;


/* ============================================================
   SHARED PORT: KEYBOARD COLUMNS AND PAD READ   (ATF22V10C)
   ============================================================

   One of the four chips of the shared port at 5200h (docs/IO.md).  The
   keyboard, both SNES pads, the SD card and the two PS/2 ports are all
   polled, never at the same moment, so they share one output latch
   (74HC574), one input buffer (74F541) and this PLD.

   KEYBOARD COLUMNS
      The port latch's bits 7:4 (K3:K0) hold a column number.  Codes
      0-7 drive that column of the 8 x 8 key matrix low; codes 8-15
      drive none.  The columns are combinational from the latch, so a
      column is steady long before the CPU reads the rows: the read is
      then only the 74F541's enable, like any other I/O read.  (The
      plan's 74F138 decoded the column from the address during the
      read itself, which needs about 45 ns and does not fit in one
      39.7 ns clock.)
      The columns are push-pull.  Every key has a Schottky diode in
      series (cathode at the column), so a high column never drives
      a row.

   PAD READ AND PS/2 KEYBOARD CLOCK
      The pads' DATA lines are never tri-stated and are low after the
      16th bit, so they can't share the matrix rows.  This PLD drives
      them onto the read bus on reads of odd addresses (A0 = 1):
          D7 = pad 1 DATA      D5:D0 not driven
          D6 = pad 2 DATA when latch bit 4 (K0) is 0,
               the PS/2 keyboard's CLK line when K0 is 1
      (rev 02.)  The PS/2 keyboard socket (the lower half of the stacked
      dual socket) shares DATA with the mouse; latch bit 4 holds its CLK
      low through a Schottky diode.  With latch bit 7 = 1 (no column),
      bit 4 is free: 0 holds the keyboard off and picks pad 2 for pad
      reads, 1 lets the keyboard send and shows its clock here.  Its
      clock can't go on a key row, because bit 4 is low on every even
      column of a key scan and would read as a key down.
      The 74F541 (rows) is enabled on even addresses only (its /OE2
      is A0), so the two never drive the bus together.  Reads of the
      pads must mask D5:D0.  The output enable is 7.5 ns from
      /PORT_RD, faster than the 74F541's 9.5 ns.

   PIN BUDGET
      Inputs (9):  /PORT_RD, A0, K0-K3, PAD1, PAD2, KCLK
      Outputs (10): /COL0-/COL7, D6, D7
      Unused: pins 10, 11, 13 (inputs).
      Every output is one product term except D6 (two); the data
      outputs have one more for the output enable.  One array pass.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 1  = !PORT_RD;     /* I/O decode PLD pin 20, low on a read of 5200h-52FFh */
PIN 2  = A0;           /* address bit 0: 0 = rows (74F541), 1 = pads (this PLD) */
PIN 3  = K0;           /* port latch Q4 */
PIN 4  = K1;           /* port latch Q5 */
PIN 5  = K2;           /* port latch Q6 */
PIN 6  = K3;           /* port latch Q7: 1 = no column */
PIN 7  = PAD1;         /* SNES pad 1 DATA (10k pull-up: no pad reads 1) */
PIN 8  = PAD2;         /* SNES pad 2 DATA (10k pull-up) */
PIN 9  = KCLK;         /* PS/2 keyboard CLK (4.7k pull-up: no keyboard reads 1) */


/* ---------------- OUTPUTS ---------------- */

PIN 14 = !COL0;        /* keyboard column 0, low when driven */
PIN 15 = !COL1;
PIN 16 = !COL2;
PIN 17 = !COL3;
PIN 18 = !COL4;
PIN 19 = !COL5;
PIN 20 = !COL6;
PIN 21 = !COL7;
PIN 22 = D6;           /* data bus bit 6, 3-state */
PIN 23 = D7;           /* data bus bit 7, 3-state */


/* ---------------- EQUATIONS ---------------- */

COL0 = !K3 & !K2 & !K1 & !K0;
COL1 = !K3 & !K2 & !K1 &  K0;
COL2 = !K3 & !K2 &  K1 & !K0;
COL3 = !K3 & !K2 &  K1 &  K0;
COL4 = !K3 &  K2 & !K1 & !K0;
COL5 = !K3 &  K2 & !K1 &  K0;
COL6 = !K3 &  K2 &  K1 & !K0;
COL7 = !K3 &  K2 &  K1 &  K0;

D7    = PAD1;
D7.OE = PORT_RD & A0;
D6    = !K0 & PAD2
      #  K0 & KCLK;
D6.OE = PORT_RD & A0;
