Name     VGA640x480;
PartNo   01;
Date     09/10/2026;
Revision 01;
Designer OpenAI;
Company  TTL_VGA;
Assembly None;
Location None;
Device   ATF22V10;


/* ---------------------------------------------------------
   INPUTS
   --------------------------------------------------------- */

/* Horizontal counter bits */
PIN 1  = H9;
PIN 2  = H8;
PIN 3  = H7;
PIN 4  = H6;
PIN 5  = H5;
PIN 6  = H4;

/* Vertical counter bits */
PIN 7  = V9;
PIN 8  = V8;
PIN 9  = V7;
PIN 10 = V6;
PIN 11 = V5;
PIN 13 = V4;
PIN 14 = V3;
PIN 15 = V2;
PIN 16 = V1;


/* ---------------------------------------------------------
   OUTPUTS
   --------------------------------------------------------- */

PIN 18 = HSYNC;
PIN 19 = VSYNC;
PIN 20 = VIDEO_ENABLE;


/* ---------------------------------------------------------
   HORIZONTAL ACTIVE VIDEO
   HCOUNT = 0..639
   --------------------------------------------------------- */

H_ACTIVE =
       !H9
     # (!H8 & !H7);


/* ---------------------------------------------------------
   HORIZONTAL SYNC
   Active LOW
   HCOUNT = 656..751
   --------------------------------------------------------- */

HSYNC_ACTIVE =
       (H9 & H7 & !H8 & !H5 & H4)
     # (H9 & H7 & !H8 & H6 & H5)
     # (H9 & H7 & !H8 & !H6 & !H4);

HSYNC = !HSYNC_ACTIVE;


/* ---------------------------------------------------------
   VERTICAL ACTIVE VIDEO
   VCOUNT = 0..479
   --------------------------------------------------------- */

V_ACTIVE =
       (!V9 & !V8)
     # (!V9 & !V7)
     # (!V9 & !V6)
     # (!V9 & !V5);


/* ---------------------------------------------------------
   VERTICAL SYNC
   Active LOW
   VCOUNT = 490..491
   --------------------------------------------------------- */

VSYNC_ACTIVE =
       !V9 & V8 & V7 & V6 & V5 & !V4
     & V3 & !V2 & V1;

VSYNC = !VSYNC_ACTIVE;


/* ---------------------------------------------------------
   VIDEO ENABLE
   HCOUNT = 0..639
   VCOUNT = 0..479
   --------------------------------------------------------- */

VIDEO_ENABLE =
       (!H9 & !V9 & !V8)
     # (!H9 & !V9 & !V7)
     # (!H9 & !V9 & !V6)
     # (!H9 & !V9 & !V5)
     # (!H8 & !H7 & !V9 & !V8)
     # (!H8 & !H7 & !V9 & !V7)
     # (!H8 & !H7 & !V9 & !V6)
     # (!H8 & !H7 & !V9 & !V5);
