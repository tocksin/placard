Name     SYNC;
PartNo   01;
Date     09/10/2026;
Revision 01;
Designer ;
Company  ;
Assembly ;
Location ;
Device   ATF22V10;

/* =================================================
   INPUTS
   ================================================= */

PIN 1  = CLK;

/* Vertical counter */
PIN 2  = V0;
PIN 3  = V1;
PIN 4  = V2;
PIN 5  = V3;
PIN 6  = V4;
PIN 7  = V5;
PIN 8  = V6;
PIN 9  = V7;
PIN 10 = V8;
PIN 11 = V9;

/* Horizontal active-video state */
PIN 13 = H_VIDEO_ACTIVE;


/* =================================================
   OUTPUTS
   ================================================= */

/* Pixel-within-byte counter */
PIN 14 = H0;
PIN 15 = H1;
PIN 16 = H2;

/* Combined video active */
PIN 17 = VIDEO_ACTIVE;

/* VGA vertical sync */
PIN 18 = VSYNC;

/* Load framebuffer byte */
PIN 19 = BYTE_LOAD;


/* =================================================
   H0:H2 PIXEL COUNTER
   =================================================

   Counts continuously:

       000
       001
       010
       011
       100
       101
       110
       111
       000
       ...

   H2:H0 are also sent to the H Counter PLD.
   The H Counter PLD uses 111 as its count enable.
   ================================================= */

H0.D = !H0;

H1.D = H1 $ H0;

H2.D = H2 $ (H1 & H0);


/* =================================================
   VIDEO ACTIVE
   =================================================

   Vertical active video is:

       V = 544 through 1023

   Vertical active begins when:

       V9 = 1
       V5 = 1

   Once active, it remains active while V9 = 1
   and V5 = 0.

   Horizontal blanking clears VIDEO_ACTIVE every
   line, allowing it to become active again when
   H_VIDEO_ACTIVE returns high.

   Therefore:

       Start:
           H_VIDEO_ACTIVE & V9 & V5

       Hold:
           H_VIDEO_ACTIVE & V9 & !V5
           & VIDEO_ACTIVE
   ================================================= */

VIDEO_ACTIVE.D =
      (H_VIDEO_ACTIVE & V9 & V5)
    # (VIDEO_ACTIVE & H_VIDEO_ACTIVE & V9 & !V5);


/* =================================================
   VSYNC
   =================================================

   VGA VSYNC is ACTIVE LOW.

   Active interval:

       V = 532
       V = 533

   Start condition:

       V4 = 1
       V3 = 0
       V2 = 1
       V1 = 0

   At V=534, V1 becomes 1 and VSYNC returns high.

   VSYNC itself is the registered state.
   ================================================= */

/* Force VSYNC LOW during V=532..533.
   Otherwise hold the previous state, and V1
   releases it high at V=534. */

VSYNC.D =
      !(V4 & !V3 & V2 & !V1)
    & (VSYNC # V1);


/* =================================================
   BYTE LOAD
   =================================================

   Combinational output.

   During active video, assert BYTE_LOAD when
   H2:H0 = 000.

   This corresponds to the first pixel of the
   newly loaded 8-pixel byte.

   The byte latch therefore captures the RAM data
   at the beginning of the 8-pixel group.
   ================================================= */

BYTE_LOAD =
      VIDEO_ACTIVE
    & !H2
    & !H1
    & !H0;


/* =================================================
   MIXED REGISTERED / COMBINATIONAL OUTPUTS
   =================================================

   Explicitly disable asynchronous reset and
   synchronous preset for registered outputs.
   This prevents warnings in mixed designs.
   ================================================= */

H0.AR = 'b'0;
H0.SP = 'b'0;

H1.AR = 'b'0;
H1.SP = 'b'0;

H2.AR = 'b'0;
H2.SP = 'b'0;

VIDEO_ACTIVE.AR = 'b'0;
VIDEO_ACTIVE.SP = 'b'0;

VSYNC.AR = 'b'0;
VSYNC.SP = 'b'0;
