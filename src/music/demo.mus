; demo.mus - "PLACARD DEMO": the music player's demo tune (mus_tool.py,
; docs/MUSIC.md).  It shows off the player: PWM bass, drums from wave
; programs, triangle pads and pulse chords arpeggiated by wave programs,
; the arpeggio effect, a saw lead with vibrato, slides and portamento,
; custom-wave organ and bells, a noise riser, pulse-width, voice and
; master volume effects, a speed change, transposed orderlists and a key
; change.  Key A minor, 150 bpm (speed 6), about 60 seconds.
;
; Row: note, instrument (hex), effect (hex digit + 2-digit parameter):
;   0xy arpeggio +x +y   1xx slide up   2xx slide down   3xx portamento
;   4xy vibrato (speed, depth)   5xx attack/decay   6xx sustain/release
;   7xx pulse width   8xx wave program step   9xx voice volume
;   Axx master volume   Fxx speed (ticks per row)
;
;     python3 mus_tool.py build ../music/demo.mus -o ../../sdcard/DEMO.SNG
;     python3 mus_tool.py wav ../music/demo.mus -o demo.wav --seconds 62
;
; Date: 11/01/2026
title "PLACARD DEMO"

; wave programs: a waveform and a note (absolute, or + semitones from the
; note played) per tick; "loop n" repeats from step n, "end" holds the last
wave bass    pulse +0, end
wave kick    noise C-6, pulse C-3, pulse G#2, pulse E-2, pulse C-2, pulse A-1, pulse F-1, end
wave snare   noise D-6, pulse D-3, noise C#6, noise C-6, noise B-5, noise A#5, end
wave hat     noise C-7, end
wave minor   pulse +0, +3, +7, loop 0
wave major   pulse +0, +4, +7, loop 0
wave lead    saw +0, end
wave padmin  tri +0, +3, +7, +12, loop 0
wave padmaj  tri +0, +4, +7, +12, loop 0
wave pluck   pulse +0, end
wave orgmin  cw0 +0, +3, +7, loop 0
wave orgmaj  cw0 +0, +4, +7, loop 0
wave organ   cw0 +0, end
wave bell    cw1 +0, end
wave riser   noise +0, end

; pulse programs: set a width, then ticks x change per tick
pulse bass   set 20, 40x+2, 40x-2, loop 1
pulse chord  set 40, 60x+1, 60x-1, loop 1
pulse pluck  set 10, 10x+4, 20x-1, end

; custom waves: 32 values 0-63 (cw0 organ: 3 harmonics; cw1 bell: 1st + 3rd)

custom 0 37 45 52 56 57 56 53 49 46 43 40 39 37 36 35 33 31 29 28 27 25 24 21 18 15 11 8 7 8 12 19 27
custom 1 37 47 53 55 52 47 42 39 39 42 47 52 55 53 47 37 27 17 11 9 12 17 22 25 25 22 17 12 9 11 17 27

; instruments ($ = hex number): ad = attack, decay (0-F each); sr = sustain level, release;
; hr = hard restart (the envelope from 0); vib = speed, depth; vdelay = ticks
instrument $0 bass    ad=08 sr=40 wave=bass   pulse=bass  hr
instrument $1 kick    ad=08 sr=00 wave=kick   hr
instrument $2 snare   ad=06 sr=00 vol=12 wave=snare hr
instrument $3 hat     ad=03 sr=00 vol=9  wave=hat   hr
instrument $4 minor   ad=26 sr=79 vol=11 wave=minor  pulse=chord
instrument $5 major   ad=26 sr=79 vol=11 wave=major  pulse=chord
instrument $6 lead    ad=0A sr=A8 wave=lead   vib=34 vdelay=10
instrument $7 padmin  ad=A5 sr=8A vol=10 wave=padmin
instrument $8 orgmin  ad=28 sr=C7 vol=11 wave=orgmin
instrument $9 bell    ad=09 sr=06 vol=13 wave=bell
instrument $A pluck   ad=06 sr=05 vol=12 wave=pluck  pulse=pluck hr
instrument $B riser   ad=4A sr=F8 vol=8  wave=riser
instrument $C padmaj  ad=A5 sr=8A vol=10 wave=padmaj
instrument $D orgmaj  ad=28 sr=C7 vol=11 wave=orgmaj
instrument $E organ   ad=18 sr=D7 vol=12 wave=organ  vib=23 vdelay=20

