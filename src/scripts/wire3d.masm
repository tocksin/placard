    shl
    ld   ac, [w_t]
    ld   [zr], ac
    sub  [w_t], ac
    ld   ac, [zr]
    ld   [p22], ac
    xor  255, ac
    add  1, ac
    ld   ac, [p22]
    GOTO xf_z
xm_0:
    ld   [p00], ac
