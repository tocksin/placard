.region 0x0100, 0x1F00
.chunk                          ; a mirror image of the previous vertex (AC = 1 + axis): row -= 2 p, p = -p
xf_mir:
    sub  1, ac
    beq  xm_0
    sub  1, ac
    beq  xm_1
    ld   [p02], ac
    shl
    ld   ac, [w_t]
    ld   [xr], ac
    sub  [w_t], ac
    ld   ac, [xr]
    ld   [p02], ac
    xor  255, ac
    add  1, ac
    ld   ac, [p02]
    ld   [p12], ac
    shl
    ld   ac, [w_t]
    ld   [yr], ac
    sub  [w_t], ac
    ld   ac, [yr]
    ld   [p12], ac
    xor  255, ac
    add  1, ac
