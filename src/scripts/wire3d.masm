.chunk                          ; lights: lgl_j/lgk_j = log |L'_j|, sgl_j its sign
lights:
    ld   0x24, y
    ld   [m0], ac
    add  232, x
    ld   [y,x], ac
    ld   ac, [w_t]
    ld   [m0], ac
    sub  232, x
    ld   [w_t], ac
    sub  [y,x], ac
    ld   ac, [w_acc]
    ld   [m3], ac
    add  36, x
    ld   [y,x], ac
    ld   ac, [w_t]
