; ============================================================
; placard_fsw.masm - Placard FAT file writing (the DOS image)
; ============================================================
;
; Writes files to the SD card the FAT reader (placard_fs.asm) mounted,
; FAT16 or FAT32:
;
;     fs_create    make an empty file in the current folder (a file of
;                  the same name is deleted first) and open it for writing
;     fs_write     append the next 512 bytes
;     fs_close     set the size and finish the file
;     fs_delete    delete a file
;     fs_save      create + write + close: a block of memory as a file
;
; Clusters are taken from the first free FAT entry after the file's last
; cluster (from cluster 2 for the first), every FAT is kept up to date
; after each cluster, and the folder entry is written when the file is
; created (name, no data) and again when it is closed (first cluster,
; size), so an unplugged card leaves an empty file, not a broken one.
; Folders are not made or deleted, a folder is never grown (error 11 when
; it is full), and FAT32's free-cluster count (FSInfo) is left as it is;
; a PC fixes that count by itself.  Dates are 2026-01-01 00:00.
;
; Between fs_create and fs_close only fs_write may be called: the other
; file routines (fs_next, fs_open, fs_read, fs_load, fs_delete) change the
; buffer and the reader's state.
;
; Errors (AC): 2 not found, 4, 6 and 7 from sd_write, 5 from sd_read,
; 8 not mounted, 11 folder full, 12 no file open for writing, 13 the name
; is a folder, 14 the card is full.
;
; The writer's state is in FS_VARS x6D-x7F (placard_fs.asm lists x00-x6C)
; and it uses FS_BUF for FAT and folder sectors.  The routines change
; R0-R5, X, Y, T0-T7, IO_T0-IO_T3 and IO_TMP, and use the stack like the
; reader (about 10 bytes).
;
; This is not in the library proper: it is part of the DOS image at
; FSW_CODE (xB000-xBFFF), reached by programs through the DOS vectors at
; x8010-x8020 (dos.masm, docs/DOS.md).  placard_lib.asm's jump table is
; unchanged.  asm_expand.py writes placard_fsw.asm from this file.
;
; Date: 10/25/2026
; ============================================================

V_WCLUS   = 0x6D        ; 4: the file's first cluster, 0 = none yet
V_WLAST   = 0x71        ; 4: the cluster being written
V_WSECT    = 0x75        ; 4: the next sector to write (V_WSLEFT > 0)
V_WSLEFT   = 0x79        ; sectors left in that cluster
V_WENT    = 0x7A        ; bit 7 = a file is open for writing, bits 3:0 =
                        ; its folder entry (0-15) in sector V_WESEC
V_WESEC   = 0x7B        ; 4: the folder sector holding its entry
V_WDIRTY  = 0x7F        ; 1 = FS_BUF holds a changed FAT sector (V_FATC)
V_WBUF    = 0x3B        ; 2: fs_write's caller's buffer (R5:R4) while it
                        ; works on the FAT (x3B-x3F are free in the reader)
V_WSAVE   = 0x3D        ; 2: fs_save's buffer address while fs_create works
FSW_CODE  = 0xB000      ; the code (the DOS image, docs/ROM.md)

E_NOFILE  = 12
E_FOLDER  = 13
E_FULL    = 14
E_DIRFULL = 11

.prefix fsw
.region FSW_CODE, FSW_CODE + 0x1000

; ============================================================
; leaf helpers
; ============================================================
.chunk  fw_putb - 4 bytes of FS_VARS at offset AC = T4-T7.  Changes X, Y.
fw_putb:
    ld   ac, [FS_IDX]
    ld   ac, x
    ld   FSV, y
    ld   [T4], ac
    ld   ac, [y,x]
    ld   [FS_IDX], ac
    add  1, x
    ld   [T5], ac
    ld   ac, [y,x]
    ld   [FS_IDX], ac
    add  2, x
    ld   [T6], ac
    ld   ac, [y,x]
    ld   [FS_IDX], ac
    add  3, x
    ld   [T7], ac
    ld   ac, [y,x]
    RET

.chunk  fw_inc - T0-T3 = T0-T3 + 1
fw_inc:
    ld   [T0], ac
    inc
    ld   ac, [T0]
    bne  fi_d
    ld   [T1], ac
    inc
    ld   ac, [T1]
    bne  fi_d
    ld   [T2], ac
    inc
    ld   ac, [T2]
    bne  fi_d
    ld   [T3], ac
    inc
    ld   ac, [T3]
fi_d:
    RET

.chunk  fw_cp47 - T4-T7 = T0-T3
fw_cp47:
    ld   [T0], ac
    ld   ac, [T4]
    ld   [T1], ac
    ld   ac, [T5]
    ld   [T2], ac
    ld   ac, [T6]
    ld   [T3], ac
    ld   ac, [T7]
    RET

.chunk  fw_sub - T0-T3 = T0-T3 - T4-T7
fw_sub:
    ld   [T0], ac
    sub  [T4], ac
    ld   ac, [T0]
    ld   [T1], ac
    bcc  fsb_1
    sub  1, ac
    bcs  fsb_1z                 ; T1 was 0: T1 = FF - T5, borrow out
fsb_1:
    sub  [T5], ac
    ld   ac, [T1]
    ld   [T2], ac
    bcc  fsb_2
fsb_2c:
    sub  1, ac
    bcs  fsb_2z
fsb_2:
    sub  [T6], ac
    ld   ac, [T2]
    ld   [T3], ac
    bcc  fsb_3
fsb_3c:
    sub  1, ac
fsb_3:
    sub  [T7], ac
    ld   ac, [T3]
    RET
fsb_1z:
    sub  [T5], ac
    ld   ac, [T1]
    ld   [T2], ac
    bra  fsb_2c
fsb_2z:
    sub  [T6], ac
    ld   ac, [T2]
    ld   [T3], ac
    bra  fsb_3c

.chunk  fw_shr - T0-T3 = T0-T3 >> 1
fw_shr:
    ld   [T3], ac
    ld   ac, [IO_T0]
    shr  ac
    ld   ac, [T3]
    ld   [T2], ac
    ld   ac, [IO_T1]
    shr  ac
    ld   ac, [T2]
    ld   [IO_T0], ac
    and  1, ac
    beq  fsh_2
    ld   [T2], ac
    or   0x80, ac
    ld   ac, [T2]
fsh_2:
    ld   [T1], ac
    ld   ac, [IO_T0]
    shr  ac
    ld   ac, [T1]
    ld   [IO_T1], ac
    and  1, ac
    beq  fsh_1
    ld   [T1], ac
    or   0x80, ac
    ld   ac, [T1]
fsh_1:
    ld   [T0], ac
    shr  ac
    ld   ac, [T0]
    ld   [IO_T0], ac
    and  1, ac
    beq  fsh_0
    ld   [T0], ac
    or   0x80, ac
    ld   ac, [T0]
fsh_0:
    RET

.chunk  fw_lba - R3:R0 = T0-T3, R5:R4 = FS_BUF: the arguments of sd_read / sd_write
fw_lba:
    ld   [T0], ac
    ld   ac, [R0]
    ld   [T1], ac
    ld   ac, [R1]
    ld   [T2], ac
    ld   ac, [R2]
    ld   [T3], ac
    ld   ac, [R3]
    clr  ac
    ld   ac, [R4]
    ld   FSB, ac
    ld   ac, [R5]
    RET

.chunk  fw_fatval - T4-T7 = the FAT entry at V_OFFP:V_OFF in FS_BUF (FAT16: 16 bits; FAT32: 28 bits)
fw_fatval:
    ld   FSV, y
    ld   V_OFF, x
    ld   [y,x], ac
    ld   ac, [FS_IDX]
    ld   V_OFFP, x
    ld   [y,x], ac
    ld   ac, [IO_T1]
    ld   [FS_IDX], x
    ld   [IO_T1], y
    ld   [y,x], ac
    ld   ac, [T4]
    ld   [FS_IDX], ac
    add  1, x
    ld   [y,x], ac
    ld   ac, [T5]
    clr  ac
    ld   ac, [T6]
    ld   ac, [T7]
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    xor  32, ac
    bne  fv_d
    ld   [FS_IDX], ac
    add  2, x
    ld   [IO_T1], y
    ld   [y,x], ac
    ld   ac, [T6]
    ld   [FS_IDX], ac
    add  3, x
    ld   [y,x], ac
    and  0x0F, ac
    ld   ac, [T7]
fv_d:
    RET

.chunk  fw_fatset - the FAT entry at V_OFFP:V_OFF = T4-T7 (2 or 4 bytes), the buffer is dirty
fw_fatset:
    ld   FSV, y
    ld   V_WDIRTY, x
    ld   1, [y,x]
    ld   V_OFF, x
    ld   [y,x], ac
    ld   ac, [FS_IDX]
    ld   V_OFFP, x
    ld   [y,x], ac
    ld   ac, [IO_T1]
    ld   [FS_IDX], x
    ld   [IO_T1], y
    ld   [T4], ac
    ld   ac, [y,x]
    ld   [FS_IDX], ac
    add  1, x
    ld   [T5], ac
    ld   ac, [y,x]
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    xor  32, ac
    bne  fst_d
    ld   [FS_IDX], ac
    add  2, x
    ld   [IO_T1], y
    ld   [T6], ac
    ld   ac, [y,x]
    ld   [FS_IDX], ac
    add  3, x
    ld   [T7], ac
    ld   ac, [y,x]
fst_d:
    RET

.chunk  fw_ebase - IO_T0 = (AC & 7) * 32, IO_T1 = the page of folder entry AC (0-15) in FS_BUF
fw_ebase:
    ld   ac, [IO_T0]
    and  8, ac
    beq  eb_p0
    ld   FSB + 1, ac
    bra  eb_p
eb_p0:
    ld   FSB, ac
eb_p:
    ld   ac, [IO_T1]
    ld   [IO_T0], ac
    and  7, ac
    shl
    shl
    shl
    shl
    shl
    ld   ac, [IO_T0]
    RET

; ============================================================
; fw_flush - write FS_BUF (a changed FAT sector, V_FATC) to every FAT
;   out: AC = 0, or an sd_write error.  Nothing when V_WDIRTY = 0.
; ============================================================
.chunk
fw_flush:
    PUSH_LINK
    ld   FSV, y
    ld   V_WDIRTY, x
    ld   [y,x], ac
    beq  ffl_ok
    ld   0, [y,x]
    ld   V_NFATS, x
    ld   [y,x], ac
    ld   V_TMPT, x              ; FATs left
    ld   ac, [y,x]
    ld   V_FATC, ac
    CALL fs_get
    ld   V_REM, ac              ; the sector being written
    CALL fs_put
ffl_loop:
    CALL fw_lba
    CALL sd_write
    bne  ffl_ret
    ld   FSV, y
    ld   V_TMPT, x
    ld   [y,x], ac
    dec
    ld   ac, [y,x]
    beq  ffl_ok
    ld   V_REM, ac              ; the same sector in the next FAT
    CALL fs_get
    ld   V_FATSZ, ac
    CALL fs_getb
    CALL fs_add
    ld   V_REM, ac
    CALL fs_put
    bra  ffl_loop
ffl_ok:
    clr  ac
ffl_ret:
    LEAVE

; ============================================================
; fw_maxc - V_MAXC = the first cluster number past the data area, from the
; boot sector: 2 + (volume sectors - data start) >> V_SHIFT.  Once per mount.
;   out: AC = 0 or an SD error
; ============================================================
.chunk
fw_maxc:
    PUSH_LINK
    ld   V_MAXC, ac
    CALL fs_get
    ld   [T0], ac
    or   [T1], ac
    or   [T2], ac
    or   [T3], ac
    bne  fmx_ok
    CALL fw_flush               ; FS_BUF is about to be reused
    bne  fmx_ret
    ld   V_PART, ac             ; the boot sector into FS_BUF
    CALL fs_get
    CALL fw_lba
    CALL sd_read
    bne  fmx_ret
    ld   FSV, y
    ld   V_FATC + 3, x          ; no FAT sector in the buffer now
    ld   0xFF, [y,x]
    ld   0x13, ac               ; total sectors, 16 bits ...
    CALL fs_bget
    clr  ac
    ld   ac, [T6]
    ld   ac, [T7]
    ld   [T4], ac
    or   [T5], ac
    bne  fmx_tot
    ld   0x20, ac               ; ... or 32
    CALL fs_bget
fmx_tot:
    GOTO fmx_count
fmx_ok:
    clr  ac
fmx_ret:
    LEAVE

.chunk  fmx_count: T4-T7 = the volume's sectors
fmx_count:
    ld   V_PART, ac
    CALL fs_get
    CALL fs_add                 ; + the volume's first sector
    ld   V_DATA, ac
    CALL fs_getb
    CALL fw_sub                 ; - the data start = data sectors
    ld   FSV, y
    ld   V_SHIFT, x
    ld   [y,x], ac
fmx_sh:
    beq  fmx_2
    ld   ac, [IO_TMP]
    CALL fw_shr
    ld   [IO_TMP], ac
    dec
    bra  fmx_sh
fmx_2:
    CALL fw_inc                 ; clusters start at 2
    CALL fw_inc
    ld   V_MAXC, ac
    CALL fs_put
    clr  ac
    LEAVE

; ============================================================
; fw_entry - FS_BUF = the FAT sector of cluster T0-T3 (written first if
; it was changed), V_OFFP:V_OFF = the entry's place, V_SCLUS = the cluster
;   out: AC = 0, 14 when the cluster is past the data area, or an SD error
; ============================================================
.chunk
fw_entry:
    PUSH_LINK
    ld   V_SCLUS, ac
    CALL fs_put
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    xor  32, ac
    beq  fe_32
    ld   [T0], ac               ; FAT16: entry at byte cluster * 2
    shl
    ld   V_OFF, x
    ld   ac, [y,x]
    ld   [T0], ac
    blt  fe_p1
    ld   FSB, ac
    bra  fe_p
fe_p1:
    ld   FSB + 1, ac
fe_p:
    ld   V_OFFP, x
    ld   ac, [y,x]
    ld   [T1], ac               ; sector = cluster >> 8
    ld   ac, [T0]
    ld   [T2], ac
    ld   ac, [T1]
    ld   [T3], ac
    ld   ac, [T2]
    clr  ac
    ld   ac, [T3]
    GOTO fe_sec
fe_32:
    ld   [T0], ac               ; FAT32: entry at byte (cluster & 7F) * 4
    shl
    shl
    ld   V_OFF, x
    ld   ac, [y,x]
    ld   [T0], ac
    and  0x40, ac
    beq  fe_q0
    ld   FSB + 1, ac
    bra  fe_q
fe_q0:
    ld   FSB, ac
fe_q:
    ld   V_OFFP, x
    ld   ac, [y,x]
    CALL fs_shl                 ; sector = cluster >> 7
    ld   [T1], ac
    ld   ac, [T0]
    ld   [T2], ac
    ld   ac, [T1]
    ld   [T3], ac
    ld   ac, [T2]
    clr  ac
    ld   ac, [T3]
    GOTO fe_sec

.chunk  fe_sec: T0-T3 = the sector in the FAT
fe_sec:
    ld   V_SLBA, ac             ; the FAT sector, while the cluster is checked
    CALL fs_put
    CALL fw_maxc
    bne  fe_full
    ld   V_SCLUS, ac            ; past the data area: the card is full
    CALL fs_get
    ld   V_MAXC, ac
    CALL fs_getb
    ld   [T3], ac
    sub  [T7], ac
    bcs  fe_in
    bne  fe_fullc
    ld   [T2], ac
    sub  [T6], ac
    bcs  fe_in
    bne  fe_fullc
    ld   [T1], ac
    sub  [T5], ac
    bcs  fe_in
    bne  fe_fullc
    ld   [T0], ac
    sub  [T4], ac
    bcs  fe_in
fe_fullc:
    ld   E_FULL, ac
fe_full:
    LEAVE
fe_in:
    GOTO fe_have

.chunk  fe_have: the cluster is in range; V_SLBA = its sector in the FAT
fe_have:
    ld   V_SLBA, ac
    CALL fs_get
    ld   V_FAT, ac              ; its address on the card
    CALL fs_getb
    CALL fs_add
    ld   V_FATC, ac             ; already in FS_BUF?
    CALL fs_getb
    ld   [T0], ac
    xor  [T4], ac
    bne  fe_load
    ld   [T1], ac
    xor  [T5], ac
    bne  fe_load
    ld   [T2], ac
    xor  [T6], ac
    bne  fe_load
    ld   [T3], ac
    xor  [T7], ac
    bne  fe_load
    clr  ac
    LEAVE
fe_load:
    ld   V_SLBA, ac             ; the sector wanted, while the old one is written
    CALL fs_put
    CALL fw_flush
    bne  fe_ret
    ld   V_SLBA, ac
    CALL fs_get
    ld   V_FATC, ac
    CALL fs_put
    CALL fw_lba
    CALL sd_read
    beq  fe_ret
    ld   ac, [IO_TMP]
    ld   FSV, y                 ; no FAT sector in the buffer now
    ld   V_FATC + 3, x
    ld   0xFF, [y,x]
    ld   [IO_TMP], ac
fe_ret:
    LEAVE

; ============================================================
; fw_alloc - take a free cluster: T0-T3 = it, its FAT entry = end of chain
;   The search starts after the file's last cluster (V_WLAST), or at 2,
;   and goes round once.
;   out: AC = 0, 14 when the card is full, or an SD error
; ============================================================
.chunk
fw_alloc:
    PUSH_LINK
    ld   FSV, y
    ld   V_SMODE, x             ; 1 once the search has started over at 2
    ld   0, [y,x]
    ld   V_WLAST, ac
    CALL fs_get
    ld   [T0], ac
    or   [T1], ac
    or   [T2], ac
    or   [T3], ac
    bne  fa_scan
fa_from2:
    ld   FSV, y
    ld   V_SMODE, x
    ld   1, [y,x]
    clr  ac
    ld   ac, [T1]
    ld   ac, [T2]
    ld   ac, [T3]
    ld   2, ac
    ld   ac, [T0]
fa_scan:
    CALL fw_entry
    beq  fa_look
    ld   ac, [IO_TMP]
    xor  E_FULL, ac
    bne  fa_fail
    ld   FSV, y
    ld   V_SMODE, x
    ld   [y,x], ac
    bne  fa_fail                ; the whole FAT seen: full
    bra  fa_from2
fa_fail:
    ld   [IO_TMP], ac
    LEAVE
fa_look:
    CALL fw_fatval
    ld   [T4], ac
    or   [T5], ac
    or   [T6], ac
    or   [T7], ac
    beq  fa_free
    ld   V_SCLUS, ac            ; in use: the next one
    CALL fs_get
    CALL fw_inc
    bra  fa_scan
fa_free:
    ld   0xFF, ac               ; end of chain: FFFF or 0FFFFFFF
    ld   ac, [T4]
    ld   ac, [T5]
    ld   ac, [T6]
    ld   0x0F, ac
    ld   ac, [T7]
    CALL fw_fatset
    ld   V_SCLUS, ac
    CALL fs_get
    clr  ac
    LEAVE

; ============================================================
; fw_find - find V_NAME in the current folder (fs_name first)
;   out: AC = 0 found (FS_ENTRY = the entry, FS_BUF = its sector V_DSEC,
;        V_DIRI - 1 = its place), 2 not found, or an error
; ============================================================
.chunk
fw_find:
    PUSH_LINK
    CALL fs_cwd
    bne  ffd_ret
ffd_next:
    CALL fs_next
    beq  ffd_cmp
    ld   ac, [IO_TMP]
    xor  1, ac
    bne  ffd_err
    ld   2, ac
    LEAVE
ffd_err:
    ld   [IO_TMP], ac
ffd_ret:
    LEAVE
ffd_cmp:
    clr  ac
    ld   ac, [IO_T2]
ffd_c:
    ld   [IO_T2], ac
    add  V_ENTRY, x
    ld   FSV, y
    ld   [y,x], ac
    ld   ac, [IO_T3]
    ld   [IO_T2], ac
    add  V_NAME, x
    ld   [y,x], ac
    xor  [IO_T3], ac
    bne  ffd_next
    ld   [IO_T2], ac
    inc
    ld   ac, [IO_T2]
    xor  11, ac
    bne  ffd_c
    clr  ac
    LEAVE

; ============================================================
; fw_unlink - delete the file fw_find found: mark its entry, free its chain
;   out: AC = 0, 13 for a folder, or an SD error
; ============================================================
.chunk
fw_unlink:
    PUSH_LINK
    ld   FSV, y
    ld   V_ENTRY + 11, x
    ld   [y,x], ac
    and  0x10, ac
    beq  fu_file
    ld   E_FOLDER, ac
    LEAVE
fu_file:
    ld   V_DIRI, x
    ld   [y,x], ac
    dec
    CALL fw_ebase
    ld   [IO_T0], x
    ld   [IO_T1], y
    ld   0xE5, [y,x]            ; deleted
    ld   V_DSEC, ac
    CALL fs_get
    CALL fw_lba
    CALL sd_write
    bne  fu_ret
    ld   V_ENTRY + 26, ac       ; its first cluster, low word
    CALL fs_get
    ld   V_ENTRY + 20, ac       ; and high word (FAT32)
    CALL fs_getb
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    xor  32, ac
    beq  fu_32
    clr  ac
    ld   ac, [T4]
    ld   ac, [T5]
fu_32:
    ld   [T4], ac
    ld   ac, [T2]
    ld   [T5], ac
    and  0x0F, ac
    ld   ac, [T3]
    GOTO fw_freech
fu_ret:
    LEAVE

.chunk  fw_freech - free the chain from cluster T0-T3 (fw_unlink's second half: it leaves for it)
fw_freech:
    ld   [T0], ac
    or   [T1], ac
    or   [T2], ac
    or   [T3], ac
    beq  fch_done
    CALL fw_entry
    bne  fch_ret
    CALL fw_fatval              ; the next cluster
    ld   V_SLBA, ac
    CALL fw_putb
    clr  ac                     ; this one is free
    ld   ac, [T4]
    ld   ac, [T5]
    ld   ac, [T6]
    ld   ac, [T7]
    CALL fw_fatset
    ld   V_SLBA, ac
    CALL fs_get
    ld   FSV, y                 ; the end of the chain?
    ld   V_TYPE, x
    ld   [y,x], ac
    xor  32, ac
    beq  fch_32
    ld   [T1], ac               ; FAT16: FFF8-FFFF
    xor  0xFF, ac
    bne  fch_low
    bra  fch_t0
fch_32:
    ld   [T3], ac               ; FAT32: 0FFFFFF8-0FFFFFFF
    xor  0x0F, ac
    bne  fch_low
    ld   [T2], ac
    and  [T1], ac
    xor  0xFF, ac
    bne  fch_low
fch_t0:
    ld   [T0], ac
    and  0xF8, ac
    xor  0xF8, ac
    beq  fch_done
fch_low:
    ld   [T3], ac               ; 0 and 1 end a broken chain
    or   [T2], ac
    or   [T1], ac
    bne  fw_freech
    ld   [T0], ac
    and  0xFE, ac
    bne  fw_freech
fch_done:
    CALL fw_flush
fch_ret:
    LEAVE

; ============================================================
; fw_abort - give the clusters of the file being written back (a write
; failed): fs_close then leaves an empty file
;   out: AC = 0 or an SD error
; ============================================================
.chunk
fw_abort:
    PUSH_LINK
    ld   V_WCLUS, ac
    CALL fs_get
    ld   FSV, y
    ld   7, ac
fab_c:
    add  V_WCLUS, x             ; V_WCLUS = V_WLAST = 0
    ld   0, [y,x]
    sub  1, ac
    bcc  fab_c
    ld   V_WSLEFT, x
    ld   0, [y,x]
    GOTO fw_freech

; ============================================================
; fs_delete - delete a file in the current folder
;   in:      R1:R0 = the name, as fs_open ("GAME.BIN")
;   out:     AC = 0, 2 not found, 8 not mounted, 13 a folder, or an SD error
;   changes: R0-R5, X, Y, T0-T7, IO_T0-IO_T3, IO_TMP
;   clocks:  the search (about 1,000 per entry plus 140,000 per sector),
;            then one sector write per 128 (FAT32) or 256 (FAT16)
;            clusters freed, times the number of FATs
; ============================================================
.chunk
fs_delete:
    PUSH_LINK
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    bne  fd_m
    ld   8, ac
    LEAVE
fd_m:
    CALL fs_name
    CALL fw_find
    bne  fd_ret
    CALL fw_unlink
fd_ret:
    LEAVE

; ============================================================
; fs_create - make an empty file in the current folder and open it for
; fs_write; a file of the same name is deleted first
;   in:      R1:R0 = the name, as fs_open
;   out:     AC = 0 (the file exists, empty), 8 not mounted, 11 the folder
;            is full, 13 the name is a folder, or an SD error
;   changes: R0-R5, X, Y, T0-T7, IO_T0-IO_T3, IO_TMP
;   clocks:  the folder search (about 1,000 per entry plus 140,000 per
;            sector) and one sector write; the delete when it replaces
; ============================================================
.chunk
fs_create:
    PUSH_LINK
    ld   FSV, y
    ld   V_TYPE, x
    ld   [y,x], ac
    bne  fc_m
    ld   8, ac
    LEAVE
fc_m:
    ld   V_WENT, x              ; nothing open while this works
    ld   0, [y,x]
    CALL fs_name
    CALL fw_find
    beq  fc_del
    ld   ac, [IO_TMP]
    xor  2, ac
    beq  fc_free
    ld   [IO_TMP], ac
    LEAVE
fc_del:
    CALL fw_unlink
    bne  fc_ret
fc_free:
    CALL fs_cwd                 ; a free entry: the first 00 or E5
    bne  fc_ret
fc_sec:
    ld   V_SLBA, ac             ; the sector about to be read
    CALL fs_get
    ld   V_WESEC, ac
    CALL fs_put
    ld   FSB, ac
    ld   ac, [R5]
    clr  ac
    ld   ac, [R4]
    CALL fs_snext
    beq  fc_look
    ld   ac, [IO_TMP]
    xor  1, ac
    beq  fc_dfull
    ld   [IO_TMP], ac
fc_ret:
    LEAVE
fc_dfull:
    ld   E_DIRFULL, ac
    LEAVE
fc_look:
    clr  ac
    ld   ac, [IO_T2]
fc_e:
    ld   [IO_T2], ac
    CALL fw_ebase
    ld   [IO_T0], x
    ld   [IO_T1], y
    ld   [y,x], ac
    beq  fc_got
    xor  0xE5, ac
    beq  fc_got
    ld   [IO_T2], ac
    inc
    ld   ac, [IO_T2]
    xor  16, ac
    bne  fc_e
    bra  fc_sec
fc_got:
    GOTO fc_fill

.chunk  fc_fill: entry IO_T2 of the sector in FS_BUF (IO_T0 = its offset, IO_T1 = its page) becomes the file's
fc_fill:
    clr  ac
    ld   ac, [IO_T3]
fcf_n:
    ld   [IO_T3], ac            ; the name, 11 characters
    add  V_NAME, x
    ld   FSV, y
    ld   [y,x], ac
    ld   ac, [T0]
    ld   [IO_T3], ac
    add  [IO_T0], x
    ld   [IO_T1], y
    ld   [T0], ac
    ld   ac, [y,x]
    ld   [IO_T3], ac
    inc
    ld   ac, [IO_T3]
    xor  11, ac
    bne  fcf_n
fcf_z:
    ld   [IO_T3], ac            ; the rest 00
    add  [IO_T0], x
    ld   0, [y,x]
    ld   [IO_T3], ac
    inc
    ld   ac, [IO_T3]
    xor  32, ac
    bne  fcf_z
    ld   [IO_T0], ac
    add  11, x
    ld   0x20, [y,x]            ; a plain file
    ld   [IO_T0], ac
    add  16, x
    ld   0x21, [y,x]            ; made 2026-01-01
    ld   [IO_T0], ac
    add  17, x
    ld   0x5C, [y,x]
    ld   [IO_T0], ac
    add  24, x
    ld   0x21, [y,x]            ; written 2026-01-01
    ld   [IO_T0], ac
    add  25, x
    ld   0x5C, [y,x]
    ld   FSV, y
    ld   [IO_T2], ac
    or   0x80, ac
    ld   V_WENT, x              ; open for writing, entry IO_T2
    ld   ac, [y,x]
    ld   V_WESEC, ac
    CALL fs_get
    CALL fw_lba
    CALL sd_write
    bne  fcf_ret
    ld   FSV, y
    ld   7, ac
fcf_c:
    add  V_WCLUS, x             ; V_WCLUS = V_WLAST = 0
    ld   0, [y,x]
    sub  1, ac
    bcc  fcf_c
    ld   V_WSLEFT, x
    ld   0, [y,x]
    ld   V_WDIRTY, x
    ld   0, [y,x]
    ld   V_FATC + 3, x          ; FS_BUF holds the folder sector
    ld   0xFF, [y,x]
    clr  ac
fcf_ret:
    LEAVE

; ============================================================
; fs_write - append 512 bytes to the file being written
;   in:      R5:R4 = the bytes
;   out:     AC = 0 and R5:R4 + 512, 12 no file open, 14 card full, or
;            an SD error
;   changes: R0-R5, X, Y, T0-T7, IO_T0-IO_T3, IO_TMP
;   clocks:  about 130,000 (one sector write) plus the card's busy time;
;            a new cluster adds FAT reads and one write per FAT
; ============================================================
.chunk
fs_write:
    PUSH_LINK
    ld   FSV, y
    ld   V_WENT, x
    ld   [y,x], ac
    blt  fw_open
    ld   E_NOFILE, ac
    LEAVE
fw_open:
    ld   V_WBUF, x              ; the caller's buffer, kept while the FAT
    ld   [R4], ac               ; work changes R0-R5
    ld   ac, [y,x]
    ld   V_WBUF + 1, x
    ld   [R5], ac
    ld   ac, [y,x]
    ld   V_WSLEFT, x
    ld   [y,x], ac
    bne  fw_sec
    GOTO fw_newc
fw_sec:
    GOTO fw_sec2

.chunk  fw_newc: the cluster is used up (or there is none yet): take another
fw_newc:
    CALL fw_alloc               ; T0-T3 = a new cluster
    bne  fw_ret
    ld   V_WSECT, ac             ; parked here
    CALL fs_put
    ld   V_WCLUS, ac
    CALL fs_getb
    ld   [T4], ac
    or   [T5], ac
    or   [T6], ac
    or   [T7], ac
    bne  fw_link
    ld   V_WCLUS, ac            ; the file's first cluster
    CALL fs_put
    bra  fw_setl
fw_link:
    ld   V_WLAST, ac            ; after the last one: FAT[last] = new
    CALL fs_get
    CALL fw_entry
    bne  fw_ret
    ld   V_WSECT, ac
    CALL fs_getb
    CALL fw_fatset
    ld   V_WSECT, ac
    CALL fs_get
fw_setl:
    ld   V_WLAST, ac
    CALL fs_put
    CALL fw_flush
    bne  fw_ret
    ld   V_WLAST, ac
    CALL fs_get
    CALL fs_clba
    ld   V_WSECT, ac
    CALL fs_put
    ld   FSV, y
    ld   V_SPC, x
    ld   [y,x], ac
    ld   V_WSLEFT, x
    ld   ac, [y,x]
    GOTO fw_sec2
fw_ret:
    LEAVE

.chunk  fw_sec2: write the caller's 512 bytes to sector V_WSECT
fw_sec2:
    ld   V_WSECT, ac
    CALL fs_get
    ld   [T0], ac
    ld   ac, [R0]
    ld   [T1], ac
    ld   ac, [R1]
    ld   [T2], ac
    ld   ac, [R2]
    ld   [T3], ac
    ld   ac, [R3]
    ld   FSV, y
    ld   V_WBUF, x
    ld   [y,x], ac
    ld   ac, [R4]
    ld   V_WBUF + 1, x
    ld   [y,x], ac
    ld   ac, [R5]
    CALL sd_write
    bne  fws_ret
    ld   V_WSECT, ac
    CALL fs_get
    CALL fw_inc
    ld   V_WSECT, ac
    CALL fs_put
    ld   FSV, y
    ld   V_WSLEFT, x
    ld   [y,x], ac
    dec
    ld   ac, [y,x]
    clr  ac
fws_ret:
    LEAVE

; ============================================================
; fs_close - finish the file being written: its size and first cluster
; go into its folder entry
;   in:      R3:R0 = the size in bytes (R0 lowest); at most the bytes
;            written
;   out:     AC = 0, 12 no file open, or an SD error
;   changes: R0-R5, X, Y, T0-T7, IO_T0-IO_T3, IO_TMP
;   clocks:  one sector read and one write, plus the FAT writes if a
;            cluster was taken since the last fs_write
; ============================================================
.chunk
fs_close:
    PUSH_LINK
    ld   FSV, y
    ld   V_WENT, x
    ld   [y,x], ac
    blt  fcl_open
    ld   E_NOFILE, ac
    LEAVE
fcl_open:
    and  0x0F, ac
    ld   ac, [y,x]              ; closed, whatever happens next
    ld   [R0], ac               ; the size, kept in V_UBUF-V_LBUF
    ld   ac, [T0]
    ld   [R1], ac
    ld   ac, [T1]
    ld   [R2], ac
    ld   ac, [T2]
    ld   [R3], ac
    ld   ac, [T3]
    ld   V_UBUF, ac
    CALL fs_put
    CALL fw_flush
    bne  fcl_ret
    ld   V_WESEC, ac            ; the entry's sector
    CALL fs_get
    CALL fw_lba
    CALL sd_read
    bne  fcl_ret
    ld   FSV, y
    ld   V_FATC + 3, x          ; FS_BUF holds the folder sector
    ld   0xFF, [y,x]
    ld   V_WENT, x
    ld   [y,x], ac
    CALL fw_ebase
    GOTO fcl_fill
fcl_ret:
    LEAVE

.chunk  fcl_fill: entry IO_T0 (page IO_T1) of the folder sector in FS_BUF gets the cluster and size
fcl_fill:
    ld   V_WCLUS, ac
    CALL fs_get
    ld   [IO_T0], ac
    add  26, x
    ld   [IO_T1], y
    ld   [T0], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  27, x
    ld   [T1], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  20, x
    ld   [T2], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  21, x
    ld   [T3], ac
    ld   ac, [y,x]
    ld   V_UBUF, ac
    CALL fs_get
    ld   [IO_T0], ac
    add  28, x
    ld   [IO_T1], y
    ld   [T0], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  29, x
    ld   [T1], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  30, x
    ld   [T2], ac
    ld   ac, [y,x]
    ld   [IO_T0], ac
    add  31, x
    ld   [T3], ac
    ld   ac, [y,x]
    ld   V_WESEC, ac
    CALL fs_get
    CALL fw_lba
    CALL sd_write
    LEAVE

; ============================================================
; fs_save - write a block of memory as a file in the current folder
;   in:      R1:R0 = the name, R5:R4 = the first byte, R3:R2 = the length
;            (1-65535; whole 512-byte sectors are read from memory, so up
;            to 511 bytes past the end are read too)
;   out:     AC = 0, or an error as fs_create, fs_write, fs_close; when a
;            write fails (the card is full, 14) the file is left empty
;   changes: R0-R5, X, Y, T0-T7, IO_T0-IO_T3, IO_TMP
;   clocks:  about 130,000 per 512 bytes plus the card's busy time
; ============================================================
.chunk
fs_save:
    PUSH_LINK
    ld   FSV, y
    ld   V_WBUF, x              ; the length, while fs_create works
    ld   [R2], ac               ; (that changes R0-R5 and V_UBUF)
    ld   ac, [y,x]
    ld   V_WBUF + 1, x
    ld   [R3], ac
    ld   ac, [y,x]
    ld   V_WSAVE, x             ; and the address
    ld   [R4], ac
    ld   ac, [y,x]
    ld   V_WSAVE + 1, x
    ld   [R5], ac
    ld   ac, [y,x]
    CALL fs_create
    bne  fsv_ret
    ld   FSV, y
    ld   V_WSAVE, x
    ld   [y,x], ac
    ld   ac, [R4]
    ld   V_WSAVE + 1, x
    ld   [y,x], ac
    ld   ac, [R5]
    ld   V_WBUF, x              ; the size
    ld   [y,x], ac
    ld   V_UBUF, x
    ld   ac, [y,x]
    ld   V_LBUF, x              ; and the bytes left to write
    ld   ac, [y,x]
    ld   V_WBUF + 1, x
    ld   [y,x], ac
    ld   V_UBUF + 1, x
    ld   ac, [y,x]
    ld   V_LBUF + 1, x
    ld   ac, [y,x]
fsv_loop:
    ld   FSV, y
    ld   V_LBUF, x
    ld   [y,x], ac
    ld   V_LBUF + 1, x
    or   [y,x], ac
    beq  fsv_close
    CALL fs_write
    bne  fsv_bad
    ld   FSV, y
    ld   V_LBUF + 1, x
    ld   [y,x], ac
    sub  2, ac                  ; 512 fewer
    bcs  fsv_zero
    ld   ac, [y,x]
    bra  fsv_loop
fsv_zero:
    ld   0, [y,x]               ; less than 512 were left
    ld   V_LBUF, x
    ld   0, [y,x]
    bra  fsv_loop
fsv_close:
    ld   V_UBUF, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   V_UBUF + 1, x
    ld   [y,x], ac
    ld   ac, [R1]
    clr  ac
    ld   ac, [R2]
    ld   ac, [R3]
    CALL fs_close
fsv_ret:
    LEAVE
fsv_bad:
    GOTO fsv_abort

.chunk  fsv_abort: a write failed (AC = why): the file stays, empty
fsv_abort:
    ld   FSV, y
    ld   V_WBUF, x
    ld   ac, [y,x]
    CALL fw_abort
    clr  ac
    ld   ac, [R0]
    ld   ac, [R1]
    ld   ac, [R2]
    ld   ac, [R3]
    CALL fs_close
    ld   FSV, y
    ld   V_WBUF, x
    ld   [y,x], ac
    LEAVE
