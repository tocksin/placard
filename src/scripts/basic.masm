; ============================================================
; basic.masm - PLACARD BASIC: the bytecode machine's native code
; ============================================================
;
; rom32.masm includes this file.  BASIC itself is written in bytecode
; (basic.vm, compiled by vmc.py when asm_expand.py meets the .include at
; the end of this file); this file is the machine that runs it and the
; primitives that have to be fast or touch the hardware.  docs/BASIC.md,
; "The bytecode machine", describes it:
;
;   IP     the next instruction (IPL, IPH)
;   TOS    the top cell of the data stack (TL, TH); the rest of the data
;          stack is in the zero page below DS_EMPTY, DSP = its top cell
;          (low byte at DSP, high byte at DSP + 1), growing down
;   RSP    the return stack in page RSTK: the top entry's low byte at
;          RSP + 1, high byte at RSP + 2, growing down from xFF
;
; An instruction byte x00-x3F runs the primitive of that number (through
; the page vm_jump, made by vmc.py from the PRIM lines of basic.vm, four
; bytes a primitive: ld hi, y / jmp lo); x80-xFF is the
; high byte of a word's address, the next byte its low byte: a call.
; Every primitive ends by jumping to next.
;
; The library is used as by any program (CALL, the stack at xC0-xFF);
; R0-R7 and T0-T7 are free between primitives.
;
; Date: 10/27/2026
; ============================================================

; the machine's zero page
IPL     = 0x20
IPH     = 0x21
TL      = 0x22
TH      = 0x23
DSP     = 0x24
RSP     = 0x25
W0      = 0x26          ; scratch for the primitives
W1      = 0x27
W2      = 0x28
W3      = 0x29
W4      = 0x2A
W5      = 0x2B
W6      = 0x2C
W7      = 0x2D
SPG     = 0x2E          ; ROWCPY: source page
DPG     = 0x2F          ; and destination page
; BASIC's zero page that the primitives use (basic.vm has the rest, x36-x4F)
TP      = 0x30          ; 2: the text pointer
TXTROWS = 0x32          ; text rows on the screen (the window)
TXT2X   = 0x33          ; 0: 80 x 60 text (1x rows), 1: 80 x 30 (2x rows)
LASTFR  = 0x34          ; FRAME_LO at the last POLL
DS_EMPTY = 0x90         ; the data stack: x50-x8F
RSTK    = 0x5500        ; the return stack page
B_RAM   = 0x5C          ; the page the RAM routines are copied to

.prefix bas

; ------------------------------------------------------------
; macros
; ------------------------------------------------------------
.macro PUSHT                    ; push TOS (TOS stays)
    ld   [DSP], ac
    sub  2, ac
    ld   ac, [DSP]
    ld   ac, x
    ld   [TL], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [TH], ac
    ld   ac, [x]
.endm
.macro POPT                     ; TOS = the cell below it
    ld   [DSP], x
    ld   [x], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [TH]
    ld   [DSP], ac
    add  2, ac
    ld   ac, [DSP]
.endm
.macro NIP2                     ; drop the cell below TOS
    ld   [DSP], ac
    add  2, ac
    ld   ac, [DSP]
.endm
.macro IPBYTE                   ; AC = the byte at IP
    ld   [IPH], y
    ld   [IPL], x
    ld   [y,x], ac
.endm
.macro IPINC                    ; IP + 1
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    bne  ii\@
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
ii\@:
.endm
.macro NEXT
    ld   next >> 8, y
    jmp  next
.endm

; ============================================================
; basic - the vector x8024 comes here (power-up with no card, the DOS's
; BASIC command, BOOT.CFG "BASIC")
; ============================================================
.chunk  basic: map 07, LIB_RAM, the port, the RAM routines, the machine
basic:
    ld   STACK_TOP, ac
    ld   ac, [SP]
    ld   MAP_RUN, ac
    ld   ac, [MAP_SHADOW]
    ld   0x50, y
    ld   MAP_RUN, [y,x]
    CALL lib_ram_copy
    CALL port_init
    CALL snd_init
    ld   rc_ram & 0xFF, ac      ; the RAM routines to x5C00 + their offset
    ld   ac, [W0]
bs_cp:
    ld   [W0], x
    ld   rc_ram >> 8, y
    ld   [y,x], ac
    ld   B_RAM, y
    ld   ac, [y,x]
    ld   [W0], ac
    inc
    ld   ac, [W0]
    xor  rc_end & 0xFF, ac
    bne  bs_cp
    ld   DS_EMPTY, ac
    ld   ac, [DSP]
    ld   0xFF, ac
    ld   ac, [RSP]
    ld   w_COLD & 0xFF, ac
    ld   ac, [IPL]
    ld   w_COLD >> 8, ac
    ld   ac, [IPH]
    NEXT

; ============================================================
; the inner interpreter
; ============================================================
.chunk  next, calls, IP + 1 or 2, the branches
next:
    ld   [IPH], y               ; Y:X = IP, then IP + 1
    ld   [IPL], x
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    beq  nx_c
nx_f:
    ld   [y,x], ac
    blt  nx_call
    shl                         ; the primitive: vm_jump + opcode x 4
    shl
    ld   vm_jump >> 8, y
    jmp  ac
nx_c:
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  nx_f
nx_call:                        ; AC = the word's high byte, IP at its low byte
    ld   ac, [W0]
    IPBYTE
    ld   ac, [W1]
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    bne  nx_2
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
nx_2:
    ld   [RSP], x               ; push IP on the return stack
    ld   RSTK >> 8, y
    ld   [IPH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [IPL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   [W1], ac
    ld   ac, [IPL]
    ld   [W0], ac
    ld   ac, [IPH]
    bra  next
ip2:
    ld   [IPL], ac
    add  2, ac
    ld   ac, [IPL]
    bcc  next
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  next
ip1:
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    bne  next
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  next
p_br:                           ; BR n: IP = IP + 1 + n (n signed)
    IPBYTE
    ld   ac, [W0]
    add  [IPL], ac
    ld   ac, [IPL]
    bcc  br_nc
    ld   [W0], ac
    blt  ip1                    ; back, with a carry: the same page
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  ip1
br_nc:
    ld   [W0], ac
    blt  br_dec
    bra  ip1
br_dec:
    ld   [IPH], ac
    dec
    ld   ac, [IPH]
    bra  ip1
p_0br:                          ; 0BR n: branch if TOS = 0, drop it
    ld   [TL], ac
    or   [TH], ac
    ld   ac, [W2]
    POPT
    ld   [W2], ac
    beq  p_br
    bra  ip1

.chunk  EXIT, LBR, L0BR, EXECUTE, RESET
p_exit:
    ld   [RSP], ac
    add  1, x
    ld   RSTK >> 8, y
    ld   [y,x], ac
    ld   ac, [IPL]
    ld   [RSP], ac
    add  2, x
    ld   [y,x], ac
    ld   ac, [IPH]
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    NEXT
p_l0br:                         ; L0BR a: IP = a if TOS = 0, drop it
    ld   [TL], ac
    or   [TH], ac
    ld   ac, [W2]
    POPT
    ld   [W2], ac
    beq  p_lbr
    ld   ip2 >> 8, y
    jmp  ip2
p_lbr:                          ; LBR a: IP = a
    IPBYTE
    ld   ac, [W0]
    ld   [IPL], ac
    inc
    ld   ac, x
    bne  lb_1
    ld   [IPH], ac
    inc
    ld   ac, y
lb_1:
    ld   [y,x], ac
    ld   ac, [IPH]
    ld   [W0], ac
    ld   ac, [IPL]
    NEXT
p_execute:                      ; EXECUTE ( a -- ): call the word at a
    ld   [RSP], x
    ld   RSTK >> 8, y
    ld   [IPH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [IPL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   [TL], ac
    ld   ac, [IPL]
    ld   [TH], ac
    ld   ac, [IPH]
    ld   p_drop >> 8, y
    jmp  p_drop
p_reset:                        ; RESET: empty both stacks (TOS = 0), go on
    ld   DS_EMPTY, ac
    ld   ac, [DSP]
    ld   0xFF, ac
    ld   ac, [RSP]
    clr  ac
    ld   ac, [TL]
    ld   ac, [TH]
    ld   STACK_TOP, ac          ; and the library's stack
    ld   ac, [SP]
    NEXT

.chunk  LIT8, LIT16, SLIT
p_lit8:                         ; LIT8 n ( -- n )
    PUSHT
    IPBYTE
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_lit16:                        ; LIT16 n ( -- n )
    PUSHT
    IPBYTE
    ld   ac, [TL]
    IPINC
    IPBYTE
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_slit:                         ; SLIT n "..." ( -- a ): a = the length byte's address
    PUSHT
    ld   [IPL], ac
    ld   ac, [TL]
    ld   [IPH], ac
    ld   ac, [TH]
    IPBYTE
    inc
    add  [IPL], ac
    ld   ac, [IPL]
    bcc  sl_nc
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
sl_nc:
    NEXT

.chunk  ZP@ ZP! ZPC@ ZPC!
p_zpat:                         ; ZP@ n ( -- [n] )
    PUSHT
    IPBYTE
    ld   ac, [W0]
    ld   ac, x
    ld   [x], ac
    ld   ac, [TL]
    ld   [W0], ac
    add  1, x
    ld   [x], ac
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_zpcat:                        ; ZPC@ n ( -- [n] ), one byte
    PUSHT
    IPBYTE
    ld   ac, x
    ld   [x], ac
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_zpst:                         ; ZP! n ( v -- )
    IPBYTE
    ld   ac, [W0]
    ld   ac, x
    ld   [TL], ac
    ld   ac, [x]
    ld   [W0], ac
    add  1, x
    ld   [TH], ac
    ld   ac, [x]
    POPT
    ld   ip1 >> 8, y
    jmp  ip1
p_zpcst:                        ; ZPC! n ( v -- ), one byte
    IPBYTE
    ld   ac, x
    ld   [TL], ac
    ld   ac, [x]
    POPT
    ld   ip1 >> 8, y
    jmp  ip1

.chunk  DUP DROP SWAP OVER NIP 2DUP
p_dup:
    PUSHT
    NEXT
p_drop:
    POPT
    NEXT
p_nip:
    NIP2
    NEXT
p_swap:
    ld   [DSP], x
    ld   [x], ac
    ld   ac, [W0]
    ld   [TL], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [TH], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TH]
    NEXT
p_over:                         ; ( a b -- a b a )
    PUSHT
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [TH]
    NEXT
p_2dup:                         ; ( a b -- a b a b )
    ld   [DSP], ac              ; W1:W0 = a
    ld   ac, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], ac              ; two cells more: b, then a below TOS
    sub  4, ac
    ld   ac, [DSP]
    add  2, x
    ld   [TL], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  3, x
    ld   [TH], ac
    ld   ac, [x]
    ld   [DSP], x
    ld   [W0], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [W1], ac
    ld   ac, [x]
    NEXT

.chunk  ROT >R R> R@ RDROP
p_rot:                          ; ( a b c -- b c a )
    ld   [DSP], ac              ; W1:W0 = a (at DSP + 2)
    add  2, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], x               ; DSP + 2 = b
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  2, x
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  3, x
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], x               ; DSP = c
    ld   [TL], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [TH], ac
    ld   ac, [x]
    ld   [W0], ac               ; TOS = a
    ld   ac, [TL]
    ld   [W1], ac
    ld   ac, [TH]
    NEXT
p_tor:                          ; >R ( a -- )
    ld   [RSP], x
    ld   RSTK >> 8, y
    ld   [TH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [TL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   p_drop >> 8, y
    jmp  p_drop
p_rfrom:                        ; R> ( -- a )
    PUSHT
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    bra  rf_get
p_rat:                          ; R@ ( -- a )
    PUSHT
    ld   [RSP], ac
    add  2, ac
rf_get:                         ; TOS = the return stack entry at AC - 1 (low), AC (high)
    ld   ac, [W0]
    ld   ac, x
    ld   RSTK >> 8, y
    ld   [y,x], ac
    ld   ac, [TH]
    ld   [W0], ac
    sub  1, x
    ld   [y,x], ac
    ld   ac, [TL]
    NEXT
p_rdrop:
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    NEXT

.chunk  @ ! C@ C!
p_at:                           ; @ ( a -- [a] )
    ld   [TH], y
    ld   [TL], x
    ld   [y,x], ac
    ld   ac, [W0]
    ld   [TL], ac
    inc
    ld   ac, x
    bne  at_1
    ld   [TH], ac
    inc
    ld   ac, y
at_1:
    ld   [y,x], ac
    ld   ac, [TH]
    ld   [W0], ac
    ld   ac, [TL]
    NEXT
p_cat:                          ; C@ ( a -- [a] ), one byte
    ld   [TH], y
    ld   [TL], x
    ld   [y,x], ac
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    NEXT
p_store:                        ; ! ( v a -- )
    ld   [DSP], ac              ; W0 = v high
    add  1, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], x               ; v low
    ld   [x], ac
    ld   [TH], y
    ld   [TL], x
    ld   ac, [y,x]
    ld   [TL], ac
    inc
    ld   ac, x
    bne  st_1
    ld   [TH], ac
    inc
    ld   ac, y
st_1:
    ld   [W0], ac
    ld   ac, [y,x]
st_pop2:
    NIP2
    POPT
    NEXT
p_cstore:                       ; C! ( v a -- )
    ld   [DSP], x
    ld   [x], ac
    ld   [TH], y
    ld   [TL], x
    ld   ac, [y,x]
    bra  st_pop2

.chunk  + - AND OR XOR
p_add:
    ld   [DSP], x
    ld   [x], ac
    add  [TL], ac
    ld   ac, [TL]
    bcc  vad_1
    ld   [TH], ac
    inc
    ld   ac, [TH]
vad_1:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    add  [TH], ac
    ld   ac, [TH]
ad_nip:
    NIP2
    NEXT
p_sub:                          ; - ( a b -- a-b )
    ld   [DSP], x
    ld   [x], ac
    sub  [TL], ac
    ld   ac, [TL]
    bcc  sb_1
    ld   [TH], ac               ; a borrow: take one more from the high byte
    inc
    ld   ac, [TH]
sb_1:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    sub  [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_and:
    ld   [DSP], x
    ld   [x], ac
    and  [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    and  [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_or:
    ld   [DSP], x
    ld   [x], ac
    or   [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    or   [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_xor:
    ld   [DSP], x
    ld   [x], ac
    xor  [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  [TH], ac
    ld   ac, [TH]
    bra  ad_nip

.chunk  INVERT 1+ 1- 2* 2/ TP+
p_invert:
    ld   [TL], ac
    not
    ld   ac, [TL]
    ld   [TH], ac
    not
    ld   ac, [TH]
    NEXT
p_inc:
    ld   [TL], ac
    inc
    ld   ac, [TL]
    bne  in_1
    ld   [TH], ac
    inc
    ld   ac, [TH]
in_1:
    NEXT
p_dec:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  in_1
    ld   [TH], ac
    dec
    ld   ac, [TH]
    NEXT
p_2mul:
    ld   [TL], ac
    shl
    ld   ac, [TL]
    ld   [TH], ac
    bcc  m2_1
    shl
    or   1, ac
    ld   ac, [TH]
    NEXT
m2_1:
    shl
    ld   ac, [TH]
    NEXT
p_2div:                         ; arithmetic: the sign stays
    ld   [TL], ac
    shr  ac
    ld   ac, [TL]
    ld   [TH], ac
    and  1, ac
    beq  d2_1
    ld   [TL], ac
    or   0x80, ac
    ld   ac, [TL]
d2_1:
    ld   [TH], ac
    and  0x80, ac
    ld   ac, [W0]
    ld   [TH], ac
    shr  ac
    or   [W0], ac
    ld   ac, [TH]
    NEXT
p_tpinc:                        ; TP+: TP + 1
    ld   [TP], ac
    inc
    ld   ac, [TP]
    bne  in_1
    ld   [TP + 1], ac
    inc
    ld   ac, [TP + 1]
    NEXT

.chunk  VARNAME ( -- name ): the name at TP (spaces skipped), TP after it
; name = the first letter (+ x80 for $), high byte the second letter or
; digit or 0 (+ x80 for an array: the ( is left at TP); further letters
; and digits are skipped.  W2 = the state: 0 first letter, 1 second,
; 2 the rest, 3 after the $; W3 = the character.
p_varname:
    PUSHT
    clr  ac
    ld   ac, [W2]
vn_lp:
    ld   [TP + 1], y
    ld   [TP], x
    ld   [y,x], ac
    ld   ac, [W3]
    xor  0x20, ac
    beq  vn_inc                 ; a space
    ld   [W2], ac
    bne  vn_1
    ld   [W3], ac               ; the first letter
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    ld   1, ac
    ld   ac, [W2]
    bra  vn_inc
vn_1:
    sub  3, ac
    beq  vn_paren
    ld   [W3], ac
    sub  0x30, ac
    sub  10, ac
    bcs  vn_an
    ld   [W3], ac
    sub  0x41, ac
    sub  26, ac
    bcc  vn_suf
vn_an:                          ; a letter or digit
    ld   [W2], ac
    sub  1, ac
    bne  vn_inc
    ld   [W3], ac               ; the second
    ld   ac, [TH]
    ld   2, ac
    ld   ac, [W2]
vn_inc:
    ld   [TP], ac
    inc
    ld   ac, [TP]
    bne  vn_lp
    ld   [TP + 1], ac
    inc
    ld   ac, [TP + 1]
    bra  vn_lp
vn_suf:
    ld   [W3], ac
    xor  0x24, ac               ; $
    bne  vn_paren
    ld   [TL], ac
    or   0x80, ac
    ld   ac, [TL]
    ld   3, ac
    ld   ac, [W2]
    bra  vn_inc
vn_paren:
    ld   [W3], ac
    xor  0x28, ac               ; (
    bne  vn_x
    ld   [TH], ac
    or   0x80, ac
    ld   ac, [TH]
vn_x:
    NEXT

.chunk  = U< < 0= 0<
p_eq:
    ld   [DSP], x
    ld   [x], ac
    xor  [TL], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  [TH], ac
    or   [W0], ac
    beq  t_true
    bra  t_false
p_ult:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    sub  [TH], ac
    bcs  t_true
    bne  t_false
ult_lo:
    ld   [DSP], x
    ld   [x], ac
    sub  [TL], ac
    bcs  t_true
t_false:
    NIP2
u_false:
    clr  ac
    ld   ac, [TL]
    ld   ac, [TH]
    NEXT
p_lt:                           ; signed: compare with the sign bits flipped
    ld   [TH], ac
    xor  0x80, ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  0x80, ac
    sub  [W0], ac
    bcs  t_true
    bne  t_false
    bra  ult_lo
t_true:
    NIP2
u_true:
    ld   0xFF, ac
    ld   ac, [TL]
    ld   ac, [TH]
    NEXT
p_0eq:
    ld   [TL], ac
    or   [TH], ac
    beq  u_true
    bra  u_false
p_0lt:
    ld   [TH], ac
    blt  u_true
    bra  u_false
p_digq:                         ; DIGIT? ( c -- f ): c is 0-9
    ld   [TH], ac
    bne  u_false
    ld   [TL], ac
    sub  0x30, ac
    sub  10, ac
    bcs  u_true
    bra  u_false
p_alphq:                        ; ALPHA? ( c -- f ): c is A-Z
    ld   [TH], ac
    bne  u_false
    ld   [TL], ac
    sub  0x41, ac
    sub  26, ac
    bcs  u_true
    bra  u_false

.chunk  FINDVAR ( name -- a | 0 ): the variable's data, or 0 when there is none
; The records from VBASE (x0100) to [VTOP]: [name][size][data], each an
; even number of bytes, so a record's name, and its size, never cross a page.
VTOP    = 0x3A
p_findvar:
    ld   0x01, ac               ; W1:W0 = VBASE
    ld   ac, [W1]
    clr  ac
    ld   ac, [W0]
fv_lp:
    ld   [W1], ac               ; W1:W0 below VTOP?
    sub  [VTOP + 1], ac
    bcs  fv_in
    bne  fv_none
    ld   [W0], ac
    sub  [VTOP], ac
    bcc  fv_none
fv_in:
    ld   [W1], y
    ld   [W0], x
    ld   [y,x], ac
    xor  [TL], ac
    ld   ac, [W2]
    ld   [W0], ac
    add  1, x
    ld   [y,x], ac
    xor  [TH], ac
    or   [W2], ac
    beq  fv_found
    ld   [W0], ac               ; W5:W4 = the size
    add  2, ac
    ld   ac, x
    ld   [W1], ac
    bcc  fv_s
    inc
fv_s:
    ld   ac, y
    ld   [y,x], ac
    ld   ac, [W4]
    ld   [W0], ac
    add  3, x
    ld   [y,x], ac
    ld   ac, [W5]
    ld   [W0], ac               ; W1:W0 += size + 4
    add  [W4], ac
    ld   ac, [W0]
    ld   [W1], ac
    bcc  fv_n1
    inc
fv_n1:
    add  [W5], ac
    ld   ac, [W1]
    ld   [W0], ac
    add  4, ac
    ld   ac, [W0]
    bcc  fv_lp
    ld   [W1], ac
    inc
    ld   ac, [W1]
    bra  fv_lp
fv_found:
    ld   [W0], ac
    add  4, ac
    ld   ac, [TL]
    ld   [W1], ac
    bcc  fv_f1
    inc
fv_f1:
    ld   ac, [TH]
    NEXT
fv_none:
    clr  ac
    ld   ac, [TL]
    ld   ac, [TH]
    NEXT

.chunk  * ( a b -- a*b )
p_mul:
    ld   [DSP], x               ; W1:W0 = a, W3:W2 = 0
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    clr  ac
    ld   ac, [W2]
    ld   ac, [W3]
mu_lp:
    ld   [TL], ac
    and  1, ac
    beq  mu_sh
    ld   [W2], ac
    add  [W0], ac
    ld   ac, [W2]
    bcc  mu_hi
    ld   [W3], ac
    inc
    ld   ac, [W3]
mu_hi:
    ld   [W3], ac
    add  [W1], ac
    ld   ac, [W3]
mu_sh:
    ld   [W0], ac               ; a << 1
    shl
    ld   ac, [W0]
    ld   [W1], ac
    bcc  mu_a0
    shl
    or   1, ac
    bra  mu_a1
mu_a0:
    shl
mu_a1:
    ld   ac, [W1]
    ld   [TL], ac               ; b >> 1
    shr  ac
    ld   ac, [TL]
    ld   [TH], ac
    and  1, ac
    beq  mu_b0
    ld   [TL], ac
    or   0x80, ac
    ld   ac, [TL]
mu_b0:
    ld   [TH], ac
    shr  ac
    ld   ac, [TH]
    or   [TL], ac
    bne  mu_lp
    ld   [W2], ac
    ld   ac, [TL]
    ld   [W3], ac
    ld   ac, [TH]
    NIP2
    NEXT

.chunk  U/MOD ( a b -- a mod b  a/b ), unsigned
p_umod:
    ld   [DSP], x               ; W1:W0 = a (becomes the quotient)
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    clr  ac                     ; W3:W2 = the remainder
    ld   ac, [W2]
    ld   ac, [W3]
    ld   16, ac
    ld   ac, [W4]
um_lp:
    ld   [W0], ac               ; W3:W2:W1:W0 << 1
    shl
    ld   ac, [W0]
    ld   [W1], ac
    bcc  um_1
    shl
    or   1, ac
    bra  um_2
um_1:
    shl
um_2:
    ld   ac, [W1]
    ld   [W2], ac
    bcc  um_3
    shl
    or   1, ac
    bra  um_4
um_3:
    shl
um_4:
    ld   ac, [W2]
    ld   [W3], ac
    bcc  um_5
    shl
    or   1, ac
    ld   ac, [W3]
    bra  um_sub                 ; bit 16 set: the remainder is more than b
um_5:
    shl
    ld   ac, [W3]
    sub  [TH], ac               ; remainder >= b?
    bcs  um_next
    bne  um_sub
    ld   [W2], ac
    sub  [TL], ac
    bcs  um_next
um_sub:
    ld   [W2], ac               ; remainder - b, quotient bit 1
    sub  [TL], ac
    ld   ac, [W2]
    ld   [W3], ac
    bcc  um_6
    dec
um_6:
    sub  [TH], ac
    ld   ac, [W3]
    ld   [W0], ac
    or   1, ac
    ld   ac, [W0]
um_next:
    ld   [W4], ac
    dec
    ld   ac, [W4]
    bne  um_lp
    ld   [DSP], x               ; below: the remainder, TOS: the quotient
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [W3], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TL]
    ld   [W1], ac
    ld   ac, [TH]
    NEXT

.chunk  CMOVE ( from to n -- ): first byte first
p_cmove:
    ld   [DSP], x               ; W1:W0 = to, W3:W2 = from, TOS = n
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [W3]
cm_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  cm_done
    ld   [W3], y
    ld   [W2], x
    ld   [y,x], ac
    ld   [W1], y
    ld   [W0], x
    ld   ac, [y,x]
    ld   [W2], ac
    inc
    ld   ac, [W2]
    bne  cm_1
    ld   [W3], ac
    inc
    ld   ac, [W3]
cm_1:
    ld   [W0], ac
    inc
    ld   ac, [W0]
    bne  cm_2
    ld   [W1], ac
    inc
    ld   ac, [W1]
cm_2:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  cm_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  cm_lp
cm_done:
    NIP2
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  CMOVE> ( from to n -- ): last byte first
p_cmoveu:
    ld   [DSP], x               ; W1:W0 = to + n, W3:W2 = from + n
    ld   [x], ac
    add  [TL], ac
    ld   ac, [W0]
    ld   [TH], ac
    bcc  cu_1
    inc
cu_1:
    ld   ac, [W1]
    ld   [DSP], ac
    add  1, x
    ld   [W1], ac
    add  [x], ac
    ld   ac, [W1]
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    add  [TL], ac
    ld   ac, [W2]
    ld   [TH], ac
    bcc  cu_2
    inc
cu_2:
    ld   ac, [W3]
    ld   [DSP], ac
    add  3, x
    ld   [W3], ac
    add  [x], ac
    ld   ac, [W3]
cu_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  cu_done
    ld   [W2], ac               ; from - 1
    sub  1, ac
    ld   ac, [W2]
    bcc  cu_3
    ld   [W3], ac
    dec
    ld   ac, [W3]
cu_3:
    ld   [W0], ac               ; to - 1
    sub  1, ac
    ld   ac, [W0]
    bcc  cu_4
    ld   [W1], ac
    dec
    ld   ac, [W1]
cu_4:
    ld   [W3], y
    ld   [W2], x
    ld   [y,x], ac
    ld   [W1], y
    ld   [W0], x
    ld   ac, [y,x]
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  cu_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  cu_lp
cu_done:
    NIP2
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  FILL ( a n c -- )
p_fill:
    ld   [TL], ac               ; W4 = c, TOS = n, W1:W0 = a
    ld   ac, [W4]
    POPT
    ld   [DSP], x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
fi_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  fi_done
    ld   [W1], y
    ld   [W0], x
    ld   [W4], ac
    ld   ac, [y,x]
    ld   [W0], ac
    inc
    ld   ac, [W0]
    bne  fi_1
    ld   [W1], ac
    inc
    ld   ac, [W1]
fi_1:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  fi_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  fi_lp
fi_done:
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  SYS ( ac a -- ac ): CALL the native routine at a with AC; R0-R7 as set
p_sys:
    ld   [TL], ac
    ld   ac, [W0]
    ld   [TH], ac
    ld   ac, [W1]
    POPT
    ld   LINK_LO, x
    ld   sy_back, [x]
    ld   LINK_HI, x
    ld   sy_back >> 8, [x]
    ld   [TL], ac
    ld   [W1], y
    jmp  [W0]
sy_back:
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    NEXT

.chunk  CH ( -- c ): the character at TP, spaces skipped; NUM ( -- n ): digits at TP
p_ch:
    PUSHT
    clr  ac
    ld   ac, [TH]
ch_lp:
    ld   [TP + 1], y
    ld   [TP], x
    ld   [y,x], ac
    ld   ac, [TL]
    xor  0x20, ac
    bne  ch_done
    ld   [TP], ac
    inc
    ld   ac, [TP]
    bne  ch_lp
    ld   [TP + 1], ac
    inc
    ld   ac, [TP + 1]
    bra  ch_lp
ch_done:
    NEXT
p_num:
    PUSHT
    clr  ac
    ld   ac, [TL]
    ld   ac, [TH]
nm_lp:
    ld   [TP + 1], y
    ld   [TP], x
    ld   [y,x], ac
    sub  0x30, ac
    ld   ac, [W0]
    sub  10, ac
    bcc  ch_done                ; not a digit
    ld   [TL], ac               ; W2:W1 = n * 2
    shl
    ld   ac, [W1]
    ld   [TH], ac
    bcc  nm_1
    shl
    or   1, ac
    bra  nm_2
nm_1:
    shl
nm_2:
    ld   ac, [W2]
    ld   [W1], ac               ; n * 8
    shl
    ld   ac, [TL]
    ld   [W2], ac
    bcc  nm_3
    shl
    or   1, ac
    bra  nm_4
nm_3:
    shl
nm_4:
    ld   ac, [TH]
    ld   [TL], ac
    shl
    ld   ac, [TL]
    ld   [TH], ac
    bcc  nm_5
    shl
    or   1, ac
    bra  nm_6
nm_5:
    shl
nm_6:
    ld   ac, [TH]
    ld   [TL], ac               ; n * 8 + n * 2
    add  [W1], ac
    ld   ac, [TL]
    bcc  nm_7
    ld   [TH], ac
    inc
    ld   ac, [TH]
nm_7:
    ld   [TH], ac
    add  [W2], ac
    ld   ac, [TH]
    ld   [TL], ac               ; + the digit
    add  [W0], ac
    ld   ac, [TL]
    bcc  nm_8
    ld   [TH], ac
    inc
    ld   ac, [TH]
nm_8:
    ld   [TP], ac
    inc
    ld   ac, [TP]
    bne  nm_lp
    ld   [TP + 1], ac
    inc
    ld   ac, [TP + 1]
    bra  nm_lp

.chunk  POLL ( -- f ): once a frame the sound, the keyboard; f = Esc or Ctrl+C is down
p_poll:
    PUSHT
    CALL frame_poll
    ld   [FRAME_LO], ac
    xor  [LASTFR], ac
    beq  po_esc
    ld   [FRAME_LO], ac
    ld   ac, [LASTFR]
    CALL snd_update
    CALL kbd_scan
po_esc:
    clr  ac
    ld   ac, [TH]
    ld   [KBD_NOW + 5], ac      ; C is key 44: column 5, bit 4 = 0 while down
    and  0x10, ac
    bne  po_e
    ld   [KBD_NOW + 3], ac      ; with the left Ctrl (key 28)
    and  0x10, ac
    beq  po_brk
    ld   [KBD_NOW + 7], ac      ; or the right Ctrl (key 59)
    and  0x08, ac
    bne  po_e
po_brk:
    ld   1, ac
    ld   ac, [TL]
    NEXT
po_e:
    ld   [KBD_NOW], ac          ; Esc is key 0: bit 0 = 0 while down
    and  1, ac
    xor  1, ac
    ld   ac, [TL]
    NEXT

; ============================================================
; the screen
; ============================================================
; Text row R's glyph row k is at x6000 + column * 512 + offset + k * step:
;   80 x 60 (1x rows):  offset 32 + 8R, step 1
;   80 x 30 (2x rows):  offset x120 + 16R (R < 14), x101 + 16(R - 14), step 2
; (screen line y's byte, v = y + 32: 1x at v, 2x at x100 | v7:v1 | v8)
.chunk  GLYPH ( c -- ): draw c at CUR_COL, CUR_ROW;  ROWCPY ( from to -- ): copy a text row
p_glyph:
    clr  ac
    ld   ac, [W7]               ; rowbase returns to gl_row
    ld   [CUR_ROW], ac
    bra  rowbase
gl_row:
    ld   [CUR_COL], ac          ; W1 = x60 + 2 * column + the offset's bit 8
    shl
    add  [W1], ac
    ld   ac, [W1]
    ld   LIB_FONT >> 8, ac
    ld   ac, [W3]
gl_lp:
    ld   [TL], x
    ld   [W3], y
    ld   [y,x], ac
    ld   [W1], y
    ld   [W0], x
    ld   ac, [y,x]
    ld   [W0], ac
    add  [W2], ac
    ld   ac, [W0]
    ld   [W3], ac
    inc
    ld   ac, [W3]
    xor  (LIB_FONT >> 8) + 8, ac
    bne  gl_lp
    ld   p_drop >> 8, y
    jmp  p_drop
rowbase:                        ; AC = row: W0 = offset low, W1 = x60 + bit 8, W2 = step
    ld   ac, [W5]
    ld   [TXT2X], ac
    bne  rb_2x
    ld   1, ac
    ld   ac, [W2]
    ld   0x60, ac
    ld   ac, [W1]
    ld   [W5], ac
    sub  28, ac                 ; rows 28-59: the column's second page, 8 * (R - 28)
    blt  rb_1lo
    shl
    shl
    shl
    ld   ac, [W0]
    ld   0x61, ac
    ld   ac, [W1]
    bra  rb_done
rb_1lo:
    add  28 + 4, ac             ; rows 0-27: 8 * R + 32
    shl
    shl
    shl
    ld   ac, [W0]
    bra  rb_done
rb_2x:
    ld   2, ac
    ld   ac, [W2]
    ld   0x61, ac
    ld   ac, [W1]
    ld   [W5], ac
    sub  14, ac
    blt  rb_top
    shl
    shl
    shl
    shl
    or   1, ac
    ld   ac, [W0]
    bra  rb_done
rb_top:
    ld   [W5], ac
    shl
    shl
    shl
    shl
    add  0x20, ac
    ld   ac, [W0]
rb_done:
    ld   [W7], ac
    beq  gl_row
    sub  1, ac
    beq  rc_from
    bra  rc_to
p_rowcpy:
    ld   1, ac
    ld   ac, [W7]
    ld   [DSP], x               ; the source row
    ld   [x], ac
    bra  rowbase
rc_from:                        ; T0-T7 = the source offsets, SPG
    ld   [W1], ac
    ld   ac, [SPG]
    ld   T0, ac
    ld   ac, [W6]
rc_f1:
    ld   [W6], x
    ld   [W0], ac
    ld   ac, [x]
    add  [W2], ac
    ld   ac, [W0]
    ld   [W6], ac
    inc
    ld   ac, [W6]
    xor  T0 + 8, ac
    bne  rc_f1
    ld   2, ac
    ld   ac, [W7]
    ld   [TL], ac               ; the destination row
    bra  rowbase
rc_to:                          ; R0-R7 = the destination offsets, DPG
    ld   [W1], ac
    ld   ac, [DPG]
    ld   R0, ac
    ld   ac, [W6]
vrc_t1:
    ld   [W6], x
    ld   [W0], ac
    ld   ac, [x]
    add  [W2], ac
    ld   ac, [W0]
    ld   [W6], ac
    inc
    ld   ac, [W6]
    xor  R0 + 8, ac
    bne  vrc_t1
    ld   80, ac
    ld   ac, [W4]
    ld   B_RAM, y
    jmp  rc_ram & 0xFF
rc_back:
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  VPLOT ( col line mask bits -- ): the byte at column col of screen line line = (byte & ~mask) | bits
p_vplot:
    ld   [TL], ac               ; W3 = bits
    ld   ac, [W3]
    POPT
    ld   [TL], ac               ; W4 = ~mask
    not
    ld   ac, [W4]
    POPT
    ld   [TL], ac               ; R3:R2 = line
    ld   ac, [R2]
    ld   [TH], ac
    ld   ac, [R3]
    POPT
    ld   [TL], ac               ; AC = column
    CALL vid_addr               ; AC = the byte's page, X = its low byte (kept to the end)
    ld   ac, [W6]
    ld   B_RAM, y
    jmp  vr_ram & 0xFF
vr_back:                        ; AC = the byte
    and  [W4], ac
    or   [W3], ac
    ld   [W6], y
    ld   ac, [y,x]
    ld   p_drop >> 8, y
    jmp  p_drop

; ------------------------------------------------------------
; the RAM routines: copied to x5C00 + their offset (basic:), they map
; the video RAM in to read it.  Only branches inside the page, and jumps
; to fixed addresses.
; ------------------------------------------------------------
.chunk  rc_ram (in RAM): the 80 columns of a text row from SPG/T0-T7 to DPG/R0-R7; vr_ram: read a video byte
rc_ram:
    ld   0x50, y
    ld   0xFF, [y,x]            ; map FF: every section RAM
rcr_col:
    ld   [SPG], y
    ld   [T0], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R0], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T1], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R1], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T2], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R2], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T3], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R3], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T4], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R4], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T5], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R5], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T6], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R6], x
    ld   ac, [y,x]
    ld   [SPG], y
    ld   [T7], x
    ld   [y,x], ac
    ld   [DPG], y
    ld   [R7], x
    ld   ac, [y,x]
    ld   [SPG], ac
    add  2, ac
    ld   ac, [SPG]
    ld   [DPG], ac
    add  2, ac
    ld   ac, [DPG]
    ld   [W4], ac
    dec
    ld   ac, [W4]
    bne  rcr_col
    ld   0x50, y
    ld   MAP_RUN, [y,x]
    ld   rc_back >> 8, y
    jmp  rc_back
vr_ram:                         ; W6 = the page, X = the low byte (the map write keeps X)
    ld   0x50, y
    ld   0xFF, [y,x]
    ld   [W6], y
    ld   [y,x], ac
    ld   0x50, y
    ld   MAP_RUN, [y,x]
    ld   vr_back >> 8, y
    jmp  vr_back
rc_end:

; ============================================================
; the bytecode
; ============================================================
.include "basic.vm"
