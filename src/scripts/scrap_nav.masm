; ============================================================
; scrap_nav.masm - SCRAPWRIGHT's navigation screen: SCRAP.NAV, SCRAP.NV2
; ============================================================
;
; Included at the end of scrap.masm as #overlay2: the region x4100-x4CFF
; (gen_plc.py --swap 0x4100,0x4D00,NAV,2: SCRAP.NAV, over SCRAP.INV's
; place, rooms_build's work space: a rebuild waits) and what does not fit
; in x3600-x3FFF (--swap 0x3600,0x4000,NV2,2: SCRAP.NV2, over the
; actions table and the cell art, which SCRAP.ART puts back when the
; screen closes).  nav_action
; reads them in when NAVIGATE is picked at the helm; nav_main reads the
; last of it, SCRAP.NV3, into the file system's buffer (x4E00-x4FFF; --swap
; 0x4E00,0x5000,NV3,2) after the sector file, its last card read.  The flight itself is
; resident (scrap_fl.masm): it goes on when you leave this screen.
;
; Row 0 is a 1 bpp status row (nv_stat): the ship's date and time, the
; nitrogen (kg), its delta-v, the batteries.  Under it the view is 2 bpp
; while the screen is up (view_mode): the sector map, 256 x 184 square
; pixels in byte columns 8-71 (a position a byte), the tug in the middle:
; a dotted blue grid fixed in space (nv_gmv); the tug a small white triangle at
; its heading, gold dots the way it drifts; the sector's objects
; (SCRAP/K3A, read to x5400 with prt_load: gen_scrap.SECTOR): a station
; on an asteroid as a white circle its size, a derelict as a gold
; asterisk until you have visited it (FL_VIS), then a diamond; the
; selected one in gold corners.  + and - zoom in doubling steps: 4 to
; 512 m a pixel (1 to 128 km across, near enough: 1.024 km << the zoom).
;
; The panel is a control panel: boxed blocks with inverse titles, FLIGHT
; (heading, docked: no speed, which means something only against the
; target), PROPULSION (nitrogen, mass, thrusters) and TARGET (the
; selected object: name, kind, registry, range, radar return, visited,
; the tug's speed toward it and across), then the keys as inverse caps.
;
; Keys: Left / Right (A, D) spin the tug up (1/256 of a heading step a
; frame more, to NAV_SPIN; it keeps spinning: nv_spt), R stops the spin,
; Up / Down (W, S) thrust forward and back while held, Q / E sideways
; (left, right of the heading, at the back thrust), + - zoom, a click
; on an object or Tab picks the target, C the docking and comms screen
; (SCRAP.DCK, scrap_dck.masm: hailing, docking, undocking), Esc back to
; the ship.
;
; Date: 11/08/2026
; ============================================================

NV_T    = 0xB0              ; FL_PG: frames, 0-15 (the map every 8, the panel every 16)
NV_TW   = 0xB1              ;   (free)
NV_N    = 0xB2              ;   points drawn (nv_put)
NV_ZS   = 0xB3              ;   the map's shift: metres >> NV_ZS = pixels
NV_DL   = 0xB4              ;   an object from the tug: dx, dy (metres, 2 bytes each)
NV_GX   = 0xB8              ;   the grid's offsets (nv_gmv): its lines where x + GX,
NV_GY   = 0xB9              ;   y + GY are 0 mod 64 (FF: none drawn yet)
FL_SPN  = 0xBA              ; the spin: 1/256 heading steps a frame (signed), kept
FL_HF   = 0xBB              ;   the heading's 1/256 steps
FL_SFL  = 0xBC              ;   the frame counter when the spin was last worked out
FL_SFH  = 0xBD              ;   (nv_spt: the spin goes on off this screen too)
FL_STP  = 0xBE              ;   1: R, the spin brought down to 0 (1 a frame)
NV_Q    = 0xC0              ;   the status row's numbers (nv_stat): month, day, hour,
NV_QMO  = 0xC0              ;     minute, second (a byte each), then the nitrogen
NV_QD   = 0xC1              ;     (kg), the delta-v (m/s) and the batteries
NV_QH   = 0xC2              ;     (2 bytes each)
NV_QMI  = 0xC3
NV_QS   = 0xC4
NV_QL   = 0xC5
NV_QDV  = 0xC7
NV_QB   = 0xC9
NV_SEL  = 0x80              ; FL_PG + x80 up (rooms_build's, free while this is up):
                            ;   the selected object
NV_ANG  = 0x81              ;   nv_cm's angle (0-31)
NV_I    = 0x82              ;   the object being drawn
NV_AX   = 0x8A              ;   nv_atan's x, y (2 bytes each, x8A-x8D)
NV_AY   = 0x8C
NV_RS   = 0x8E              ;   nv_dot's sum (2 bytes)
NV_OX   = 0x90              ;   each object's pixel: x (x90-x97), y (x98-x9F); FF off
NV_OY   = 0x98
NV_E    = 0xA0              ;   an object's 10 bytes (nv_ent):
E_X     = 0xA0              ;     x, y (metres), its size (radius / half width)
E_Y     = 0xA2
E_R     = 0xA4
E_SH    = 0xA6              ;     0 a station (a circle), 1 a derelict
E_NM    = 0xA7              ;     its strings in page x55: name, registry, kind
E_RF    = 0xA8              ;     its radar factor (size x 100 / 16)
NV_S1   = 0xAA              ;   the strings: registry, kind (low bytes)
NV_S2   = 0xAB
NV_RG   = 0xAC              ;   the target's range, metres (2 bytes)
                            ; the points drawn, to rub out (255 at most): x, y in
                            ;   the screen bytes no line shows (offsets 0-30 even
                            ;   of pages x61-x7F, x81-x9F; nv_put)
SEC     = 0x5400            ; the sector file: the count, the objects from x5410
SEC_STR = 0x55              ;   (SEC_REC bytes each), their strings in page x55

; nav_main - the screen until Esc (or you die); FL_NAV while it is up
.chunk
nav_main:
    PUSH_LINK
    ld   SEC_K, ac              ; the sector's objects into x5400
    CALL prt_load
    ld   s_nv3f & 0xFF, ac      ; then SCRAP.NV3 into the file system's
    ld   ac, [R0]               ; buffer (no card reads after it while the
    ld   s_nv3f >> 8, ac        ; screen is up)
    ld   ac, [R1]
    ld   NAV3_LO >> 8, ac
    ld   ac, [u5]
    ld   1, ac
    ld   ac, [u6]
    CALL swap_fetch
    ld   0x4D, y                ; (no FAT sector in the buffer now: FS_VARS
    ld   0x2F, x                ; V_FATC + 3)
    ld   0xFF, [y,x]
    ld   FL_PG, y
    ld   FL_NAV, x
    ld   1, [y,x]
    ld   NV_N, x
    ld   0x00, [y,x]
    ld   NV_SEL, x
    ld   0x00, [y,x]
    ld   NV_GX, x
    ld   0xFF, [y,x]
    ld   FL_GO, x
    ld   0x00, [y,x]
    ld   32, ac                 ; the view black: even offsets 32 up,
    CALL clear_rows             ; then the odd ones (the panel too: drawn next)
    ld   1, ac
    CALL clear_rows
    CALL nv_spt                 ; the spin while the map was away
    CALL nv_modes
    CALL nv_draw
    CALL nv_panel
    GOTO nv_loop
s_nv3f:                         ; (in nav_main's chunk: not in SCRAP.NV3)
    #d "SCRAP.NV3", 0x00

; nv_loop - a frame of the screen.  The rest of nav_main
.chunk
nv_loop:
nm_l:
    CALL pt_show
    ld   1, ac
    CALL l_wait_frames_io
    CALL l_kbd_scan
    CALL input_mouse            ; (FL_NAV: a left click is nv_pick)
    ld   [KBD_NOW], ac          ; Esc (key 0; 0 = down)
    and  1, ac
    beq  nm_x
    ld   [dead], ac
    bne  nm_x
    CALL nv_keys
    CALL nv_spt
    ld   FL_PG, y               ; C: FL_GO 2, the docking screen next
    ld   FL_GO, x
    ld   [y,x], ac
    bne  nm_x
    CALL game_tick
    ld   [dirty], ac            ; the message's time and row (update_panel,
    and  0xFE, ac               ; not the ship's panel)
    ld   ac, [dirty]
    CALL update_panel
    ld   FL_PG, y
    ld   NV_T, x
    ld   [y,x], ac
    inc
    and  15, ac
    ld   ac, [y,x]
    xor  4, ac                  ; frame 4: the status row (on its own:
    bne  nm_8                   ; a frame is not enough for it and more)
    CALL nv_stat
    bra  nm_l
nm_8:
    ld   [y,x], ac
    and  7, ac
    bne  nm_l
    CALL nv_draw
    ld   FL_PG, y
    ld   NV_T, x
    ld   [y,x], ac
    bne  nm_l
    CALL nv_panel
    bra  nm_l
nm_x:
    CALL pt_hide
    GOTO nv_exit

; nv_pick - a left click (input_mouse's while FL_NAV): the object nearest
; the pointer (within 6 art pixels across, 12 down) is the target
.chunk
nv_pick:
    PUSH_LINK
    CALL in_view
    beq  pk_e
    CALL pt_xy                  ; u1 m_y / 2 (less 8: the map's y), u2
    ld   [u1], ac               ; m_x / 4: u0 the x (m_x / 2 - 32, to 2
    sub  8, ac                  ; pixels)
    bcs  pk_e
    ld   ac, [u1]
    ld   [u2], ac
    sub  16, ac
    bcs  pk_e
    shl
    bcs  pk_e
    ld   ac, [u0]
    ld   7, ac                  ; u3 the best distance so far, u4 its object
    ld   ac, [u3]
    ld   0xFF, ac
    ld   ac, [u4]
    clr  ac
    ld   ac, [u2]
npk_l:
    CALL nv_cnt
    xor  [u2], ac
    beq  pk_d
    ld   FL_PG, y
    ld   [u2], ac
    add  NV_OX, x
    ld   [y,x], ac
    sub  [u0], ac               ; |the difference| (a borrow: negative)
    bcc  pk_4
    xor  0xFF, ac
    inc
pk_4:
    ld   ac, [u5]
    ld   [u2], ac
    add  NV_OY, x
    ld   [y,x], ac
    sub  [u1], ac
    bcc  pk_5
    xor  0xFF, ac
    inc
pk_5:
    sub  [u5], ac               ; the larger
    bcc  pk_2
    ld   [u5], ac
    bra  pk_3
pk_2:
    add  [u5], ac
pk_3:
    sub  [u3], ac
    bcc  pk_n
    add  [u3], ac
    ld   ac, [u3]
    ld   [u2], ac
    ld   ac, [u4]
pk_n:
    ld   [u2], ac
    inc
    ld   ac, [u2]
    bra  npk_l
pk_d:
    ld   [u4], ac
    xor  0xFF, ac
    beq  pk_e
    ld   [u4], ac
    GOTO nv_seln
pk_e:
    LEAVE

; nv_thr - this frame's thrust (FL_TH: the offset of its vector): Up
; forward, Down back, Q (key 15) or E (17) sideways (fl_dv's).  A leaf.
.chunk
nv_thr:
    ld   FL_PG, y
    ld   FL_TH, x
    ld   [dirs], ac
    and  1, ac
    beq  th_b
    ld   FL_DVX, [y,x]
    RET
th_b:
    ld   [dirs], ac
    and  2, ac
    beq  th_q
    ld   FL_RVX, [y,x]
    RET
th_q:
    ld   [KBD_NOW + 1], ac      ; Q
    and  0x80, ac
    bne  th_e
    ld   FL_LVX, [y,x]
    RET
th_e:
    ld   [KBD_NOW + 2], ac      ; E
    and  0x02, ac
    bne  th_n
    ld   FL_SVX, [y,x]
    RET
th_n:
    ld   0x00, [y,x]
    RET

; nv_cnt - AC = the sector's objects.  A leaf.
.chunk
nv_cnt:
    ld   SEC >> 8, y
    ld   0x00, x
    ld   [y,x], ac
    RET

; nv_seln - AC: the new target; the map and the panel again.  The rest
; of nv_pick, nv_keys
.chunk
nv_seln:
    ld   FL_PG, y
    ld   NV_SEL, x
    ld   ac, [y,x]
    CALL nv_draw
    CALL nv_panel
    LEAVE

; nv_keys - thrust while Up / Down is held, the spin up while Left /
; Right is (neither while docked), + - Tab C R
.chunk
nv_keys:
    PUSH_LINK
    CALL l_pad_read
    CALL read_dirs
    ld   FL_PG, y               ; docked: no thrust, no turning
    ld   FL_DOCK, x
    ld   [y,x], ac
    bne  nk_k
    CALL nv_thr
    ld   FL_PG, y
    ld   [dirs], ac
    and  12, ac
    beq  nk_k
    ld   FL_STP, x              ; Left / Right: the spin up (not past
    ld   0x00, [y,x]            ; NAV_SPIN either way)
    ld   FL_SPN, x
    ld   [dirs], ac
    and  4, ac
    beq  nk_r
    ld   [y,x], ac
    xor  (0 - NAV_SPIN) & 0xFF, ac
    beq  nk_k
    ld   [y,x], ac
    dec
    bra  nk_h
nk_r:
    ld   [y,x], ac
    xor  NAV_SPIN, ac
    beq  nk_k
    ld   [y,x], ac
    inc
nk_h:
    ld   ac, [y,x]
nk_k:
    CALL l_kbd_getc
    beq  nk_e
    or   0x20, ac
    ld   ac, [key]
    xor  0x2D, ac               ; -: out
    bne  nk_p
    ld   FL_PG, y
    ld   FL_ZM, x
    ld   [y,x], ac
    xor  7, ac
    beq  nk_e
    ld   [y,x], ac
    inc
    bra  nk_z
nk_p:
    xor  0x2D ^ 0x2B, ac        ; +
    beq  nk_in
    xor  0x2B ^ 0x3D, ac        ; = (+ without shift)
    bne  nk_o
nk_in:
    ld   FL_PG, y
    ld   FL_ZM, x
    ld   [y,x], ac
    beq  nk_e
    dec
nk_z:
    ld   ac, [y,x]
    CALL nv_draw
    CALL nv_panel
    LEAVE
nk_o:
    GOTO nv_keys2
nk_e:
    LEAVE

; nv_keys2 - Tab, C.  The rest of nv_keys
.chunk
nv_keys2:
    ld   [key], ac
    xor  0x29, ac               ; Tab (09, or 20): the next target
    bne  nk2_c
    ld   FL_PG, y
    ld   NV_SEL, x
    ld   [y,x], ac
    inc
    ld   ac, [u0]
    CALL nv_cnt
    xor  [u0], ac
    beq  nk2_0
    ld   [u0], ac
nk2_0:
    GOTO nv_seln
nk2_c:
    xor  0x29 ^ 0x63, ac        ; c: the docking and comms screen (SCRAP.DCK:
    bne  nk2_r                  ; nav_action reads it in when this closes)
    ld   FL_PG, y
    ld   FL_GO, x
    ld   2, [y,x]
    LEAVE
nk2_r:
    xor  0x63 ^ 0x72, ac        ; r: the spin stopped
    bne  nk2_e
    ld   FL_PG, y
    ld   FL_STP, x
    ld   1, [y,x]
nk2_e:
    LEAVE

; nv_spt - the spin worked out to now: nv_spin for each frame since
; FL_SFL, FL_SFH (mod 8192: the heading comes round in that many at any
; spin), then fl_dv when the heading changed
.chunk
nv_spt:
    PUSH_LINK
    ld   FL_PG, y
    ld   FL_SFL, x
    ld   [FRAME_LO], ac
    sub  [y,x], ac
    ld   ac, [v0]
    ld   [FRAME_LO], ac
    ld   ac, [y,x]
    ld   FL_SFH, x
    ld   [FRAME_HI], ac
    bcc  st_nb
    dec
st_nb:
    sub  [y,x], ac
    and  0x1F, ac
    ld   ac, [v1]
    ld   [FRAME_HI], ac
    ld   ac, [y,x]
    ld   FL_SPN, x              ; not spinning: nothing to work out
    ld   [y,x], ac
    beq  st_e
    clr  ac
    ld   ac, [v2]
st_l:
    ld   [v0], ac
    or   [v1], ac
    beq  st_d
    CALL nv_spin
    or   [v2], ac
    ld   ac, [v2]
    ld   [v0], ac
    bne  spt_1
    ld   [v1], ac
    dec
    ld   ac, [v1]
spt_1:
    ld   [v0], ac
    dec
    ld   ac, [v0]
    bra  st_l
st_d:
    ld   [v2], ac
    beq  st_e
    CALL fl_dv
st_e:
    LEAVE

; nv_spin - a frame of spin: R's stop (the spin 1 nearer 0), then the
; heading's fraction + the spin, a step on when it carries (AC 1, else
; 0).  A leaf (u0).
.chunk
nv_spin:
    ld   FL_PG, y
    ld   FL_SPN, x
    ld   [y,x], ac
    ld   ac, [u0]
    ld   FL_STP, x
    ld   [y,x], ac
    beq  sp_m
    ld   [u0], ac
    beq  sp_0
    blt  sp_up
    dec
    bra  sp_w
sp_up:
    inc
sp_w:
    ld   ac, [u0]
    ld   FL_SPN, x
    ld   ac, [y,x]
    bra  sp_m
sp_0:
    ld   0x00, [y,x]            ; stopped
sp_m:
    ld   FL_HF, x
    ld   [y,x], ac
    add  [u0], ac
    ld   ac, [y,x]
    ld   FL_HD, x
    ld   [u0], ac
    blt  spn_n
    bcc  sp_no                  ; spinning right: a carry, a step on
    ld   [y,x], ac
    inc
    bra  sp_h
spn_n:
    bcs  sp_no                  ; left: no carry, a step back
    ld   [y,x], ac
    dec
sp_h:
    and  31, ac
    ld   ac, [y,x]
    ld   1, ac
    RET
sp_no:
    clr  ac
    RET


; nv_put - map pixel u0, u1 in color u2 (off the view: nothing), kept in
; the hidden screen bytes (255 at most) to rub out.  A leaf (nv_plot's).
.chunk
nv_put:
    ld   [u0], ac
    xor  0xFF, ac
    beq  np_e
    ld   [u1], ac
    sub  184, ac
    bcc  np_e
    ld   FL_PG, y
    ld   NV_N, x
    ld   [y,x], ac
    ld   ac, [u3]
    xor  255, ac
    beq  np_e
    ld   [u3], ac
    inc
    ld   ac, [y,x]
    ld   [u3], ac               ; point i: offset (i << 1) & x1E,
    shl                         ; page x61 + (i >> 3) & x1E (x), + x20 (y)
    and  0x1E, ac
    ld   ac, x
    ld   [u3], ac
    shr  ac
    shr  ac
    shr  ac
    and  0x1E, ac
    add  0x61, ac
    ld   ac, y
    ld   [u0], ac
    ld   ac, [y,x]
    ld   [u3], ac
    shr  ac
    shr  ac
    shr  ac
    and  0x1E, ac
    add  0x81, ac
    ld   ac, y
    ld   [u1], ac
    ld   ac, [y,x]
    GOTO nv_plot
np_e:
    RET

; nv_rub - the points drawn put back to the grid (or black)
.chunk
nv_rub:
    PUSH_LINK
nr_l:
    ld   FL_PG, y
    ld   NV_N, x
    ld   [y,x], ac
    beq  nr_e
    dec
    ld   ac, [y,x]
    ld   ac, [u3]               ; (nv_put's place for point u3)
    shl
    and  0x1E, ac
    ld   ac, x
    ld   [u3], ac
    shr  ac
    shr  ac
    shr  ac
    and  0x1E, ac
    add  0x61, ac
    ld   ac, y
    ld   [y,x], ac
    ld   ac, [u0]
    ld   [u3], ac
    shr  ac
    shr  ac
    shr  ac
    and  0x1E, ac
    add  0x81, ac
    ld   ac, y
    ld   [y,x], ac
    ld   ac, [u1]
    CALL nv_bg
    ld   ac, [u2]
    CALL nv_plot
    bra  nr_l
nr_e:
    LEAVE

; nv_bg - AC = the grid's color at u0, u1 (1, blue), or 0: dotted lines
; where u0 + NV_GX is 0 mod 64 (a dot where u1 + NV_GY is 0 mod 4) and
; where u1 + NV_GY is 0 mod 64 (a dot every 4 across).  A leaf.
.chunk
nv_bg:
    ld   FL_PG, y
    ld   NV_GX, x
    ld   [u0], ac
    add  [y,x], ac
    ld   ac, [u3]
    ld   NV_GY, x
    ld   [u1], ac
    add  [y,x], ac
    ld   ac, [u4]
    ld   [u3], ac
    and  63, ac
    bne  bg_h
    ld   [u4], ac
    and  3, ac
    beq  bg_g
bg_h:
    ld   [u4], ac
    and  63, ac
    bne  bg_0
    ld   [u3], ac
    and  3, ac
    beq  bg_g
bg_0:
    clr  ac
    RET
bg_g:
    ld   1, ac
    RET

; nv_gl - the grid's dots in color AC (0: off) at NV_GX, NV_GY (nv_bg's)
.chunk
nv_gl:
    PUSH_LINK
    ld   ac, [u2]
    ld   FL_PG, y
    ld   NV_GX, x
    clr  ac
    sub  [y,x], ac
    ld   ac, [v2]               ; v2 = -GX, v3 = -GY
    ld   NV_GY, x
    clr  ac
    sub  [y,x], ac
    ld   ac, [v3]
    ld   [v2], ac               ; down: x = -GX mod 64, + 64 k
    and  63, ac
    ld   ac, [v0]
gv_x:
    ld   [v3], ac
    and  3, ac
    ld   ac, [v1]
gv_y:
    CALL nv_gp
    ld   [v1], ac
    add  4, ac
    ld   ac, [v1]
    sub  184, ac
    bcs  gv_y
    ld   [v0], ac
    add  64, ac
    ld   ac, [v0]
    bcc  gv_x
    ld   [v3], ac               ; across: y = -GY mod 64, + 64 k
    and  63, ac
    ld   ac, [v1]
gh_y:
    ld   [v2], ac
    and  3, ac
    ld   ac, [v0]
gh_x:
    CALL nv_gp
    ld   [v0], ac
    add  4, ac
    ld   ac, [v0]
    bcc  gh_x
    ld   [v1], ac
    add  64, ac
    ld   ac, [v1]
    sub  184, ac
    bcs  gh_y
    LEAVE

; nv_gp - nv_plot at v0, v1.  The rest of the caller's (nv_plot's RET)
.chunk
nv_gp:
    ld   [v0], ac
    ld   ac, [u0]
    ld   [v1], ac
    ld   ac, [u1]
    GOTO nv_plot

; nv_gmv - the grid's offsets from the tug's position (metres >> NV_ZS,
; mod 64; y + 36, so lines cross at the middle, 92): when they change, the
; old grid off and the new one on
.chunk
nv_gmv:
    PUSH_LINK
    ld   FL_PG, y
    ld   FL_PX + 2, x
    ld   [y,x], ac
    ld   ac, [w0]
    ld   FL_PX + 3, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   FL_PY + 2, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   FL_PY + 3, x
    ld   [y,x], ac
    ld   ac, [w3]
    ld   NV_ZS, x
    ld   [y,x], ac
    ld   ac, [v2]
gm_s:
    ld   [v2], ac
    beq  gm_d
    dec
    ld   ac, [v2]
    CALL nv_sh2
    bra  gm_s
gm_d:
    ld   [w0], ac
    and  63, ac
    ld   ac, [v4]
    ld   [w2], ac
    add  36, ac
    and  63, ac
    ld   ac, [v5]
    ld   FL_PG, y
    ld   NV_GX, x
    ld   [y,x], ac
    xor  [v4], ac
    bne  gm_m
    ld   NV_GY, x
    ld   [y,x], ac
    xor  [v5], ac
    beq  gm_e
gm_m:
    clr  ac
    CALL nv_gl
    ld   FL_PG, y
    ld   NV_GX, x
    ld   [v4], ac
    ld   ac, [y,x]
    ld   NV_GY, x
    ld   [v5], ac
    ld   ac, [y,x]
    ld   1, ac
    CALL nv_gl
gm_e:
    LEAVE

; nv_modes - the status row's lines (0-15) 1 bpp, the map's (16-383) 2 bpp
.chunk
nv_modes:
    PUSH_LINK
    ld   0x5A, y
    ld   0x2F, ac
nmd_l:
    ld   ac, x
    ld   0x04, [y,x]
    xor  0x20, ac
    beq  nmd_e
    xor  0x20, ac
    dec
    bra  nmd_l
nmd_e:
    ld   0x30, ac
    ld   ac, [u2]
    ld   0x05, ac
    GOTO view_mode

; nv_draw - the map: the points rubbed out, each object, then the tug
.chunk
nv_draw:
    PUSH_LINK
    CALL pt_hide
    CALL nv_rub
    ld   FL_PG, y               ; NV_ZS = 2 + zoom
    ld   FL_ZM, x
    ld   [y,x], ac
    add  2, ac
    ld   NV_ZS, x
    ld   ac, [y,x]
    CALL nv_gmv
    ld   FL_PG, y
    ld   NV_I, x
    ld   0x00, [y,x]
nd_l:
    CALL nv_cnt
    ld   ac, [u6]
    ld   FL_PG, y
    ld   NV_I, x
    ld   [y,x], ac
    xor  [u6], ac
    beq  nd_t
    CALL nv_obj
    ld   FL_PG, y
    ld   NV_I, x
    ld   [y,x], ac
    inc
    ld   ac, [y,x]
    bra  nd_l
nd_t:
    GOTO nv_tug

; nv_ent - AC = an object: its SEC_REC bytes to NV_E (FL_PG), NV_DL = it
; from the tug (metres).  A leaf.
.chunk
nv_ent:
    shl
    ld   ac, [u5]
    shl
    shl
    add  [u5], ac               ; 10 i
    add  0x10, ac
    ld   ac, [u5]
    clr  ac
    ld   ac, [u6]
ne_l:
    ld   SEC >> 8, y
    ld   [u5], ac
    add  [u6], ac
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [u7]
    ld   FL_PG, y
    ld   [u6], ac
    add  NV_E, x
    ld   [u7], ac
    ld   ac, [y,x]
    ld   [u6], ac
    inc
    ld   ac, [u6]
    xor  SEC_REC, ac
    bne  ne_l
    ld   E_X, x                 ; dx = its x - the tug's
    ld   [y,x], ac
    ld   FL_PX + 2, x
    sub  [y,x], ac
    ld   NV_DL, x
    ld   ac, [y,x]
    ld   E_X + 1, x
    ld   [y,x], ac
    bcc  ne_1
    dec
ne_1:
    ld   FL_PX + 3, x
    sub  [y,x], ac
    ld   NV_DL + 1, x
    ld   ac, [y,x]
    ld   E_Y, x                 ; dy
    ld   [y,x], ac
    ld   FL_PY + 2, x
    sub  [y,x], ac
    ld   NV_DL + 2, x
    ld   ac, [y,x]
    ld   E_Y + 1, x
    ld   [y,x], ac
    bcc  ne_2
    dec
ne_2:
    ld   FL_PY + 3, x
    sub  [y,x], ac
    ld   NV_DL + 3, x
    ld   ac, [y,x]
    RET

; nv_obj - object NV_I: its pixel (NV_OX, NV_OY: for the mouse), a
; circle (a station) or an asterisk (a derelict not visited) or a diamond,
; yellow corners when it is the target
.chunk
nv_obj:
    PUSH_LINK
    ld   FL_PG, y
    ld   NV_I, x
    ld   [y,x], ac
    CALL nv_ent
    clr  ac
    ld   ac, [u7]
    ld   NV_DL, ac
    CALL nv_px
    ld   ac, [v0]
    ld   NV_DL + 2, ac
    CALL nv_py
    ld   ac, [v1]
    ld   FL_PG, y
    ld   NV_I, x
    ld   [y,x], ac
    add  NV_OX, x
    ld   [v0], ac
    ld   ac, [y,x]
    ld   NV_I, x
    ld   [y,x], ac
    add  NV_OY, x
    ld   [v1], ac
    ld   ac, [y,x]
    ld   [v0], ac
    xor  0xFF, ac
    beq  no_e
    ld   [v1], ac
    xor  0xFF, ac
    beq  no_e
    ld   E_SH, x
    ld   [y,x], ac
    bne  no_d
    GOTO nv_circ
no_d:
    ld   NV_I, x                ; visited: a diamond
    ld   [y,x], ac
    CALL nv_bit
    ld   ac, [u6]
    ld   FL_PG, y
    ld   FL_VIS, x
    ld   [y,x], ac
    and  [u6], ac
    beq  no_a
    ld   SH_DIA & 0xFF, ac
    bra  no_s
no_a:
    ld   SH_AST & 0xFF, ac
no_s:
    ld   ac, [u6]
    ld   2, ac                  ; gold
    ld   ac, [u2]
    ld   [u6], ac
    CALL nv_shape
    GOTO nv_osel
no_e:
    LEAVE

; nv_osel - the target: yellow corners round it.  The end of nv_obj
.chunk
nv_osel:
    ld   FL_PG, y               ; the target: yellow corners
    ld   NV_I, x
    ld   [y,x], ac
    ld   ac, [u6]
    ld   NV_SEL, x
    ld   [y,x], ac
    xor  [u6], ac
    bne  os_e
    ld   2, ac
    ld   ac, [u2]
    ld   SH_SEL & 0xFF, ac
    CALL nv_shape
os_e:
    LEAVE

; nv_bit - AC = 1 << AC.  A leaf.
.chunk
nv_bit:
    ld   ac, [u6]
    ld   1, ac
nb2_l:
    ld   ac, [u7]
    ld   [u6], ac
    beq  nb2_e
    dec
    ld   ac, [u6]
    ld   [u7], ac
    shl
    bra  nb2_l
nb2_e:
    ld   [u7], ac
    RET

; nv_shape - the shape whose low byte (in NV_SHP's page) is AC round v0,
; v1 in color u2: its count, then x, y offsets (signed)
.chunk
nv_shape:
    PUSH_LINK
    ld   ac, [v6]
    ld   NV_SHP >> 8, y
    ld   [v6], x
    ld   [y,x], ac
    ld   ac, [v5]
ns_l:
    ld   [v6], ac
    inc
    ld   ac, [v6]
    ld   ac, x
    ld   NV_SHP >> 8, y
    ld   [y,x], ac
    add  [v0], ac
    ld   ac, [u0]
    ld   [v6], ac
    inc
    ld   ac, [v6]
    ld   ac, x
    ld   [y,x], ac
    add  [v1], ac
    ld   ac, [u1]
    CALL nv_put
    ld   [v5], ac
    dec
    ld   ac, [v5]
    bne  ns_l
    LEAVE

; the shapes: a count, then x, y pairs (pixels are square)
.chunk
NV_SHP:
SH_AST:                         ; an asterisk: a derelict not visited
    #d8 9, 0, 0, 0xFF, 0, 1, 0, 0, 0xFF, 0, 1, 0xFF, 0xFF, 1, 0xFF, 0xFF, 1, 1, 1
SH_DIA:                         ; a diamond: visited
    #d8 8, 0, 0xFE, 1, 0xFF, 2, 0, 1, 1, 0, 2, 0xFF, 1, 0xFE, 0, 0xFF, 0xFF
SH_SEL:                         ; the target's corners
    #d8 12, 0xFB, 0xFB, 0xFC, 0xFB, 0xFB, 0xFC, 0xFB, 5, 0xFC, 5, 0xFB, 4
    #d8 5, 0xFB, 4, 0xFB, 5, 0xFC, 5, 5, 4, 5, 5, 4

; nv_circ - a station: a circle of its size (E_R >> NV_ZS pixels across,
; 3 at least, 63 at most) round v0, v1, 32 points (nv_vert), teal; then
; nv_osel.  The rest of nv_obj
.chunk
nv_circ:
    ld   FL_PG, y
    ld   E_R, x
    ld   [y,x], ac
    ld   ac, [w0]
    ld   E_R + 1, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   NV_ZS, x
    ld   [y,x], ac
    ld   ac, [v2]
ncs_l:
    ld   [v2], ac
    beq  nc_d
    dec
    ld   ac, [v2]
    CALL nv_sh2
    bra  ncs_l
nc_d:
    ld   [w1], ac
    bne  nc_b
    ld   [w0], ac
    sub  64, ac
    bcc  nc_b
    ld   [w0], ac
    sub  3, ac
    bcc  nc_r
    ld   3, ac
    bra  nc_v
nc_b:
    ld   63, ac
    bra  nc_v
nc_r:
    ld   [w0], ac
nc_v:
    ld   ac, [v3]
    ld   FL_PG, y
    ld   NV_ANG, x
    ld   0x00, [y,x]
    ld   3, ac
    ld   ac, [u2]
    clr  ac
    ld   ac, [v5]
ncl:
    ld   [v5], ac
    CALL nv_vert
    ld   [v0], ac
    ld   ac, [u7]
    ld   [u0], ac
    CALL nv_addc
    ld   ac, [u0]
    ld   [v1], ac
    ld   ac, [u7]
    ld   [u1], ac
    CALL nv_addc
    ld   ac, [u1]
    CALL nv_put
    ld   [v5], ac
    inc
    ld   ac, [v5]
    xor  32, ac
    bne  ncl
    GOTO nv_osel

; nv_addc - AC = u7 + AC (AC signed), or xFF when that leaves 0-255.
; A leaf.
.chunk
nv_addc:
    blt  ad_n
    add  [u7], ac
    bcs  ad_f
    RET
ad_n:
    add  [u7], ac
    bcc  ad_f
    RET
ad_f:
    ld   0xFF, ac
    RET

; nv_cm - AC = cos (NV_ANG + AC) x v3 / 128 (signed: 127 is 1)
.chunk
nv_cm:
    PUSH_LINK
    ld   ac, [w1]
    ld   FL_PG, y
    ld   NV_ANG, x
    ld   [y,x], ac
    add  [w1], ac
    and  31, ac
    add  COS32 & 0xFF, x
    ld   COS32 >> 8, y
    ld   [y,x], ac
    ld   ac, [w1]
    blt  cm_n
    bra  cm_p
cm_n:
    xor  0xFF, ac
    inc
cm_p:
    ld   ac, [R0]
    ld   [v3], ac
    ld   ac, [R1]
    CALL l_mul8
    ld   [R2], ac               ; rounded
    add  64, ac
    ld   ac, [R2]
    ld   [R3], ac
    bcc  cm_r
    inc
    ld   ac, [R3]
cm_r:
    ld   [R2], ac
    and  0x80, ac
    beq  cm_0
    ld   1, ac
cm_0:
    ld   ac, [w0]
    ld   [R3], ac
    shl
    or   [w0], ac
    ld   ac, [w0]
    ld   [w1], ac
    blt  cm_m
    ld   [w0], ac
    LEAVE
cm_m:
    ld   [w0], ac
    xor  0xFF, ac
    inc
    LEAVE

; nv_vert - u0, u1 = the point v3 out at NV_ANG + AC (x: v3 cos, y:
; v3 sin)
.chunk
nv_vert:
    PUSH_LINK
    ld   ac, [v4]
    CALL nv_cm
    ld   ac, [u0]
    ld   [v4], ac
    add  24, ac
    CALL nv_cm
    ld   ac, [u1]
    LEAVE

; nv_tug - the tug: a small white triangle pointing along its heading, to
; the nearest of 8 (any finer is ragged at this size): NV_TS's shape for 0
; or 45 degrees (dx, dy pairs, x80 the end) turned by quarters, then
; nv_drift.  The rest of
; nv_draw
.chunk
nv_tug:
    ld   FL_PG, y
    ld   FL_HD, x
    ld   [y,x], ac
    add  2, ac
    shr  ac
    shr  ac
    and  7, ac
    ld   ac, [v4]               ; the heading in 8ths
    and  1, ac
    add  NV_TS & 0xFF, x
    ld   NV_TS >> 8, y
    ld   [y,x], ac
    ld   ac, [v6]               ; its shape
tu_l:
    ld   NV_TS >> 8, y
    ld   [v6], x
    ld   [y,x], ac
    xor  0x80, ac
    beq  tu_d
    ld   [y,x], ac
    ld   ac, [v0]
    ld   [v6], ac
    add  1, x
    ld   [y,x], ac
    ld   ac, [v1]
    ld   [v4], ac
    shr  ac
    ld   ac, [v5]               ; quarter turns: (x, y) to (-y, x)
tu_q:
    ld   [v5], ac
    beq  tu_p
    dec
    ld   ac, [v5]
    ld   [v1], ac
    xor  0xFF, ac
    inc
    ld   ac, [v2]
    ld   [v0], ac
    ld   ac, [v1]
    ld   [v2], ac
    ld   ac, [v0]
    bra  tu_q
tu_p:
    ld   [v0], ac
    add  128, ac
    ld   ac, [u0]
    ld   [v1], ac
    add  92, ac
    ld   ac, [u1]
    ld   3, ac
    ld   ac, [u2]
    CALL nv_put
    ld   [v6], ac
    add  2, ac
    ld   ac, [v6]
    bra  tu_l
tu_d:
    GOTO nv_drift

; the tug's shapes: filled, pointing 0 degrees (7 tall, 4 long) and 45 (a right
; triangle, its square corner the tip)
.chunk
NV_TS:
    #d8 NV_T0 & 0xFF, NV_T1 & 0xFF
NV_T0:
    #d8 0xFE, 0xFD, 0xFE, 0xFE, 0xFF, 0xFE, 0xFE, 0xFF, 0xFF, 0xFF, 0x00, 0xFF
    #d8 0xFE, 0x00, 0xFF, 0x00, 0x00, 0x00, 0x01, 0x00, 0xFE, 0x01, 0xFF, 0x01
    #d8 0x00, 0x01, 0xFE, 0x02, 0xFF, 0x02, 0xFE, 0x03, 0x80
NV_T1:
    #d8 0x01, 0xFD, 0x00, 0xFE, 0x01, 0xFE, 0xFF, 0xFF, 0x00, 0xFF, 0x01, 0xFF
    #d8 0xFE, 0x00, 0xFF, 0x00, 0x00, 0x00, 0x01, 0x00, 0xFD, 0x01, 0xFE, 0x01
    #d8 0xFF, 0x01, 0x00, 0x01, 0x01, 0x01, 0x80

; nv_tg - nv_drift's dots: NV_DRT's points round the tug turned to NV_ANG
; (nv_term).  The end of nv_draw
.chunk
nv_tg:
tg_l:
    ld   NV_DRT >> 8, y
    ld   [v6], x
    ld   [y,x], ac
    xor  0x80, ac
    beq  tg_d
    ld   [y,x], ac              ; x: u cos - w sin (cos (a + 8) = -sin)
    ld   ac, [v2]
    clr  ac
    CALL nv_term
    ld   ac, [v0]
    CALL nv_tw
    ld   8, ac
    CALL nv_term
    add  [v0], ac
    add  128, ac
    ld   ac, [u0]
    clr  ac                     ; y: u sin + w cos (cos (a + 24) = sin)
    CALL nv_term
    ld   ac, [v1]
    ld   NV_DRT >> 8, y
    ld   [v6], x
    ld   [y,x], ac
    ld   ac, [v2]
    ld   24, ac
    CALL nv_term
    add  [v1], ac
    add  92, ac
    ld   ac, [u1]
    CALL nv_put
    ld   [v6], ac
    add  2, ac
    ld   ac, [v6]
    bra  tg_l
tg_d:
    LEAVE

; nv_tw - v2 = the point's y (NV_DRT + v6 + 1).  A leaf.
.chunk
nv_tw:
    ld   NV_DRT >> 8, y
    ld   [v6], ac
    add  1, x
    ld   [y,x], ac
    ld   ac, [v2]
    RET

; nv_term - AC = v2 (signed) x cos (NV_ANG + AC): nv_cm's, which it ends in
.chunk
nv_term:
    ld   ac, [v5]
    ld   [v2], ac
    blt  tm_n
    ld   ac, [v3]
    ld   [v5], ac
    GOTO nv_cm
tm_n:
    xor  0xFF, ac
    inc
    ld   ac, [v3]
    ld   [v5], ac
    add  16, ac
    GOTO nv_cm

; the tug's drift's dots (9, 12, 15 out): x, y pairs, then x80
.chunk
NV_DRT:
    #d8 9, 0, 12, 0, 15, 0, 0x80

; nv_drift - gold dots 9-15 pixels out the way the tug drifts (when it
; does, 2/256 m a frame or more): NV_DRT in nv_tug's loop.  The end of
; nv_draw (its LEAVE)
.chunk
nv_drift:
    CALL fl_speed
    ld   [w1], ac
    bne  ndr_go
    ld   [w0], ac
    sub  2, ac
    bcc  ndr_go
    LEAVE
ndr_go:
    ld   FL_VX + 2, ac
    ld   ac, [u0]
    ld   FL_VY + 2, ac
    CALL nv_atv
    ld   2, ac
    ld   ac, [u2]
    ld   NV_DRT & 0xFF, ac
    ld   ac, [v6]
    GOTO tg_l

; nv_atv - NV_ANG = the angle of (the 2 bytes at FL_PG + u0, those at
; FL_PG + AC): nv_atan of them
.chunk
nv_atv:
    PUSH_LINK
    ld   ac, [u1]
    ld   FL_PG, y
    ld   [u0], x
    ld   [y,x], ac
    ld   NV_AX, x
    ld   ac, [y,x]
    ld   [u0], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    ld   NV_AX + 1, x
    ld   ac, [y,x]
    ld   [u1], x
    ld   [y,x], ac
    ld   NV_AY, x
    ld   ac, [y,x]
    ld   [u1], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    ld   NV_AY + 1, x
    ld   ac, [y,x]
    CALL nv_atan
    ld   FL_PG, y
    ld   NV_ANG, x
    ld   ac, [y,x]
    LEAVE

; nv_atan - AC = the angle (0-31, 0 east, 8 down) of NV_AX, NV_AY
; (signed): the octant from the signs and which is larger, then the step
; in it from the ratio against tan 5.6, 16.9, 28.1, 39.4 degrees
.chunk
nv_atan:
    PUSH_LINK
    ld   NV_AX, ac
    CALL fl_abs
    ld   [u0], ac
    ld   ac, [w0]
    ld   [u1], ac
    ld   ac, [w1]
    ld   NV_AY, ac
    CALL fl_abs
    ld   [u0], ac
    ld   ac, [w2]
    ld   [u1], ac
    ld   ac, [w3]
an_s:
    ld   [w1], ac               ; both to 8 bits
    or   [w3], ac
    beq  an_d
    CALL nv_sh2
    bra  an_s
an_d:
    clr  ac
    ld   ac, [w6]
    ld   [w0], ac
    ld   ac, [w4]               ; w4 the larger, w5 the smaller
    ld   [w2], ac
    ld   ac, [w5]
    ld   [w0], ac
    sub  [w2], ac
    bcc  an_k
    ld   [w2], ac
    ld   ac, [w4]
    ld   [w0], ac
    ld   ac, [w5]
    ld   1, ac
    ld   ac, [w6]               ; w6: y the larger
an_k:
    GOTO nv_atan2

; nv_atan2 - the step in the octant, the quadrant.  The rest of nv_atan
.chunk
nv_atan2:
    clr  ac
    ld   ac, [v5]
    ld   ac, [v4]
ak_l:
    ld   [w4], ac
    ld   ac, [R0]
    ld   [v4], ac
    add  NV_TAN & 0xFF, x
    ld   NV_TAN >> 8, y
    ld   [y,x], ac
    ld   ac, [R1]
    CALL l_mul8                 ; the larger x tan: R3 its whole part
    ld   [R3], ac
    sub  [w5], ac
    bcc  ak_n
    ld   [v5], ac
    inc
    ld   ac, [v5]
ak_n:
    ld   [v4], ac
    inc
    ld   ac, [v4]
    xor  4, ac
    bne  ak_l
    ld   [w6], ac               ; a = k, or 8 - k
    beq  ak_a
    ld   8, ac
    sub  [v5], ac
    ld   ac, [v5]
ak_a:
    ld   FL_PG, y
    ld   NV_AX + 1, x
    ld   [y,x], ac
    blt  ak_xn
    ld   NV_AY + 1, x
    ld   [y,x], ac
    blt  ak_4
    ld   [v5], ac               ; x+ y+: a
    bra  nk_ae
ak_4:
    ld   32, ac                 ; x+ y-: 32 - a
    sub  [v5], ac
    bra  nk_ae
ak_xn:
    ld   NV_AY + 1, x
    ld   [y,x], ac
    blt  ak_3
    ld   16, ac                 ; x- y+: 16 - a
    sub  [v5], ac
    bra  nk_ae
ak_3:
    ld   16, ac                 ; x- y-: 16 + a
    add  [v5], ac
nk_ae:
    and  31, ac
    LEAVE

.chunk
NV_TAN:
    #d8 25, 78, 137, 210


; ============================================================
; the control panel: rows 24-27 three boxed blocks with inverse titles
; (FLIGHT, PROPULSION, TARGET), each label with its unit and its value
; to the right; row 28 the keys as inverse caps; row 29 the message
; ============================================================

; nv_panel - the panel again: the labels (NV_LAB: row, column, string in
; NV_STR's page), then nv_pn1
.chunk
nv_panel:
    PUSH_LINK
    ld   161, ac
    CALL clear_rows
    clr  ac
    ld   ac, [v0]
lb_l:
    ld   NV_LAB >> 8, y
    ld   [v0], ac
    add  NV_LAB & 0xFF, x
    ld   [y,x], ac
    beq  lb_e
    ld   ac, [CUR_ROW]
    ld   [v0], ac
    add  (NV_LAB & 0xFF) + 1, x
    ld   [y,x], ac
    ld   ac, [CUR_COL]
    ld   [v0], ac
    add  (NV_LAB & 0xFF) + 2, x
    ld   [y,x], ac
    CALL nv_s
    ld   [v0], ac
    add  3, ac
    ld   ac, [v0]
    bra  lb_l
lb_e:
    GOTO nv_pn1
NV_LAB:
    #d8 24, 1, s_t1 & 0xFF, 24, 20, s_t2 & 0xFF, 24, 39, s_t3 & 0xFF
    #d8 25, 1, s_head & 0xFF
    #d8 25, 20, s_n2 & 0xFF, 26, 20, s_mass & 0xFF, 27, 20, s_thr & 0xFF
    #d8 25, 62, s_reg & 0xFF, 26, 39, s_rng & 0xFF, 26, 54, s_rad & 0xFF
    #d8 27, 39, s_tow & 0xFF, 27, 57, s_acr & 0xFF, 0

; nv_pn1 - the boxes, the target's name in its title (inverse, to the
; block's end), nitrogen.  The rest of nv_panel
.chunk
nv_pn1:
    CALL nv_box
    ld   FL_PG, y
    ld   NV_SEL, x
    ld   [y,x], ac
    CALL nv_ent
    ld   24, ac
    ld   ac, [CUR_ROW]
    ld   48, ac
    ld   ac, [CUR_COL]
    ld   0x80, ac
    ld   ac, [p_inv]
    ld   FL_PG, y
    ld   E_NM, x
    ld   [y,x], ac
    CALL nv_s55
p1_l:
    ld   [CUR_COL], ac
    xor  79, ac
    beq  p1_e
    ld   0x20, ac
    CALL tputc
    bra  p1_l
p1_e:
    ld   ac, [p_inv]            ; (AC 0)
    ld   25, ac
    ld   ac, [CUR_ROW]
    ld   FL_PG, y
    ld   FL_FLL, x
    ld   [y,x], ac
    ld   ac, [num_l]
    ld   FL_FLH, x
    ld   [y,x], ac
    ld   ac, [num_h]
    ld   31, ac
    CALL nv_dec
    GOTO nv_pn2

; nv_dec - num in decimal from column AC (put_dec's return is the
; caller's).  nv_s - the string in NV_STR's page whose low byte is AC, at
; the cursor.  nv_s55 - the same in the sector file's strings (page x55)
.chunk
nv_dec:
    ld   ac, [CUR_COL]
    GOTO put_dec
nv_s:
    ld   ac, [R0]
    ld   NV_STR >> 8, ac
    ld   ac, [R1]
    GOTO tputs
nv_s55:
    ld   ac, [R0]
    ld   SEC_STR, ac
    ld   ac, [R1]
    GOTO tputs

; nv_next - AC = the offset after the string at offset AC of page x55.
; A leaf.
.chunk
nv_next:
    ld   ac, [u0]
nx2_l:
    ld   SEC_STR, y
    ld   [u0], x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   [u0], ac
    inc
    ld   ac, [u0]
    ld   [u1], ac
    bne  nx2_l
    ld   [u0], ac
    RET

; nv_box - the blocks' sides (bit 7: the pixel glyphs leave blank) of
; columns 0, 18, 19, 37, 38 and 78 down rows 25-27 (line pairs 8-31:
; offsets 177-223), then a line under row 27 (offset 223) but in the gaps
; between the blocks.  A leaf.
.chunk
nv_box:
    clr  ac
    ld   ac, [u0]
bx_c:
    ld   NV_BXC >> 8, y
    ld   [u0], ac
    add  NV_BXC & 0xFF, x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   177, ac
    ld   ac, [u2]
bx_l:
    ld   [u1], y
    ld   [u2], x
    ld   [y,x], ac
    or   0x80, ac
    ld   ac, [y,x]
    ld   [u2], ac
    add  2, ac
    ld   ac, [u2]
    xor  225, ac
    bne  bx_l
    ld   [u0], ac
    inc
    ld   ac, [u0]
    xor  6, ac
    bne  bx_c
    ld   0x63, ac               ; under: columns 1-78
    ld   ac, [u1]
bx_b:
    ld   [u1], y
    ld   223, x
    ld   0xFF, [y,x]
    ld   [u1], ac
    add  2, ac
    ld   ac, [u1]
    xor  0xFF, ac
    bne  bx_b
    ld   0x61 + 38, y           ; the gaps: columns 19 and 38 their side only
    ld   0x80, [y,x]
    ld   0x61 + 76, y
    ld   0x80, [y,x]
    RET
NV_BXC:
    #d8 0x61, 0x61 + 36, 0x61 + 38, 0x61 + 74, 0x61 + 76, 0x61 + 156

; nv_pn2 - heading, mass, docked, thrusters.  The rest of nv_panel
.chunk
nv_pn2:
    ld   FL_PG, y
    ld   FL_HD, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   45, ac
    ld   ac, [R1]
    CALL l_mul8
    CALL nv_q4
    ld   12, ac
    CALL nv_dec
    ld   26, ac
    ld   ac, [CUR_ROW]
    ld   FL_PG, y
    ld   FL_ML, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   FL_MH, x
    ld   [y,x], ac
    ld   ac, [R1]
    ld   10, ac
    ld   ac, [R2]
    CALL l_div16
    ld   [R0], ac
    ld   ac, [num_l]
    ld   [R1], ac
    ld   ac, [num_h]
    ld   31, ac
    CALL nv_dec
    ld   1, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   FL_DOCK, x
    ld   [y,x], ac
    beq  p2_f
    ld   s_dkd & 0xFF, ac
    bra  p2_s
p2_f:
    ld   s_free & 0xFF, ac
p2_s:
    CALL nv_s
    ld   27, ac
    ld   ac, [CUR_ROW]
    ld   FL_PG, y
    ld   FL_NT, x
    ld   [y,x], ac
    ld   ac, [num_l]
    clr  ac
    ld   ac, [num_h]
    ld   31, ac
    CALL nv_dec
    GOTO nv_pn3

; nv_pn3 - the target: what it is, its registry; its range (the larger
; of |dx| and |dy|).  The rest of nv_panel
.chunk
nv_pn3:
    ld   25, ac
    ld   ac, [CUR_ROW]
    ld   39, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   E_SH, x
    ld   [y,x], ac
    beq  p3_st
    ld   s_der & 0xFF, ac
    bra  p3_s
p3_st:
    ld   s_stn & 0xFF, ac
p3_s:
    CALL nv_s
    ld   FL_PG, y
    ld   E_NM, x
    ld   [y,x], ac
    CALL nv_next
    ld   FL_PG, y
    ld   NV_S1, x
    ld   ac, [y,x]
    CALL nv_next
    CALL nv_s55                 ; the kind
    ld   66, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   NV_S1, x
    ld   [y,x], ac
    CALL nv_s55                 ; the registry
    ld   NV_DL, ac
    CALL fl_abs
    ld   [u0], ac
    ld   ac, [w0]
    ld   [u1], ac
    ld   ac, [w1]
    ld   NV_DL + 2, ac
    CALL fl_abs
    CALL fl_max
    GOTO nv_pn4

; nv_pn4 - the range less its size (0 at least), the radar return,
; visited.  The rest of nv_panel
.chunk
nv_pn4:
    ld   FL_PG, y
    ld   E_R, x
    ld   [w0], ac
    sub  [y,x], ac
    ld   ac, [w0]
    ld   E_R + 1, x
    ld   [w1], ac
    bcc  p4_1
    dec
p4_1:
    sub  [y,x], ac
    ld   ac, [w1]
    blt  p4_0
    bra  p4_2
p4_0:
    clr  ac
    ld   ac, [w0]
    ld   ac, [w1]
p4_2:
    ld   [w0], ac
    ld   ac, [num_l]
    ld   NV_RG, x
    ld   ac, [y,x]
    ld   [w1], ac
    ld   ac, [num_h]
    ld   NV_RG + 1, x
    ld   ac, [y,x]
    ld   26, ac
    ld   ac, [CUR_ROW]
    ld   47, ac
    CALL nv_dec
    ld   62, ac                 ; the radar return: its radar factor (size
    ld   ac, [CUR_COL]          ; x 100 / 16) / (range / 256), 99 at most
    ld   FL_PG, y
    ld   NV_RG + 1, x
    ld   [y,x], ac
    beq  p4_99
    ld   ac, [R2]
    ld   E_RF, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   E_RF + 1, x
    ld   [y,x], ac
    ld   ac, [R1]
    CALL l_div16
    ld   [R1], ac
    bne  p4_99
    ld   [R0], ac
    sub  100, ac
    bcc  p4_99
    ld   [R0], ac
    bra  p4_p
p4_99:
    ld   99, ac
p4_p:
    CALL put_dec8
    ld   66, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   NV_SEL, x
    ld   [y,x], ac
    CALL nv_bit
    ld   ac, [u6]
    ld   FL_PG, y
    ld   FL_VIS, x
    ld   [y,x], ac
    and  [u6], ac
    beq  p4_n
    ld   s_vis & 0xFF, ac
    bra  p4_v
p4_n:
    ld   s_nvis & 0xFF, ac
p4_v:
    CALL nv_s
    GOTO nv_pn5

; nv_pn5 - the tug's speed toward the target (along its bearing from the
; tug: under 0 moving away) and across it.  The rest of nv_panel
.chunk
nv_pn5:
    ld   27, ac
    ld   ac, [CUR_ROW]
    ld   NV_DL, ac
    ld   ac, [u0]
    ld   NV_DL + 2, ac
    CALL nv_atv
    ld   50, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   NV_ANG, x
    ld   [y,x], ac
    CALL nv_dot
    ld   1, ac
    CALL nv_spd
    ld   68, ac
    ld   ac, [CUR_COL]
    ld   FL_PG, y
    ld   NV_ANG, x
    ld   [y,x], ac
    add  8, ac
    CALL nv_dot
    clr  ac
    CALL nv_spd
    GOTO nv_pn6

; nv_pn6 - row 28: the keys as inverse caps (the sector file's s_k0,
; s_k1), the zoom's range in the first; then the message.  The end of
; nv_panel
.chunk
nv_pn6:
    ld   28, ac
    ld   ac, [CUR_ROW]
    ld   1, ac
    ld   ac, [CUR_COL]
    ld   s_k0 & 0xFF, ac
    ld   ac, [R0]
    ld   s_k0 >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   0x80, ac
    ld   ac, [p_inv]
    ld   FL_PG, y               ; the range across: 1 << FL_ZM km (256
    ld   FL_ZM, x               ; pixels of 4 m << FL_ZM: 1.024 km << it)
    ld   [y,x], ac
    CALL nv_bit
    ld   ac, [num_l]
    clr  ac
    ld   ac, [num_h]
    CALL put_dec
    ld   s_km & 0xFF, ac
    ld   ac, [R0]
    ld   s_km >> 8, ac
    ld   ac, [R1]
    CALL tputs
    clr  ac
    ld   ac, [p_inv]
    ld   s_k1 & 0xFF, ac
    ld   ac, [R0]
    ld   s_k1 >> 8, ac
    ld   ac, [R1]
    CALL tputs
    CALL draw_msg
    LEAVE

; the range's unit
.chunk
s_km:
    #d " KM", 0x00

; the panel's strings: one page (nv_s takes the low byte); the titles are
; inverse letters (bit 7)
.chunk
NV_STR:
s_q0:
    #d "-", 0x00
s_q1:
    #d "-2175  ", 0x00
s_q2:
    #d ":", 0x00
s_q3:
    #d "   NITROGEN ", 0x00
s_q5:
    #d " KG   DELTA-V ", 0x00
s_q6:
    #d " M/S   BATTERIES ", 0x00
s_t1:                           ; " FLIGHT", 18 wide
    #d8 0xA0, 0xC6, 0xCC, 0xC9, 0xC7, 0xC8, 0xD4, 0xA0, 0xA0, 0xA0, 0xA0, 0xA0
    #d8 0xA0, 0xA0, 0xA0, 0xA0, 0xA0, 0xA0, 0x00
s_t2:                           ; " PROPULSION", 18 wide
    #d8 0xA0, 0xD0, 0xD2, 0xCF, 0xD0, 0xD5, 0xCC, 0xD3, 0xC9, 0xCF, 0xCE, 0xA0
    #d8 0xA0, 0xA0, 0xA0, 0xA0, 0xA0, 0xA0, 0x00
s_t3:                           ; " TARGET: " (then its name)
    #d8 0xA0, 0xD4, 0xC1, 0xD2, 0xC7, 0xC5, 0xD4, 0xBA, 0xA0, 0x00
s_head:
    #d "HEADING", 0x00
s_n2:
    #d "N2 KG", 0x00
s_mass:
    #d "MASS T", 0x00
s_thr:
    #d "THRUSTERS", 0x00
s_reg:
    #d "REG", 0x00
s_rng:
    #d "RANGE M", 0x00
s_rad:
    #d "RADAR %", 0x00
s_tow:
    #d "TOWARD M/S", 0x00
s_acr:
    #d "ACROSS M/S", 0x00
s_dkd:
    #d "DOCKED", 0x00
s_free:
    #d "FREE FLIGHT", 0x00
s_der:
    #d "DERELICT ", 0x00
s_stn:
    #d "STATION ", 0x00
s_nvis:
    #d "NOT "
s_vis:
    #d "VISITED", 0x00

; nv_sh2 - w1:w0 >>= 1, w3:w2 >>= 1 (no sign).  A leaf.
.chunk
nv_sh2:
    ld   [w1], ac
    and  1, ac
    beq  sh_a
    ld   0x80, ac
sh_a:
    ld   ac, [w6]
    ld   [w0], ac
    shr  ac
    or   [w6], ac
    ld   ac, [w0]
    ld   [w1], ac
    shr  ac
    ld   ac, [w1]
    ld   [w3], ac
    and  1, ac
    beq  sh_b
    ld   0x80, ac
sh_b:
    ld   ac, [w6]
    ld   [w2], ac
    shr  ac
    or   [w6], ac
    ld   ac, [w2]
    ld   [w3], ac
    shr  ac
    ld   ac, [w3]
    RET

; nv_spd - NV_RS (1/256 m a frame, signed) in m/s; a - first
; when it is under 0 and AC is 1 (else its size)
.chunk
nv_spd:
    PUSH_LINK
    ld   ac, [v0]
    ld   NV_RS, ac
    CALL fl_abs
    ld   [u1], ac
    ld   ac, [R3]
    ld   [u0], ac
    ld   ac, [R2]
    ld   [v0], ac
    beq  nsp_p
    ld   FL_PG, y
    ld   NV_RS + 1, x
    ld   [y,x], ac
    blt  nsp_n
    bra  nsp_p
nsp_n:
    ld   0x2D, ac
    CALL tputc
nsp_p:
    CALL nv_q4
    CALL nv_ms
    CALL put_dec
    LEAVE

; nv_dot - NV_RS = the tug's velocity along angle AC: vx cos + vy sin
.chunk
nv_dot:
    PUSH_LINK
    ld   ac, [v4]
    ld   FL_PG, y
    ld   NV_RS, x
    ld   0x00, [y,x]
    ld   NV_RS + 1, x
    ld   0x00, [y,x]
    ld   FL_VX + 2, ac
    CALL nv_mt
    ld   [v4], ac
    add  24, ac
    ld   ac, [v4]
    ld   FL_VY + 2, ac
    CALL nv_mt
    LEAVE

; nv_mt - NV_RS += the 2 bytes at FL_PG + AC (signed) x cos v4 (COS32:
; 127 is 1) / 128
.chunk
nv_mt:
    PUSH_LINK
    CALL fl_abs                 ; u1:u0 its size, u2 where it is
    ld   FL_PG, y
    ld   [u2], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    and  0x80, ac
    ld   ac, [v6]               ; v6: under 0
    ld   [v4], ac
    and  31, ac
    add  COS32 & 0xFF, x
    ld   COS32 >> 8, y
    ld   [y,x], ac
    blt  mt_n
    bra  mt_p
mt_n:
    xor  0xFF, ac
    inc
    ld   ac, [v7]
    ld   [v6], ac
    xor  0x80, ac
    ld   ac, [v6]
    ld   [v7], ac
mt_p:
    ld   ac, [v7]               ; v7 |cos|
    ld   ac, [R1]
    ld   [u0], ac
    ld   ac, [R0]
    CALL l_mul8                 ; the low byte x |cos| / 128: w0
    ld   [R2], ac
    and  0x80, ac
    beq  mt_0
    ld   1, ac
mt_0:
    ld   ac, [w0]
    ld   [R3], ac
    shl
    or   [w0], ac
    ld   ac, [w0]
    ld   [u1], ac
    ld   ac, [R0]
    ld   [v7], ac
    ld   ac, [R1]
    CALL l_mul8                 ; the high byte x |cos| x 2: w3:w2
    ld   [R2], ac
    shl
    ld   ac, [w2]
    ld   [R3], ac
    bcc  mt_1
    shl
    inc
    bra  mt_2
mt_1:
    shl
mt_2:
    ld   ac, [w3]
    GOTO nv_mt2

; nv_mt2 - the sum, its sign, added to NV_RS.  The rest of nv_mt
.chunk
nv_mt2:
    ld   [w2], ac
    add  [w0], ac
    ld   ac, [w2]
    ld   [w3], ac
    bcc  m2_1
    inc
m2_1:
    ld   ac, [w3]
    ld   [v6], ac
    beq  m2_a
    ld   [w2], ac
    xor  0xFF, ac
    add  1, ac
    ld   ac, [w2]
    ld   [w3], ac
    xor  0xFF, ac
    bcc  m2_2
    inc
m2_2:
    ld   ac, [w3]
m2_a:
    ld   FL_PG, y
    ld   NV_RS, x
    ld   [y,x], ac
    add  [w2], ac
    ld   ac, [y,x]
    ld   NV_RS + 1, x
    ld   [y,x], ac
    bcc  m2_3
    inc
m2_3:
    add  [w3], ac
    ld   ac, [y,x]
    LEAVE


; nv_exit - Esc let go (or the loop would take it for the DOS's), then
; back.  The end of nav_main
.chunk
nv_exit:
    ld   1, ac
    CALL l_wait_frames_io
    CALL l_kbd_scan
    ld   [dead], ac
    bne  nx_e
    ld   [KBD_NOW], ac
    and  1, ac
    beq  nv_exit
nx_e:
    ld   FL_PG, y
    ld   FL_NAV, x
    ld   0x00, [y,x]
    clr  ac                     ; the message off: its string may be in the
    ld   ac, [msg_t]            ; sector file (part text again from now)
    ld   0x20, ac               ; the ship's view 4 bpp again
    ld   ac, [u2]
    ld   0x06, ac
    GOTO view_mode




; view_mode - AC = the mode byte of the view's lines from u2 (x20 + the
; line) to 383 (x5B9F): x06 the ship (4 bpp), x05 the map (2 bpp).  The
; end of nv_modes and nv_exit (their LEAVE)
.chunk
view_mode:
    ld   ac, [u0]
    ld   0x5A, y
    ld   [u2], ac
vwm_1:
    ld   ac, x                  ; (the library's vid_mode, the view only)
    inc
    ld   ac, [u1]
    ld   [u0], ac
    ld   ac, [y,x]
    ld   [u1], ac
    bne  vwm_1
    ld   0x5B, y
    ld   0xA0, ac
vwm_2:
    dec
    ld   ac, x
    ld   ac, [u1]
    ld   [u0], ac
    ld   ac, [y,x]
    ld   [u1], ac
    bne  vwm_2
    LEAVE

; nv_stat - the status row (row 0): the ship's date and time (CLK: seconds
; from 05-07-2175 00:00:00, 08:00:00 at the start), the nitrogen (kg),
; the delta-v it gives (a kg is 20 kN s: kg x 200 / the mass in 100 kg)
; and the working batteries (NV_QT)
.chunk
nv_stat:
    PUSH_LINK
    ld   ACT_PG, y              ; w2:w1:w0 = the clock (seconds from
    ld   CLK_0 & 0xFF, x        ; 05-07-2175 00:00:00)
    ld   [y,x], ac
    ld   ac, [w0]
    ld   CLK_1 & 0xFF, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   CLK_2 & 0xFF, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   60, ac                 ; seconds, minutes, hours
    CALL nv_dv
    ld   NV_QS, ac
    CALL nv_qput
    ld   60, ac
    CALL nv_dv
    ld   NV_QMI, ac
    CALL nv_qput
    ld   24, ac
    CALL nv_dv
    ld   NV_QH, ac
    CALL nv_qput
    GOTO nv_stat2

; nv_qput - FL_PG + AC = w3 (nv_dv's remainder).  A leaf.
.chunk
nv_qput:
    ld   ac, x
    ld   FL_PG, y
    ld   [w3], ac
    ld   ac, [y,x]
    RET

; nv_stat2 - the date from the days (w0: May 7 is day 0), the nitrogen.
; The rest of nv_stat
.chunk
nv_stat2:
    ld   [w0], ac               ; v3 the day of the month - 1, v4 the month
    add  6, ac
    ld   ac, [v3]
    ld   5, ac
    ld   ac, [v4]
ms_l:
    ld   NV_ML >> 8, y
    ld   [v4], ac
    add  ((NV_ML & 0xFF) - 5) & 0xFF, x
    ld   [y,x], ac
    ld   ac, [v5]
    ld   [v3], ac
    sub  [v5], ac
    bcs  ms_d
    ld   ac, [v3]
    ld   [v4], ac
    inc
    ld   ac, [v4]
    bra  ms_l
ms_d:
    ld   FL_PG, y
    ld   NV_QMO, x
    ld   [v4], ac
    ld   ac, [y,x]
    ld   NV_QD, x
    ld   [v3], ac
    inc
    ld   ac, [y,x]
    ld   NV_QB, x               ; the batteries
    ld   [n_bat], ac
    ld   ac, [y,x]
    ld   NV_QB + 1, x
    ld   0x00, [y,x]
    ld   FL_FLL, x              ; the nitrogen, litres
    ld   [y,x], ac
    ld   ac, [w0]
    ld   NV_QL, x
    ld   ac, [y,x]
    ld   FL_FLH, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   NV_QL + 1, x
    ld   ac, [y,x]
    GOTO nv_stat3

; the months' days, May to December
NV_ML:
    #d8 31, 30, 31, 31, 30, 31, 30, 31

; nv_stat3 - the delta-v: kg x 40 / (the mass / 5), the mass in 100 kg
; (255 at most after / 5); then the row (NV_QT).  The rest of nv_stat
.chunk
nv_stat3:
    ld   FL_PG, y
    ld   FL_ML, x
    ld   [y,x], ac
    ld   ac, [w0]
    ld   FL_MH, x
    ld   [y,x], ac
    ld   ac, [w1]
    clr  ac
    ld   ac, [w2]
    ld   5, ac
    CALL nv_dv
    ld   [w1], ac
    beq  dv_mq
    ld   0xFF, ac
    ld   ac, [w0]
dv_mq:
    ld   [w0], ac               ; (not 0: the tug weighs something)
    ld   ac, [v6]
    ld   FL_PG, y               ; kg x 40: low byte, then high byte x 40
    ld   NV_QL, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   40, ac
    ld   ac, [R1]
    CALL l_mul8
    ld   [R2], ac
    ld   ac, [w0]
    ld   [R3], ac
    ld   ac, [w1]
    ld   FL_PG, y
    ld   NV_QL + 1, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   40, ac
    ld   ac, [R1]
    CALL l_mul8
    ld   [R2], ac
    add  [w1], ac
    ld   ac, [w1]
    ld   [R3], ac
    bcc  dv_n
    inc
dv_n:
    ld   ac, [w2]
    ld   [v6], ac
    CALL nv_dv
    ld   FL_PG, y
    ld   NV_QDV, x
    ld   [w0], ac
    ld   ac, [y,x]
    ld   NV_QDV + 1, x
    ld   [w1], ac
    ld   ac, [y,x]
    GOTO nv_strow

; nv_strow - the status row from NV_QT: a code (0 the end, 1 a string in
; NV_STR's page, 2 a byte at FL_PG + the next byte in 2 digits, 3 two
; bytes there in decimal) and its byte.  The end of nv_stat (its LEAVE)
.chunk
nv_strow:
    clr  ac
    ld   ac, [CUR_ROW]
    ld   ac, [CUR_COL]
    ld   ac, [p_inv]
sr_c:
    ld   0x20, ac
    CALL tputc
    ld   [CUR_COL], ac
    xor  80, ac
    bne  sr_c
    ld   1, ac
    ld   ac, [CUR_COL]
    clr  ac
    ld   ac, [v0]
sr_l:
    ld   NV_QT >> 8, y
    ld   [v0], ac
    add  NV_QT & 0xFF, x
    ld   [y,x], ac
    beq  sr_e
    ld   ac, [v1]
    ld   [v0], ac
    add  (NV_QT & 0xFF) + 1, x
    ld   [y,x], ac
    ld   ac, [v2]
    ld   [v0], ac
    add  2, ac
    ld   ac, [v0]
    ld   [v1], ac
    xor  1, ac
    bne  sr_n
    ld   [v2], ac
    CALL nv_s
    bra  sr_l
sr_n:
    ld   FL_PG, y
    ld   [v2], x
    ld   [y,x], ac
    ld   ac, [num_l]
    clr  ac
    ld   ac, [num_h]
    ld   [v1], ac
    xor  2, ac
    beq  sr_2
    ld   [v2], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [num_h]
    bra  sr_d
sr_2:
    ld   [num_l], ac
    sub  10, ac
    bcc  sr_d
    ld   0x30, ac
    CALL tputc
sr_d:
    CALL put_dec
    bra  sr_l
sr_e:
    LEAVE
NV_QT:
    #d8 2, NV_QMO, 1, s_q0 & 0xFF, 2, NV_QD, 1, s_q1 & 0xFF, 2, NV_QH
    #d8 1, s_q2 & 0xFF, 2, NV_QMI, 1, s_q2 & 0xFF, 2, NV_QS
    #d8 1, s_q3 & 0xFF, 3, NV_QL
    #d8 1, s_q5 & 0xFF, 3, NV_QDV, 1, s_q6 & 0xFF, 3, NV_QB, 0

; nv_dv - w2:w1:w0 /= AC (w2:w1 / AC under 256 x AC), the remainder in w3
.chunk
nv_dv:
    PUSH_LINK
    ld   ac, [R2]
    ld   [w2], ac
    ld   ac, [R1]
    ld   [w1], ac
    ld   ac, [R0]
    CALL l_div16
    ld   ac, [w3]               ; the remainder
    ld   [R1], ac               ; w2:w1 = the quotient
    ld   ac, [w2]
    ld   [R0], ac
    ld   ac, [w1]
    ld   [w3], ac               ; then the remainder:w0
    ld   ac, [R1]
    ld   [w0], ac
    ld   ac, [R0]
    CALL l_div16
    ld   ac, [w3]
    ld   [R0], ac
    ld   ac, [w0]
    LEAVE

; nv_plot - map pixel u0, u1 in color u2 (2 bpp: 0-3): byte column 8 +
; u0 / 4 (page x71 + (u0 >> 1) & x7E), line pair u1 + 8 (under the status
; row: offset 2 u1 + 48, or 2 u1 - 207 from 104), bits 2 (u0 & 3) up (the
; first pixel the low bits).  A leaf.
.chunk
nv_plot:
    ld   [u0], ac
    shr  ac
    and  0x7E, ac
    add  0x71, ac
    ld   ac, [u4]
    ld   [u1], ac
    sub  104, ac
    blt  pl_lo
    ld   [u1], ac
    shl
    sub  207, ac
    bra  pl_go
pl_lo:
    ld   [u1], ac
    shl
    add  48, ac
pl_go:
    ld   ac, [u5]
    ld   [u2], ac
    ld   ac, [u6]
    ld   [u0], ac
    and  3, ac
pl_s:
    ld   ac, [u3]               ; u6 the color moved up to its pixel
    beq  pl_w
    ld   [u6], ac
    shl
    shl
    ld   ac, [u6]
    ld   [u3], ac
    dec
    bra  pl_s
pl_w:
    ld   NV_PM >> 8, y          ; the other pixels' mask
    ld   [u0], ac
    and  3, ac
    add  NV_PM & 0xFF, x
    ld   [y,x], ac
    ld   [u4], y
    ld   [u5], x
    and  [y,x], ac
    or   [u6], ac
    ld   ac, [y,x]
    RET

; the masks that keep the other three pixels of a byte
NV_PM:
    #d8 0xFC, 0xF3, 0xCF, 0x3F




; nv_px - AC = the x pixel of the 2 bytes at FL_PG + AC (metres from the
; tug, signed) >> NV_ZS + u7, from the middle (128), or xFF when off the
; view.  nv_py - the y pixel (92).  A leaf.
.chunk
nv_px:
    ld   ac, [w2]
    ld   128, ac
    bra  nx_go
nv_py:
    ld   ac, [w2]
    ld   92, ac
nx_go:
    ld   ac, [w3]               ; w3 the middle and the half size
    ld   FL_PG, y               ; w1:w0 the metres, w2 the shift
    ld   [w2], x
    ld   [y,x], ac
    ld   ac, [w0]
    ld   [w2], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   NV_ZS, x
    ld   [y,x], ac
    add  [u7], ac
    ld   ac, [w2]
    ld   ac, [w5]
pj_l:
    ld   [w5], ac
    beq  pj_d
    dec
    ld   ac, [w5]
    ld   [w1], ac
    and  1, ac
    beq  pj_0
    ld   0x80, ac
pj_0:
    ld   ac, [w6]
    ld   [w0], ac
    shr  ac
    or   [w6], ac
    ld   ac, [w0]
    ld   [w1], ac
    and  0x80, ac
    ld   ac, [w6]
    ld   [w1], ac
    shr  ac
    or   [w6], ac
    ld   ac, [w1]
    bra  pj_l
pj_d:
    ld   [w1], ac
    beq  pj_p
    xor  0xFF, ac
    bne  pj_off
    ld   [w0], ac
    add  [w3], ac
    bcc  pj_off
    bra  pj_ok
pj_p:
    ld   [w0], ac
    sub  [w3], ac
    bcc  pj_off
pj_ok:
    ld   [w0], ac
    add  [w3], ac
    RET
pj_off:
    ld   0xFF, ac
    RET




; nv_q4 - num = R3:R2 / 4.  A leaf.
.chunk
nv_q4:
    ld   [R2], ac
    shr  ac
    shr  ac
    ld   ac, [num_l]
    ld   [R3], ac
    shl
    shl
    shl
    shl
    shl
    shl
    or   [num_l], ac
    ld   ac, [num_l]
    ld   [R3], ac
    shr  ac
    shr  ac
    ld   ac, [num_h]
    RET

; nv_ms - num -= num / 16: after nv_q4, 1/256 m a frame in m/s (x 15 /
; 64).  A leaf.
.chunk
nv_ms:
    ld   [num_l], ac            ; w1:w0 = num >> 4
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [w0]
    ld   [num_h], ac
    shl
    shl
    shl
    shl
    or   [w0], ac
    ld   ac, [w0]
    ld   [num_h], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [w1]
    ld   [num_l], ac
    sub  [w0], ac
    ld   ac, [num_l]
    ld   [num_h], ac
    bcc  nms_0
    dec
nms_0:
    sub  [w1], ac
    ld   ac, [num_h]
    RET

