; ============================================================
; boing.masm - the Amiga Boing Ball on the Placard (made by gen_boing.py:
;   change that and run it again; see its docstring)
; Date: 10/28/2026
; ============================================================

#include "placard.asm"
#include "placard_lib.asm"

xr       = 0x60
ny       = 0x61
oy       = 0x62
bx       = 0x63
dir      = 0x64
ph       = 0x65
php      = 0x66
tb       = 0x67
hc       = 0x68
w_r      = 0x69
w_rend   = 0x6A
w_i      = 0x6B
w_k      = 0x6C
w_kend   = 0x6D
w_d      = 0x6E
w_dend   = 0x6F
w_del    = 0x70
w_v      = 0x71
w_pg     = 0x72
w_sp     = 0x73
w_so     = 0x74
lastf    = 0x75
secf     = 0x76
lps      = 0x77
fps      = 0x78
w_t      = 0x79

.prefix bo


.region 0x0100, 0x0C00
.chunk                          ; frame: wait for the wrap, the column pages, the rows to draw
frame:
fr_w:
    ld   0x50, y               ; tick: line read (V9:V2)
    ld   [y,x], ac
    ld   ac, [w_t]
    sub  [LINE_LAST], ac
    ld   [w_t], ac
    ld   ac, [LINE_LAST]
    bcc  tk_1
    ld   [FRAME_LO], ac
    inc
    ld   ac, [FRAME_LO]
    bcc  tk_1
    ld   [FRAME_HI], ac
    inc
    ld   ac, [FRAME_HI]
tk_1:
    ld   [FRAME_LO], ac
    xor  [lastf], ac
    beq  fr_w
    ld   [FRAME_LO], ac
    ld   ac, [lastf]
fr_go:
    ld   0xFF, ac
    ld   0x50, y
    ld   ac, [y,x]
    ld   [bx], ac
    shl
    add  0x5D, ac             ; the page of column bx - 2
    ld   ac, [0x40]
    add  2, ac
    ld   ac, [0x41]
    add  2, ac
    ld   ac, [0x42]
    add  2, ac
    ld   ac, [0x43]
    add  2, ac
    ld   ac, [0x44]
    add  2, ac
    ld   ac, [0x45]
    add  2, ac
    ld   ac, [0x46]
    add  2, ac
    ld   ac, [0x47]
    add  2, ac
    ld   ac, [0x48]
    add  2, ac
    ld   ac, [0x49]
    add  2, ac
    ld   ac, [0x4A]
    add  2, ac
    ld   ac, [0x4B]
    add  2, ac
    ld   ac, [0x4C]
    add  2, ac
    ld   ac, [0x4D]
    add  2, ac
    ld   ac, [0x4E]
    add  2, ac
    ld   ac, [0x4F]
    add  2, ac
    ld   ac, [0x50]
    add  2, ac
    ld   ac, [0x51]
    add  2, ac
    ld   ac, [0x52]
    add  2, ac
    ld   ac, [0x53]
    add  2, ac
    ld   ac, [0x54]
    add  2, ac
    ld   ac, [0x55]
    add  2, ac
    ld   ac, [0x56]
    add  2, ac
    ld   ac, [0x57]
    add  2, ac
    ld   ac, [0x58]
    add  2, ac
    ld   ac, [0x59]
    add  2, ac
    ld   ac, [0x5A]
    add  2, ac
    ld   ac, [0x5B]
    add  2, ac
    ld   ac, [0x5C]
    add  2, ac
    ld   ac, [0x5D]
    add  2, ac
    ld   ac, [0x5E]
    add  2, ac
    ld   ac, [0x5F]
    ld   [oy], ac
    sub  [ny], ac
    blt  fr_o
    ld   [ny], ac
    ld   ac, [w_r]
    ld   [oy], ac
    bra  fr_e
fr_o:
    ld   [oy], ac
    ld   ac, [w_r]
    ld   [ny], ac
fr_e:
    add  50, ac
    ld   ac, [w_rend]
    GOTO row

.chunk                          ; wrow: RB into the picture, the next row
wrow:
    ld   [xr], x
    ld   [0x40], y
    ld   [0x20], ac
    ld   ac, [y,x]
    ld   [0x41], y
    ld   [0x21], ac
    ld   ac, [y,x]
    ld   [0x42], y
    ld   [0x22], ac
    ld   ac, [y,x]
    ld   [0x43], y
    ld   [0x23], ac
    ld   ac, [y,x]
    ld   [0x44], y
    ld   [0x24], ac
    ld   ac, [y,x]
    ld   [0x45], y
    ld   [0x25], ac
    ld   ac, [y,x]
    ld   [0x46], y
    ld   [0x26], ac
    ld   ac, [y,x]
    ld   [0x47], y
    ld   [0x27], ac
    ld   ac, [y,x]
    ld   [0x48], y
    ld   [0x28], ac
    ld   ac, [y,x]
    ld   [0x49], y
    ld   [0x29], ac
    ld   ac, [y,x]
    ld   [0x4A], y
    ld   [0x2A], ac
    ld   ac, [y,x]
    ld   [0x4B], y
    ld   [0x2B], ac
    ld   ac, [y,x]
    ld   [0x4C], y
    ld   [0x2C], ac
    ld   ac, [y,x]
    ld   [0x4D], y
    ld   [0x2D], ac
    ld   ac, [y,x]
    ld   [0x4E], y
    ld   [0x2E], ac
    ld   ac, [y,x]
    ld   [0x4F], y
    ld   [0x2F], ac
    ld   ac, [y,x]
    ld   [0x50], y
    ld   [0x30], ac
    ld   ac, [y,x]
    ld   [0x51], y
    ld   [0x31], ac
    ld   ac, [y,x]
    ld   [0x52], y
    ld   [0x32], ac
    ld   ac, [y,x]
    ld   [0x53], y
    ld   [0x33], ac
    ld   ac, [y,x]
    ld   [0x54], y
    ld   [0x34], ac
    ld   ac, [y,x]
    ld   [0x55], y
    ld   [0x35], ac
    ld   ac, [y,x]
    ld   [0x56], y
    ld   [0x36], ac
    ld   ac, [y,x]
    ld   [0x57], y
    ld   [0x37], ac
    ld   ac, [y,x]
    ld   [0x58], y
    ld   [0x38], ac
    ld   ac, [y,x]
    ld   [0x59], y
    ld   [0x39], ac
    ld   ac, [y,x]
    ld   [0x5A], y
    ld   [0x3A], ac
    ld   ac, [y,x]
    ld   [0x5B], y
    ld   [0x3B], ac
    ld   ac, [y,x]
    ld   [0x5C], y
    ld   [0x3C], ac
    ld   ac, [y,x]
    ld   [0x5D], y
    ld   [0x3D], ac
    ld   ac, [y,x]
    ld   [0x5E], y
    ld   [0x3E], ac
    ld   ac, [y,x]
    ld   [0x5F], y
    ld   [0x3F], ac
    ld   ac, [y,x]
row_done:
    ld   [w_r], ac
    add  1, ac
    ld   ac, [w_r]
    xor  [w_rend], ac
    beq  wr_e
    GOTO row
wr_e:
    GOTO move

.chunk                          ; row: this row's byte offsets, then the clean background into RB
row:
    ld   0x0C, y
    ld   [w_r], x
    ld   [y,x], ac
    ld   ac, [xr]
    and  0x7F, x
    ld   [0x40], y
    ld   [y,x], ac
    ld   ac, [0x20]
    ld   [0x41], y
    ld   [y,x], ac
    ld   ac, [0x21]
    ld   [0x42], y
    ld   [y,x], ac
    ld   ac, [0x22]
    ld   [0x43], y
    ld   [y,x], ac
    ld   ac, [0x23]
    ld   [0x44], y
    ld   [y,x], ac
    ld   ac, [0x24]
    ld   [0x45], y
    ld   [y,x], ac
    ld   ac, [0x25]
    ld   [0x46], y
    ld   [y,x], ac
    ld   ac, [0x26]
    ld   [0x47], y
    ld   [y,x], ac
    ld   ac, [0x27]
    ld   [0x48], y
    ld   [y,x], ac
    ld   ac, [0x28]
    ld   [0x49], y
    ld   [y,x], ac
    ld   ac, [0x29]
    ld   [0x4A], y
    ld   [y,x], ac
    ld   ac, [0x2A]
    ld   [0x4B], y
    ld   [y,x], ac
    ld   ac, [0x2B]
    ld   [0x4C], y
    ld   [y,x], ac
    ld   ac, [0x2C]
    ld   [0x4D], y
    ld   [y,x], ac
    ld   ac, [0x2D]
    ld   [0x4E], y
    ld   [y,x], ac
    ld   ac, [0x2E]
    ld   [0x4F], y
    ld   [y,x], ac
    ld   ac, [0x2F]
    ld   [0x50], y
    ld   [y,x], ac
    ld   ac, [0x30]
    ld   [0x51], y
    ld   [y,x], ac
    ld   ac, [0x31]
    ld   [0x52], y
    ld   [y,x], ac
    ld   ac, [0x32]
    ld   [0x53], y
    ld   [y,x], ac
    ld   ac, [0x33]
    ld   [0x54], y
    ld   [y,x], ac
    ld   ac, [0x34]
    ld   [0x55], y
    ld   [y,x], ac
    ld   ac, [0x35]
    ld   [0x56], y
    ld   [y,x], ac
    ld   ac, [0x36]
    ld   [0x57], y
    ld   [y,x], ac
    ld   ac, [0x37]
    ld   [0x58], y
    ld   [y,x], ac
    ld   ac, [0x38]
    ld   [0x59], y
    ld   [y,x], ac
    ld   ac, [0x39]
    ld   [0x5A], y
    ld   [y,x], ac
    ld   ac, [0x3A]
    ld   [0x5B], y
    ld   [y,x], ac
    ld   ac, [0x3B]
    ld   [0x5C], y
    ld   [y,x], ac
    ld   ac, [0x3C]
    ld   [0x5D], y
    ld   [y,x], ac
    ld   ac, [0x3D]
    ld   [0x5E], y
    ld   [y,x], ac
    ld   ac, [0x3E]
    ld   [0x5F], y
    ld   [y,x], ac
    ld   ac, [0x3F]
    GOTO shad

.chunk                          ; ball: this phase's bytes of the row over RB
ball:
    ld   [w_r], ac
    sub  [ny], ac
    ld   ac, [w_i]
    blt  bl_no
    sub  48, ac
    blt  bl_go
bl_no:
    GOTO wrow
bl_go:
    ld   0x0D, y
    ld   [w_i], x
    ld   [y,x], ac
    ld   ac, [w_k]
    ld   [w_i], ac
    add  0x30, x
    ld   [y,x], ac
    ld   ac, [w_kend]
    ld   [w_i], ac
    add  0xC0, x
    ld   [y,x], ac
    ld   ac, [w_d]
    sub  [w_k], ac
    ld   ac, [w_del]           ; data index - RB address
    ld   [w_kend], ac
    add  [w_del], ac
    ld   ac, [w_dend]
    ld   [w_i], ac
    add  0x60, x
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_i], ac
    add  0x90, x
    ld   [y,x], ac
    add  [php], y              ; the row's page in this phase
    ld   [w_v], ac
    beq  bl_full
    ld   [w_d], x              ; left half byte: the ball's right pixel
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_k], x
    ld   [x], ac
    and  0x0F, ac
    or   [w_v], ac
    ld   ac, [x]
    ld   [w_dend], ac          ; right half byte: the ball's left pixel
    sub  1, x
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_kend], ac
    sub  1, x
    ld   [x], ac
    and  0xF0, ac
    or   [w_v], ac
    ld   ac, [x]
    ld   [w_d], ac
    add  1, ac
    ld   ac, [w_d]
    ld   [w_dend], ac
    sub  1, ac
    ld   ac, [w_dend]
bl_full:
    ld   [w_d], ac
    xor  [w_dend], ac
    beq  bl_d
bl_lp:
    ld   [w_d], x
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_d], ac
    sub  [w_del], x
    ld   [w_v], ac
    ld   ac, [x]
    ld   [w_d], ac
    add  1, ac
    ld   ac, [w_d]
    xor  [w_dend], ac
    bne  bl_lp
bl_d:
    GOTO wrow

.chunk                          ; count: frames a second on the second text row, keys, the menu hook
count:
    ld   [lps], ac
    add  1, ac
    ld   ac, [lps]
    ld   [FRAME_LO], ac
    sub  [secf], ac
    sub  60, ac
    bcs  ct_k
    ld   [secf], ac
    add  60, ac
    ld   ac, [secf]
    ld   [lps], ac
    ld   ac, [fps]
    ld   0, ac
    ld   ac, [lps]
    ld   ac, [CUR_COL]
    ld   1, ac
    ld   ac, [CUR_ROW]
    ld   s_fps & 0xFF, ac
    ld   ac, [R0]
    ld   s_fps >> 8, ac
    ld   ac, [R1]
    CALL con_puts
    ld   [fps], ac
    CALL con_dec8
    ld   s_sp & 0xFF, ac
    ld   ac, [R0]
    ld   s_sp >> 8, ac
    ld   ac, [R1]
    CALL con_puts
ct_k:
fe_mark:
    CALL kbd_scan
    CALL menu_poll
    GOTO frame

.chunk                          ; shad: the shadow's span of this row darkened
shad:
    ld   [w_r], ac
    sub  [ny], ac
    sub  2, ac
    ld   ac, [w_i]
    blt  sh_no
    sub  48, ac
    blt  sh_go
sh_no:
    GOTO ball
sh_go:
    ld   0x0D, y
    ld   [w_i], x
    ld   [y,x], ac
    add  4, ac
    ld   ac, [w_k]
    ld   [w_i], ac
    add  0x30, x
    ld   [y,x], ac
    add  4, ac
    ld   ac, [w_kend]
    ld   [w_i], ac
    add  0x60, x
    ld   [y,x], ac
    beq  sh_full
    ld   [w_k], x              ; left half byte: its right pixel
    ld   [x], ac
    ld   ac, x
    ld   0x11, y
    ld   [y,x], ac
    ld   [w_k], x
    ld   ac, [x]
    ld   [w_kend], ac          ; right half byte: its left pixel
    sub  1, x
    ld   [x], ac
    ld   ac, x
    ld   0x10, y
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_kend], ac
    sub  1, x
    ld   [w_v], ac
    ld   ac, [x]
    ld   [w_k], ac
    add  1, ac
    ld   ac, [w_k]
    ld   [w_kend], ac
    sub  1, ac
    ld   ac, [w_kend]
sh_full:
    ld   [w_k], ac
    xor  [w_kend], ac
    beq  sh_d
    ld   0x0F, y
sh_lp:
    ld   [w_k], x
    ld   [x], ac
    ld   ac, x
    ld   [y,x], ac
    ld   [w_k], x
    ld   ac, [x]
    ld   [w_k], ac
    add  1, ac
    ld   ac, [w_k]
    xor  [w_kend], ac
    bne  sh_lp
sh_d:
    GOTO ball

.chunk                          ; bgb: the background rows, into the picture and the clean copy
bgb:
    ld   4, ac
    ld   ac, [w_r]
bg_row:
    ld   0x0C, y
    ld   [w_r], x
    ld   [y,x], ac
    ld   ac, [xr]
    ld   0x0E, y
    ld   [y,x], ac
    ld   ac, [w_sp]
    ld   [w_r], ac
    add  0x80, x
    ld   [y,x], ac
    ld   ac, [w_so]
    ld   0x61, ac
    ld   ac, [w_pg]
bg_col:
    ld   [w_sp], y
    ld   [w_so], x
    ld   [y,x], ac
    ld   ac, [w_v]
    ld   [w_pg], y
    ld   [xr], x
    ld   [w_v], ac
    ld   ac, [y,x]
    ld   [xr], ac
    and  0x7F, x
    ld   [w_v], ac
    ld   ac, [y,x]
    ld   [w_so], ac
    add  1, ac
    ld   ac, [w_so]
    ld   [w_pg], ac
    add  2, ac
    ld   ac, [w_pg]
    xor  0x01, ac
    bne  bg_col
    ld   [w_r], ac
    add  1, ac
    ld   ac, [w_r]
    xor  120, ac
    bne  bg_row
    GOTO init

.chunk                          ; move: the next frame's place and phase
move:
    ld   0x07, ac
    ld   0x50, y
    ld   ac, [y,x]
    ld   [ny], ac
    ld   ac, [oy]
    ld   [tb], ac
    add  1, ac
    and  63, ac
    ld   ac, [tb]
    ld   0x0C, y
    add  0x80, x
    ld   [y,x], ac
    ld   ac, [ny]
    ld   [hc], ac
    add  1, ac
    ld   ac, [hc]
    xor  2, ac
    bne  mv_s
    ld   ac, [hc]
    ld   [bx], ac
    add  [dir], ac
    ld   ac, [bx]
    xor  50, ac
    bne  mv_l
    ld   255, ac
    ld   ac, [dir]
    bra  mv_s
mv_l:
    xor  48, ac
    bne  mv_s
    ld   1, ac
    ld   ac, [dir]
mv_s:
    ld   [ph], ac
    add  [dir], ac
    and  7, ac
    ld   ac, [ph]
    shl
    shl
    add  0x20, ac
    ld   ac, [php]
    GOTO count

.chunk                          ; init: the ball's state
init:
    ld   20, ac
    ld   ac, [bx]
    ld   1, ac
    ld   ac, [dir]
    ld   0, ac
    ld   ac, [tb]
    ld   ac, [hc]
    ld   ac, [ph]
    ld   ac, [lps]
    ld   ac, [fps]
    ld   0x20, ac
    ld   ac, [php]
    ld   62, ac
    ld   ac, [ny]
    ld   ac, [oy]
    ld   [FRAME_LO], ac
    ld   ac, [lastf]
    ld   ac, [secf]
    GOTO frame

.fixed 0x0100                    ; main: the screen, the background, the state
main:
    ld   STACK_TOP, ac
    ld   ac, [SP]
    ld   0x07, ac
    ld   ac, [MAP_SHADOW]
    ld   0x0A, ac
    CALL vid_clear
    ld   0x5A, y
    ld   0x20, ac
mn_m:
    ld   ac, x
    ld   0x40, [y,x]
    add  1, ac
    xor  0x30, ac
    beq  mn_d
    xor  0x30, ac
    bra  mn_m
mn_d:
    ld   0, ac
    ld   ac, [CUR_COL]
    ld   ac, [CUR_ROW]
    ld   s_title & 0xFF, ac
    ld   ac, [R0]
    ld   s_title >> 8, ac
    ld   ac, [R1]
    CALL con_puts
    GOTO bgb

.fixed 0x0C00                    ; ROW4 (x00), the bounce (x80)
    #d8 0xA0, 0xA4, 0xA8, 0xAC, 0xB0, 0xB4, 0xB8, 0xBC, 0xC0, 0xC4, 0xC8, 0xCC, 0xD0, 0xD4, 0xD8, 0xDC
    #d8 0xE0, 0xE4, 0xE8, 0xEC, 0xF0, 0xF4, 0xF8, 0xFC, 0x81, 0x85, 0x89, 0x8D, 0x91, 0x95, 0x99, 0x9D
    #d8 0xA1, 0xA5, 0xA9, 0xAD, 0xB1, 0xB5, 0xB9, 0xBD, 0xC1, 0xC5, 0xC9, 0xCD, 0xD1, 0xD5, 0xD9, 0xDD
    #d8 0xE1, 0xE5, 0xE9, 0xED, 0xF1, 0xF5, 0xF9, 0xFD, 0x82, 0x86, 0x8A, 0x8E, 0x92, 0x96, 0x9A, 0x9E
    #d8 0xA2, 0xA6, 0xAA, 0xAE, 0xB2, 0xB6, 0xBA, 0xBE, 0xC2, 0xC6, 0xCA, 0xCE, 0xD2, 0xD6, 0xDA, 0xDE
    #d8 0xE2, 0xE6, 0xEA, 0xEE, 0xF2, 0xF6, 0xFA, 0xFE, 0x83, 0x87, 0x8B, 0x8F, 0x93, 0x97, 0x9B, 0x9F
    #d8 0xA3, 0xA7, 0xAB, 0xAF, 0xB3, 0xB7, 0xBB, 0xBF, 0xC3, 0xC7, 0xCB, 0xCF, 0xD3, 0xD7, 0xDB, 0xDF
    #d8 0xE3, 0xE7, 0xEB, 0xEF, 0xF3, 0xF7, 0xFB, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    #d8 0x3E, 0x3B, 0x37, 0x34, 0x31, 0x2E, 0x2C, 0x29, 0x26, 0x24, 0x22, 0x1F, 0x1D, 0x1B, 0x19, 0x17
    #d8 0x16, 0x14, 0x12, 0x11, 0x10, 0x0E, 0x0D, 0x0C, 0x0B, 0x0B, 0x0A, 0x09, 0x09, 0x08, 0x08, 0x08
    #d8 0x08, 0x08, 0x08, 0x08, 0x09, 0x09, 0x0A, 0x0B, 0x0B, 0x0C, 0x0D, 0x0E, 0x10, 0x11, 0x12, 0x14
    #d8 0x16, 0x17, 0x19, 0x1B, 0x1D, 0x1F, 0x22, 0x24, 0x26, 0x29, 0x2C, 0x2E, 0x31, 0x34, 0x37, 0x3B
s_title:
    #d "PLACARD BOING BALL    ESC: DOS", 0x00
s_fps:
    #d "FPS ", 0x00
s_sp:
    #d " ", 0x00

