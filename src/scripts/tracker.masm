; ============================================================
; tracker.masm - TRACKER.PLC: the PLACARD music editor (docs/MUSIC.md)
; ============================================================
;
; A library program the DOS runs from the card.  It edits a song for the
; music player (placard_mus.masm) on the machine: the orderlists, the
; patterns of the four voices side by side, the instruments and the wave
; and pulse tables, plays it while editing, and loads and saves .SNG
; files on the card (the same files mus_tool.py makes).  It starts with
; DEMO.SNG when the card has it, else with a blank song.
;
; The screen is 80 x 30 text on 2x lines (VIDEO.md, line repeat): the
; editor and the player are more code than the RAM beside a 1x screen
; holds, and the even video pages that 2x frees hold most of the code and
; the patterns.
;
;
;   row 0        the header: file, title, octave, instrument, mode, state
;   rows 2-10    left: the orderlists (8 positions, the > marks the one
;                shown below); right: the instrument and its fields
;   row 12-13    the pattern's title and the voice columns
;   rows 14-     the four voices' patterns at the order position, a row
;                per line: note, instrument, effect (or the wave or
;                pulse table when that pane is shown)
;   rows -2, -1  the status line and the keys
;
; Tints: the header and the keys gold, the active pane's cursor row blue,
; the row being played green (cyan when the cursor follows it).
;
; Memory.  TRACKER.PLC loads at x0100-x3DFF (code to x33FF, then the
; player's tables); the rest of the code is TRACKER.OVL, which main reads
; into the even pages xA8, xAA ... xFE (gen_plc.py --overlay).  Every
; pattern has a 256-byte slot of its own: the 40 slots are the even pages
; x60 ... xA6 and the RAM pages x57, x58, x59, x5C.  The song's header
; pages (title, tables, instruments, custom waves) are at x4800-x4CFF and
; the orderlists at x5600 (64 bytes a voice); the player reads the
; patterns where they are through the offsets in page 0, which this
; program keeps.  The decoded form of the orderlists is in the player's
; own state pages (x4310-x436D and the same in the next three pages); a
; pattern being edited is decoded into x5400 (64 rows x 4 bytes);
; x5400-x55FF is the file buffer while loading and saving.
;
; The map.  The CPU reads the ROM above x6000 under the map a library
; program runs with (07), so this program sets the map to FF (every
; section RAM) and goes back to 07 only inside the l_* stubs below, which
; wrap each library and DOS routine it calls, and in tputc while it reads
; the font.  LEAVE goes to tr_leave, a copy of lib_leave in the RAM.  The
; stubs, tr_leave, tputc, ovl_load and exit_dos must therefore sit below
; x3400 (they do: they come first in the file).
;
; Keys (no function keys on the 63-key layout; Ctrl-Q/R/S/T are the
; arrows, so the file keys are Ctrl-O, Ctrl-W, Ctrl-N, Ctrl-E, Ctrl-X):
;
;   Z-M , L .      notes, the lower octave      Q-I 9 O 0 P  the upper
;   1              key off (note column)        - =          octave
;   < >            the instrument for new notes
;   Tab            next pane: pattern, order, instrument, wave, pulse
;   arrows         move                         Del, Backspace  clear
;   0-9 A-F        a hex digit into the field under the cursor
;   [ ]            order pane: transpose; instrument and table panes: -1 +1
;   I / L / S      order pane: insert a position / loop here / stop here
;   Enter          play the song from the start
;   Space          play from the order position shown (stop when playing)
;   Esc            stop
;   Ctrl-L         pattern length 64 > 16 > 32 > 64
;   Ctrl-O / W     load / save a .SNG (the name is asked on the status row)
;   Ctrl-N         a blank song
;   Ctrl-X         back to the DOS (twice when the song is not saved)
;
;     python3 asm_expand.py tracker.masm              tracker.asm
;     python3 gen_plc.py tracker.asm -o ../../sdcard/TRACKER.PLC --overlay 0xA800,2
;                                                     (and TRACKER.OVL)
;     python3 test_tracker.py                         runs it in placard_sim
;
; Date: 11/02/2026
; ============================================================

#include "placard.asm"
#include "placard_lib.asm"

MUS_TABLES = 0x3400         ; the player's tables, 10 pages (in the file)
MUS_RAM    = 0x3E00         ; the player's RAM, 10 pages
VSPAGE     = (MUS_RAM >> 8) + 5   ; voice state pages (voice v at VSPAGE + v)
SONG       = 0x4800         ; the song's header pages 0-4
OLIST      = 0x5600         ; the encoded orderlists, voice v at v x 64
EMPTY_LO   = 0x07           ; SONG + 7 holds FF: the pattern of unused slots
OLH        = (OLIST - SONG) >> 8   ; the orderlists' offset, high byte
OVL_PAGE   = 0xA8           ; the overlay's first page (every 2nd page from there)
CAP        = 40             ; pattern slots
CAP_VID    = 36             ; of them in the video pages x60 + 2n; the rest in ramsl
SLOT_LO    = 0              ; a slot's low byte (256-byte slots)
ROWS       = 30             ; text rows
PV         = 14             ; pattern rows shown
SCRATCH    = 0x5400         ; the decoded pattern: 64 rows x 4 bytes
ENCBUF     = 0x5500         ; a pattern being encoded
FBUF       = 0x5400         ; 512-byte file buffer (both pages) while loading, saving
PTAB_PG    = 0x5D           ; slot table: x5D00 + n = page, x5D40 + n = low byte
PTAB_HI    = 0x00
PTAB_LO    = 0x40
FS_REM_LO  = 0x4D28         ; the FAT reader's bytes left (placard_fs.asm V_REM)
FS_REM_HI  = 0x4D29
dos_back   = 0x8008
fs_create  = 0x8010         ; the DOS's FAT writer (docs/DOS.md)
fs_write   = 0x8014
fs_close   = 0x8018

; decoded orderlists, in the voice state pages (below the player's x76)
OD_PAT  = 0x10              ; + 2k: pattern of position k (k < 30)
OD_TR   = 0x11              ; + 2k: its transpose (signed)
OD_LEN  = 0x4C              ; positions
OD_END  = 0x4D              ; FE stop, FF loop
OD_TGT  = 0x4E              ; the loop's position
OD_OFF  = 0x50              ; + k: byte offset of position k in the encoded list (k <= len)
OD_MAX  = 30

; the decoded pattern: SCRATCH + 4 x row
D_NOTE = 0                  ; 00-5F, 60 key off, 61 none
D_INS  = 1                  ; FF none
D_FX   = 2                  ; FF none
D_PAR  = 3

; instrument bytes
I_AD = 0
I_SR = 1
I_WAVE = 2
I_PULSE = 3
I_PW = 4
I_FLAGS = 5
I_VDLY = 6
I_VIB = 7
I_VOL = 8
I_NAME = 9

; screen
ROW_HDR  = 0
ROW_ORD  = 3                ; first of 8 orderlist rows (titles on row 2)
ROW_INS  = 2                ; instrument panel rows 2-8
COL_INS  = 40
ROW_PTIT = 12
ROW_GRID = 14               ; first pattern row
COL_GRID = 6                ; voice 0's cell; a voice is 12 columns
ORD_ROWS = 8

TINT_GOLD  = 0x30
TINT_BLUE  = 0x40
TINT_GREEN = 0x20

; zero page x20-x5F
e_res   = 0x20              ; load_cmd: load_song's result across the redraw
e_pane  = 0x23              ; 0 pattern, 1 order, 2 instrument, 3 wave, 4 pulse
e_oct   = 0x26
e_ins   = 0x27
e_op    = 0x28              ; order position shown
e_otop  = 0x29              ; first order position on the screen
c_v     = 0x2A              ; pattern cursor: voice
c_row   = 0x2B              ;   row
c_col   = 0x2C              ;   column 0 note, 1-2 instrument, 3 effect, 4-5 parameter
c_top   = 0x2D              ; first pattern row on the screen
o_v     = 0x2E              ; order cursor: voice
o_k     = 0x2F              ;   position
o_f     = 0x30              ;   0 pattern, 1 transpose
i_f     = 0x31              ; instrument field 0-11
t_e     = 0x32              ; table entry 1-63
t_f     = 0x33              ; table side 0 left, 1 right
e_play  = 0x34
e_dirty = 0x35              ; 01 grid, 02 order, 04 instrument, 08 header, 10 table, 20 title
e_drow  = 0x36              ; grid draw: next voice column
p_len   = 0x37              ; rows of the decoded pattern
p_pat   = 0x38              ; which pattern SCRATCH holds (FF none)
e_plop  = 0x39              ; the position voice 1 plays (FF none)
e_plrow = 0x3A              ; the row it plays
s_col   = 0x3B              ; status: the column after its string (prompt)
e_mod   = 0x3C              ; the song changed since it was saved
e_key   = 0x3D
e_name  = 0x3E              ; x3E-x4A: the file name and a 00
p_ch    = 0x4B              ; text output
p_k     = 0x4C
p_pg    = 0x4D
p_off   = 0x4E
p_st    = 0x4F
u0 = 0x50                   ; scratch, the lower routines
u1 = 0x51
u2 = 0x52
u3 = 0x53
u4 = 0x54
u5 = 0x55
u6 = 0x56
u7 = 0x57
w0 = 0x58                   ; scratch, the higher routines
w1 = 0x59
w2 = 0x5A
w3 = 0x5B
w4 = 0x5C
w5 = 0x5D
i_np    = 0x5E              ; the name character being typed
e_fl    = 0x5F              ; bit 0: Ctrl-X pressed once

; MAP07 / MAPFF - the map register (x5000): the library's map, all RAM
.macro MAP07
    ld   0x50, y
    clr  x
    ld   0x07, [y,x]
.endm
.macro MAPFF
    ld   0x50, y
    clr  x
    ld   0xFF, [y,x]
.endm

.prefix tr
.leave tr_leave
.region 0x0100, 0x1F00      ; the regions, in the order chunks spill over
.region 0x2000, MUS_TABLES
.region OVL_PAGE << 8, 0x10000, 2, overlay
.region 0x0100, 0x1F00

; ============================================================
; main
; ============================================================
.fixed 0x0100
main:
    ld   STACK_TOP, ac
    ld   ac, [SP]
    ld   0x07, ac
    ld   ac, [MAP_SHADOW]
    CALL l_fs_mount
    CALL ovl_load
    MAPFF
    clr  ac
    ld   ac, [e_pane]
    ld   ac, [e_ins]
    ld   ac, [e_op]
    ld   ac, [e_otop]
    ld   ac, [c_v]
    ld   ac, [c_row]
    ld   ac, [c_col]
    ld   ac, [c_top]
    ld   ac, [o_v]
    ld   ac, [o_k]
    ld   ac, [o_f]
    ld   ac, [i_f]
    ld   ac, [t_f]
    ld   ac, [e_play]
    ld   ac, [e_mod]
    ld   ac, [e_fl]
    ld   ac, [i_np]
    ld   1, ac
    ld   ac, [t_e]
    ld   4, ac
    ld   ac, [e_oct]
    ld   0xFF, ac
    ld   ac, [p_pat]
    ld   ac, [e_plop]
    ld   ac, [e_plrow]
    CALL set_slots
    CALL clear_screen
    CALL new_song
    ld   s_demo & 0xFF, ac      ; DEMO.SNG when the card has it
    ld   ac, [R0]
    ld   s_demo >> 8, ac
    ld   ac, [R1]
    CALL copy_name
    CALL load_song
    CALL redraw_all
    GOTO loop

; ============================================================
; the frame loop
; ============================================================
.chunk
loop:
    ld   1, ac
    CALL l_wait_frames
    CALL mus_frame
    CALL l_kbd_scan
    CALL follow
    CALL l_kbd_getc
    beq  lp_draw
    ld   ac, [e_key]
    CALL handle_key
lp_draw:
    CALL draw_step
    GOTO loop

; the file names the library reads (it runs under map 07, so they must be
; below x6000, not in the overlay)
.chunk
s_ovl:
    #d "TRACKER.OVL", 0x00
s_demo:
    #d "DEMO.SNG", 0x00

; ------------------------------------------------------------
; tr_leave - the library's lib_leave (LEAVE) copied into the RAM: the
; ROM is mapped out while this program runs
; ------------------------------------------------------------
.chunk
tr_leave:
    ld   ac, [SAVE_AC]
    ld   [SP], ac
    inc
    ld   ac, x
    inc
    ld   ac, [SP]
    ld   [x], ac
    ld   ac, [LINK_LO]
    ld   [SP], x
    ld   [x], ac
    ld   ac, y
    ld   [SAVE_AC], ac
    jmp  [LINK_LO]

; ------------------------------------------------------------
; l_* - the library and DOS routines, called under the library's map
; (see the header); exit_dos - back to the DOS under its map
; ------------------------------------------------------------
.chunk
l_wait_frames:
    PUSH_LINK
    MAP07
    CALL wait_frames
    MAPFF
    LEAVE

.chunk
l_kbd_scan:
    PUSH_LINK
    MAP07
    CALL kbd_scan
    MAPFF
    LEAVE

.chunk
l_kbd_getc:
    PUSH_LINK
    MAP07
    CALL kbd_getc
    MAPFF
    LEAVE

.chunk
l_fs_mount:
    PUSH_LINK
    MAP07
    CALL fs_mount
    MAPFF
    LEAVE

.chunk
l_fs_open:
    PUSH_LINK
    MAP07
    CALL fs_open
    MAPFF
    LEAVE

.chunk
l_fs_read:
    PUSH_LINK
    MAP07
    CALL fs_read
    MAPFF
    LEAVE

.chunk
l_fs_create:
    PUSH_LINK
    MAP07
    CALL fs_create
    MAPFF
    LEAVE

.chunk
l_fs_write:
    PUSH_LINK
    MAP07
    CALL fs_write
    MAPFF
    LEAVE

.chunk
l_fs_close:
    PUSH_LINK
    MAP07
    CALL fs_close
    MAPFF
    LEAVE

.chunk
l_vid_mode:
    PUSH_LINK
    MAP07
    CALL vid_mode
    MAPFF
    LEAVE

.chunk
l_vid_clear:
    PUSH_LINK
    MAP07
    CALL vid_clear
    MAPFF
    LEAVE

.chunk
exit_dos:
    MAP07
    GOTO dos_back

; ------------------------------------------------------------
; ovl_load - TRACKER.OVL (the code gen_plc.py put in the overlay) into
; the even pages from OVL_PAGE: a sector holds two of them
; ------------------------------------------------------------
.chunk
ovl_load:
    PUSH_LINK
    ld   s_ovl & 0xFF, ac
    ld   ac, [R0]
    ld   s_ovl >> 8, ac
    ld   ac, [R1]
    CALL l_fs_open
    bne  ov_e
    ld   OVL_PAGE, ac
    ld   ac, [u5]
ov_s:
    ld   FBUF & 0xFF, ac
    ld   ac, [R4]
    ld   FBUF >> 8, ac
    ld   ac, [R5]
    CALL l_fs_read
    bne  ov_e
    ld   FBUF >> 8, ac
    ld   ac, [u6]
    ld   2, ac
    ld   ac, [u7]
ov_p:
    clr  ac
    ld   ac, [u4]
ov_b:
    ld   [u6], y
    ld   [u4], x
    ld   [y,x], ac
    ld   [u5], y
    ld   ac, [y,x]
    ld   [u4], ac
    inc
    ld   ac, [u4]
    bne  ov_b
    ld   [u6], ac
    inc
    ld   ac, [u6]
    ld   [u5], ac
    add  2, ac
    ld   ac, [u5]
    beq  ov_e
    ld   [u7], ac
    dec
    ld   ac, [u7]
    bne  ov_p
    bra  ov_s
ov_e:
    LEAVE

; ------------------------------------------------------------
; set_slots - the slot table: slot n is the even video page x60 + 2n
; (n < CAP_VID), then the RAM pages in ramsl; low byte 0.  Then the
; song's offsets
; ------------------------------------------------------------
.chunk
set_slots:
    clr  ac
    ld   ac, [u0]
sls_l:
    ld   [u0], ac
    sub  CAP_VID, ac
    bcc  sls_r
    ld   [u0], ac
    shl
    add  0x60, ac
    bra  sls_p
sls_r:
    add  ramsl & 0xFF, x
    ld   ramsl >> 8, y
    ld   [y,x], ac
sls_p:
    ld   ac, [u1]
    ld   PTAB_PG, y
    ld   [u0], ac
    add  PTAB_HI, x
    ld   [u1], ac
    ld   ac, [y,x]
    ld   [u0], ac
    add  PTAB_LO, x
    ld   SLOT_LO, [y,x]
    ld   [u0], ac
    inc
    ld   ac, [u0]
    xor  CAP, ac
    bne  sls_l
    GOTO set_offsets

; the song's page 0: pattern n's offset = slot n - SONG (the empty pattern
; at SONG + 7 for n past the capacity); the orderlist offsets x500 + 64v;
; one subtune; byte 7 = FF (the empty pattern)
.chunk
set_offsets:
    clr  ac
    ld   ac, [u0]
so_l:
    ld   [u0], ac
    sub  CAP, ac
    bcc  so_e
    ld   PTAB_PG, y
    ld   [u0], ac
    add  PTAB_HI, x
    ld   [y,x], ac
    sub  SONG >> 8, ac
    ld   ac, [u1]
    ld   [u0], ac
    add  PTAB_LO, x
    ld   [y,x], ac
    ld   ac, [u2]
    bra  so_w
so_e:
    clr  ac
    ld   ac, [u1]
    ld   EMPTY_LO, ac
    ld   ac, [u2]
so_w:
    ld   SONG >> 8, y
    ld   [u0], ac
    add  0x80, x
    ld   [u2], ac
    ld   ac, [y,x]
    ld   [u0], ac
    add  0xC0, x
    ld   [u1], ac
    ld   ac, [y,x]
    ld   [u0], ac
    inc
    ld   ac, [u0]
    xor  64, ac
    bne  so_l
    ld   SONG >> 8, y
    ld   0x04, x
    ld   1, [y,x]
    ld   0x07, x
    ld   0xFF, [y,x]
    ld   0x41, x
    ld   0x00, [y,x]
    ld   0x42, x
    ld   OLH, [y,x]
    ld   0x43, x
    ld   0x40, [y,x]
    ld   0x44, x
    ld   OLH, [y,x]
    ld   0x45, x
    ld   0x80, [y,x]
    ld   0x46, x
    ld   OLH, [y,x]
    ld   0x47, x
    ld   0xC0, [y,x]
    ld   0x48, x
    ld   OLH, [y,x]
    RET

; ============================================================
; text output.  con_putc only knows the 1x screen, so the editor writes
; its own characters: tputc draws the glyph of AC at CUR_ROW, CUR_COL in
; the 1x or 2x layout (docs/VIDEO.md, "Line repeat") and moves on.
; ============================================================

; the address of the glyph's first byte: p_pg:p_off, p_st = the stride
.macro TADDR
    ld   [CUR_COL], ac
    shl
    add  0x61, ac
    ld   ac, [p_pg]
    ld   2, ac
    ld   ac, [p_st]
    ld   [CUR_ROW], ac
    sub  14, ac
    blt  ta_2a\@
    shl                         ; rows 14-29: 16 (r - 14) + 1
    shl
    shl
    shl
    inc
    ld   ac, [p_off]
    bra  ta_go\@
ta_2a\@:
    add  16, ac                 ; rows 0-13: 16 r + 32
    shl
    shl
    shl
    shl
    ld   ac, [p_off]
ta_go\@:
.endm

.chunk
tputc:
    ld   ac, [p_ch]
    ld   [CUR_COL], ac
    sub  80, ac
    bcc  tp_off                 ; past the right edge: nothing
    TADDR
    MAP07
    clr  ac
    ld   ac, [p_k]
tp_l:
    ld   [p_k], ac
    add  LIB_FONT >> 8, y
    ld   [p_ch], x
    ld   [y,x], ac
    ld   [p_pg], y
    ld   [p_off], x
    ld   ac, [y,x]
    ld   [p_off], ac
    add  [p_st], ac
    ld   ac, [p_off]
    ld   [p_k], ac
    inc
    ld   ac, [p_k]
    xor  8, ac
    bne  tp_l
    ld   [CUR_COL], ac
    inc
    ld   ac, [CUR_COL]
    MAPFF
tp_off:
    ld   [p_ch], ac             ; AC kept (callers print a character twice)
    RET

; tmark - underline AC characters from the cursor (the glyph's last line)
.chunk
tmark:
    ld   ac, [p_k]
tm_l:
    ld   [CUR_COL], ac
    sub  80, ac
    bcc  tm_off
    TADDR
    ld   [p_st], ac             ; + 7 x stride
    shl
    shl
    shl
    sub  [p_st], ac
    add  [p_off], ac
    ld   ac, x
    ld   [p_pg], y
    ld   0xFF, [y,x]
    ld   [CUR_COL], ac
    inc
    ld   ac, [CUR_COL]
    ld   [p_k], ac
    dec
    ld   ac, [p_k]
    bne  tm_l
tm_off:
    RET

; tputs - the string at R1:R0 (ending in 00)
.chunk
tputs:
    PUSH_LINK
ts_l:
    ld   [R1], y
    ld   [R0], x
    ld   [y,x], ac
    beq  ts_e
    CALL tputc
    ld   [R0], ac
    inc
    ld   ac, [R0]
    bne  ts_l
    ld   [R1], ac
    inc
    ld   ac, [R1]
    bra  ts_l
ts_e:
    LEAVE

; tspc - AC spaces
.chunk
tspc:
    PUSH_LINK
    ld   ac, [u7]
    beq  tsp_e
tsp_l:
    ld   0x20, ac
    CALL tputc
    ld   [u7], ac
    dec
    ld   ac, [u7]
    bne  tsp_l
tsp_e:
    LEAVE

; thex1 - the low nibble of AC as a hex digit
.chunk
thex1:
    PUSH_LINK
    and  15, ac
    add  hexdig & 0xFF, x
    ld   hexdig >> 8, y
    ld   [y,x], ac
    CALL tputc
    LEAVE

; thex2 - AC as two hex digits
.chunk
thex2:
    PUSH_LINK
    ld   ac, [u6]
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    CALL thex1
    ld   [u6], ac
    CALL thex1
    LEAVE

; tdec2 - AC (0-99) as two decimal digits
.chunk
tdec2:
    PUSH_LINK
    ld   ac, [u6]
    clr  ac
    ld   ac, [u5]
td_l:
    ld   [u6], ac
    sub  10, ac
    bcs  td_d
    ld   ac, [u6]
    ld   [u5], ac
    inc
    ld   ac, [u5]
    bra  td_l
td_d:
    ld   [u5], ac
    CALL thex1
    ld   [u6], ac
    CALL thex1
    LEAVE

; tsigned - AC as a signed byte: +nn / -nn (decimal)
.chunk
tsigned:
    PUSH_LINK
    ld   ac, [u4]
    blt  tsg_n
    ld   0x2B, ac
    CALL tputc
    ld   [u4], ac
    bra  tsg_d
tsg_n:
    ld   0x2D, ac
    CALL tputc
    clr  ac
    sub  [u4], ac
tsg_d:
    CALL tdec2
    LEAVE

; tnote - AC = a pattern note: C-4, === (key off), ... (none)
.chunk
tnote:
    PUSH_LINK
    ld   ac, [u4]
    sub  0x60, ac
    bcs  tn_n
    beq  tn_off
    ld   s_dots & 0xFF, ac
    ld   ac, [R0]
    ld   s_dots >> 8, ac
    ld   ac, [R1]
    CALL tputs
    LEAVE
tn_off:
    ld   s_koff & 0xFF, ac
    ld   ac, [R0]
    ld   s_koff >> 8, ac
    ld   ac, [R1]
    CALL tputs
    LEAVE
tn_n:
    GOTO tnote_name

.chunk
tnote_name:
    clr  ac                     ; octave = note / 12
    ld   ac, [u5]
tnn_o:
    ld   [u4], ac
    sub  12, ac
    bcs  tnn_d
    ld   ac, [u4]
    ld   [u5], ac
    inc
    ld   ac, [u5]
    bra  tnn_o
tnn_d:
    ld   [u4], ac
    add  [u4], ac
    add  notes & 0xFF, x
    ld   notes >> 8, y
    ld   [y,x], ac
    CALL tputc
    ld   [u4], ac
    add  [u4], ac
    add  (notes + 1) & 0xFF, x
    ld   notes >> 8, y
    ld   [y,x], ac
    CALL tputc
    ld   [u5], ac
    add  0x30, ac
    CALL tputc
    LEAVE

; tat - cursor to R2 = row, R3 = column
.chunk
tat:
    ld   [R2], ac
    ld   ac, [CUR_ROW]
    ld   [R3], ac
    ld   ac, [CUR_COL]
    RET

; tclr - AC spaces from the cursor; cursor back where it was
.chunk
tclr:
    PUSH_LINK
    ld   ac, [u3]
    ld   [CUR_COL], ac
    ld   ac, [u2]
    ld   [u3], ac
    CALL tspc
    ld   [u2], ac
    ld   ac, [CUR_COL]
    LEAVE

; ------------------------------------------------------------
; tint_row - AC = text row, R0 = tint bits: the row's 16 mode bytes
; (with the 2x line repeat bit)
; ------------------------------------------------------------
.chunk
tint_row:
    ld   ac, [u0]
    ld   [u0], ac               ; 2x: lines 16r .. 16r+15
    shl
    shl
    shl
    shl
    add  0x20, ac
    ld   ac, [u1]
    ld   0x5A, ac
    ld   ac, [u2]
    ld   [u0], ac
    sub  14, ac
    blt  tr_2a
    ld   0x5B, ac
    ld   ac, [u2]
tr_2a:
    ld   16, ac
    ld   ac, [u3]
    ld   [R0], ac
    or   0x04, ac
tr_go:
    ld   ac, [u4]
    ld   [u2], y
tr_l:
    ld   [u1], x
    ld   [u4], ac
    ld   ac, [y,x]
    ld   [u1], ac
    inc
    ld   ac, [u1]
    ld   [u3], ac
    dec
    ld   ac, [u3]
    bne  tr_l
    RET

; ------------------------------------------------------------
; clear_screen - the pixels in the odd pages (the text; the even pages
; hold patterns and code), the mode bytes: 2x, no tint
; ------------------------------------------------------------
.chunk
clear_screen:
    PUSH_LINK
    ld   0x61, ac
    ld   ac, [u0]
csc_p:
    ld   [u0], y
    clr  ac
csc_b:
    ld   ac, x
    ld   0x00, [y,x]
    inc
    bne  csc_b
    ld   [u0], ac
    add  2, ac
    ld   ac, [u0]
    xor  0x01, ac
    bne  csc_p
    ld   0x04, ac
    CALL l_vid_mode
    LEAVE

; ------------------------------------------------------------
; status - the string at R1:R0 on the status row, the rest cleared
; ------------------------------------------------------------
.chunk
status:
    PUSH_LINK
    ld   ROWS - 2, ac
    ld   ac, [CUR_ROW]
    ld   1, ac
    ld   ac, [CUR_COL]
    CALL tputs
    ld   [CUR_COL], ac
    ld   ac, [s_col]
    ld   80, ac
    sub  [CUR_COL], ac
    CALL tspc
    LEAVE

.chunk
status_clear:
    PUSH_LINK
    ld   s_empty & 0xFF, ac
    ld   ac, [R0]
    ld   s_empty >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE

; ============================================================
; the song: patterns in their slots, the decoded pattern, the orderlists
; ============================================================

; SLOTADDR - AC = pattern: u1 = page, u2 = low byte of its slot
.macro SLOTADDR
    ld   ac, [u0]
    ld   PTAB_PG, y
    add  PTAB_HI, x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   [u0], ac
    add  PTAB_LO, x
    ld   [y,x], ac
    ld   ac, [u2]
.endm

; slot_addr - the same as a routine (for callers that keep their link)
.chunk
slot_addr:
    SLOTADDR
    RET

; pat_of - AC = voice: AC = its pattern at e_op, FF when the orderlist
; is shorter
.chunk
pat_of:
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [e_op], ac
    sub  [y,x], ac
    bcc  po_n
    ld   [e_op], ac
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    RET
po_n:
    ld   0xFF, ac
    RET

; ------------------------------------------------------------
; decode_pat - AC = pattern: SCRATCH = its rows (p_len of them, the rest
; empty), p_pat = AC.  A blank slot (FF first) is 64 empty rows.
; ------------------------------------------------------------
.chunk
decode_pat:
    ld   ac, [p_pat]
    ld   SCRATCH >> 8, y
    clr  ac
    ld   ac, [u0]
dp_c:
    ld   [u0], ac
    ld   ac, x
    ld   0x61, [y,x]
    inc
    ld   ac, x
    ld   0xFF, [y,x]
    inc
    ld   ac, x
    ld   0xFF, [y,x]
    inc
    ld   ac, x
    ld   0x00, [y,x]
    inc
    ld   ac, [u0]
    bne  dp_c
    ld   ac, [p_len]
    ld   [p_pat], ac
    sub  CAP, ac
    bcc  dp_none                ; none, or past the capacity
    ld   [p_pat], ac
    SLOTADDR
    ld   [u1], y
    ld   [u2], x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  dp_go
    ld   64, ac                 ; blank: 64 empty rows
    ld   ac, [p_len]
dp_none:
    RET
dp_go:
    GOTO dp_parse

.chunk
dp_parse:
    clr  ac
    ld   ac, [u4]               ; rows so far
    ld   0xFF, ac
    ld   ac, [u5]               ; pending instrument
    ld   ac, [u6]               ; pending effect
    clr  ac
    ld   ac, [u7]
dpp_l:
    ld   [u4], ac
    xor  64, ac
    beq  dpp_end
    ld   [u1], y
    ld   [u2], x
    ld   [y,x], ac
    ld   ac, [u3]
    ld   [u2], ac
    inc
    ld   ac, [u2]
    ld   [u3], ac
    xor  0xFF, ac
    beq  dpp_end
    ld   [u3], ac
    sub  0xE0, ac
    bcc  dpp_fx
    ld   [u3], ac
    sub  0xC0, ac
    bcc  dpp_ins
    ld   [u3], ac
    sub  0x80, ac
    bcc  dpp_empty
    ld   [u4], ac               ; a note: row u4 = note, pending ins, fx, par
    shl
    shl
    ld   ac, [u0]
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [u3], ac
    ld   ac, [y,x]
    ld   [u0], ac
    add  1, x
    ld   [u5], ac
    ld   ac, [y,x]
    ld   [u0], ac
    add  2, x
    ld   [u6], ac
    ld   ac, [y,x]
    ld   [u0], ac
    add  3, x
    ld   [u7], ac
    ld   ac, [y,x]
    ld   0xFF, ac
    ld   ac, [u5]
    ld   ac, [u6]
    ld   [u4], ac
    inc
    ld   ac, [u4]
    bra  dpp_l
dpp_fx:
    and  0x0F, ac
    ld   ac, [u6]
    ld   [u1], y
    ld   [u2], x
    ld   [y,x], ac
    ld   ac, [u7]
    ld   [u2], ac
    inc
    ld   ac, [u2]
    bra  dpp_l
dpp_ins:
    and  0x1F, ac
    ld   ac, [u5]
    bra  dpp_l
dpp_empty:
    and  0x3F, ac               ; this row and that many more
    inc
    add  [u4], ac
    ld   ac, [u4]
    sub  65, ac
    bcs  dpp_e2
    ld   64, ac
    ld   ac, [u4]
dpp_e2:
    ld   0xFF, ac
    ld   ac, [u5]
    ld   ac, [u6]
    bra  dpp_l
dpp_end:
    ld   [u4], ac
    ld   ac, [p_len]
    RET

; ------------------------------------------------------------
; need - AC = pattern: decoded into SCRATCH unless it is there already
; ------------------------------------------------------------
.chunk
need:
    xor  [p_pat], ac
    beq  nd_ok
    xor  [p_pat], ac
    GOTO decode_pat
nd_ok:
    RET

; ------------------------------------------------------------
; encode_pat - SCRATCH (p_len rows) -> ENCBUF, then pattern p_pat's slot
; (the rest of the slot FF).  AC = 0 done, 1 too long for the slot (the
; slot is left as it was)
; ------------------------------------------------------------
.macro EMIT
    ld   [u5], ac               ; EMIT: the byte in u7 -> ENCBUF
    bne  en_full\@
    ld   ENCBUF >> 8, y
    ld   [u1], x
    ld   [u7], ac
    ld   ac, [y,x]
    ld   [u1], ac
    inc
    ld   ac, [u1]
    xor  SLOT_LO, ac
    bne  en_ok\@
    ld   1, ac
    ld   ac, [u5]
en_ok\@:
    bra  en_done\@
en_full\@:
    GOTO en_fail
en_done\@:
.endm

.chunk
encode_pat:
    clr  ac
    ld   ac, [u0]               ; row
    ld   ac, [u1]               ; bytes out
    ld   ac, [u5]               ; full
    ld   0xFF, ac
    ld   ac, [u2]               ; the instrument emitted last
en_l:
    ld   [u0], ac
    xor  [p_len], ac
    beq  en_end
    ld   [u0], ac
    shl
    shl
    ld   ac, [u3]
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    ld   ac, [u4]               ; note
    xor  0x61, ac
    bne  en_row
    ld   [u3], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  en_row
    ld   [u3], ac
    add  2, ac
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  en_row
    GOTO en_run
en_row:
    GOTO en_note
en_end:
    ld   0xFF, ac
    ld   ac, [u7]
    EMIT
    GOTO en_copy

; a run of empty rows from row u0: count them (64 at most), one byte
.chunk
en_run:
    clr  ac
    ld   ac, [u6]               ; the count
er_l:
    ld   [u0], ac
    add  [u6], ac
    xor  [p_len], ac
    beq  er_d
    ld   [u0], ac
    add  [u6], ac
    shl
    shl
    ld   ac, [u3]
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    xor  0x61, ac
    bne  er_d
    ld   [u3], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  er_d
    ld   [u3], ac
    add  2, ac
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  er_d
    ld   [u6], ac
    inc
    ld   ac, [u6]
    xor  64, ac
    bne  er_l
er_d:
    ld   [u6], ac
    dec
    or   0x80, ac
    ld   ac, [u7]
    EMIT
    ld   [u0], ac
    add  [u6], ac
    ld   ac, [u0]
    GOTO en_l

; a row with something in it: [instrument] [effect, parameter] note
.chunk
en_note:
    ld   [u3], ac
    inc
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    ld   ac, [u6]               ; its instrument
    xor  0xFF, ac
    beq  en_fx
    ld   [u6], ac
    xor  [u2], ac
    beq  en_fx
    ld   [u6], ac
    ld   ac, [u2]
    or   0xC0, ac
    ld   ac, [u7]
    EMIT
en_fx:
    ld   [u3], ac
    add  2, ac
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    xor  0xFF, ac
    beq  en_n
    ld   [y,x], ac
    or   0xE0, ac
    ld   ac, [u7]
    EMIT
    ld   [u3], ac
    add  3, ac
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    ld   ac, [u7]
    EMIT
en_n:
    ld   [u3], ac
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    ld   ac, [u7]
    EMIT
    ld   [u0], ac
    inc
    ld   ac, [u0]
    GOTO en_l

.chunk
en_fail:
    ld   1, ac
    RET

; ENCBUF (u1 bytes, 256 when u1 = 0) -> the slot, FF to its end
.chunk
en_copy:
    ld   [p_pat], ac
    SLOTADDR
    clr  ac
    ld   ac, [u3]
ec_l:
    ld   ENCBUF >> 8, y
    ld   [u3], x
    ld   [y,x], ac
    ld   ac, [u4]
    ld   [u1], y
    ld   [u3], ac
    add  [u2], ac
    ld   ac, x
    ld   [u4], ac
    ld   ac, [y,x]
    ld   [u3], ac
    inc
    ld   ac, [u3]
    xor  [u1], ac
    bne  ec_l
ec_p:
    ld   [u3], ac
    xor  SLOT_LO, ac
    beq  ec_e
    ld   [u1], y
    ld   [u3], ac
    add  [u2], ac
    ld   ac, x
    ld   0xFF, [y,x]
    ld   [u3], ac
    inc
    ld   ac, [u3]
    bra  ec_p
ec_e:
    ld   1, ac
    ld   ac, [e_mod]
    clr  ac
    RET

; ------------------------------------------------------------
; encode_ol - AC = voice: its decoded orderlist -> OLIST + 64 v, with
; the byte offset of each position in OD_OFF (every position gets its
; transpose byte, so a loop lands on the right transpose)
; ------------------------------------------------------------
.chunk
encode_ol:
    ld   ac, [u0]
    shl
    shl
    shl
    shl
    shl
    shl
    ld   ac, [u1]               ; 64 v: the list's first byte
    ld   ac, [u2]               ; the write pointer (low byte)
    clr  ac
    ld   ac, [u3]               ; position k
eo_l:
    ld   [u0], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [u3], ac
    xor  [y,x], ac
    beq  eo_end
    ld   [u2], ac               ; OD_OFF + k = offset
    sub  [u1], ac
    ld   ac, [u4]
    ld   [u3], ac
    add  OD_OFF, x
    ld   [u4], ac
    ld   ac, [y,x]
    ld   [u3], ac
    shl
    add  OD_TR, x
    ld   [y,x], ac
    add  0xA0, ac
    ld   ac, [u5]
    ld   [u3], ac
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    ld   ac, [u6]
    ld   OLIST >> 8, y
    ld   [u2], x
    ld   [u5], ac
    ld   ac, [y,x]
    ld   [u2], ac
    inc
    ld   ac, x
    ld   [u6], ac
    ld   ac, [y,x]
    ld   [u2], ac
    add  2, ac
    ld   ac, [u2]
    ld   [u3], ac
    inc
    ld   ac, [u3]
    bra  eo_l
eo_end:
    ld   [u2], ac               ; OD_OFF + len = the end's offset
    sub  [u1], ac
    ld   ac, [u4]
    ld   [u3], ac
    add  OD_OFF, x
    ld   [u4], ac
    ld   ac, [y,x]
    ld   OD_END, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  eo_stop
    ld   OD_TGT, x              ; FF, the target's offset
    ld   [y,x], ac
    add  OD_OFF, x
    ld   [y,x], ac
    ld   ac, [u5]
    ld   OLIST >> 8, y
    ld   [u2], x
    ld   0xFF, [y,x]
    ld   [u2], ac
    inc
    ld   ac, x
    ld   [u5], ac
    ld   ac, [y,x]
    RET
eo_stop:
    ld   OLIST >> 8, y
    ld   [u2], x
    ld   0xFE, [y,x]
    RET

; ------------------------------------------------------------
; decode_ol - AC = voice: OLIST + 64 v -> its decoded orderlist (at most
; OD_MAX positions; a loop lands on the position holding its byte)
; ------------------------------------------------------------
.chunk
decode_ol:
    ld   ac, [u0]
    shl
    shl
    shl
    shl
    shl
    shl
    ld   ac, [u1]               ; the list's first byte
    ld   ac, [u2]               ; the read pointer
    clr  ac
    ld   ac, [u3]               ; position k
    ld   ac, [u4]               ; transpose
    ld   ac, [u6]               ; a transpose byte started the position
    ld   [u0], ac
    add  VSPAGE, y
    ld   OD_END, x
    ld   0xFE, [y,x]
    ld   OD_TGT, x
    ld   0x00, [y,x]
do_l:
    ld   OLIST >> 8, y
    ld   [u2], x
    ld   [y,x], ac
    ld   ac, [u5]
    xor  0xFE, ac
    beq  do_end
    ld   [u5], ac
    xor  0xFF, ac
    beq  do_loop
    ld   [u5], ac
    sub  0x80, ac
    bcs  do_pat
    ld   [u5], ac
    sub  0xC0, ac
    bcc  do_pat                 ; C0-FD: taken as a pattern byte (& 3F)
    ld   [u5], ac               ; a transpose
    sub  0xA0, ac
    ld   ac, [u4]
    ld   [u6], ac
    bne  do_t2
    ld   [u2], ac               ; the position starts here
    sub  [u1], ac
    ld   ac, [u7]
    ld   1, ac
    ld   ac, [u6]
do_t2:
    ld   [u2], ac
    inc
    ld   ac, [u2]
    bra  do_l
do_pat:
    ld   [u6], ac
    bne  do_p2
    ld   [u2], ac
    sub  [u1], ac
    ld   ac, [u7]
do_p2:
    ld   [u3], ac
    xor  OD_MAX, ac
    beq  do_end                 ; too many: the rest is dropped
    ld   [u0], ac
    add  VSPAGE, y
    ld   [u3], ac
    add  OD_OFF, x
    ld   [u7], ac
    ld   ac, [y,x]
    ld   [u3], ac
    shl
    add  OD_PAT, x
    ld   [u5], ac
    and  0x3F, ac
    ld   ac, [y,x]
    ld   [u3], ac
    shl
    add  OD_TR, x
    ld   [u4], ac
    ld   ac, [y,x]
    ld   [u3], ac
    inc
    ld   ac, [u3]
    clr  ac
    ld   ac, [u6]
    ld   [u2], ac
    inc
    ld   ac, [u2]
    bra  do_l
do_loop:
    GOTO do_loop2
do_end:
    ld   [u0], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [u3], ac
    ld   ac, [y,x]
    RET

; FF nn: the loop; OD_OFF + len = the FF's offset; target = the first
; position whose next position starts after nn
.chunk
do_loop2:
    ld   [u0], ac
    add  VSPAGE, y
    ld   OD_END, x
    ld   0xFF, [y,x]
    ld   [u3], ac
    add  OD_OFF, x
    ld   [u2], ac
    sub  [u1], ac
    ld   ac, [y,x]
    ld   OLIST >> 8, y
    ld   [u2], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [u5]               ; nn
    ld   [u0], ac
    add  VSPAGE, y
    clr  ac
    ld   ac, [u7]               ; j
dl_l:
    ld   [u7], ac
    xor  [u3], ac
    beq  dl_0                   ; past the end: 0
    ld   [u7], ac
    add  OD_OFF + 1, x
    ld   [y,x], ac              ; start of j + 1
    sub  [u5], ac
    bcs  dl_n                   ; start(j+1) <= nn: not this one
    beq  dl_n
    ld   OD_TGT, x
    ld   [u7], ac
    ld   ac, [y,x]
    bra  dl_e
dl_n:
    ld   [u7], ac
    inc
    ld   ac, [u7]
    bra  dl_l
dl_0:
    ld   OD_TGT, x
    ld   0, [y,x]
dl_e:
    ld   OD_LEN, x
    ld   [u3], ac
    ld   ac, [y,x]
    RET

; ------------------------------------------------------------
; encode_all - the four orderlists
; ------------------------------------------------------------
.chunk
encode_all:
    PUSH_LINK
    clr  ac
    ld   ac, [w5]
ea_l:
    ld   [w5], ac
    CALL encode_ol
    ld   [w5], ac
    inc
    ld   ac, [w5]
    xor  4, ac
    bne  ea_l
    LEAVE

.chunk
decode_all:
    PUSH_LINK
    clr  ac
    ld   ac, [w5]
da_l:
    ld   [w5], ac
    CALL decode_ol
    ld   [w5], ac
    inc
    ld   ac, [w5]
    xor  4, ac
    bne  da_l
    LEAVE

; ------------------------------------------------------------
; slot_blank - AC = pattern: AC = 1 when its slot is blank (FF, or BF FF:
; 64 empty rows), else 0
; ------------------------------------------------------------
.chunk
slot_blank:
    SLOTADDR
    ld   [u1], y
    ld   [u2], x
    ld   [y,x], ac
    xor  0xFF, ac
    beq  sb_y
    ld   [y,x], ac
    xor  0xBF, ac
    bne  sb_n
    ld   [u2], ac
    inc
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  sb_n
sb_y:
    ld   1, ac
    RET
sb_n:
    clr  ac
    RET

; ------------------------------------------------------------
; slot_len - AC = pattern: AC = the bytes of its pattern up to and with
; the FF (the slot's size when there is no FF)
; ------------------------------------------------------------
.chunk
slot_len:
    SLOTADDR
    clr  ac
    ld   ac, [u3]
sl_l:
    ld   [u1], y
    ld   [u3], ac
    add  [u2], ac
    ld   ac, x
    ld   [u3], ac
    inc
    ld   ac, [u3]
    ld   [y,x], ac
    xor  0xFF, ac
    beq  sl_e
    ld   [u3], ac
    xor  SLOT_LO, ac
    bne  sl_l
sl_e:
    ld   [u3], ac
    RET

; ------------------------------------------------------------
; slot_fix - AC = pattern: an FF at the slot's last byte when it has none
; ------------------------------------------------------------
.chunk
slot_fix:
    SLOTADDR
    clr  ac
    ld   ac, [u3]
sf_l:
    ld   [u1], y
    ld   [u3], ac
    add  [u2], ac
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    beq  sf_e
    ld   [u3], ac
    inc
    ld   ac, [u3]
    xor  SLOT_LO, ac
    bne  sf_l
    ld   [u3], ac               ; none: the last byte
    dec
    add  [u2], ac
    ld   ac, x
    ld   0xFF, [y,x]
sf_e:
    RET

; ------------------------------------------------------------
; slot_clear - AC = pattern: its slot = FF (blank)
; ------------------------------------------------------------
.chunk
slot_clear:
    SLOTADDR
    ld   [u1], y
    ld   [u2], x
    ld   0xFF, [y,x]
    RET

; ============================================================
; drawing
; ============================================================

; ------------------------------------------------------------
; draw_step - once a frame: the blocks marked in e_dirty; the pattern
; grid one voice column a frame (the player must run every frame)
; ------------------------------------------------------------
.chunk
draw_step:
    PUSH_LINK
    ld   [e_dirty], ac
    and  0x08, ac
    beq  ds_t
    CALL draw_header
    ld   [e_dirty], ac
    and  0xF7, ac
    ld   ac, [e_dirty]
ds_t:
    ld   [e_dirty], ac
    and  0x20, ac
    beq  ds_o
    CALL draw_ptitle
    ld   [e_dirty], ac
    and  0xDF, ac
    ld   ac, [e_dirty]
ds_o:
    ld   [e_dirty], ac
    and  0x02, ac
    beq  ds_i
    CALL draw_order
    ld   [e_dirty], ac
    and  0xFD, ac
    ld   ac, [e_dirty]
ds_i:
    ld   [e_dirty], ac
    and  0x04, ac
    beq  ds_g
    CALL draw_ins
    ld   [e_dirty], ac
    and  0xFB, ac
    ld   ac, [e_dirty]
ds_g:
    GOTO draw_step2

.chunk
draw_step2:
    ld   [e_pane], ac
    sub  3, ac
    bcc  ds_tab
    ld   [e_dirty], ac
    and  0x01, ac
    beq  ds_e
    ld   [e_drow], ac
    CALL draw_grid_col
    ld   [e_drow], ac
    inc
    ld   ac, [e_drow]
    xor  4, ac
    bne  ds_e
    CALL draw_rownums
    CALL grid_tints
    CALL cursor_show
    ld   [e_dirty], ac
    and  0xFE, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE
ds_tab:
    ld   [e_dirty], ac
    and  0x11, ac
    beq  ds_e
    CALL draw_table
    ld   [e_dirty], ac
    and  0xEE, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
ds_e:
    LEAVE

; ------------------------------------------------------------
; redraw_all - the screen from scratch
; ------------------------------------------------------------
.chunk
redraw_all:
    PUSH_LINK
    CALL clear_screen
    CALL draw_footer
    ld   0x3F, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE

; ------------------------------------------------------------
; draw_header - row 0: file, title, octave, instrument, mode, state
; ------------------------------------------------------------
.chunk
draw_header:
    PUSH_LINK
    clr  ac
    ld   ac, [CUR_ROW]
    ld   1, ac
    ld   ac, [CUR_COL]
    ld   s_hdr & 0xFF, ac
    ld   ac, [R0]
    ld   s_hdr >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   e_name, ac
    ld   ac, [R0]
    clr  ac
    ld   ac, [R1]
    CALL tputs
    ld   31, ac
    sub  [CUR_COL], ac
    CALL tspc
    ld   0x20, ac
    ld   ac, [w0]
dh_t:
    ld   SONG >> 8, y
    ld   [w0], x
    ld   [y,x], ac
    bne  dh_t2
    ld   0x20, ac
dh_t2:
    CALL tputc
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  0x38, ac
    bne  dh_t
    ld   s_oct & 0xFF, ac
    ld   ac, [R0]
    ld   s_oct >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [e_oct], ac
    CALL thex1
    ld   s_ins & 0xFF, ac
    ld   ac, [R0]
    ld   s_ins >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [e_ins], ac
    CALL thex2
    GOTO draw_header2

.chunk
draw_header2:
    ld   0x20, ac
    CALL tputc
    CALL tputc
    ld   [e_play], ac
    bne  dh_p
    ld   s_stop & 0xFF, ac
    ld   ac, [R0]
    ld   s_stop >> 8, ac
    ld   ac, [R1]
    bra  dh_s
dh_p:
    ld   s_play & 0xFF, ac
    ld   ac, [R0]
    ld   s_play >> 8, ac
    ld   ac, [R1]
dh_s:
    CALL tputs
    clr  ac
    ld   ac, [R0]
    ld   TINT_GOLD, ac
    ld   ac, [R0]
    clr  ac
    CALL tint_row
    LEAVE

; ------------------------------------------------------------
; draw_footer - the keys on the last row
; ------------------------------------------------------------
.chunk
draw_footer:
    PUSH_LINK
    ld   ROWS, ac
    dec
    ld   ac, [CUR_ROW]
    clr  ac
    ld   ac, [CUR_COL]
    ld   s_keys & 0xFF, ac
    ld   ac, [R0]
    ld   s_keys >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   TINT_GOLD, ac
    ld   ac, [R0]
    ld   ROWS, ac
    dec
    CALL tint_row
    LEAVE

; ------------------------------------------------------------
; draw_order - the orderlist block: rows 2-10
; ------------------------------------------------------------
.chunk
draw_order:
    PUSH_LINK
    ld   2, ac
    ld   ac, [CUR_ROW]
    ld   2, ac
    ld   ac, [CUR_COL]
    ld   s_order & 0xFF, ac
    ld   ac, [R0]
    ld   s_order >> 8, ac
    ld   ac, [R1]
    CALL tputs
    clr  ac
    ld   ac, [w0]               ; the screen row - 3
do_r:
    ld   [w0], ac
    add  ROW_ORD, ac
    ld   ac, [CUR_ROW]
    clr  ac
    ld   ac, [CUR_COL]
    ld   [w0], ac
    add  [e_otop], ac
    ld   ac, [w1]               ; the position
    ld   0x20, ac
    ld   [w1], ac
    xor  [e_op], ac
    bne  do_m
    ld   0x3E, ac
do_m:
    CALL tputc
    ld   0x20, ac
    CALL tputc
    ld   [w1], ac
    CALL thex2
    clr  ac
    ld   ac, [w2]               ; the voice
do_v:
    ld   [w2], ac
    CALL draw_oentry
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  4, ac
    bne  do_v
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  ORD_ROWS, ac
    bne  do_r
    CALL cursor_show
    LEAVE

; one orderlist entry: voice AC, position w1, at column 8 + 7 v
.chunk
draw_oentry:
    PUSH_LINK
    ld   ac, [w3]
    shl
    shl
    shl
    sub  [w3], ac
    add  8, ac
    ld   ac, [CUR_COL]
    ld   [w3], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [w1], ac
    sub  [y,x], ac
    bcs  doe_p
    bne  doe_blank
    ld   OD_END, x              ; the end row
    ld   [y,x], ac
    xor  0xFF, ac
    bne  doe_stop
    ld   s_loop & 0xFF, ac
    ld   ac, [R0]
    ld   s_loop >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [w3], ac
    add  VSPAGE, y
    ld   OD_TGT, x
    ld   [y,x], ac
    CALL thex2
    LEAVE
doe_stop:
    ld   s_stop6 & 0xFF, ac
    ld   ac, [R0]
    ld   s_stop6 >> 8, ac
    ld   ac, [R1]
    CALL tputs
    LEAVE
doe_blank:
    ld   6, ac
    CALL tspc
    LEAVE
doe_p:
    ld   [w1], ac
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    CALL thex2
    ld   0x20, ac
    CALL tputc
    ld   [w3], ac
    add  VSPAGE, y
    ld   [w1], ac
    shl
    add  OD_TR, x
    ld   [y,x], ac
    bne  doe_t
    ld   3, ac
    CALL tspc
    LEAVE
doe_t:
    CALL tsigned
    LEAVE

; ------------------------------------------------------------
; draw_ins - the instrument panel, rows 2-8 from column 40
; ------------------------------------------------------------
.chunk
draw_ins:
    PUSH_LINK
    ld   ROW_INS, ac
    ld   ac, [CUR_ROW]
    ld   COL_INS, ac
    ld   ac, [CUR_COL]
    ld   s_instr & 0xFF, ac
    ld   ac, [R0]
    ld   s_instr >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [e_ins], ac
    CALL thex2
    ld   0x20, ac
    CALL tputc
    ld   I_NAME, ac
    ld   ac, [w0]
di_n:
    ld   [w0], ac
    CALL ins_byte
    bne  di_n2
    ld   0x20, ac
di_n2:
    CALL tputc
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  16, ac
    bne  di_n
    ld   ROW_INS + 1, ac        ; the field rows, from a script
    ld   ac, [CUR_ROW]
    ld   COL_INS, ac
    ld   ac, [CUR_COL]
    ld   s_ifields & 0xFF, ac
    ld   ac, [R0]
    ld   s_ifields >> 8, ac
    ld   ac, [R1]
    GOTO draw_ins2

; the script: text, then a code byte: 01-7F a character, 80 + n the high
; nibble of instrument byte n, 90 + n its low nibble, A0 + n the byte,
; B0 + n bit 0 of it, FE a new row, FF the end
.chunk
draw_ins2:
    ld   [R1], y
    ld   [R0], x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   [R0], ac
    inc
    ld   ac, [R0]
    bne  di2_a
    ld   [R1], ac
    inc
    ld   ac, [R1]
di2_a:
    ld   [w1], ac
    xor  0xFF, ac
    beq  di2_end
    ld   [w1], ac
    xor  0xFE, ac
    beq  di2_row
    ld   [w1], ac
    sub  0x80, ac
    bcs  di2_ch
    and  0x0F, ac
    CALL ins_byte
    ld   ac, [w2]
    ld   [w1], ac
    and  0x30, ac
    beq  di2_hi
    sub  0x10, ac
    beq  di2_lo
    sub  0x10, ac
    beq  di2_by
    ld   [w2], ac
    and  1, ac
    add  0x30, ac
    CALL tputc
    bra  draw_ins2
di2_hi:
    ld   [w2], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    CALL thex1
    bra  draw_ins2
di2_lo:
    ld   [w2], ac
    CALL thex1
    bra  draw_ins2
di2_by:
    ld   [w2], ac
    CALL thex2
    bra  draw_ins2
di2_ch:
    ld   [w1], ac
    CALL tputc
    bra  draw_ins2
di2_row:
    ld   [CUR_ROW], ac
    inc
    ld   ac, [CUR_ROW]
    ld   COL_INS, ac
    ld   ac, [CUR_COL]
    bra  draw_ins2
di2_end:
    CALL cursor_show
    LEAVE

; ins_byte - AC = offset 0-15: AC = that byte of instrument e_ins
.chunk
ins_byte:
    ld   ac, [u0]
    ld   [e_ins], ac
    and  0x0F, ac
    shl
    shl
    shl
    shl
    add  [u0], ac
    ld   ac, x
    ld   [e_ins], ac
    and  0x10, ac
    beq  ib_2
    ld   (SONG >> 8) + 3, y
    ld   [y,x], ac
    RET
ib_2:
    ld   (SONG >> 8) + 2, y
    ld   [y,x], ac
    RET

; ins_addr - AC = offset: Y:X = the byte's address (for a store)
.chunk
ins_addr:
    ld   ac, [u0]
    ld   [e_ins], ac
    and  0x0F, ac
    shl
    shl
    shl
    shl
    add  [u0], ac
    ld   ac, x
    ld   [e_ins], ac
    and  0x10, ac
    beq  ia_2
    ld   (SONG >> 8) + 3, y
    RET
ia_2:
    ld   (SONG >> 8) + 2, y
    RET

; ------------------------------------------------------------
; draw_ptitle - rows 12-13: the pattern under the cursor, the columns
; ------------------------------------------------------------
.chunk
draw_ptitle:
    PUSH_LINK
    ld   ROW_PTIT, ac
    ld   ac, [CUR_ROW]
    ld   1, ac
    ld   ac, [CUR_COL]
    ld   [e_pane], ac
    sub  3, ac
    bcs  dpt_pat
    GOTO dpt_tab
dpt_pat:
    ld   s_pattern & 0xFF, ac
    ld   ac, [R0]
    ld   s_pattern >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [c_v], ac
    CALL pat_of
    ld   ac, [w0]
    xor  0xFF, ac
    beq  dpt_none
    ld   [w0], ac
    CALL thex2
    ld   [w0], ac
    CALL need
    ld   0x20, ac
    CALL tputc
    CALL tputc
    ld   [p_len], ac
    CALL tdec2
    ld   s_rows & 0xFF, ac
    ld   ac, [R0]
    ld   s_rows >> 8, ac
    ld   ac, [R1]
    CALL tputs
    GOTO draw_ptitle2
dpt_none:
    ld   s_nopat & 0xFF, ac
    ld   ac, [R0]
    ld   s_nopat >> 8, ac
    ld   ac, [R1]
    CALL tputs
    GOTO draw_ptitle2

.chunk
draw_ptitle2:
    ld   s_voice & 0xFF, ac
    ld   ac, [R0]
    ld   s_voice >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [c_v], ac
    add  0x31, ac
    CALL tputc
    ld   s_pos & 0xFF, ac
    ld   ac, [R0]
    ld   s_pos >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [e_op], ac
    CALL thex2
    ld   80, ac
    sub  [CUR_COL], ac
    CALL tspc
    ld   ROW_PTIT + 1, ac
    ld   ac, [CUR_ROW]
    ld   1, ac
    ld   ac, [CUR_COL]
    ld   s_cols & 0xFF, ac
    ld   ac, [R0]
    ld   s_cols >> 8, ac
    ld   ac, [R1]
    CALL tputs
    LEAVE
dpt_tab:
    GOTO draw_ttitle

.chunk
draw_ttitle:
    ld   [e_pane], ac
    xor  3, ac
    bne  dtt_p
    ld   s_wtab & 0xFF, ac
    ld   ac, [R0]
    ld   s_wtab >> 8, ac
    ld   ac, [R1]
    bra  dtt_s
dtt_p:
    ld   s_ptab & 0xFF, ac
    ld   ac, [R0]
    ld   s_ptab >> 8, ac
    ld   ac, [R1]
dtt_s:
    CALL tputs
    ld   80, ac
    sub  [CUR_COL], ac
    CALL tspc
    ld   ROW_PTIT + 1, ac
    ld   ac, [CUR_ROW]
    clr  ac
    ld   ac, [CUR_COL]
    ld   80, ac
    CALL tspc
    LEAVE

; ------------------------------------------------------------
; draw_grid_col - AC = voice: its pattern's rows from c_top, PV of them
; ------------------------------------------------------------
.chunk
draw_grid_col:
    PUSH_LINK
    ld   ac, [w0]
    CALL pat_of
    CALL need
    clr  ac
    ld   ac, [w2]
dgc_l:
    ld   [w2], ac
    add  [c_top], ac
    ld   ac, [w1]
    CALL draw_cell
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  PV, ac
    bne  dgc_l
    LEAVE

; ------------------------------------------------------------
; draw_cell - voice w0, pattern row w1 (from the decoded pattern in
; SCRATCH, which must be the voice's): note, instrument, effect
; ------------------------------------------------------------
.chunk
draw_cell:
    PUSH_LINK
    ld   [w1], ac
    sub  [c_top], ac
    add  ROW_GRID, ac
    ld   ac, [CUR_ROW]
    ld   [w0], ac
    shl
    add  [w0], ac
    shl
    shl
    add  COL_GRID, ac
    ld   ac, [CUR_COL]
    ld   [w1], ac
    sub  [p_len], ac
    bcs  dc_r
    ld   10, ac
    CALL tspc
    LEAVE
dc_r:
    ld   [w1], ac
    shl
    shl
    ld   ac, [w3]
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    CALL tnote
    ld   0x20, ac
    CALL tputc
    ld   [w3], ac
    inc
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    xor  0xFF, ac
    beq  dc_noins
    ld   [y,x], ac
    CALL thex2
    GOTO draw_cell2
dc_noins:
    ld   0x2D, ac
    CALL tputc
    CALL tputc
    GOTO draw_cell2

.chunk
draw_cell2:
    ld   0x20, ac
    CALL tputc
    ld   [w3], ac
    add  2, ac
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    xor  0xFF, ac
    beq  dc_nofx
    ld   [y,x], ac
    CALL thex1
    ld   [w3], ac
    add  3, ac
    ld   ac, x
    ld   SCRATCH >> 8, y
    ld   [y,x], ac
    CALL thex2
    LEAVE
dc_nofx:
    ld   s_dots & 0xFF, ac
    ld   ac, [R0]
    ld   s_dots >> 8, ac
    ld   ac, [R1]
    CALL tputs
    LEAVE

; ------------------------------------------------------------
; draw_rownums - the row numbers down the grid
; ------------------------------------------------------------
.chunk
draw_rownums:
    PUSH_LINK
    clr  ac
    ld   ac, [w2]
dr_l:
    ld   [w2], ac
    add  ROW_GRID, ac
    ld   ac, [CUR_ROW]
    ld   2, ac
    ld   ac, [CUR_COL]
    ld   [w2], ac
    add  [c_top], ac
    ld   ac, [w1]
    sub  64, ac
    bcc  dr_b
    ld   [w1], ac
    CALL thex2
    bra  dr_n
dr_b:
    ld   2, ac
    CALL tspc
dr_n:
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  PV, ac
    bne  dr_l
    LEAVE

; ------------------------------------------------------------
; draw_row - pattern row AC of all four voices (when on the screen)
; ------------------------------------------------------------
.chunk
draw_row:
    PUSH_LINK
    ld   ac, [w1]
    sub  [c_top], ac
    bcs  drw_e
    sub  PV, ac
    bcc  drw_e
    clr  ac
    ld   ac, [w0]
drw_l:
    ld   [w0], ac
    CALL pat_of
    CALL need
    CALL draw_cell
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  4, ac
    bne  drw_l
    ld   [w1], ac
    CALL grid_tint
drw_e:
    LEAVE

; ------------------------------------------------------------
; grid_tint - pattern row AC: its tint (blue under the cursor in the
; pattern pane, green when it is being played), when on the screen
; ------------------------------------------------------------
.chunk
grid_tint:
    PUSH_LINK
    ld   ac, [u7]
    sub  [c_top], ac
    bcs  gt_e
    sub  PV, ac
    bcc  gt_e
    clr  ac
    ld   ac, [R0]
    ld   [e_pane], ac
    bne  gt_p
    ld   [u7], ac
    xor  [c_row], ac
    bne  gt_p
    ld   TINT_BLUE, ac
    ld   ac, [R0]
gt_p:
    ld   [e_play], ac
    beq  gt_w
    ld   [e_plop], ac
    xor  [e_op], ac
    bne  gt_w
    ld   [u7], ac
    xor  [e_plrow], ac
    bne  gt_w
    ld   [R0], ac
    or   TINT_GREEN, ac
    ld   ac, [R0]
gt_w:
    ld   [u7], ac
    sub  [c_top], ac
    add  ROW_GRID, ac
    CALL tint_row
gt_e:
    LEAVE

; grid_tints - every grid row on the screen
.chunk
grid_tints:
    PUSH_LINK
    clr  ac
    ld   ac, [w4]
gts_l:
    ld   [w4], ac
    add  [c_top], ac
    CALL grid_tint
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  PV, ac
    bne  gts_l
    LEAVE

; ------------------------------------------------------------
; pane_tint - the active pane's cursor row (not the grid: grid_tint)
; R0 = the tint (blue, or 0 to take it off)
; ------------------------------------------------------------
.chunk
pane_tint:
    PUSH_LINK
    ld   [e_pane], ac
    xor  1, ac
    bne  pt_2
    ld   [o_k], ac
    sub  [e_otop], ac
    add  ROW_ORD, ac
    CALL tint_row
    LEAVE
pt_2:
    ld   [e_pane], ac
    xor  2, ac
    bne  pt_3
    ld   [i_f], ac
    CALL ifield
    ld   [R2], ac
    CALL tint_row
    LEAVE
pt_3:
    ld   [e_pane], ac
    sub  3, ac
    bcs  pt_e
    ld   [t_e], ac
    CALL tcell
    ld   [R2], ac
    CALL tint_row
pt_e:
    LEAVE

; ifield - AC = instrument field: R2 = row, R3 = column, R4 = width
.chunk
ifield:
    ld   ac, [u0]
    shl
    add  [u0], ac
    add  ifld & 0xFF, x
    ld   ifld >> 8, y
    ld   [y,x], ac
    ld   ac, [R2]
    ld   [u0], ac
    shl
    add  [u0], ac
    add  (ifld + 1) & 0xFF, x
    ld   [y,x], ac
    ld   ac, [R3]
    ld   [u0], ac
    shl
    add  [u0], ac
    add  (ifld + 2) & 0xFF, x
    ld   [y,x], ac
    ld   ac, [R4]
    RET

; tcell - AC = table entry 1-63: R2 = row, R3 = column of its text
.chunk
tcell:
    dec
    ld   ac, [u0]
    clr  ac
    ld   ac, [u1]               ; the column
tc_l:
    ld   [u0], ac
    sub  PV, ac
    bcs  tc_d
    ld   ac, [u0]
    ld   [u1], ac
    inc
    ld   ac, [u1]
    bra  tc_l
tc_d:
    ld   [u0], ac
    add  ROW_GRID, ac
    ld   ac, [R2]
    ld   [u1], ac
    shl
    shl
    shl
    shl
    ld   ac, [R3]
    RET

; ------------------------------------------------------------
; cursor_show - the underline under the field of the active pane
; ------------------------------------------------------------
.chunk
cursor_show:
    PUSH_LINK
    ld   [e_pane], ac
    bne  cs_1
    ld   [c_row], ac
    sub  [c_top], ac
    bcs  cs_e
    sub  PV, ac
    bcc  cs_e
    ld   [c_row], ac
    sub  [c_top], ac
    add  ROW_GRID, ac
    ld   ac, [CUR_ROW]
    ld   [c_v], ac
    shl
    add  [c_v], ac
    shl
    shl
    add  COL_GRID, ac
    ld   ac, [u0]
    ld   [c_col], ac
    add  ccol & 0xFF, x
    ld   ccol >> 8, y
    ld   [y,x], ac
    add  [u0], ac
    ld   ac, [CUR_COL]
    ld   3, ac
    ld   ac, [u1]
    ld   [c_col], ac
    beq  cs_m
    ld   1, ac
    ld   ac, [u1]
cs_m:
    ld   [u1], ac
    CALL tmark
cs_e:
    LEAVE
cs_1:
    GOTO cursor_show2

.chunk
cursor_show2:
    ld   [e_pane], ac
    xor  1, ac
    bne  cs2_2
    ld   [o_k], ac              ; the orderlist
    sub  [e_otop], ac
    add  ROW_ORD, ac
    ld   ac, [CUR_ROW]
    ld   [o_v], ac
    shl
    shl
    shl
    sub  [o_v], ac
    add  8, ac
    ld   ac, [CUR_COL]
    ld   [o_v], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [o_k], ac
    xor  [y,x], ac
    bne  cs2_f
    ld   6, ac                  ; the end row
    CALL tmark
    LEAVE
cs2_f:
    ld   [o_f], ac
    beq  cs2_p
    ld   [CUR_COL], ac
    add  3, ac
    ld   ac, [CUR_COL]
    ld   3, ac
    CALL tmark
    LEAVE
cs2_p:
    ld   2, ac
    CALL tmark
    LEAVE
cs2_2:
    ld   [e_pane], ac
    xor  2, ac
    bne  cs2_3
    ld   [i_f], ac              ; the instrument field
    CALL ifield
    CALL tat
    ld   [R4], ac
    CALL tmark
    LEAVE
cs2_3:
    ld   [t_e], ac              ; the table entry
    CALL tcell
    CALL tat
    ld   [t_f], ac
    beq  cs2_l
    ld   [CUR_COL], ac
    add  9, ac
    ld   ac, [CUR_COL]
    ld   3, ac
    CALL tmark
    LEAVE
cs2_l:
    ld   [CUR_COL], ac
    add  3, ac
    ld   ac, [CUR_COL]
    ld   5, ac
    CALL tmark
    LEAVE

; ------------------------------------------------------------
; cursor_hide - draw the field again without the underline
; ------------------------------------------------------------
.chunk
cursor_hide:
    PUSH_LINK
    ld   [e_pane], ac
    bne  ch_1
    ld   [c_v], ac
    ld   ac, [w0]
    CALL pat_of
    CALL need
    ld   [c_row], ac
    sub  [c_top], ac
    bcs  ch_e
    sub  PV, ac
    bcc  ch_e
    ld   [c_row], ac
    ld   ac, [w1]
    CALL draw_cell
ch_e:
    LEAVE
ch_1:
    ld   [e_pane], ac
    xor  1, ac
    bne  ch_2
    ld   [o_k], ac
    sub  [e_otop], ac
    add  ROW_ORD, ac
    ld   ac, [CUR_ROW]
    ld   [o_k], ac
    ld   ac, [w1]
    ld   [o_v], ac
    CALL draw_oentry
    LEAVE
ch_2:
    ld   [e_pane], ac
    xor  2, ac
    bne  ch_3
    ld   4, ac
    ld   ac, [e_dirty]          ; the whole panel is cheap
    LEAVE
ch_3:
    ld   [t_e], ac
    CALL draw_tentry
    LEAVE

; ------------------------------------------------------------
; draw_table - the wave or pulse table, entries 1-63 in columns
; ------------------------------------------------------------
.chunk
draw_table:
    PUSH_LINK
    clr  ac
    ld   ac, [w4]               ; clear the rows first
dt_c:
    ld   [w4], ac
    add  ROW_GRID, ac
    ld   ac, [CUR_ROW]
    clr  ac
    ld   ac, [CUR_COL]
    ld   80, ac
    CALL tspc
    clr  ac
    ld   ac, [R0]
    ld   [w4], ac
    add  ROW_GRID, ac
    CALL tint_row
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  PV, ac
    bne  dt_c
    ld   1, ac
    ld   ac, [w4]
dt_l:
    ld   [w4], ac
    CALL draw_tentry
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  64, ac
    bne  dt_l
    ld   TINT_BLUE, ac
    ld   ac, [R0]
    CALL pane_tint
    CALL cursor_show
    LEAVE

; draw_tentry - AC = entry: "nn left right" at its place
.chunk
draw_tentry:
    PUSH_LINK
    ld   ac, [w0]
    CALL tcell
    CALL tat
    ld   [w0], ac
    CALL thex2
    ld   0x20, ac
    CALL tputc
    ld   [e_pane], ac
    xor  4, ac
    beq  dte_p
    GOTO draw_wentry
dte_p:
    GOTO draw_pentry

; the wave table: left = the waveform name, right = the note
.chunk
draw_wentry:
    ld   (SONG >> 8) + 1, y
    ld   [w0], x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   [w0], ac
    add  0x40, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   [w1], ac
    sub  13, ac
    bcs  dw_nm                  ; 0-12: the names
    ld   [w1], ac
    xor  0x7F, ac
    beq  dw_off
    ld   [w1], ac
    xor  0xFE, ac
    beq  dw_end
    ld   [w1], ac
    xor  0xFF, ac
    beq  dw_loop
    ld   16, ac
    bra  dw_nm2
dw_off:
    ld   13, ac
    bra  dw_nm2
dw_end:
    ld   14, ac
    bra  dw_nm2
dw_loop:
    ld   15, ac
dw_nm2:
    ld   ac, [w1]
dw_nm:
    ld   [w1], ac
    CALL wname
    ld   0x20, ac
    CALL tputc
    ld   [w1], ac
    xor  15, ac
    bne  dw_r
    ld   [w2], ac               ; LOOP nn
    CALL thex2
    ld   0x20, ac
    CALL tputc
    LEAVE
dw_r:
    ld   [w1], ac
    xor  14, ac
    bne  dw_r2
    ld   3, ac                  ; END
    CALL tspc
    LEAVE
dw_r2:
    ld   [w2], ac
    blt  dw_abs
    ld   [w2], ac               ; relative: 7-bit two's complement
    and  0x40, ac
    beq  dw_rel
    ld   [w2], ac
    or   0x80, ac
    ld   ac, [w2]
dw_rel:
    ld   [w2], ac
    CALL tsigned
    LEAVE
dw_abs:
    ld   [w2], ac
    and  0x7F, ac
    CALL tnote
    LEAVE

; wname - AC = name index 0-16: five characters
.chunk
wname:
    PUSH_LINK
    ld   ac, [w3]
    shl
    shl
    add  [w3], ac
    ld   ac, [w3]
    ld   5, ac
    ld   ac, [w5]
wn_l:
    ld   [w3], ac
    add  wnames & 0xFF, x
    ld   wnames >> 8, y
    ld   [y,x], ac
    CALL tputc
    ld   [w3], ac
    inc
    ld   ac, [w3]
    ld   [w5], ac
    dec
    ld   ac, [w5]
    bne  wn_l
    LEAVE

; the pulse table: 00 END, 80 SET nn, FF LOOP nn, else xTT +ss
.chunk
draw_pentry:
    ld   (SONG >> 8) + 1, y
    ld   [w0], ac
    add  0x80, x
    ld   [y,x], ac
    ld   ac, [w1]
    ld   [w0], ac
    add  0xC0, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   [w1], ac
    beq  dp_end
    ld   [w1], ac
    xor  0x80, ac
    beq  dp_set
    ld   [w1], ac
    xor  0xFF, ac
    beq  dp_loop
    ld   0x78, ac               ; x
    CALL tputc
    ld   [w1], ac
    CALL thex2
    ld   0x20, ac
    CALL tputc
    CALL tputc
    ld   [w2], ac
    CALL tsigned
    LEAVE
dp_end:
    ld   14, ac
    CALL wname
    ld   4, ac
    CALL tspc
    LEAVE
dp_set:
    ld   17, ac
    CALL wname
    bra  dp_v
dp_loop:
    ld   15, ac
    CALL wname
dp_v:
    ld   0x20, ac
    CALL tputc
    ld   [w2], ac
    CALL thex2
    ld   0x20, ac
    CALL tputc
    LEAVE

; ============================================================
; keys
; ============================================================

; handle_key - AC = the key (e_key)
.chunk
handle_key:
    PUSH_LINK
    sub  0x41, ac               ; A-Z (caps lock) -> a-z
    blt  hk_a
    sub  26, ac
    bcc  hk_a
    ld   [e_key], ac
    or   0x20, ac
    ld   ac, [e_key]
hk_a:
    ld   [e_key], ac
    xor  0x18, ac
    beq  hk_b
    ld   [e_fl], ac             ; any other key: Ctrl-X must be pressed twice again
    and  0xFE, ac
    ld   ac, [e_fl]
hk_b:
    ld   [e_key], ac
    xor  0x09, ac
    bne  hk_1
    CALL next_pane
    LEAVE
hk_1:
    ld   [e_key], ac
    xor  0x0A, ac
    bne  hk_2
    clr  ac
    CALL do_play
    LEAVE
hk_2:
    ld   [e_key], ac
    xor  0x20, ac
    bne  hk_3
    ld   [e_play], ac
    beq  hk_2p
    CALL do_stop
    LEAVE
hk_2p:
    ld   [e_op], ac
    CALL do_play
    LEAVE
hk_3:
    ld   [e_key], ac
    xor  0x1B, ac
    bne  hk_4
    CALL do_stop
    LEAVE
hk_4:
    ld   [e_key], ac
    xor  0x2D, ac
    bne  hk_5
    ld   [e_oct], ac
    beq  hk_e
    dec
    ld   ac, [e_oct]
    ld   8, ac
    ld   ac, [e_dirty]
    LEAVE
hk_5:
    ld   [e_key], ac
    xor  0x3D, ac
    bne  hk_6
    ld   [e_oct], ac
    xor  7, ac
    beq  hk_e
    ld   [e_oct], ac
    inc
    ld   ac, [e_oct]
    ld   8, ac
    ld   ac, [e_dirty]
    LEAVE
hk_6:
    GOTO handle_key2
hk_e:
    LEAVE

.chunk
handle_key2:
    ld   [e_key], ac
    xor  0x3C, ac
    bne  hk2_1
    ld   [e_ins], ac
    beq  hk2_e
    dec
    bra  hk2_i
hk2_1:
    ld   [e_key], ac
    xor  0x3E, ac
    bne  hk2_2
    ld   [e_ins], ac
    xor  31, ac
    beq  hk2_e
    ld   [e_ins], ac
    inc
hk2_i:
    ld   ac, [e_ins]
    ld   [e_dirty], ac
    or   0x0C, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [i_np]
    LEAVE
hk2_e:
    LEAVE
hk2_2:
    GOTO handle_key3

.chunk
handle_key3:
    ld   [e_key], ac
    xor  0x0F, ac
    bne  hk2_3
    CALL load_cmd
    LEAVE
hk2_3:
    ld   [e_key], ac
    xor  0x17, ac
    bne  hk2_4
    CALL save_cmd
    LEAVE
hk2_4:
    ld   [e_key], ac
    xor  0x0E, ac
    bne  hk2_6
    CALL new_cmd
    LEAVE
hk2_6:
    ld   [e_key], ac
    xor  0x18, ac
    bne  hk2_7
    CALL exit_cmd
    LEAVE
hk2_7:
    ld   [e_key], ac
    xor  0x0C, ac
    bne  hk2_8
    CALL len_cmd
    LEAVE
hk2_8:
    ld   [e_pane], ac
    bne  hk2_p1
    CALL key_pat
    LEAVE
hk2_p1:
    ld   [e_pane], ac
    xor  1, ac
    bne  hk2_p2
    CALL key_ord
    LEAVE
hk2_p2:
    ld   [e_pane], ac
    xor  2, ac
    bne  hk2_p3
    CALL key_ins
    LEAVE
hk2_p3:
    CALL key_tab
    LEAVE

; ------------------------------------------------------------
; next_pane - Tab
; ------------------------------------------------------------
.chunk
next_pane:
    PUSH_LINK
    CALL cursor_hide
    clr  ac
    ld   ac, [R0]
    CALL pane_tint
    ld   [e_pane], ac
    ld   ac, [w4]               ; the old pane
    inc
    ld   ac, [e_pane]
    xor  5, ac
    bne  npn_a
    clr  ac
    ld   ac, [e_pane]
npn_a:
    ld   [w4], ac
    bne  np_b
    ld   [c_row], ac            ; leaving the pattern pane: no blue there
    CALL grid_tint
np_b:
    ld   [w4], ac
    xor  4, ac
    beq  np_view
    ld   [e_pane], ac
    sub  3, ac
    bcc  np_view
    ld   [e_pane], ac
    bne  np_c
    ld   [c_row], ac
    CALL grid_tint
    CALL cursor_show
    LEAVE
np_c:
    ld   TINT_BLUE, ac
    ld   ac, [R0]
    CALL pane_tint
    CALL cursor_show
    LEAVE
np_view:
    CALL view_refresh
    LEAVE

; view_refresh - the main view (grid or table) and its title again
.chunk
view_refresh:
    PUSH_LINK
    ld   [e_pane], ac
    sub  3, ac
    bcc  vr_t
    ld   ROW_PTIT, ac           ; the table's text off the rows first
    ld   ac, [w4]
vr_c:
    ld   [w4], ac
    ld   ac, [CUR_ROW]
    clr  ac
    ld   ac, [CUR_COL]
    ld   80, ac
    CALL tspc
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  ROW_GRID + PV, ac
    bne  vr_c
    ld   [e_dirty], ac
    or   0x21, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE
vr_t:
    ld   [e_dirty], ac
    or   0x30, ac
    ld   ac, [e_dirty]
    LEAVE

; hexval - AC = key: AC = 0-15, or FF when it is no hex digit
.chunk
hexval:
    ld   ac, [u0]
    sub  0x30, ac
    blt  hv_n
    sub  10, ac
    bcs  hv_d
    ld   [u0], ac
    sub  0x61, ac
    blt  hv_n
    sub  6, ac
    bcs  hv_a
hv_n:
    ld   0xFF, ac
    RET
hv_d:
    ld   [u0], ac
    sub  0x30, ac
    RET
hv_a:
    ld   [u0], ac
    sub  0x61 - 10, ac
    RET

; piano - AC = key: AC = semitone from the octave (0-28), FF when none
.chunk
piano:
    ld   ac, [u0]
    clr  ac
    ld   ac, [u1]
pi_l:
    ld   [u1], ac
    add  pkeys & 0xFF, x
    ld   pkeys >> 8, y
    ld   [y,x], ac
    beq  pi_n
    xor  [u0], ac
    beq  pi_f
    ld   [u1], ac
    add  2, ac
    ld   ac, [u1]
    bra  pi_l
pi_f:
    ld   [u1], ac
    add  (pkeys + 1) & 0xFF, x
    ld   [y,x], ac
    RET
pi_n:
    ld   0xFF, ac
    RET

; ------------------------------------------------------------
; key_pat - the pattern pane
; ------------------------------------------------------------
.chunk
key_pat:
    PUSH_LINK
    ld   [e_key], ac
    xor  0x11, ac
    bne  kp_1
    ld   [c_row], ac
    beq  kp_e
    dec
    CALL move_row
    LEAVE
kp_1:
    ld   [e_key], ac
    xor  0x12, ac
    bne  kp_2
    ld   [c_row], ac
    xor  63, ac
    beq  kp_e
    ld   [c_row], ac
    inc
    CALL move_row
    LEAVE
kp_e:
    LEAVE
kp_2:
    GOTO key_pat2

.chunk
key_pat2:
    ld   [e_key], ac
    xor  0x13, ac
    bne  kp_3
    ld   [c_col], ac
    bne  kp_2a
    ld   [c_v], ac
    beq  kp_e2
    CALL cursor_hide
    ld   [c_v], ac
    dec
    ld   ac, [c_v]
    ld   6, ac
    ld   ac, [c_col]
    ld   [e_dirty], ac
    or   0x20, ac
    ld   ac, [e_dirty]
kp_2a:
    CALL cursor_hide
    ld   [c_col], ac
    dec
    ld   ac, [c_col]
    CALL cursor_show
    LEAVE
kp_3:
    ld   [e_key], ac
    xor  0x14, ac
    bne  kp_4
    ld   [c_col], ac
    xor  5, ac
    bne  kp_3a
    ld   [c_v], ac
    xor  3, ac
    beq  kp_e2
    CALL cursor_hide
    ld   [c_v], ac
    inc
    ld   ac, [c_v]
    ld   0xFF, ac
    ld   ac, [c_col]
    ld   [e_dirty], ac
    or   0x20, ac
    ld   ac, [e_dirty]
kp_3a:
    CALL cursor_hide
    ld   [c_col], ac
    inc
    ld   ac, [c_col]
    CALL cursor_show
    LEAVE
kp_4:
    CALL edit_cell
    LEAVE
kp_e2:
    LEAVE

; move_row - the pattern cursor to row AC (the view follows)
.chunk
move_row:
    PUSH_LINK
    ld   ac, [w5]
    CALL cursor_hide
    ld   [c_row], ac
    ld   ac, [w4]
    ld   [w5], ac
    ld   ac, [c_row]
    CALL scroll_to
    bne  mr_full
    ld   [w4], ac
    CALL grid_tint
    ld   [c_row], ac
    CALL grid_tint
    CALL cursor_show
    LEAVE
mr_full:
    ld   [e_dirty], ac
    or   0x01, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE

; scroll_to - c_row on the screen: AC = 1 when c_top moved (a redraw)
.chunk
scroll_to:
    ld   [c_row], ac
    sub  [c_top], ac
    bcs  st_m
    sub  PV, ac
    bcs  st_ok
st_m:
    ld   PV, ac             ; centre it
    shr  ac
    ld   ac, [u0]
    ld   [c_row], ac
    sub  [u0], ac
    bcs  st_0
    ld   ac, [c_top]
    ld   1, ac
    RET
st_0:
    clr  ac
    ld   ac, [c_top]
    ld   1, ac
    RET
st_ok:
    clr  ac
    RET

; ------------------------------------------------------------
; edit_cell - a key into the field under the pattern cursor
; ------------------------------------------------------------
.chunk
edit_cell:
    PUSH_LINK
    ld   [c_v], ac
    CALL pat_of
    ld   ac, [w0]
    xor  0xFF, ac
    bne  edc_a
    ld   s_nopat2 & 0xFF, ac
    ld   ac, [R0]
    ld   s_nopat2 >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
edc_a:
    ld   [w0], ac
    CALL need
    ld   [c_row], ac
    sub  [p_len], ac
    bcs  edc_b
    ld   s_pastend & 0xFF, ac
    ld   ac, [R0]
    ld   s_pastend >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
edc_b:
    ld   [c_row], ac
    shl
    shl
    ld   ac, [w1]               ; the row's first byte
    ld   [c_col], ac
    bne  edc_c
    GOTO edit_note
edc_c:
    ld   [e_key], ac            ; the other columns: hex digits, Del
    xor  0x7F, ac
    beq  edc_del
    ld   [e_key], ac
    xor  0x08, ac
    beq  edc_del
    ld   [e_key], ac
    CALL hexval
    ld   ac, [w2]
    xor  0xFF, ac
    beq  edc_e
    GOTO edit_hex
edc_del:
    GOTO edit_del
edc_e:
    LEAVE

; the note column: the piano keys, 1 = key off, Del
.chunk
edit_note:
    ld   [e_key], ac
    xor  0x31, ac
    bne  edn_a
    ld   SCRATCH >> 8, y
    ld   [w1], x
    ld   0x60, [y,x]
    GOTO commit_adv
edn_a:
    ld   [e_key], ac
    xor  0x7F, ac
    beq  edn_del
    ld   [e_key], ac
    xor  0x08, ac
    beq  edn_del
    ld   [e_key], ac
    CALL piano
    ld   ac, [w2]
    xor  0xFF, ac
    beq  edn_e
    ld   [e_oct], ac
    shl
    add  [e_oct], ac
    shl
    shl
    add  [w2], ac               ; 12 x octave + semitone
    ld   ac, [w2]
    sub  96, ac
    bcs  edn_ok
    ld   s_high & 0xFF, ac
    ld   ac, [R0]
    ld   s_high >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
edn_ok:
    ld   SCRATCH >> 8, y
    ld   [w1], x
    ld   [w2], ac
    ld   ac, [y,x]
    ld   [w1], ac
    inc
    ld   ac, x
    ld   [e_ins], ac
    ld   ac, [y,x]
    ld   [e_play], ac           ; hear it when the song is not playing
    bne  edn_c
    ld   [e_ins], ac
    ld   ac, [R0]
    ld   20, ac
    ld   ac, [R1]
    ld   [w2], ac
    CALL mus_sfx
edn_c:
    GOTO commit_adv
edn_del:
    ld   SCRATCH >> 8, y
    ld   [w1], x
    ld   0x61, [y,x]
    ld   [w1], ac
    inc
    ld   ac, x
    ld   0xFF, [y,x]
    GOTO commit
edn_e:
    LEAVE

; a hex digit (w2) into the instrument or effect columns
.chunk
edit_hex:
    ld   SCRATCH >> 8, y
    ld   [c_col], ac
    xor  3, ac
    beq  eh_fx
    ld   [c_col], ac
    sub  4, ac
    bcc  eh_par
    ld   [w1], ac               ; the instrument: 1 = high nibble (0-1), 2 = low
    inc
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  eh_i1
    clr  ac
    ld   ac, [y,x]
eh_i1:
    ld   [c_col], ac
    xor  1, ac
    bne  eh_i2
    ld   [w2], ac
    and  1, ac
    shl
    shl
    shl
    shl
    ld   ac, [w3]
    ld   [y,x], ac
    and  0x0F, ac
    or   [w3], ac
    ld   ac, [y,x]
    GOTO commit
eh_i2:
    ld   [y,x], ac
    and  0x10, ac
    or   [w2], ac
    ld   ac, [y,x]
    GOTO commit
eh_fx:
    ld   [w1], ac
    add  2, ac
    ld   ac, x
    ld   [w2], ac
    ld   ac, [y,x]
    GOTO commit
eh_par:
    ld   [w1], ac               ; the parameter: an effect 0 when none yet
    add  2, ac
    ld   ac, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  eh_p1
    clr  ac
    ld   ac, [y,x]
eh_p1:
    ld   [w1], ac
    add  3, ac
    ld   ac, x
    ld   [c_col], ac
    xor  4, ac
    bne  eh_p2
    ld   [w2], ac
    shl
    shl
    shl
    shl
    ld   ac, [w3]
    ld   [y,x], ac
    and  0x0F, ac
    or   [w3], ac
    ld   ac, [y,x]
    GOTO commit
eh_p2:
    ld   [y,x], ac
    and  0xF0, ac
    or   [w2], ac
    ld   ac, [y,x]
    GOTO commit

; Del in the instrument or effect columns
.chunk
edit_del:
    ld   SCRATCH >> 8, y
    ld   [c_col], ac
    sub  3, ac
    bcc  ed_fx
    ld   [w1], ac
    inc
    ld   ac, x
    ld   0xFF, [y,x]
    GOTO commit
ed_fx:
    ld   [w1], ac
    add  2, ac
    ld   ac, x
    ld   0xFF, [y,x]
    inc
    ld   ac, x
    ld   0x00, [y,x]
    GOTO commit

; commit - the decoded pattern back into its slot, the row drawn again;
; commit_adv also moves the cursor down a row
.chunk
commit_adv:
    CALL encode_pat
    bne  cm_full
    ld   [c_row], ac
    CALL draw_row
    ld   [c_row], ac
    xor  63, ac
    beq  cm_s
    ld   [c_row], ac
    inc
    CALL move_row
    LEAVE
cm_s:
    CALL cursor_show
    LEAVE
commit:
    CALL encode_pat
    bne  cm_full
    ld   [c_row], ac
    CALL draw_row
    CALL cursor_show
    LEAVE
cm_full:
    ld   0xFF, ac               ; the slot is as it was: decode it again
    ld   ac, [p_pat]
    ld   s_full & 0xFF, ac
    ld   ac, [R0]
    ld   s_full >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE

; ------------------------------------------------------------
; key_ord - the orderlist pane
; ------------------------------------------------------------
.chunk
key_ord:
    PUSH_LINK
    ld   [o_v], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [y,x], ac
    ld   ac, [w3]               ; the voice's positions
    ld   [e_key], ac
    xor  0x11, ac
    bne  ko_1
    ld   [o_k], ac
    beq  ko_e
    dec
    CALL ord_move
    LEAVE
ko_1:
    ld   [e_key], ac
    xor  0x12, ac
    bne  ko_2
    ld   [o_k], ac
    xor  [w3], ac
    beq  ko_e
    ld   [o_k], ac
    inc
    CALL ord_move
    LEAVE
ko_2:
    ld   [e_key], ac
    xor  0x13, ac
    bne  ko_3
    ld   [o_v], ac
    shl
    add  [o_f], ac
    beq  ko_e
    dec
    CALL ord_field
    LEAVE
ko_3:
    ld   [e_key], ac
    xor  0x14, ac
    bne  ko_4
    ld   [o_v], ac
    shl
    add  [o_f], ac
    xor  7, ac
    beq  ko_e
    ld   [o_v], ac
    shl
    add  [o_f], ac
    inc
    CALL ord_field
    LEAVE
ko_4:
    GOTO key_ord2
ko_e:
    LEAVE

; ord_field - the order cursor to field AC (2 voice + field)
.chunk
ord_field:
    PUSH_LINK
    ld   ac, [w4]
    CALL cursor_hide
    ld   [w4], ac
    and  1, ac
    ld   ac, [o_f]
    ld   [w4], ac
    shr  ac
    ld   ac, [o_v]
    CALL cursor_show
    LEAVE

; ord_move - the order cursor to position AC; the grid shows it
.chunk
ord_move:
    PUSH_LINK
    ld   ac, [w4]
    CALL cursor_hide
    clr  ac
    ld   ac, [R0]
    CALL pane_tint
    ld   [w4], ac
    ld   ac, [o_k]
    ld   ac, [e_op]
    sub  [e_otop], ac
    bcs  om_up
    sub  ORD_ROWS, ac
    bcs  om_ok
    ld   [o_k], ac
    sub  ORD_ROWS - 1, ac
    ld   ac, [e_otop]
    bra  om_ok
om_up:
    ld   [o_k], ac
    ld   ac, [e_otop]
om_ok:
    ld   [e_dirty], ac
    or   0x23, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    ld   TINT_BLUE, ac
    ld   ac, [R0]
    CALL pane_tint
    LEAVE

; the orderlist's editing keys: hex digits, [ ], i, Del, l, s
.chunk
key_ord2:
    ld   [e_key], ac
    xor  0x5B, ac
    bne  ko2_1
    ld   0xFF, ac
    GOTO ord_trans
ko2_1:
    ld   [e_key], ac
    xor  0x5D, ac
    bne  ko2_2
    ld   1, ac
    GOTO ord_trans
ko2_2:
    ld   [e_key], ac
    xor  0x69, ac
    bne  ko2_3
    GOTO ord_insert
ko2_3:
    ld   [e_key], ac
    xor  0x7F, ac
    beq  ko2_del
    ld   [e_key], ac
    xor  0x08, ac
    bne  ko2_4
ko2_del:
    GOTO ord_delete
ko2_4:
    ld   [e_key], ac
    xor  0x6C, ac
    bne  ko2_5
    ld   0xFF, ac
    GOTO ord_end
ko2_5:
    ld   [e_key], ac
    xor  0x73, ac
    bne  ko2_6
    ld   0xFE, ac
    GOTO ord_end
ko2_6:
    ld   [e_key], ac
    CALL hexval
    ld   ac, [w2]
    xor  0xFF, ac
    beq  ko2_e
    GOTO ord_hex
ko2_e:
    LEAVE

; ord_hex - the digit w2 into the pattern number, or the loop target on
; the end row
.chunk
ord_hex:
    ld   [o_v], ac
    add  VSPAGE, y
    ld   [o_k], ac
    xor  [w3], ac
    beq  oh_end
    ld   [o_f], ac
    bne  oh_e
    ld   [o_k], ac
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    shl
    shl
    shl
    shl
    or   [w2], ac
    and  0x3F, ac
    ld   ac, [y,x]
    GOTO ord_changed
oh_end:
    ld   OD_END, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  oh_e
    ld   OD_TGT, x
    ld   [y,x], ac
    shl
    shl
    shl
    shl
    or   [w2], ac
    and  0x3F, ac
    ld   ac, [u0]
    sub  [w3], ac
    bcs  oh_t
    clr  ac
    ld   ac, [u0]
oh_t:
    ld   [u0], ac
    ld   ac, [y,x]
    GOTO ord_changed
oh_e:
    LEAVE

; ord_trans - AC = +1 / -1 on the transpose (-32..31)
.chunk
ord_trans:
    ld   ac, [u0]
    ld   [o_k], ac
    xor  [w3], ac
    beq  ot_e
    ld   [o_v], ac
    add  VSPAGE, y
    ld   [o_k], ac
    shl
    add  OD_TR, x
    ld   [y,x], ac
    add  [u0], ac
    ld   ac, [u1]
    add  32, ac
    sub  64, ac
    bcc  ot_e                   ; out of -32..31
    ld   [u1], ac
    ld   ac, [y,x]
    GOTO ord_changed
ot_e:
    LEAVE

; ord_end - AC = FE stop / FF loop at the end of the list
.chunk
ord_end:
    ld   ac, [u0]
    ld   [o_v], ac
    add  VSPAGE, y
    ld   OD_END, x
    ld   [u0], ac
    ld   ac, [y,x]
    ld   OD_TGT, x
    ld   0, [y,x]
    GOTO ord_changed

; ord_insert - a position (pattern 00) at the cursor
.chunk
ord_insert:
    ld   [w3], ac
    xor  OD_MAX, ac
    beq  oi_e
    ld   [o_v], ac
    add  VSPAGE, y
    ld   [w3], ac               ; from the last down to o_k: entry k+1 = entry k
    ld   ac, [u0]
oi_l:
    ld   [u0], ac
    xor  [o_k], ac
    beq  oi_d
    ld   [u0], ac
    dec
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   [u0], ac
    dec
    shl
    add  OD_TR, x
    ld   [y,x], ac
    ld   ac, [u2]
    ld   [u0], ac
    shl
    add  OD_PAT, x
    ld   [u1], ac
    ld   ac, [y,x]
    ld   [u0], ac
    shl
    add  OD_TR, x
    ld   [u2], ac
    ld   ac, [y,x]
    ld   [u0], ac
    dec
    ld   ac, [u0]
    bra  oi_l
oi_d:
    ld   [o_k], ac
    shl
    add  OD_PAT, x
    ld   0, [y,x]
    ld   [o_k], ac
    shl
    add  OD_TR, x
    ld   0, [y,x]
    ld   OD_LEN, x
    ld   [w3], ac
    inc
    ld   ac, [y,x]
    ld   ac, [w3]
    GOTO ord_changed
oi_e:
    LEAVE

; ord_delete - the position at the cursor
.chunk
ord_delete:
    ld   [o_k], ac
    xor  [w3], ac
    beq  od_e
    ld   [o_v], ac
    add  VSPAGE, y
    ld   [o_k], ac
    ld   ac, [u0]
od_l:
    ld   [u0], ac
    inc
    xor  [w3], ac
    beq  od_d
    ld   [u0], ac
    inc
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   [u0], ac
    inc
    shl
    add  OD_TR, x
    ld   [y,x], ac
    ld   ac, [u2]
    ld   [u0], ac
    shl
    add  OD_PAT, x
    ld   [u1], ac
    ld   ac, [y,x]
    ld   [u0], ac
    shl
    add  OD_TR, x
    ld   [u2], ac
    ld   ac, [y,x]
    ld   [u0], ac
    inc
    ld   ac, [u0]
    bra  od_l
od_d:
    ld   OD_LEN, x
    ld   [w3], ac
    dec
    ld   ac, [y,x]
    ld   ac, [w3]
    ld   OD_TGT, x
    ld   [y,x], ac
    sub  [w3], ac
    bcs  od_t
    ld   OD_TGT, x
    ld   0, [y,x]
od_t:
    GOTO ord_changed
od_e:
    LEAVE

; ord_changed - voice o_v's list encoded again, the block drawn again
; (and the grid when the position shown changed)
.chunk
ord_changed:
    ld   [o_v], ac
    CALL encode_ol
    ld   1, ac
    ld   ac, [e_mod]
    ld   [e_dirty], ac
    or   0x23, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE

; ------------------------------------------------------------
; key_ins - the instrument pane
; ------------------------------------------------------------
.chunk
key_ins:
    PUSH_LINK
    ld   [e_key], ac
    xor  0x11, ac
    bne  ki_1
    ld   [i_f], ac
    beq  ki_e
    dec
    CALL ins_field
    LEAVE
ki_1:
    ld   [e_key], ac
    xor  0x12, ac
    bne  ki_2
    ld   [i_f], ac
    xor  11, ac
    beq  ki_e
    ld   [i_f], ac
    inc
    CALL ins_field
    LEAVE
ki_2:
    ld   [i_f], ac
    xor  11, ac
    beq  ki_name
    ld   [e_key], ac
    xor  0x5B, ac
    bne  ki_3
    ld   0xFF, ac
    CALL ins_adj
    LEAVE
ki_3:
    ld   [e_key], ac
    xor  0x5D, ac
    bne  ki_4
    ld   1, ac
    CALL ins_adj
    LEAVE
ki_4:
    ld   [e_key], ac
    CALL hexval
    ld   ac, [w2]
    xor  0xFF, ac
    beq  ki_e
    CALL ins_digit
    LEAVE
ki_name:
    CALL ins_name
ki_e:
    LEAVE

; ins_field - the cursor to field AC
.chunk
ins_field:
    PUSH_LINK
    ld   ac, [w4]
    clr  ac
    ld   ac, [R0]
    CALL pane_tint
    ld   [w4], ac
    ld   ac, [i_f]
    clr  ac
    ld   ac, [i_np]
    ld   TINT_BLUE, ac
    ld   ac, [R0]
    CALL pane_tint
    ld   [e_dirty], ac
    or   0x04, ac
    ld   ac, [e_dirty]
    LEAVE

; ikind - the field i_f: u0 = its byte offset, u1 = its kind (0 high
; nibble, 1 low nibble, 2 byte, 3 bit 0)
.macro IKIND
    ld   [i_f], ac
    shl
    add  ikinds & 0xFF, x
    ld   ikinds >> 8, y
    ld   [y,x], ac
    ld   ac, [u0]
    ld   [i_f], ac
    shl
    add  (ikinds + 1) & 0xFF, x
    ld   [y,x], ac
    ld   ac, [u1]
.endm

; ins_adj - AC = +1 / -1 on the field
.chunk
ins_adj:
    PUSH_LINK
    ld   ac, [w0]
    IKIND
    ld   [u0], ac
    CALL ins_byte
    ld   ac, [w1]
    ld   [u1], ac
    bne  iad_1
    ld   [w1], ac               ; the high nibble
    and  0x0F, ac
    ld   ac, [w3]
    ld   [w1], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    add  [w0], ac
    shl
    shl
    shl
    shl
    or   [w3], ac
    bra  iad_w
iad_1:
    ld   [u1], ac
    xor  1, ac
    bne  iad_2
    ld   [w1], ac               ; the low nibble
    add  [w0], ac
    and  0x0F, ac
    ld   ac, [w3]
    ld   [w1], ac
    and  0xF0, ac
    or   [w3], ac
    bra  iad_w
iad_2:
    ld   [u1], ac
    xor  2, ac
    bne  iad_3
    ld   [w1], ac               ; the byte
    add  [w0], ac
    bra  iad_w
iad_3:
    ld   [w1], ac               ; the bit
    xor  1, ac
iad_w:
    ld   ac, [w1]
    ld   [u0], ac
    CALL ins_addr
    ld   [w1], ac
    ld   ac, [y,x]
    CALL ins_changed
    LEAVE

; ins_digit - the hex digit w2 into the field
.chunk
ins_digit:
    PUSH_LINK
    IKIND
    ld   [u0], ac
    CALL ins_byte
    ld   ac, [w1]
    ld   [u1], ac
    bne  id_1
    ld   [w2], ac
    shl
    shl
    shl
    shl
    ld   ac, [w3]
    ld   [w1], ac
    and  0x0F, ac
    or   [w3], ac
    bra  id_w
id_1:
    ld   [u1], ac
    xor  1, ac
    bne  id_2
    ld   [w1], ac
    and  0xF0, ac
    or   [w2], ac
    bra  id_w
id_2:
    ld   [u1], ac
    xor  2, ac
    bne  id_3
    ld   [w1], ac
    shl
    shl
    shl
    shl
    or   [w2], ac
    bra  id_w
id_3:
    ld   [w2], ac
    and  1, ac
id_w:
    ld   ac, [w1]
    ld   [u0], ac
    CALL ins_addr
    ld   [w1], ac
    ld   ac, [y,x]
    CALL ins_changed
    LEAVE

; ins_name - a character into the name (Backspace takes one back)
.chunk
ins_name:
    PUSH_LINK
    ld   [e_key], ac
    xor  0x08, ac
    bne  in_c
    ld   [i_np], ac
    beq  in_e
    dec
    ld   ac, [i_np]
    ld   0x20, ac
    bra  in_w
in_c:
    ld   [e_key], ac
    sub  0x20, ac
    blt  in_e
    ld   [e_key], ac
    sub  0x61, ac               ; a-z -> A-Z
    blt  in_p
    sub  26, ac
    bcc  in_p
    ld   [e_key], ac
    and  0xDF, ac
    ld   ac, [e_key]
in_p:
    ld   [i_np], ac
    xor  7, ac
    beq  in_e
    ld   [e_key], ac
in_w:
    ld   ac, [w1]
    ld   [i_np], ac
    add  I_NAME, ac
    CALL ins_addr
    ld   [w1], ac
    ld   ac, [y,x]
    ld   [e_key], ac
    xor  0x08, ac
    beq  in_d
    ld   [i_np], ac
    inc
    ld   ac, [i_np]
in_d:
    CALL ins_changed
in_e:
    LEAVE

.chunk
ins_changed:
    ld   1, ac
    ld   ac, [e_mod]
    ld   [e_dirty], ac
    or   0x04, ac
    ld   ac, [e_dirty]
    RET

; ------------------------------------------------------------
; key_tab - the wave and pulse table panes
; ------------------------------------------------------------
.chunk
key_tab:
    PUSH_LINK
    ld   [e_key], ac
    xor  0x11, ac
    bne  kt_1
    ld   [t_e], ac
    xor  1, ac
    beq  kt_e
    ld   [t_e], ac
    dec
    CALL tab_move
    LEAVE
kt_1:
    ld   [e_key], ac
    xor  0x12, ac
    bne  kt_2
    ld   [t_e], ac
    xor  63, ac
    beq  kt_e
    ld   [t_e], ac
    inc
    CALL tab_move
    LEAVE
kt_2:
    ld   [e_key], ac
    xor  0x13, ac
    bne  kt_3
    clr  ac
    CALL tab_side
    LEAVE
kt_3:
    ld   [e_key], ac
    xor  0x14, ac
    bne  kt_4
    ld   1, ac
    CALL tab_side
    LEAVE
kt_4:
    ld   [e_key], ac
    xor  0x5B, ac
    bne  kt_5
    ld   0xFF, ac
    CALL tab_adj
    LEAVE
kt_5:
    ld   [e_key], ac
    xor  0x5D, ac
    bne  kt_6
    ld   1, ac
    CALL tab_adj
    LEAVE
kt_6:
    ld   [e_key], ac
    CALL hexval
    ld   ac, [w2]
    xor  0xFF, ac
    beq  kt_e
    CALL tab_digit
kt_e:
    LEAVE

.chunk
tab_move:
    PUSH_LINK
    ld   ac, [w4]
    CALL cursor_hide
    clr  ac
    ld   ac, [R0]
    CALL pane_tint
    ld   [w4], ac
    ld   ac, [t_e]
    ld   TINT_BLUE, ac
    ld   ac, [R0]
    CALL pane_tint
    CALL cursor_show
    LEAVE

.chunk
tab_side:
    PUSH_LINK
    ld   ac, [w4]
    CALL cursor_hide
    ld   [w4], ac
    ld   ac, [t_f]
    CALL cursor_show
    LEAVE

; tab_addr - Y:X = the byte under the table cursor
.macro TABADDR
    ld   (SONG >> 8) + 1, y
    ld   [e_pane], ac
    xor  4, ac
    bne  tad_w\@
    ld   0x80, ac
    bra  tad_s\@
tad_w\@:
    clr  ac
tad_s\@:
    ld   ac, [u2]
    ld   [t_f], ac
    beq  tad_l\@
    ld   [u2], ac
    add  0x40, ac
    ld   ac, [u2]
tad_l\@:
    ld   [u2], ac
    add  [t_e], ac
    ld   ac, x
.endm

.chunk
tab_adj:
    PUSH_LINK
    ld   ac, [w0]
    TABADDR
    ld   [y,x], ac
    add  [w0], ac
    ld   ac, [y,x]
    CALL tab_changed
    LEAVE

.chunk
tab_digit:
    PUSH_LINK
    TABADDR
    ld   [y,x], ac
    shl
    shl
    shl
    shl
    or   [w2], ac
    ld   ac, [y,x]
    CALL tab_changed
    LEAVE

.chunk
tab_changed:
    PUSH_LINK
    ld   1, ac
    ld   ac, [e_mod]
    ld   [t_e], ac
    CALL draw_tentry
    CALL cursor_show
    LEAVE

; ============================================================
; playing
; ============================================================

; do_play - AC = the order position to start at
.chunk
do_play:
    PUSH_LINK
    ld   ac, [w0]
    clr  ac
    CALL mus_play
    ld   [w0], ac
    beq  dpl_s
    clr  ac                     ; each voice's orderlist pointer to the position
    ld   ac, [w1]
dpl_v:
    ld   [w1], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [w0], ac
    sub  [y,x], ac
    bcs  dpl_k
    ld   [y,x], ac              ; past its end: the end
    bra  dpl_k2
dpl_k:
    ld   [w0], ac
dpl_k2:
    add  OD_OFF, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   [w1], ac
    shl
    shl
    shl
    shl
    shl
    shl
    add  [w2], ac
    ld   ac, [w2]
    ld   W_OLL, x
    ld   [w2], ac
    ld   ac, [y,x]
    ld   [w1], ac
    inc
    ld   ac, [w1]
    xor  4, ac
    bne  dpl_v
dpl_s:
    ld   1, ac
    ld   ac, [e_play]
    ld   0xFF, ac
    ld   ac, [e_plop]
    ld   ac, [e_plrow]
    ld   [e_dirty], ac
    or   0x08, ac
    ld   ac, [e_dirty]
    LEAVE

.chunk
do_stop:
    PUSH_LINK
    CALL mus_stop
    clr  ac
    ld   ac, [e_play]
    ld   [e_plrow], ac          ; the green off
    CALL grid_tint
    ld   0xFF, ac
    ld   ac, [e_plop]
    ld   ac, [e_plrow]
    ld   [e_dirty], ac
    or   0x08, ac
    ld   ac, [e_dirty]
    LEAVE

; ------------------------------------------------------------
; follow - once a frame while playing: voice 1's position and row from
; the player's state; the grid follows them
; ------------------------------------------------------------
.chunk
follow:
    PUSH_LINK
    ld   [e_play], ac
    beq  fl_e
    ld   VSPAGE, y
    ld   W_STOP, x
    ld   [y,x], ac
    bne  fl_e
    ld   W_PPH, x
    ld   [y,x], ac
    beq  fl_e
    ld   W_OLL, x               ; which position: OD_OFF[j] = the pointer, j - 1
    ld   [y,x], ac
    ld   ac, [w0]
    ld   OD_LEN, x
    ld   [y,x], ac
    ld   ac, [w1]
    clr  ac
    ld   ac, [w2]
fl_j:
    ld   [w2], ac
    add  OD_OFF, x
    ld   [y,x], ac
    xor  [w0], ac
    beq  fl_f
    ld   [w2], ac
    xor  [w1], ac
    beq  fl_e
    ld   [w2], ac
    inc
    ld   ac, [w2]
    bra  fl_j
fl_f:
    ld   [w2], ac
    beq  fl_e
    dec
    ld   ac, [w2]               ; the position
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    ld   ac, [w3]               ; its pattern
    ld   W_PPL, x
    ld   [y,x], ac
    ld   ac, [w4]
    ld   W_EMPTY, x
    ld   [y,x], ac
    ld   ac, [w5]
    GOTO follow2
fl_e:
    LEAVE

; the row: the rows encoded before the pointer, less the empty ones
; still to come
.chunk
follow2:
    ld   [w3], ac
    sub  CAP, ac
    bcc  fl2_e
    ld   [w3], ac
    SLOTADDR
    ld   [w4], ac
    sub  [u2], ac
    ld   ac, [w4]               ; the offset in the pattern
    clr  ac
    ld   ac, [u3]               ; bytes passed
    ld   ac, [u4]               ; rows
fl2_l:
    ld   [u3], ac
    sub  [w4], ac
    bcc  fl2_d
    ld   [u1], y
    ld   [u3], ac
    add  [u2], ac
    ld   ac, x
    ld   [u3], ac
    inc
    ld   ac, [u3]
    ld   [y,x], ac
    ld   ac, [u5]
    xor  0xFF, ac
    beq  fl2_d
    ld   [u5], ac
    sub  0xE0, ac
    bcc  fl2_fx
    ld   [u5], ac
    sub  0xC0, ac
    bcc  fl2_l
    ld   [u5], ac
    sub  0x80, ac
    bcc  fl2_run
    ld   [u4], ac
    inc
    ld   ac, [u4]
    bra  fl2_l
fl2_fx:
    ld   [u3], ac
    inc
    ld   ac, [u3]
    bra  fl2_l
fl2_run:
    and  0x3F, ac
    inc
    add  [u4], ac
    ld   ac, [u4]
    bra  fl2_l
fl2_d:
    ld   [u4], ac
    beq  fl2_0
    dec
    sub  [w5], ac
    blt  fl2_0
    bra  fl2_r
fl2_0:
    clr  ac
fl2_r:
    ld   ac, [w4]               ; the row
    ld   [w2], ac
    xor  [e_plop], ac
    bne  fl2_pos
    ld   [w4], ac
    xor  [e_plrow], ac
    bne  fl2_row
fl2_e:
    LEAVE
fl2_pos:
    GOTO follow_pos
fl2_row:
    GOTO follow_row

; a new position: the grid shows it
.chunk
follow_pos:
    ld   [w2], ac
    ld   ac, [e_plop]
    ld   [w4], ac
    ld   ac, [e_plrow]
    ld   [w2], ac
    xor  [e_op], ac
    bne  fp_new
    GOTO follow_row2            ; the same position shown already
fp_new:
    CALL cursor_hide
    ld   [w2], ac
    ld   ac, [e_op]
    ld   ac, [o_k]
    sub  [e_otop], ac
    bcs  fp_up
    sub  ORD_ROWS, ac
    bcs  fp_ok
    ld   [o_k], ac
    sub  ORD_ROWS - 1, ac
    ld   ac, [e_otop]
    bra  fp_ok
fp_up:
    ld   [o_k], ac
    ld   ac, [e_otop]
fp_ok:
    ld   [w4], ac
    ld   ac, [c_row]
    CALL scroll_to
    ld   [e_dirty], ac
    or   0x23, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE

; a new row in the position shown: the cursor follows
.chunk
follow_row:
    ld   [e_plrow], ac
    ld   ac, [w3]               ; the old row
follow_row_b:
    ld   [w4], ac
    ld   ac, [e_plrow]
    CALL cursor_hide
    ld   [c_row], ac
    ld   ac, [w5]
    ld   [w4], ac
    ld   ac, [c_row]
    CALL scroll_to
    bne  fr_full
    ld   [w3], ac
    CALL grid_tint
    ld   [w5], ac
    CALL grid_tint
    ld   [c_row], ac
    CALL grid_tint
    CALL cursor_show
    LEAVE
fr_full:
    ld   [e_dirty], ac
    or   0x01, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
    LEAVE
follow_row2:
    ld   0xFF, ac
    ld   ac, [w3]
    bra  follow_row_b

; ============================================================
; commands
; ============================================================

; len_cmd - Ctrl-L: the pattern's length 64 > 16 > 32 > 64
.chunk
len_cmd:
    PUSH_LINK
    ld   [e_pane], ac
    bne  lc_e
    ld   [c_v], ac
    CALL pat_of
    ld   ac, [w0]
    xor  0xFF, ac
    beq  lc_e
    ld   [w0], ac
    CALL need
    ld   [p_len], ac
    xor  64, ac
    bne  lc_1
    ld   16, ac
    bra  lc_s
lc_1:
    ld   [p_len], ac
    xor  16, ac
    bne  lc_2
    ld   32, ac
    bra  lc_s
lc_2:
    ld   64, ac
lc_s:
    ld   ac, [p_len]
    CALL encode_pat
    ld   [e_dirty], ac
    or   0x21, ac
    ld   ac, [e_dirty]
    clr  ac
    ld   ac, [e_drow]
lc_e:
    LEAVE

; exit_cmd - Ctrl-X: back to the DOS (twice when the song is not saved)
.chunk
exit_cmd:
    PUSH_LINK
    ld   [e_mod], ac
    beq  xc_go
    ld   [e_fl], ac
    and  1, ac
    bne  xc_go
    ld   [e_fl], ac
    or   1, ac
    ld   ac, [e_fl]
    ld   s_unsaved & 0xFF, ac
    ld   ac, [R0]
    ld   s_unsaved >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
xc_go:
    CALL mus_stop
    clr  ac
    CALL l_vid_clear
    GOTO exit_dos

; new_cmd - Ctrl-N: a blank song
.chunk
new_cmd:
    PUSH_LINK
    CALL do_stop
    CALL new_song
    CALL redraw_all
    LEAVE

; ------------------------------------------------------------
; new_song - a blank song: one instrument, a pattern per voice
; ------------------------------------------------------------
.chunk
new_song:
    PUSH_LINK
    CALL mus_stop
    ld   SONG >> 8, ac
    ld   ac, [w0]
ns_p:
    ld   [w0], y
    clr  ac
ns_b:
    ld   ac, x
    ld   0x00, [y,x]
    inc
    bne  ns_b
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  (SONG >> 8) + 5, ac
    bne  ns_p
    ld   SONG >> 8, y
    ld   0x00, x
    ld   0x50, [y,x]
    ld   0x01, x
    ld   0x4D, [y,x]
    ld   0x02, x
    ld   0x55, [y,x]
    ld   0x03, x
    ld   0x01, [y,x]
    ld   0x05, x
    ld   4, [y,x]
    ld   0x06, x
    ld   1, [y,x]
    ld   0x40, x
    ld   6, [y,x]
    ld   0x20, ac               ; the title
    ld   ac, [w0]
ns_t:
    ld   [w0], ac
    sub  0x20, ac
    add  s_newsong & 0xFF, x
    ld   s_newsong >> 8, y
    ld   [y,x], ac
    ld   SONG >> 8, y
    ld   [w0], x
    ld   ac, [y,x]
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  0x40, ac
    bne  ns_t
    GOTO new_song2

.chunk
new_song2:
    ld   (SONG >> 8) + 1, y     ; wave table: 1 = pulse +0, 2 = end
    ld   0x01, x
    ld   0x01, [y,x]
    ld   0x02, x
    ld   0xFE, [y,x]
    ld   (SONG >> 8) + 2, y     ; instrument 0
    ld   I_AD, x
    ld   0x0A, [y,x]
    ld   I_SR, x
    ld   0xA8, [y,x]
    ld   I_WAVE, x
    ld   0x01, [y,x]
    ld   I_PW, x
    ld   0x80, [y,x]
    ld   I_VOL, x
    ld   15, [y,x]
    clr  ac
    ld   ac, [w0]
ns_n:
    ld   [w0], ac
    add  s_pulse & 0xFF, x
    ld   s_pulse >> 8, y
    ld   [y,x], ac
    ld   ac, [w1]
    ld   [w0], ac
    add  I_NAME, x
    ld   (SONG >> 8) + 2, y
    ld   [w1], ac
    ld   ac, [y,x]
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  7, ac
    bne  ns_n
    clr  ac                     ; orderlists: voice v plays pattern v, loops
    ld   ac, [w0]
ns_o:
    ld   [w0], ac
    add  VSPAGE, y
    ld   OD_PAT, x
    ld   [w0], ac
    ld   ac, [y,x]
    ld   OD_TR, x
    ld   0, [y,x]
    ld   OD_LEN, x
    ld   1, [y,x]
    ld   OD_END, x
    ld   0xFF, [y,x]
    ld   OD_TGT, x
    ld   0, [y,x]
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  4, ac
    bne  ns_o
    CALL encode_all
    clr  ac
    ld   ac, [w0]
ns_s:
    ld   [w0], ac
    CALL slot_clear
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  CAP, ac
    bne  ns_s
    GOTO song_ready

; song_ready - after a new or loaded song: the offsets, the player, the
; cursors
.chunk
song_ready:
    CALL set_offsets
    ld   SONG >> 8, ac
    ld   ac, [R1]
    CALL mus_init
    clr  ac
    ld   ac, [e_op]
    ld   ac, [e_otop]
    ld   ac, [o_k]
    ld   ac, [o_f]
    ld   ac, [c_row]
    ld   ac, [c_top]
    ld   ac, [e_mod]
    ld   ac, [e_play]
    ld   ac, [e_fl]
    ld   0xFF, ac
    ld   ac, [p_pat]
    ld   ac, [e_plop]
    ld   ac, [e_plrow]
    LEAVE

; ------------------------------------------------------------
; load_cmd / save_cmd - Ctrl-O, Ctrl-W: the name is asked for
; ------------------------------------------------------------
.chunk
load_cmd:
    PUSH_LINK
    CALL do_stop
    ld   s_askload & 0xFF, ac
    ld   ac, [R0]
    ld   s_askload >> 8, ac
    ld   ac, [R1]
    CALL prompt
    bne  lcm_c
    CALL load_song
    ld   PTAB_PG, y
    ld   L_ERR, x
    ld   [y,x], ac
    ld   ac, [e_res]            ; (the drawing uses the w's)
    CALL redraw_all
    ld   [e_res], ac
    bne  lcm_f
    ld   s_loaded & 0xFF, ac
    ld   ac, [R0]
    ld   s_loaded >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
lcm_f:
    ld   s_notfound & 0xFF, ac
    ld   ac, [R0]
    ld   s_notfound >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
lcm_c:
    CALL status_clear
    LEAVE

.chunk
save_cmd:
    PUSH_LINK
    CALL do_stop
    ld   s_asksave & 0xFF, ac
    ld   ac, [R0]
    ld   s_asksave >> 8, ac
    ld   ac, [R1]
    CALL prompt
    bne  scm_c
    CALL save_song
    bne  scm_f
    ld   s_saved & 0xFF, ac
    ld   ac, [R0]
    ld   s_saved >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
scm_f:
    ld   s_savefail & 0xFF, ac
    ld   ac, [R0]
    ld   s_savefail >> 8, ac
    ld   ac, [R1]
    CALL status
    LEAVE
scm_c:
    CALL status_clear
    LEAVE

; ------------------------------------------------------------
; prompt - R1:R0 = the question on the status row; a name typed after
; it (Enter) goes to e_name, AC = 0; Esc or an empty line: AC = 1
; ------------------------------------------------------------
.chunk
prompt:
    PUSH_LINK
    CALL status
    ld   [s_col], ac
    ld   ac, [CUR_COL]
    ld   s_cur & 0xFF, ac
    ld   ac, [R0]
    ld   s_cur >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [CUR_COL], ac
    dec
    ld   ac, [w1]               ; the column of the next character
    clr  ac
    ld   ac, [w0]               ; characters so far
pr_l:
    ld   1, ac
    CALL l_wait_frames
    CALL mus_frame
    CALL l_kbd_scan
    CALL l_kbd_getc
    beq  pr_l
    ld   ac, [w2]
    xor  0x1B, ac
    beq  pr_cancel
    ld   [w2], ac
    xor  0x0A, ac
    beq  pr_enter
    ld   [w2], ac
    xor  0x08, ac
    beq  pr_bs
    ld   [w0], ac
    xor  12, ac
    beq  pr_l
    ld   [w2], ac
    sub  0x21, ac
    blt  pr_l
    ld   [w2], ac
    sub  0x61, ac               ; a-z -> A-Z
    blt  pr_c
    sub  26, ac
    bcc  pr_c
    ld   [w2], ac
    and  0xDF, ac
    ld   ac, [w2]
pr_c:
    GOTO prompt_char
pr_bs:
    GOTO prompt_bs
pr_enter:
    ld   [w0], ac
    beq  pr_cancel
    GOTO prompt_done
pr_cancel:
    ld   1, ac
    LEAVE

.chunk
prompt_char:
    ld   PTAB_PG, y
    ld   [w0], ac
    add  0x90, x
    ld   [w2], ac
    ld   ac, [y,x]
    ld   [w0], ac
    inc
    ld   ac, [w0]
    ld   [w1], ac
    ld   ac, [CUR_COL]
    ld   [w2], ac
    CALL tputc
    ld   s_cur & 0xFF, ac
    ld   ac, [R0]
    ld   s_cur >> 8, ac
    ld   ac, [R1]
    CALL tputs
    ld   [w1], ac
    inc
    ld   ac, [w1]
    GOTO pr_l

.chunk
prompt_bs:
    ld   [w0], ac
    bne  pb_a
    GOTO pr_l
pb_a:
    dec
    ld   ac, [w0]
    ld   [w1], ac
    dec
    ld   ac, [w1]
    ld   ac, [CUR_COL]
    ld   s_cur & 0xFF, ac
    ld   ac, [R0]
    ld   s_cur >> 8, ac
    ld   ac, [R1]
    CALL tputs
    GOTO pr_l

.chunk
prompt_done:
    ld   PTAB_PG, y             ; the name typed -> e_name, with a 00
    ld   [w0], ac
    add  0x90, x
    ld   0, [y,x]
    clr  ac
    ld   ac, [w1]
pd_l:
    ld   [w1], ac
    add  0x90, x
    ld   [y,x], ac
    ld   ac, [w2]
    ld   [w1], ac
    add  e_name, x
    ld   [w2], ac
    ld   ac, [x]
    ld   [w1], ac
    inc
    ld   ac, [w1]
    xor  13, ac
    bne  pd_l
    CALL status_clear
    clr  ac
    LEAVE

; copy_name - the string at R1:R0 -> e_name (13 bytes)
.chunk
copy_name:
    clr  ac
    ld   ac, [u0]
cn_l:
    ld   [R1], y
    ld   [u0], ac
    add  [R0], ac
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [u1]
    ld   [u0], ac
    add  e_name, x
    ld   [u1], ac
    ld   ac, [x]
    ld   [u0], ac
    inc
    ld   ac, [u0]
    xor  13, ac
    bne  cn_l
    RET

; ============================================================
; load_song - the file e_name from the card into the song's places:
; the header pages as they come, then each orderlist and pattern (in
; the order of their offsets, as mus_tool.py and this program write
; them) into its own place.  L_ERR = 0 loaded, 1 not found / unreadable
; ============================================================
L_K    = 0x80               ; x5D80: the object being filled
L_NLO  = 0x81               ; the next object's offset
L_NHI  = 0x82
L_DPG  = 0x83               ; where the bytes go
L_DLO  = 0x84
L_LLO  = 0x85               ; bytes still taken (0 when the rest is dropped)
L_LHI  = 0x86
L_ERR  = 0x87
L_SZ   = 0x88               ; x5D88-x5D8B: the orderlists' sizes (saving)
L_NPAT = 0x8C

.chunk
load_song:
    PUSH_LINK
    ld   e_name, ac
    ld   ac, [R0]
    clr  ac
    ld   ac, [R1]
    CALL l_fs_open
    beq  ls_ok
    ld   PTAB_PG, y
    ld   L_ERR, x
    ld   1, [y,x]
    LEAVE
ls_ok:
    ld   FS_REM_LO & 0xFF, x
    ld   FS_REM_LO >> 8, y
    ld   [y,x], ac
    ld   ac, [w2]
    ld   FS_REM_HI & 0xFF, x
    ld   [y,x], ac
    ld   ac, [w3]
    clr  ac
    ld   ac, [w0]
    ld   ac, [w1]
    ld   PTAB_PG, y
    ld   L_ERR, x
    ld   0, [y,x]
    clr  ac                     ; blank slots and orderlists first
    ld   ac, [w4]
ls_c:
    ld   [w4], ac
    CALL slot_clear
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  CAP, ac
    bne  ls_c
    ld   OLIST >> 8, y
    clr  ac
ls_o:
    ld   ac, x
    ld   0xFE, [y,x]
    inc
    bne  ls_o
ls_l:
    ld   [w0], ac
    xor  [w2], ac
    bne  ls_r
    ld   [w1], ac
    xor  [w3], ac
    beq  ls_done
ls_r:
    ld   FBUF & 0xFF, ac
    ld   ac, [R4]
    ld   FBUF >> 8, ac
    ld   ac, [R5]
    CALL l_fs_read
    sub  2, ac
    bcc  ls_fail
    CALL ld_sector
    ld   PTAB_PG, y
    ld   L_ERR, x
    ld   [y,x], ac
    beq  ls_l
ls_fail:
    GOTO load_fix               ; what came is kept
ls_done:
    GOTO load_fix

; ld_sector - the 512 bytes in FBUF (up to the file's size)
.chunk
ld_sector:
    PUSH_LINK
    clr  ac
    ld   ac, [w4]
    ld   ac, [w5]
lds_l:
    ld   [w0], ac
    xor  [w2], ac
    bne  lds_a
    ld   [w1], ac
    xor  [w3], ac
    beq  lds_e
lds_a:
    ld   [w5], ac
    xor  2, ac
    beq  lds_e
    ld   [w5], ac
    add  FBUF >> 8, y
    ld   [w4], x
    ld   [y,x], ac
    ld   ac, [u7]
    ld   [w1], ac
    sub  5, ac
    bcc  lds_obj
    ld   [w1], ac
    add  SONG >> 8, y
    ld   [w0], x
    ld   [u7], ac
    ld   ac, [y,x]
lds_n:
    ld   [w0], ac
    inc
    ld   ac, [w0]
    bne  lds_n2
    ld   [w1], ac
    inc
    ld   ac, [w1]
lds_n2:
    ld   [w4], ac
    inc
    ld   ac, [w4]
    bne  lds_l
    ld   [w5], ac
    inc
    ld   ac, [w5]
    bra  lds_l
lds_obj:
    CALL ld_byte
    ld   PTAB_PG, y
    ld   L_ERR, x
    ld   [y,x], ac
    beq  lds_n
lds_e:
    LEAVE

; ld_byte - the byte u7 at offset w1:w0 (x500 and up): into the object
; it belongs to
.chunk
ld_byte:
    PUSH_LINK
    ld   [w1], ac
    xor  5, ac
    bne  lb_c
    ld   [w0], ac
    bne  lb_c
    ld   PTAB_PG, y             ; the first byte past the header: object 0
    ld   L_K, x
    ld   0, [y,x]
    ld   L_LLO, x
    ld   0, [y,x]
    ld   L_LHI, x
    ld   0, [y,x]
    CALL obj_next
lb_c:
    ld   PTAB_PG, y
    ld   L_NHI, x
    ld   [w1], ac
    xor  [y,x], ac
    bne  lb_c2
    ld   L_NLO, x
    ld   [w0], ac
    xor  [y,x], ac
    bne  lb_c2
    CALL obj_start              ; this object begins here
    CALL obj_next
    bra  lb_c
lb_c2:
    ld   PTAB_PG, y
    ld   L_NHI, x
    ld   [w1], ac
    sub  [y,x], ac
    bcs  lb_put                 ; before the next object
    bne  lb_bad
    ld   L_NLO, x
    ld   [w0], ac
    sub  [y,x], ac
    bcs  lb_put
lb_bad:
    ld   L_ERR, x               ; the objects are not in order: stop
    ld   1, [y,x]
    LEAVE
lb_put:
    ld   L_LLO, x
    ld   [y,x], ac
    ld   L_LHI, x
    or   [y,x], ac
    beq  lb_e
    ld   L_LLO, x
    ld   [y,x], ac
    bne  lb_p2
    ld   L_LHI, x
    ld   [y,x], ac
    dec
    ld   ac, [y,x]
lb_p2:
    ld   L_LLO, x
    ld   [y,x], ac
    dec
    ld   ac, [y,x]
    ld   L_DPG, x
    ld   [y,x], ac
    ld   ac, [u0]
    ld   L_DLO, x
    ld   [y,x], ac
    ld   ac, [u1]
    inc
    ld   ac, [y,x]
    ld   [u0], y
    ld   [u1], x
    ld   [u7], ac
    ld   ac, [y,x]
lb_e:
    LEAVE

; obj_next - L_NHI:L_NLO = the offset of object L_K (FFFF past the last)
.chunk
obj_next:
    ld   PTAB_PG, y
    ld   L_K, x
    ld   [y,x], ac
    ld   ac, [u2]
    sub  4, ac
    bcc  on_pat
    ld   [u2], ac               ; orderlist k: x41 + 2k
    shl
    add  0x41, ac
    bra  on_rd
on_pat:
    ld   ac, [u3]               ; pattern n = k - 4, n < the file's count
    ld   SONG >> 8, y
    ld   0x05, x
    ld   [u3], ac
    sub  [y,x], ac
    bcc  on_none
    ld   [u3], ac
    add  0x80, ac
on_rd:
    ld   ac, [u4]
    ld   SONG >> 8, y
    ld   ac, x
    ld   [y,x], ac
    ld   ac, [u5]
    ld   [u2], ac
    sub  4, ac
    bcc  on_rd2
    ld   [u4], ac               ; an orderlist: the high byte follows
    inc
    ld   ac, x
    ld   [y,x], ac
    bra  on_w
on_rd2:
    ld   [u4], ac               ; a pattern: the high bytes at xC0
    add  0x40, ac
    ld   ac, x
    ld   [y,x], ac
on_w:
    ld   ac, [u6]
    ld   PTAB_PG, y
    ld   L_NLO, x
    ld   [u5], ac
    ld   ac, [y,x]
    ld   L_NHI, x
    ld   [u6], ac
    ld   ac, [y,x]
    RET
on_none:
    ld   PTAB_PG, y
    ld   L_NLO, x
    ld   0xFF, [y,x]
    ld   L_NHI, x
    ld   0xFF, [y,x]
    RET

; obj_start - object L_K's place and size: L_DPG:L_DLO, L_LHI:L_LLO;
; then L_K + 1
.chunk
obj_start:
    ld   PTAB_PG, y
    ld   L_K, x
    ld   [y,x], ac
    ld   ac, [u2]
    sub  4, ac
    bcc  os_pat
    ld   [u2], ac               ; orderlist k: OLIST + 64 k, 64 bytes
    shl
    shl
    shl
    shl
    shl
    shl
    ld   ac, [u1]
    ld   L_DLO, x
    ld   ac, [y,x]
    ld   L_DPG, x
    ld   OLIST >> 8, [y,x]
    ld   L_LLO, x
    ld   64, [y,x]
    ld   L_LHI, x
    ld   0, [y,x]
    bra  os_k
os_pat:
    ld   ac, [u3]
    sub  CAP, ac
    bcc  os_drop
    ld   [u3], ac
    SLOTADDR
    ld   PTAB_PG, y
    ld   L_DPG, x
    ld   [u1], ac
    ld   ac, [y,x]
    ld   L_DLO, x
    ld   [u2], ac
    ld   ac, [y,x]
    ld   L_LLO, x
    ld   SLOT_LO, ac
    ld   ac, [y,x]
    ld   L_LHI, x
    ld   SLOT_LO, ac
    bne  os_k2
    ld   1, [y,x]               ; 256
    bra  os_k
os_k2:
    ld   0, [y,x]
    bra  os_k
os_drop:
    ld   L_LLO, x
    ld   0, [y,x]
    ld   L_LHI, x
    ld   0, [y,x]
os_k:
    ld   L_K, x
    ld   [y,x], ac
    inc
    ld   ac, [y,x]
    RET

; load_fix - after the file: every slot ends, the orderlists decoded,
; the live offsets, the player
.chunk
load_fix:
    clr  ac
    ld   ac, [w4]
lf_l:
    ld   [w4], ac
    CALL slot_fix
    ld   [w4], ac
    inc
    ld   ac, [w4]
    xor  CAP, ac
    bne  lf_l
    CALL decode_all
    CALL encode_all
    CALL song_ready
    clr  ac
    ld   ac, [w0]
    LEAVE

; ============================================================
; save_song - the song as a .SNG file named e_name: the header pages,
; the orderlists, the patterns used (and one FF for the rest).
; AC = 0 saved, 1 failed
; ============================================================
.chunk
save_song:
    PUSH_LINK
    clr  ac                     ; the patterns to write: up to the highest
    ld   ac, [w0]               ; used or referenced
    ld   ac, [w1]               ; the highest + 1
sv_n:
    ld   [w0], ac
    CALL slot_blank
    bne  sv_n2
    ld   [w0], ac
    inc
    ld   ac, [w1]
sv_n2:
    ld   [w0], ac
    inc
    ld   ac, [w0]
    xor  CAP, ac
    bne  sv_n
    clr  ac
    ld   ac, [w2]               ; the orderlists' references
sv_v:
    ld   [w2], ac
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [y,x], ac
    ld   ac, [w3]
    clr  ac
    ld   ac, [w4]
sv_k:
    ld   [w4], ac
    xor  [w3], ac
    beq  sv_kd
    ld   [w4], ac
    shl
    add  OD_PAT, x
    ld   [y,x], ac
    inc
    sub  [w1], ac
    bcs  sv_k2
    beq  sv_k2
    ld   [y,x], ac
    inc
    ld   ac, [w1]
sv_k2:
    ld   [w4], ac
    inc
    ld   ac, [w4]
    bra  sv_k
sv_kd:
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  4, ac
    bne  sv_v
    ld   [w1], ac
    bne  sv_np
    ld   1, ac
sv_np:
    ld   PTAB_PG, y
    ld   L_NPAT, x
    ld   ac, [y,x]
    GOTO save_offsets

; the offsets in the header: the orderlists from x500, then the patterns
.chunk
save_offsets:
    clr  ac
    ld   ac, [w0]               ; the running offset, low
    ld   5, ac
    ld   ac, [w1]               ; high
    clr  ac
    ld   ac, [w2]               ; the voice
so2_v:
    ld   [w2], ac
    shl
    add  0x41, ac
    ld   ac, x
    ld   SONG >> 8, y
    ld   [w0], ac
    ld   ac, [y,x]
    ld   [w2], ac
    shl
    add  0x42, ac
    ld   ac, x
    ld   [w1], ac
    ld   ac, [y,x]
    ld   [w2], ac               ; its size: OD_OFF[len] + 1 (stop) or 2 (loop)
    add  VSPAGE, y
    ld   OD_LEN, x
    ld   [y,x], ac
    add  OD_OFF, x
    ld   [y,x], ac
    inc
    ld   ac, [w3]
    ld   OD_END, x
    ld   [y,x], ac
    xor  0xFF, ac
    bne  so2_s
    ld   [w3], ac
    inc
    ld   ac, [w3]
so2_s:
    ld   PTAB_PG, y
    ld   [w2], ac
    add  L_SZ, x
    ld   [w3], ac
    ld   ac, [y,x]
    add  [w0], ac
    ld   ac, [w0]
    bcc  so2_c
    ld   [w1], ac
    inc
    ld   ac, [w1]
so2_c:
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  4, ac
    bne  so2_v
    clr  ac
    ld   ac, [w2]               ; the patterns
so2_p:
    ld   SONG >> 8, y
    ld   [w2], ac
    add  0x80, x
    ld   [w0], ac
    ld   ac, [y,x]
    ld   [w2], ac
    add  0xC0, x
    ld   [w1], ac
    ld   ac, [y,x]
    ld   PTAB_PG, y
    ld   L_NPAT, x
    ld   [w2], ac
    sub  [y,x], ac
    bcc  so2_n                  ; past the count: the FF at the end
    ld   [w2], ac
    CALL slot_len
    add  [w0], ac
    ld   ac, [w0]
    bcc  so2_n
    ld   [w1], ac
    inc
    ld   ac, [w1]
so2_n:
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  64, ac
    bne  so2_p
    GOTO save_header

.chunk
save_header:
    ld   [w0], ac               ; + the FF: the length
    inc
    ld   ac, [w0]
    bne  sh_a
    ld   [w1], ac
    inc
    ld   ac, [w1]
sh_a:
    ld   SONG >> 8, y
    ld   0x08, x
    ld   [w0], ac
    ld   ac, [y,x]
    ld   0x09, x
    ld   [w1], ac
    ld   ac, [y,x]
    ld   0x04, x
    ld   1, [y,x]
    ld   0x07, x
    ld   0, [y,x]
    ld   0x05, x
    ld   PTAB_PG, y
    ld   L_NPAT, x
    ld   [y,x], ac
    ld   SONG >> 8, y
    ld   0x05, x
    ld   ac, [y,x]
    ld   e_name, ac             ; the file
    ld   ac, [R0]
    clr  ac
    ld   ac, [R1]
    CALL l_fs_create
    beq  sh_go
    CALL set_offsets
    ld   1, ac
    LEAVE
sh_go:
    clr  ac
    ld   ac, [w4]               ; the sink: FBUF page w5, offset w4
    ld   FBUF >> 8, ac
    ld   ac, [w5]
    ld   SONG >> 8, ac          ; pages 0-4
    ld   ac, [w2]
sh_p:
    clr  ac
    ld   ac, [w3]
sh_b:
    ld   [w2], y
    ld   [w3], x
    ld   [y,x], ac
    CALL sv_put
    ld   [w3], ac
    inc
    ld   ac, [w3]
    bne  sh_b
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  (SONG >> 8) + 5, ac
    bne  sh_p
    GOTO save_lists

.chunk
save_lists:
    clr  ac
    ld   ac, [w2]               ; the voice
sl2_v:
    ld   PTAB_PG, y
    ld   [w2], ac
    add  L_SZ, x
    ld   [y,x], ac
    ld   ac, [w1]               ; its size
    ld   [w2], ac
    shl
    shl
    shl
    shl
    shl
    shl
    ld   ac, [w3]               ; its first byte
sl2_b:
    ld   OLIST >> 8, y
    ld   [w3], x
    ld   [y,x], ac
    CALL sv_put
    ld   [w3], ac
    inc
    ld   ac, [w3]
    ld   [w1], ac
    dec
    ld   ac, [w1]
    bne  sl2_b
    ld   [w2], ac
    inc
    ld   ac, [w2]
    xor  4, ac
    bne  sl2_v
    clr  ac
    ld   ac, [w2]               ; the patterns
sl2_p:
    ld   PTAB_PG, y
    ld   L_NPAT, x
    ld   [w2], ac
    xor  [y,x], ac
    beq  sl2_d
    ld   [w2], ac
    CALL slot_len
    ld   ac, [w1]
    ld   [w2], ac
    CALL slot_addr
    clr  ac
    ld   ac, [w3]
sl2_pb:
    ld   [u1], y
    ld   [w3], ac
    add  [u2], ac
    ld   ac, x
    ld   [y,x], ac
    CALL sv_put
    ld   [w3], ac
    inc
    ld   ac, [w3]
    ld   [w1], ac
    dec
    ld   ac, [w1]
    bne  sl2_pb
    ld   [w2], ac
    inc
    ld   ac, [w2]
    bra  sl2_p
sl2_d:
    ld   0xFF, ac
    CALL sv_put
    GOTO save_end

.chunk
save_end:
    ld   [w4], ac               ; a part sector left: write it
    bne  se_w
    ld   [w5], ac
    xor  FBUF >> 8, ac
    beq  se_c
se_w:
    ld   FBUF & 0xFF, ac
    ld   ac, [R4]
    ld   FBUF >> 8, ac
    ld   ac, [R5]
    CALL l_fs_write
    bne  se_f
se_c:
    ld   SONG >> 8, y           ; the size from the header
    ld   0x08, x
    ld   [y,x], ac
    ld   ac, [R0]
    ld   0x09, x
    ld   [y,x], ac
    ld   ac, [R1]
    clr  ac
    ld   ac, [R2]
    ld   ac, [R3]
    CALL l_fs_close
    bne  se_f
    CALL set_offsets
    clr  ac
    ld   ac, [e_mod]
    ld   ac, [e_fl]
    LEAVE
se_f:
    CALL set_offsets
    ld   1, ac
    LEAVE

; sv_put - the byte AC into the file (a sector at a time)
.chunk
sv_put:
    PUSH_LINK
    ld   [w5], y
    ld   [w4], x
    ld   ac, [y,x]
    ld   [w4], ac
    inc
    ld   ac, [w4]
    bne  sp_e
    ld   [w5], ac
    inc
    ld   ac, [w5]
    xor  (FBUF >> 8) + 2, ac
    bne  sp_e
    ld   FBUF & 0xFF, ac
    ld   ac, [R4]
    ld   FBUF >> 8, ac
    ld   ac, [R5]
    CALL l_fs_write
    ld   FBUF >> 8, ac
    ld   ac, [w5]
sp_e:
    LEAVE

; ============================================================
; data
; ============================================================
.chunk
s_hdr:
    #d "PLACARD TRACKER  ", 0x00
s_oct:
    #d "  oct ", 0x00
s_ins:
    #d "  ins ", 0x00
s_stop:
    #d "STOP", 0x00
s_play:
    #d "PLAY", 0x00
s_keys:
    #d " Z-M Q-P notes 1 off -= oct <> ins Tab pane  Ent/Spc play  Esc stop  ^O ^W ^N ^X", 0x00
s_order:
    #d "ORDER V1     V2     V3     V4", 0x00
s_loop:
    #d "LOOP", 0x00
s_stop6:
    #d "STOP  ", 0x00
s_instr:
    #d "INSTRUMENT ", 0x00
s_dots:
    #d "...", 0x00
s_koff:
    #d "===", 0x00
s_empty:
    #d 0x00
s_cur:
    #d "_ ", 0x00
.chunk
s_pulse:
    #d "PULSE  "
hexdig:
    #d "0123456789ABCDEF"
notes:
    #d "C-C#D-D#E-F-F#G-G#A-A#B-"
ramsl:
    #d8 0x57, 0x58, 0x59, 0x5C
ccol:
    #d8 0, 4, 5, 7, 8, 9

.chunk
s_ifields:
    #d "Attack  ", 0x80, "   Decay   ", 0x90, 0xFE
    #d "Sustain ", 0x81, "   Release ", 0x91, 0xFE
    #d "Wave    ", 0xA2, "  Pulse   ", 0xA3, 0xFE
    #d "PW      ", 0xA4, "  HardRst ", 0xB5, 0xFE
    #d "VibDly  ", 0xA6, "  Vibrato ", 0xA7, 0xFE
    #d "Volume  ", 0xA8, 0xFF
ifld:
    #d8 3, 48, 1,  3, 60, 1,  4, 48, 1,  4, 60, 1
    #d8 5, 48, 2,  5, 60, 2,  6, 48, 2,  6, 60, 1
    #d8 7, 48, 2,  7, 60, 2,  8, 48, 2,  2, 54, 7
ikinds:
    #d8 0, 0,  0, 1,  1, 0,  1, 1,  2, 2,  3, 2
    #d8 4, 2,  5, 3,  6, 2,  7, 2,  8, 1,  9, 4
.chunk
wnames:
    #d "-----pulsesaw  tri  noisecw0  cw1  cw2  cw3  cw4  cw5  cw6  cw7  off  END  LOOP ?    SET  "
pkeys:
    #d "z", 0x00, "s", 0x01, "x", 0x02, "d", 0x03, "c", 0x04, "v", 0x05, "g", 0x06, "b", 0x07
    #d "h", 0x08, "n", 0x09, "j", 0x0A, "m", 0x0B, 0x2C, 0x0C, "l", 0x0D, ".", 0x0E, "q", 0x0C
    #d "2", 0x0D, "w", 0x0E, "3", 0x0F, "e", 0x10, "r", 0x11, "5", 0x12, "t", 0x13, "6", 0x14
    #d "y", 0x15, "7", 0x16, "u", 0x17, "i", 0x18, "9", 0x19, "o", 0x1A, "0", 0x1B, "p", 0x1C
    #d 0x00

.chunk
s_pattern:
    #d "PATTERN ", 0x00
s_rows:
    #d " rows", 0x00
s_nopat:
    #d "no pattern", 0x00
s_voice:
    #d "   voice ", 0x00
s_pos:
    #d "   position ", 0x00
s_cols:
    #d " ROW V1          V2          V3          V4", 0x00
.chunk
s_wtab:
    #d "WAVE TABLE   entry: waveform, note (+n from the note played, or absolute)", 0x00
s_ptab:
    #d "PULSE TABLE  entry: xTT ticks +step, SET width, LOOP nn, END", 0x00
s_newsong:
    #d "NEW SONG                        "

.chunk
s_nopat2:
    #d "No pattern at this position for this voice", 0x00
s_pastend:
    #d "Past the end of the pattern (Ctrl-L: its length)", 0x00
s_high:
    #d "Note too high", 0x00
s_full:
    #d "Pattern full: too many bytes for its slot", 0x00
s_unsaved:
    #d "Not saved: Ctrl-X again to leave", 0x00

.chunk
s_askload:
    #d "Load: ", 0x00
s_asksave:
    #d "Save as: ", 0x00
s_loaded:
    #d "Loaded", 0x00
s_notfound:
    #d "Not found, or not a song", 0x00
s_saved:
    #d "Saved", 0x00
s_savefail:
    #d "Save failed", 0x00

; ============================================================
; the player
; ============================================================
.include "placard_mus.masm"
