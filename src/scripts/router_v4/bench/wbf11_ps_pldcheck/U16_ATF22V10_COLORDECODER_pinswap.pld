/* PIN-SWAP VARIANT for U16 (router test bench, 2026-11-11): only the PIN lines differ from ATF22V10_COLORDECODER.pld.
   Not a released design: compile-check only. */
Name     COLOR_DECODER;
PartNo   00;
Date     11/11/2026 ;
Revision 07;
Designer "Justin Davis";
Company  "";
Assembly "";
Location "";
Device   g22v10;


/* ============================================================
   8-BIT PIXEL-PACK COLOR DECODER   (ATF22V10C, DIP-24 / PLCC-28)
   ============================================================

   VIDEN = 0  ->  all outputs forced to BLACK (0), regardless of
                  every other input.   VIDEN = 1  ->  normal operation.

   MODE1 MODE0   bits/pixel   pixels/byte   colors
      0     0        1             8            2
      0     1        2             4            4
      1     0        4             2           16
      1     1        8             1          256

   H2:H0 (the pixel clock count within each 8-clock byte, from the Sync
   PLD) chooses which pixel of the byte is shown.  Each mode uses only the
   H bits it needs, so a pixel is held for 1, 2, 4 or 8 clocks:
      1 bpp : H2:H0 -> D0..D7                       (1 clock per pixel)
      2 bpp : H2:H1 -> D1:0 / D3:2 / D5:4 / D7:6    (2 clocks per pixel)
      4 bpp : H2    -> D3:0 / D7:4                  (4 clocks per pixel)
      8 bpp : H ignored                             (8 clocks per pixel)

   OUTPUTS (resistor DAC, bit 3 = MSB of each channel)
      RED1..RED3 = R LSB..MSB   (3 bits)
      GRN1..GRN3 = G LSB..MSB   (3 bits)
      BLU2..BLU3 = B LSB..MSB   (2 bits)

   8 bpp pass-through byte format (D7..D0) = G3 G2 G1 B3 B2 R3 R2 R1

   PIN NOTES
      - 14 inputs + 8 outputs = 22 pins = every non-power pin, so the
        old PIX helper pin is gone.  Instead GRN3 computes the 1-bpp
        pixel mux itself (in 1 bpp mode GRN3 = the selected pixel)
        and the other seven outputs feed GRN3 back into the array.
      - H2 (pin 14) and VIDEN (pin 23) are on I/O pins used as inputs.
      - VIDEN is folded into M1/M2/M4/M8, so blanking costs no extra
        product terms: with VIDEN = 0 no mode term can be true.
   ============================================================ */


/* ---------------- INPUTS ---------------- */

PIN 2  = D4;  /* pin swap: was on pin 6 */
PIN 3  = D0;  /* pin swap: was on pin 2 */
PIN 4  = D6;  /* pin swap: was on pin 8 */
PIN 5  = MODE1;  /* pin swap: was on pin 11 */
PIN 6  = D1;  /* pin swap: was on pin 3 */
PIN 7  = D5;
PIN 8  = D3;  /* pin swap: was on pin 5 */
PIN 9  = D7;

PIN 10 = D2;  /* pin swap: was on pin 4 */
PIN 11 = H2;  /* pin swap: was on pin 14 */

PIN 13 = H0;
PIN 1  = H1;
PIN 14 = VIDEN;      /* video enable, active high (low = black) */  /* pin swap: was on pin 23 */

PIN 23 = MODE0;  /* pin swap: was on pin 10 */


/* ---------------- OUTPUTS ---------------- */

PIN 15 = BLU2;  /* pin swap: was on pin 22 */
PIN 16 = RED3;  /* pin swap: was on pin 21 */
PIN 21 = RED2;  /* pin swap: was on pin 16 */
PIN 22 = RED1;  /* pin swap: was on pin 15 */
PIN 18 = BLU3;
PIN 17 = GRN1;
PIN 20 = GRN2;
PIN 19 = GRN3;       /* also serves as the 1 bpp pixel source */


/* ---------------- MODE DECODE (gated by VIDEN) ---------------- */

M1 = VIDEN & !MODE1 & !MODE0;
M2 = VIDEN & !MODE1 &  MODE0;
M4 = VIDEN &  MODE1 & !MODE0;
M8 = VIDEN &  MODE1 &  MODE0;


/* ---------------- 2 bpp: 4:1 mux of 2-bit pixel ---------------- */

C0 =  D0 & !H2 & !H1
    # D2 & !H2 &  H1
    # D4 &  H2 & !H1
    # D6 &  H2 &  H1;

C1 =  D1 & !H2 & !H1
    # D3 & !H2 &  H1
    # D5 &  H2 & !H1
    # D7 &  H2 &  H1;

/* 2 bpp palette (high-contrast, color-blind safe, luminance ramp)

   Code  Color   R  G  B    Luminance
    00   Black   0  0  0      0.00
    01   Blue    0  1  3      0.09
    10   Gold    7  5  0      0.55
    11   White   7  7  3      1.00

   Per output bit (C1 = code bit 1, C0 = code bit 0):
      RED1..3 = C1              BLU2,3 = C0
      GRN1    = C1 | C0         GRN2   = C1 & C0  GRN3 = C1        */


/* ---------------- 4 bpp: nibble select ---------------- */

X0 = D0 & !H2 # D4 & H2;
X1 = D1 & !H2 # D5 & H2;
X2 = D2 & !H2 # D6 & H2;
X3 = D3 & !H2 # D7 & H2;

/* 4 bpp palette: 16 colors (4 grays, 8 hues, dark/light variants).
   Black is index 0.  Index order was chosen so that GRN3 = X3 (one
   term) and every output bit fits its pin's product-term limit.
   Channel levels: R,G = 0-7, B = 0-3.

   Idx  Color        R  G  B
    0   Black        0  0  0
    1   Dark blue    0  0  1
    2   Purple       4  0  2
    3   Blue         0  0  3
    4   Red          7  0  0
    5   Magenta      7  0  3
    6   Brown        4  2  0
    7   Dark gray    2  2  1
    8   Cyan         0  7  3
    9   Dark green   0  4  0
    A   White        7  7  3
    B   Light gray   5  5  2
    C   Pink         7  4  2
    D   Orange       7  4  0
    E   Yellow       7  7  0
    F   Green        1  7  0 */

RED1_4 =
      X2 & !X1
    # X3 & X1;

RED2_4 =
      X2 & !X1
    # !X3 & X2 & X0
    # X3 & X1 & !X0;

RED3_4 =
      X1 & !X0
    # X2 & !X1
    # X3 & !X2 & X1;

BLU2_4 =
      !X3 & X0
    # X3 & !X2 & !X0;

BLU3_4 =
      !X2 & X1
    # !X3 & X2 & !X1 & X0
    # X3 & !X1 & !X0;

GRN1_4 =
      X3 & !X2 & !X0
    # X3 & X1;

GRN2_4 =
      X2 & X1
    # X3 & !X2 & !X0;

GRN3_4 =
      X3;


/* ---------------- FINAL OUTPUTS ---------------- */

RED1 = M1 & GRN3 # M2 & C1        # M4 & RED1_4 # M8 & D0;
RED2 = M1 & GRN3 # M2 & C1        # M4 & RED2_4 # M8 & D1;
RED3 = M1 & GRN3 # M2 & C1        # M4 & RED3_4 # M8 & D2;

BLU2 = M1 & GRN3 # M2 & C0        # M4 & BLU2_4 # M8 & D3;
BLU3 = M1 & GRN3 # M2 & C0        # M4 & BLU3_4 # M8 & D4;

GRN1 = M1 & GRN3 # M2 & C1 # M2 & C0 # M4 & GRN1_4 # M8 & D5;
GRN2 = M1 & GRN3 # M2 & C1 & C0   # M4 & GRN2_4 # M8 & D6;

/* GRN3: 1 bpp 8:1 pixel mux written out (8 terms) + its own terms */
GRN3 =
      M1 & D0 & !H2 & !H1 & !H0
    # M1 & D1 & !H2 & !H1 &  H0
    # M1 & D2 & !H2 &  H1 & !H0
    # M1 & D3 & !H2 &  H1 &  H0
    # M1 & D4 &  H2 & !H1 & !H0
    # M1 & D5 &  H2 & !H1 &  H0
    # M1 & D6 &  H2 &  H1 & !H0
    # M1 & D7 &  H2 &  H1 &  H0
    # M2 & C1
    # M4 & GRN3_4
    # M8 & D7;
