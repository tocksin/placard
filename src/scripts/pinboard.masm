; ============================================================
; pinboard.masm - Pinboard, the windowed desktop: the native code
; ============================================================
;
; Pinboard (docs/software/PINBOARD.md) is a program on the SD card,
; PINBOARD.PLC: cards (windows) pinned on a board, a pointer for the PS/2
; mouse, a rail along the bottom with the launcher and the open cards.
; Its cards are the file browser (it runs the card's .PLC programs), a
; clock, a calculator, a text editor, a note about itself and the choice
; of the screen's mode.
;
; The desktop itself is written in bytecode (pinboard.vm, compiled by
; vmc.py when asm_expand.py meets the .include at the end of this file),
; for the same small stack machine as BASIC's (basic.masm; docs/software/
; BASIC.md, "The bytecode machine").  This file is that machine, copied
; from basic.masm with one change, and the primitives that have to be
; fast or touch the hardware:
;
;   the change   the words are in the RAM, below x8000, so a call's first
;                byte is the word's high byte + x80 (vmc.py: RAMCALLS) and
;                next takes the x80 off
;   EMIT HFILL GTYPE   characters at the cell GX, GY, kept inside the clip
;                rectangle CX0-CX1, CY0-CY1, from Pinboard's own font
;   INVC         turns the cell at GX, GY over (the outline of a card
;                being moved)
;   PTR          shows or hides the pointer (the screen under it is kept)
;   POLL         a frame's wait, the keyboard and the mouse; the key
;
; The drawing itself is the display driver's: x2E00-x3FFF (DRV), one for
; each mode of the screen, with its font and its pointer.  This file is
; the core, the same under every driver; pinboard_drv_mono.masm is the
; 640 x 480, 2-color driver that PINBOARD.PLC starts with, and
; pinboard_drv_color.masm the two for the rev B board's 4 and 16 colors,
; which Pinboard reads from the card's PINBOARD folder (pinboard.vm:
; Display).  pinboard_hdr.masm has what they share.
;
; RAM: the core x0100-x2DFF (asm_expand.py pages it), the driver
; x2E00-x3FFF; zero page x20-x4F and x90-x9F (no sound driver); the
; data stack x53-x8F (x50-x52 the drawing's); x4000-x4AFF the Editor's
; text, x4B00 the pointer's saved screen and the desktop's variables,
; x4C00 the return stack;
; x5400-x59FF the folder read; the menu block x5D00 and the FAT reader's
; x4D00-x4FFF as for every program.
;
;     python3 gen_pinboard.py     the drivers' tables, pinboard.asm,
;                                 ../../sdcard/PINBOARD.PLC and the
;                                 drivers in ../../sdcard/PINBOARD
;     python3 test_pinboard.py    runs it from a card in the emulator
;
; Date: 11/22/2026
; ============================================================

.include "pinboard_hdr.masm"

.prefix pb
.region 0x0100, 0x1F00
.region CORE2, PB_PTR         ; bytecode only: a page inside the driver's bytes, the same in every driver
.region 0x2000, DRV

; ============================================================
; main - the ROM's loader enters here (map 07, the card mounted)
; ============================================================
.fixed 0x0100
main:
    ld   STACK_TOP, ac
    ld   ac, [SP]
    CALL mouse_init
    ld   ac, [MOK]
    clr  ac
    ld   ac, [SH_ON]
    ld   ac, [MOVED]
    ld   ac, [PYH]
    ld   240, ac
    ld   ac, [PYL]
    ld   320 & 0xFF, ac
    ld   ac, [PXL]
    ld   1, ac
    ld   ac, [PXH]
    ld   DS_EMPTY, ac
    ld   ac, [DSP]
    ld   0xFF, ac
    ld   ac, [RSP]
    ld   w_COLD & 0xFF, ac
    ld   ac, [IPL]
    ld   w_COLD >> 8, ac
    ld   ac, [IPH]
    NEXT

; ============================================================
; the inner interpreter and the primitives every program of the
; machine needs, from basic.masm
; ============================================================
.chunk  next, calls, IP + 1 or 2, the branches; DUP DROP LIT8 (the most used: they
; branch back to next)
next:
    ld   [IPH], y               ; Y:X = IP, then IP + 1
    ld   [IPL], x
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    beq  nx_c
nx_f:
    ld   [y,x], ac
    blt  nx_call
    shl                         ; the primitive: vm_jump + opcode x 4
    shl
    ld   vm_jump >> 8, y
    jmp  ac
nx_c:
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  nx_f
nx_call:                        ; AC = the word's high byte + x80, IP at its low byte
    and  0x7F, ac
    ld   ac, [W0]
    IPBYTE
    ld   ac, [W1]
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    bne  nx_2
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
nx_2:
    ld   [RSP], x               ; push IP on the return stack
    ld   RSTK >> 8, y
    ld   [IPH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [IPL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   [W1], ac
    ld   ac, [IPL]
    ld   [W0], ac
    ld   ac, [IPH]
    bra  next
ip2:
    ld   [IPL], ac
    add  2, ac
    ld   ac, [IPL]
    bcc  next
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  next
ip1:
    ld   [IPL], ac
    inc
    ld   ac, [IPL]
    bne  next
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  next
p_br:                           ; BR n: IP = IP + 1 + n (n signed)
    IPBYTE
    ld   ac, [W0]
    add  [IPL], ac
    ld   ac, [IPL]
    bcc  br_nc
    ld   [W0], ac
    blt  ip1                    ; back, with a carry: the same page
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
    bra  ip1
br_nc:
    ld   [W0], ac
    blt  br_dec
    bra  ip1
br_dec:
    ld   [IPH], ac
    dec
    ld   ac, [IPH]
    bra  ip1
p_0br:                          ; 0BR n: branch if TOS = 0, drop it
    ld   [TL], ac
    or   [TH], ac
    ld   ac, [W2]
    POPT
    ld   [W2], ac
    beq  p_br
    bra  ip1
p_dup:
    PUSHT
    bra  next
p_drop:
    POPT
    bra  next
p_lit8:                         ; LIT8 n ( -- n )
    PUSHT
    IPBYTE
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    bra  ip1


.chunk  EXIT, LBR, L0BR, EXECUTE, RESET
p_exit:
    ld   [RSP], ac
    add  1, x
    ld   RSTK >> 8, y
    ld   [y,x], ac
    ld   ac, [IPL]
    ld   [RSP], ac
    add  2, x
    ld   [y,x], ac
    ld   ac, [IPH]
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    NEXT
p_l0br:                         ; L0BR a: IP = a if TOS = 0, drop it
    ld   [TL], ac
    or   [TH], ac
    ld   ac, [W2]
    POPT
    ld   [W2], ac
    beq  p_lbr
    ld   ip2 >> 8, y
    jmp  ip2
p_lbr:                          ; LBR a: IP = a
    IPBYTE
    ld   ac, [W0]
    ld   [IPL], ac
    inc
    ld   ac, x
    bne  lb_1
    ld   [IPH], ac
    inc
    ld   ac, y
lb_1:
    ld   [y,x], ac
    ld   ac, [IPH]
    ld   [W0], ac
    ld   ac, [IPL]
    NEXT
p_execute:                      ; EXECUTE ( a -- ): call the word at a
    ld   [RSP], x
    ld   RSTK >> 8, y
    ld   [IPH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [IPL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   [TL], ac
    ld   ac, [IPL]
    ld   [TH], ac
    ld   ac, [IPH]
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  LIT8, LIT16, SLIT
p_lit16:                        ; LIT16 n ( -- n )
    PUSHT
    IPBYTE
    ld   ac, [TL]
    IPINC
    IPBYTE
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_slit:                         ; SLIT n "..." ( -- a ): a = the length byte's address
    PUSHT
    ld   [IPL], ac
    ld   ac, [TL]
    ld   [IPH], ac
    ld   ac, [TH]
    IPBYTE
    inc
    add  [IPL], ac
    ld   ac, [IPL]
    bcc  sl_nc
    ld   [IPH], ac
    inc
    ld   ac, [IPH]
sl_nc:
    NEXT

.chunk  ZP@ ZP! ZPC@ ZPC!
p_zpat:                         ; ZP@ n ( -- [n] )
    PUSHT
    IPBYTE
    ld   ac, [W0]
    ld   ac, x
    ld   [x], ac
    ld   ac, [TL]
    ld   [W0], ac
    add  1, x
    ld   [x], ac
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_zpcat:                        ; ZPC@ n ( -- [n] ), one byte
    PUSHT
    IPBYTE
    ld   ac, x
    ld   [x], ac
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    ld   ip1 >> 8, y
    jmp  ip1
p_zpst:                         ; ZP! n ( v -- )
    IPBYTE
    ld   ac, [W0]
    ld   ac, x
    ld   [TL], ac
    ld   ac, [x]
    ld   [W0], ac
    add  1, x
    ld   [TH], ac
    ld   ac, [x]
    POPT
    ld   ip1 >> 8, y
    jmp  ip1
p_zpcst:                        ; ZPC! n ( v -- ), one byte
    IPBYTE
    ld   ac, x
    ld   [TL], ac
    ld   ac, [x]
    POPT
    ld   ip1 >> 8, y
    jmp  ip1

.chunk  SWAP OVER NIP 2DUP
p_nip:
    NIP2
    NEXT
p_swap:
    ld   [DSP], x
    ld   [x], ac
    ld   ac, [W0]
    ld   [TL], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [TH], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TH]
    NEXT
p_over:                         ; ( a b -- a b a )
    PUSHT
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [TH]
    NEXT
p_2dup:                         ; ( a b -- a b a b )
    ld   [DSP], ac              ; W1:W0 = a
    ld   ac, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], ac              ; two cells more: b, then a below TOS
    sub  4, ac
    ld   ac, [DSP]
    add  2, x
    ld   [TL], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  3, x
    ld   [TH], ac
    ld   ac, [x]
    ld   [DSP], x
    ld   [W0], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [W1], ac
    ld   ac, [x]
    NEXT

.chunk  ROT >R R> R@ RDROP
p_rot:                          ; ( a b c -- b c a )
    ld   [DSP], ac              ; W1:W0 = a (at DSP + 2)
    add  2, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], x               ; DSP + 2 = b
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  2, x
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  3, x
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], x               ; DSP = c
    ld   [TL], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [TH], ac
    ld   ac, [x]
    ld   [W0], ac               ; TOS = a
    ld   ac, [TL]
    ld   [W1], ac
    ld   ac, [TH]
    NEXT
p_tor:                          ; >R ( a -- )
    ld   [RSP], x
    ld   RSTK >> 8, y
    ld   [TH], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  1, x
    ld   [TL], ac
    ld   ac, [y,x]
    ld   [RSP], ac
    sub  2, ac
    ld   ac, [RSP]
    ld   p_drop >> 8, y
    jmp  p_drop
p_rfrom:                        ; R> ( -- a )
    PUSHT
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    bra  rf_get
p_rat:                          ; R@ ( -- a )
    PUSHT
    ld   [RSP], ac
    add  2, ac
rf_get:                         ; TOS = the return stack entry at AC - 1 (low), AC (high)
    ld   ac, [W0]
    ld   ac, x
    ld   RSTK >> 8, y
    ld   [y,x], ac
    ld   ac, [TH]
    ld   [W0], ac
    sub  1, x
    ld   [y,x], ac
    ld   ac, [TL]
    NEXT
p_rdrop:
    ld   [RSP], ac
    add  2, ac
    ld   ac, [RSP]
    NEXT

.chunk  @ ! C@ C!
p_at:                           ; @ ( a -- [a] )
    ld   [TH], y
    ld   [TL], x
    ld   [y,x], ac
    ld   ac, [W0]
    ld   [TL], ac
    inc
    ld   ac, x
    bne  at_1
    ld   [TH], ac
    inc
    ld   ac, y
at_1:
    ld   [y,x], ac
    ld   ac, [TH]
    ld   [W0], ac
    ld   ac, [TL]
    NEXT
p_cat:                          ; C@ ( a -- [a] ), one byte
    ld   [TH], y
    ld   [TL], x
    ld   [y,x], ac
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    NEXT
p_store:                        ; ! ( v a -- )
    ld   [DSP], ac              ; W0 = v high
    add  1, x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], x               ; v low
    ld   [x], ac
    ld   [TH], y
    ld   [TL], x
    ld   ac, [y,x]
    ld   [TL], ac
    inc
    ld   ac, x
    bne  st_1
    ld   [TH], ac
    inc
    ld   ac, y
st_1:
    ld   [W0], ac
    ld   ac, [y,x]
st_pop2:
    NIP2
    POPT
    NEXT
p_cstore:                       ; C! ( v a -- )
    ld   [DSP], x
    ld   [x], ac
    ld   [TH], y
    ld   [TL], x
    ld   ac, [y,x]
    bra  st_pop2

.chunk  + - AND OR XOR
p_add:
    ld   [DSP], x
    ld   [x], ac
    add  [TL], ac
    ld   ac, [TL]
    bcc  vad_1
    ld   [TH], ac
    inc
    ld   ac, [TH]
vad_1:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    add  [TH], ac
    ld   ac, [TH]
ad_nip:
    NIP2
    NEXT
p_sub:                          ; - ( a b -- a-b )
    ld   [DSP], x
    ld   [x], ac
    sub  [TL], ac
    ld   ac, [TL]
    bcc  sb_1
    ld   [TH], ac               ; a borrow: take one more from the high byte
    inc
    ld   ac, [TH]
sb_1:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    sub  [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_and:
    ld   [DSP], x
    ld   [x], ac
    and  [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    and  [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_or:
    ld   [DSP], x
    ld   [x], ac
    or   [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    or   [TH], ac
    ld   ac, [TH]
    bra  ad_nip
p_xor:
    ld   [DSP], x
    ld   [x], ac
    xor  [TL], ac
    ld   ac, [TL]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  [TH], ac
    ld   ac, [TH]
    bra  ad_nip

.chunk  INVERT 1+ 1- 2* 2/
p_invert:
    ld   [TL], ac
    not
    ld   ac, [TL]
    ld   [TH], ac
    not
    ld   ac, [TH]
    NEXT
p_inc:
    ld   [TL], ac
    inc
    ld   ac, [TL]
    bne  in_1
    ld   [TH], ac
    inc
    ld   ac, [TH]
in_1:
    NEXT
p_dec:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  in_1
    ld   [TH], ac
    dec
    ld   ac, [TH]
    NEXT
p_2mul:
    ld   [TL], ac
    shl
    ld   ac, [TL]
    ld   [TH], ac
    bcc  m2_1
    shl
    or   1, ac
    ld   ac, [TH]
    NEXT
m2_1:
    shl
    ld   ac, [TH]
    NEXT
p_2div:                         ; arithmetic: the sign stays
    ld   [TL], ac
    shr  ac
    ld   ac, [TL]
    ld   [TH], ac
    and  1, ac
    beq  d2_1
    ld   [TL], ac
    or   0x80, ac
    ld   ac, [TL]
d2_1:
    ld   [TH], ac
    and  0x80, ac
    ld   ac, [W0]
    ld   [TH], ac
    shr  ac
    or   [W0], ac
    ld   ac, [TH]
    NEXT

.chunk  = U< < 0= 0<
p_eq:
    ld   [DSP], x
    ld   [x], ac
    xor  [TL], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  [TH], ac
    or   [W0], ac
    beq  t_true
    bra  t_false
p_ult:
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    sub  [TH], ac
    bcs  t_true
    bne  t_false
ult_lo:
    ld   [DSP], x
    ld   [x], ac
    sub  [TL], ac
    bcs  t_true
t_false:
    NIP2
u_false:
    clr  ac
    ld   ac, [TL]
    ld   ac, [TH]
    NEXT
p_lt:                           ; signed: compare with the sign bits flipped
    ld   [TH], ac
    xor  0x80, ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    xor  0x80, ac
    sub  [W0], ac
    bcs  t_true
    bne  t_false
    bra  ult_lo
t_true:
    NIP2
u_true:
    ld   0xFF, ac
    ld   ac, [TL]
    ld   ac, [TH]
    NEXT
p_0eq:
    ld   [TL], ac
    or   [TH], ac
    beq  u_true
    bra  u_false
p_0lt:
    ld   [TH], ac
    blt  u_true
    bra  u_false

.chunk  * ( a b -- a*b )
p_mul:
    ld   [DSP], x               ; W1:W0 = a, W3:W2 = 0
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    clr  ac
    ld   ac, [W2]
    ld   ac, [W3]
mu_lp:
    ld   [TL], ac
    and  1, ac
    beq  mu_sh
    ld   [W2], ac
    add  [W0], ac
    ld   ac, [W2]
    bcc  mu_hi
    ld   [W3], ac
    inc
    ld   ac, [W3]
mu_hi:
    ld   [W3], ac
    add  [W1], ac
    ld   ac, [W3]
mu_sh:
    ld   [W0], ac               ; a << 1
    shl
    ld   ac, [W0]
    ld   [W1], ac
    bcc  mu_a0
    shl
    or   1, ac
    bra  mu_a1
mu_a0:
    shl
mu_a1:
    ld   ac, [W1]
    ld   [TL], ac               ; b >> 1
    shr  ac
    ld   ac, [TL]
    ld   [TH], ac
    and  1, ac
    beq  mu_b0
    ld   [TL], ac
    or   0x80, ac
    ld   ac, [TL]
mu_b0:
    ld   [TH], ac
    shr  ac
    ld   ac, [TH]
    or   [TL], ac
    bne  mu_lp
    ld   [W2], ac
    ld   ac, [TL]
    ld   [W3], ac
    ld   ac, [TH]
    NIP2
    NEXT

.chunk  U/MOD ( a b -- a mod b  a/b ), unsigned
p_umod:
    ld   [DSP], x               ; W1:W0 = a (becomes the quotient)
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    clr  ac                     ; W3:W2 = the remainder
    ld   ac, [W2]
    ld   ac, [W3]
    ld   16, ac
    ld   ac, [W4]
um_lp:
    ld   [W0], ac               ; W3:W2:W1:W0 << 1
    shl
    ld   ac, [W0]
    ld   [W1], ac
    bcc  um_1
    shl
    or   1, ac
    bra  um_2
um_1:
    shl
um_2:
    ld   ac, [W1]
    ld   [W2], ac
    bcc  um_3
    shl
    or   1, ac
    bra  um_4
um_3:
    shl
um_4:
    ld   ac, [W2]
    ld   [W3], ac
    bcc  um_5
    shl
    or   1, ac
    ld   ac, [W3]
    bra  um_sub                 ; bit 16 set: the remainder is more than b
um_5:
    shl
    ld   ac, [W3]
    sub  [TH], ac               ; remainder >= b?
    bcs  um_next
    bne  um_sub
    ld   [W2], ac
    sub  [TL], ac
    bcs  um_next
um_sub:
    ld   [W2], ac               ; remainder - b, quotient bit 1
    sub  [TL], ac
    ld   ac, [W2]
    ld   [W3], ac
    bcc  um_6
    dec
um_6:
    sub  [TH], ac
    ld   ac, [W3]
    ld   [W0], ac
    or   1, ac
    ld   ac, [W0]
um_next:
    ld   [W4], ac
    dec
    ld   ac, [W4]
    bne  um_lp
    ld   [DSP], x               ; below: the remainder, TOS: the quotient
    ld   [W2], ac
    ld   ac, [x]
    ld   [DSP], ac
    add  1, x
    ld   [W3], ac
    ld   ac, [x]
    ld   [W0], ac
    ld   ac, [TL]
    ld   [W1], ac
    ld   ac, [TH]
    NEXT

.chunk  CMOVE ( from to n -- ): first byte first
p_cmove:
    ld   [DSP], x               ; W1:W0 = to, W3:W2 = from, TOS = n
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    ld   ac, [W2]
    ld   [DSP], ac
    add  3, x
    ld   [x], ac
    ld   ac, [W3]
cm_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  cm_done
    ld   [W3], y
    ld   [W2], x
    ld   [y,x], ac
    ld   [W1], y
    ld   [W0], x
    ld   ac, [y,x]
    ld   [W2], ac
    inc
    ld   ac, [W2]
    bne  cm_1
    ld   [W3], ac
    inc
    ld   ac, [W3]
cm_1:
    ld   [W0], ac
    inc
    ld   ac, [W0]
    bne  cm_2
    ld   [W1], ac
    inc
    ld   ac, [W1]
cm_2:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  cm_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  cm_lp
cm_done:
    NIP2
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  CMOVE> ( from to n -- ): last byte first
p_cmoveu:
    ld   [DSP], x               ; W1:W0 = to + n, W3:W2 = from + n
    ld   [x], ac
    add  [TL], ac
    ld   ac, [W0]
    ld   [TH], ac
    bcc  cu_1
    inc
cu_1:
    ld   ac, [W1]
    ld   [DSP], ac
    add  1, x
    ld   [W1], ac
    add  [x], ac
    ld   ac, [W1]
    ld   [DSP], ac
    add  2, x
    ld   [x], ac
    add  [TL], ac
    ld   ac, [W2]
    ld   [TH], ac
    bcc  cu_2
    inc
cu_2:
    ld   ac, [W3]
    ld   [DSP], ac
    add  3, x
    ld   [W3], ac
    add  [x], ac
    ld   ac, [W3]
cu_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  cu_done
    ld   [W2], ac               ; from - 1
    sub  1, ac
    ld   ac, [W2]
    bcc  cu_3
    ld   [W3], ac
    dec
    ld   ac, [W3]
cu_3:
    ld   [W0], ac               ; to - 1
    sub  1, ac
    ld   ac, [W0]
    bcc  cu_4
    ld   [W1], ac
    dec
    ld   ac, [W1]
cu_4:
    ld   [W3], y
    ld   [W2], x
    ld   [y,x], ac
    ld   [W1], y
    ld   [W0], x
    ld   ac, [y,x]
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  cu_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  cu_lp
cu_done:
    NIP2
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  FILL ( a n c -- )
p_fill:
    ld   [TL], ac               ; W4 = c, TOS = n, W1:W0 = a
    ld   ac, [W4]
    POPT
    ld   [DSP], x
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
fi_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  fi_done
    ld   [W1], y
    ld   [W0], x
    ld   [W4], ac
    ld   ac, [y,x]
    ld   [W0], ac
    inc
    ld   ac, [W0]
    bne  fi_1
    ld   [W1], ac
    inc
    ld   ac, [W1]
fi_1:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  fi_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  fi_lp
fi_done:
    NIP2
    ld   p_drop >> 8, y
    jmp  p_drop

.chunk  SCAN ( a n -- a' ): on from a to the first line feed, n bytes at most
p_scan:
    ld   [DSP], x               ; TOS = n, W1:W0 = a
    ld   [x], ac
    ld   ac, [W0]
    ld   [DSP], ac
    add  1, x
    ld   [x], ac
    ld   ac, [W1]
pscn_lp:
    ld   [TL], ac
    or   [TH], ac
    beq  pscn_done
    ld   [W1], y
    ld   [W0], x
    ld   [y,x], ac
    xor  10, ac
    beq  pscn_done
    ld   [W0], ac
    inc
    ld   ac, [W0]
    bne  pscn_1
    ld   [W1], ac
    inc
    ld   ac, [W1]
pscn_1:
    ld   [TL], ac
    sub  1, ac
    ld   ac, [TL]
    bcc  pscn_lp
    ld   [TH], ac
    dec
    ld   ac, [TH]
    bra  pscn_lp
pscn_done:
    ld   [W0], ac
    ld   ac, [TL]
    ld   [W1], ac
    ld   ac, [TH]
    NIP2
    NEXT

.chunk  SYS ( ac a -- ac ): CALL the native routine at a with AC; R0-R7 as set
p_sys:
    ld   [TL], ac
    ld   ac, [W0]
    ld   [TH], ac
    ld   ac, [W1]
    POPT
    ld   LINK_LO, x
    ld   sy_back, [x]
    ld   LINK_HI, x
    ld   sy_back >> 8, [x]
    ld   [TL], ac
    ld   [W1], y
    jmp  [W0]
sy_back:
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    NEXT

; ============================================================
; EMIT ( c -- )  HFILL ( c n -- )  GTYPE ( a n -- )
; Characters at the cell GX, GY, GX moving on; nothing is drawn outside
; the clip rectangle.  GTYPE's characters are XORed with INV.
; ============================================================
.chunk  EMIT, HFILL, GTYPE: what to draw
p_emit:
    ld   [TL], ac
    ld   ac, [N_CH]
    ld   1, ac
    ld   ac, [N_CNT]
    clr  ac
    ld   ac, [N_MODE]
    GOTO DRV_CELLS
p_hfill:
    ld   [TL], ac
    ld   ac, [N_CNT]
    POPT
    ld   [TL], ac
    ld   ac, [N_CH]
    clr  ac
    ld   ac, [N_MODE]
    GOTO DRV_CELLS
p_gtype:
    ld   [TL], ac
    ld   ac, [N_CNT]
    POPT
    ld   [TL], ac
    ld   ac, [N_PL]
    ld   [TH], ac
    ld   ac, [N_PH]
    ld   1, ac
    ld   ac, [N_MODE]
    GOTO DRV_CELLS

.chunk  INVC: the driver's
p_invc:
    GOTO DRV_INVC

.chunk  PTR ( f -- ): show (f not 0) or hide the pointer
p_ptr:
    ld   [TL], ac
    ld   ac, [W2]
    POPT
    ld   [W2], ac
    beq  pp_h
    CALL DRV_SHOW
    NEXT
pp_h:
    CALL DRV_HIDE
    NEXT

; ============================================================
; POLL ( -- key ): waits for the next frame, then the keyboard and the
; mouse: the pointer moves with it (PX, PY, and on the screen when it is
; shown), MOVED = 1 when the mouse sent something (MOUSE_B has its
; buttons); key = the key pressed or 0
; ============================================================
.chunk  POLL
p_poll:
    PUSHT
    ld   1, ac
    CALL wait_frames_io
    CALL kbd_scan
    ld   [MOK], ac
    bne  pl_k
    CALL mouse_poll
    beq  pl_k
    ld   [PXL], ac
    ld   ac, [R0]
    ld   [PXH], ac
    ld   ac, [R1]
    ld   [PYL], ac
    ld   ac, [R2]
    ld   [PYH], ac
    ld   ac, [R3]
    CALL mouse_move
    ld   1, ac
    ld   ac, [MOVED]
    ld   [SH_ON], ac
    ld   ac, [W2]
    CALL DRV_HIDE
    ld   [R0], ac
    ld   ac, [PXL]
    ld   [R1], ac
    ld   ac, [PXH]
    ld   [R2], ac
    ld   ac, [PYL]
    ld   [R3], ac
    ld   ac, [PYH]
    ld   [W2], ac
    beq  pl_k
    CALL DRV_SHOW
pl_k:
    CALL kbd_getc
    ld   ac, [TL]
    clr  ac
    ld   ac, [TH]
    NEXT

.include "pinboard.vm"
