; ============================================================
; lamp_code.masm - LAMPLIGHTER's code.  gen_lamp.py puts the constants
; and the zero page in front of it, fills in the marked parts (tables
; and unrolled loops) and runs asm_expand over it: lamp.asm.
;
; The frame (docs/software/LAMPLIGHTER.md, "How it draws"):
;   frame      wait until the beam is near the playfield's last tile row
;   draw_bg    the playfield from the tile map, tile row by tile row from
;              the top (map FF: the tile routines are in the video RAM)
;   draw_spr   the sprite list over it
;   logic      sound, pads, keys, the rules, the sprite list, the text
; ============================================================

.prefix lp
.region 0x0300, 0x1F00
.region 0x2000, 0x4000
.region 0x0300, 0x1F00

.fixed 0x0100               ; ROWX: video offset (low byte) of top cell + 32, x10 off the playfield
ROWX:
@@ROWX@@

.fixed 0x0200               ; VPG: video page of byte column + 8, x60 off the screen
VPG:
@@VPG@@

; ------------------------------------------------------------
; main
; ------------------------------------------------------------
.chunk
main:
    ld   STACK_TOP, ac
    ld   ac, [SP]
    CALL con_clear
    CALL snd_init
    ld   0x5A, y                ; rows 32-479 (x5A40-x5BFF): 4 bpp 4x
    ld   0x40, ac
m_mb1:
    ld   ac, x
    ld   MODE_PF, [y,x]
    inc
    bne  m_mb1
    ld   0x5B, y
m_mb2:
    ld   ac, x
    ld   MODE_PF, [y,x]
    inc
    bne  m_mb2
    ld   0x20, ac               ; program variables x20-x8F = 0
m_z:
    ld   ac, x
    ld   0, [x]
    inc
    xor  0x90, ac
    beq  m_z1
    xor  0x90, ac
    bra  m_z
m_z1:
    ld   0xFF, ac               ; no area loaded
    ld   ac, [area]
    ld   START_ROOM, ac
    ld   ac, [room]
    ld   START_X, ac
    ld   ac, [px]
    ld   START_Y, ac
    ld   ac, [py]
    ld   START_ENERGY, ac
    ld   ac, [energy]
    ld   START_EMAX, ac
    ld   ac, [emax]
    ld   GOT >> 8, y            ; nothing found yet
    clr  ac
m_g:
    ld   ac, x
    ld   0, [y,x]
    inc
    bne  m_g
    CALL load_room
    CALL camera
    GOTO frame

; ------------------------------------------------------------
; frame: wait for the beam, then draw behind it
; ------------------------------------------------------------
.chunk
frame:
    CALL frame_poll             ; AC = the line (V9:V2)
    sub  LINE_GO, ac
    bcs  frame
    sub  2, ac                  ; (past it, after a room was read: the next time round)
    bcc  frame
frame_go:
    ld   0x50, y                ; map FF: the tile and sprite routines are in
    ld   0xFF, [y,x]            ; the video RAM
    ld   [sy], ac               ; the first tile row's top: ROWX index 32 - (sy & 15)
    and  15, ac
    ld   ac, [tmp]
    ld   32, ac
    sub  [tmp], ac
    ld   ac, [rowb]
    ld   [sx], ac               ; the first tile's first byte column
    and  7, ac
    ld   ac, [j0]
    ld   [sx], ac               ; map byte of the first tile: (ty << 5) | tx
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [tmp]
    ld   [sy], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [tmp2]
    and  7, ac
    shl
    shl
    shl
    shl
    shl
    or   [tmp], ac
    ld   ac, [mrow]
    ld   [tmp2], ac
    shr  ac
    shr  ac
    shr  ac
    add  MAP >> 8, ac
    ld   ac, [mpg]
    ld   t_ret & 0xFF, ac       ; every tile routine comes back to t_ret
    ld   ac, [rl]
    ld   t_ret >> 8, ac
    ld   ac, [rh]
    GOTO bg_row

.chunk
bg_row:
    ld   ROWX >> 8, y           ; the video offsets of this tile row's 16 cells
@@ROWT@@
    ld   0x61, ac
    ld   ac, [colpage]
    ld   8, ac                  ; the first tile: from byte column j0
    sub  [j0], ac
    ld   ac, [tcnt]
    ld   [mrow], ac
    ld   ac, [mx]
    ld   ac, x
    ld   [mpg], y
    ld   [y,x], ac
    or   [j0], ac
    bra  t_go
t_ret:
    bcs  row_done               ; past column 79
    ld   8, ac
    ld   ac, [tcnt]
    ld   [mx], ac               ; the next tile
    inc
    ld   ac, [mx]
    ld   ac, x
    ld   [mpg], y
    ld   [y,x], ac
t_go:
    ld   ac, x                  ; its routine for that byte column
    ld   TS_LO >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   TS_HI >> 8, y
    ld   [y,x], ac
    ld   ac, y
    ld   [tmp], ac
    jmp  ac
row_done:
    ld   [rowb], ac             ; the next tile row, while it is on the screen
    add  16, ac
    ld   ac, [rowb]
    sub  144, ac
    bcc  bg_done
    ld   [mrow], ac
    add  32, ac
    ld   ac, [mrow]
    bcc  bg_row
    ld   [mpg], ac
    inc
    ld   ac, [mpg]
    bra  bg_row
bg_done:
    GOTO draw_spr

; ------------------------------------------------------------
; draw_spr: draw the sprite list (still map FF), then the map back
; ------------------------------------------------------------
.chunk
draw_spr:
    ld   ds_next & 0xFF, ac     ; every sprite routine returns to ds_next
    ld   ac, [srl]
    ld   ds_next >> 8, ac
    ld   ac, [srh]
    clr  ac
    ld   ac, [s_i]
ds_next:
    ld   [s_i], ac
    sub  [sl_n], ac
    bne  ds_one
    ld   0x50, y                ; done: map 07 (the library)
    ld   0x07, [y,x]
    GOTO logic
ds_one:
    ld   SL >> 8, y
    ld   [s_i], ac
    add  SL_C, x
    ld   [y,x], ac
    ld   ac, [sc]
    ld   [s_i], ac
    add  SL_G, x
    ld   [y,x], ac
    ld   ac, [spy]
    ld   [s_i], ac
    add  SL_HI, x
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   [s_i], ac
    add  SL_LO, x
    ld   [y,x], ac
    ld   ac, [tmp2]
    ld   VPG >> 8, y
@@VPGS@@
    ld   [s_i], ac
    inc
    ld   ac, [s_i]
    ld   [tmp], y
    ld   [tmp2], ac
    jmp  ac

; ------------------------------------------------------------
; logic: sound, input
; ------------------------------------------------------------
.chunk
logic:
    CALL snd_update
    CALL pad_read
    CALL kbd_scan
    CALL menu_poll              ; (Esc: back to the DOS)
    ld   [inp], ac
    ld   ac, [inp_prev]
    clr  ac
    ld   ac, [inp]
    GOTO read_input

.chunk
read_input:
@@INPUT@@
    GOTO game

; ------------------------------------------------------------
; game: crawling
; ------------------------------------------------------------
.chunk
game:
    ld   [fcnt], ac
    inc
    ld   ac, [fcnt]
    ld   [inp], ac              ; Down on the ground: crawl
    and  IN_DOWN, ac
    beq  gc_up
    ld   [onground], ac
    beq  gc_up
    ld   [items], ac            ; (with the Burrow Rig)
    and  IT_RIG, ac
    beq  gc_up
    ld   1, ac
    ld   ac, [crawl]
    bra  gc_done
gc_up:
    ld   [crawl], ac
    beq  gc_done
    ld   [py], ac               ; stand up when the upper half is free
    ld   ac, [ta_y]
    ld   [px], ac
    inc
    ld   ac, [ta_x]
    CALL tile_at
    bne  gc_done
    ld   [px], ac
    add  6, ac
    ld   ac, [ta_x]
    CALL tile_at
    bne  gc_done
    clr  ac
    ld   ac, [crawl]
gc_done:
    GOTO g_wet

; under water (the tile at his middle), without the Ballast Boots
.chunk
g_wet:
    ld   [px], ac
    add  4, ac
    ld   ac, [ta_x]
    ld   [py], ac
    add  8, ac
    ld   ac, [ta_y]
    CALL tile_at
    ld   [ta_a], ac
    and  A_WATER, ac
    ld   ac, [wet]
    ld   [items], ac
    and  IT_BOOTS, ac
    beq  gw_1
    clr  ac
    ld   ac, [wet]
gw_1:
    GOTO g_horiz

; ------------------------------------------------------------
; game: sideways
; ------------------------------------------------------------
.chunk
g_horiz:
    clr  ac
    ld   ac, [moving]
    ld   [inp], ac
    and  IN_RIGHT, ac
    beq  gh_1
    clr  ac
    ld   ac, [facing]
    ld   1, ac
    ld   ac, [moving]
    bra  gh_gate
gh_1:
    ld   [inp], ac
    and  IN_LEFT, ac
    beq  gh_none
    ld   1, ac
    ld   ac, [facing]
    ld   ac, [moving]
gh_gate:
    ld   [crawl], ac            ; a step 3 frames of 4; crawling or in water, every other
    or   [wet], ac
    bne  gh_slow
    ld   [fcnt], ac
    and  3, ac
    xor  3, ac
    beq  gh_none
    bra  gh_go
gh_slow:
    ld   [fcnt], ac
    and  1, ac
    beq  gh_none
gh_go:
    ld   [facing], ac
    bne  gh_left
    GOTO g_right
gh_left:
    GOTO g_left
gh_none:
    GOTO g_jump

.chunk
g_right:
    ld   [px], ac               ; a wall at byte column px + 7?
    add  7, ac
    ld   ac, [ta_x]
    CALL side_free
    bne  gr_no
    ld   [px], ac
    inc
    ld   ac, [px]
    sub  [rwx], ac
    bcs  gr_no
    ld   [py], ac               ; at the right edge: an exit?
    add  8, ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ex_pos]
    ld   EX_R, ac
    ld   ac, [ex_side]
    CALL find_exit
    bne  gr_exit
    ld   [px], ac               ; none: back
    dec
    ld   ac, [px]
gr_no:
    GOTO g_jump
gr_exit:
    GOTO do_exit

.chunk
g_left:
    ld   [px], ac
    bne  gl_1
    ld   [py], ac               ; at the left edge: an exit?
    add  8, ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ex_pos]
    ld   EX_L, ac
    ld   ac, [ex_side]
    CALL find_exit
    beq  gl_no
    GOTO do_exit
gl_1:
    ld   ac, [ta_x]             ; a wall at byte column px?
    CALL side_free
    bne  gl_no
    ld   [px], ac
    dec
    ld   ac, [px]
gl_no:
    GOTO g_jump

; side_free: AC = 0 when byte column ta_x is open beside the hero
.chunk
side_free:
    ld   [LINK_LO], ac
    ld   ac, [sv_lo]
    ld   [LINK_HI], ac
    ld   ac, [sv_hi]
    ld   [crawl], ac
    bne  sf_low
    ld   [py], ac
    ld   ac, [ta_y]
    CALL tile_at
    bne  sf_out
sf_low:
    ld   [py], ac
    add  8, ac
    ld   ac, [ta_y]
    CALL tile_at
    bne  sf_out
    ld   [py], ac
    add  15, ac
    ld   ac, [ta_y]
    CALL tile_at
sf_out:
    ld   ac, [tmp]
    ld   [sv_lo], ac
    ld   ac, [LINK_LO]
    ld   [sv_hi], ac
    ld   ac, [LINK_HI]
    ld   [tmp], ac
    RET

; tile_at: AC = 0 when cell ta_y of byte column ta_x is open; ta_a = the
; tile's attributes, ta_pg / ta_i = its place in the map.  Changes X, Y, T0.
.chunk
tile_at:
    ld   [ta_y], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [T0]
    shr  ac
    shr  ac
    shr  ac
    add  MAP >> 8, ac
    ld   ac, [ta_pg]
    ld   ac, y
    ld   [T0], ac
    and  7, ac
    shl
    shl
    shl
    shl
    shl
    ld   ac, [T0]
    ld   [ta_x], ac
    shr  ac
    shr  ac
    shr  ac
    or   [T0], ac
    ld   ac, [ta_i]
    ld   ac, x
    ld   [y,x], ac
    ld   ac, x
    ld   ATTR >> 8, y
    ld   [y,x], ac
    ld   ac, [ta_a]
    ld   [ta_y], ac
    and  8, ac
    bne  ta_low
    ld   [ta_a], ac
    and  1, ac
    RET
ta_low:
    ld   [ta_a], ac
    and  2, ac
    RET

; find_exit: AC = 0 when the room has no exit on side ex_side at tile
; ex_pos; else ex_i = the exit
.chunk
find_exit:
    clr  ac
    ld   ac, [ex_i]
fe_lp:
    ld   HDR >> 8, y
    ld   [ex_i], ac
    add  HX_SIDE, x
    ld   [y,x], ac
    xor  [ex_side], ac
    bne  fe_nx
    ld   [ex_i], ac
    add  HX_LO, x
    ld   [y,x], ac
    ld   ac, [T0]
    ld   [ex_pos], ac
    sub  [T0], ac
    bcs  fe_nx
    ld   [ex_i], ac
    add  HX_HI, x
    ld   [y,x], ac
    sub  [ex_pos], ac
    bcs  fe_nx
    ld   1, ac
    RET
fe_nx:
    ld   [ex_i], ac
    inc
    ld   ac, [ex_i]
    xor  8, ac
    bne  fe_lp
    RET

; ------------------------------------------------------------
; do_exit: through exit ex_i into its room (the frame ends here)
; ------------------------------------------------------------
.chunk
do_exit:
    ld   HDR >> 8, y
    ld   [ex_i], ac
    add  HX_DELTA, x
    ld   [y,x], ac
    ld   ac, [ex_d]
    ld   [ex_i], ac
    add  HX_DEST, x
    ld   [y,x], ac
    ld   ac, [room]
    CALL load_room
    ld   [ex_side], ac
    xor  EX_L, ac
    beq  de_l
    xor  3, ac                  ; (EX_L ^ EX_R)
    beq  de_r
    xor  1, ac                  ; (EX_R ^ EX_U)
    beq  de_u
    clr  ac                     ; down: in at the top
    ld   ac, [py]
    bra  de_v
de_u:
    ld   [rhy], ac              ; up: in at the bottom
    dec
    ld   ac, [py]
de_v:
    clr  ac
    ld   ac, [pyf]
    ld   [ex_d], ac
    shl
    shl
    shl
    add  [px], ac
    ld   ac, [px]
    GOTO de_done
de_l:
    ld   [rwx], ac              ; left: in at the right edge
    dec
    ld   ac, [px]
    sub  7, ac
    ld   ac, [ta_x]
    bra  de_h
de_r:
    ld   1, ac                  ; right: in at the left edge
    ld   ac, [px]
    ld   8, ac
    ld   ac, [ta_x]
de_h:
    ld   [ex_d], ac
    shl
    shl
    shl
    shl
    add  [py], ac
    ld   ac, [py]
    add  8, ac                  ; a door in the way opens
    ld   ac, [ta_y]
    CALL tile_at
    ld   [ta_a], ac
    and  A_DOOR, ac
    beq  de_done
    CALL open_door
de_done:
    CALL camera
    GOTO g_spr

; open_door: open the door whose tile tile_at just found (ta_a, ta_pg,
; ta_i), shutting the one that is open
.chunk
open_door:
    ld   [door_t], ac
    beq  od_0
    ld   [door_pg], y           ; shut the other door
    ld   [door_i], x
    ld   T_DT, [y,x]
    ld   [door_i], ac
    add  32, ac
    ld   ac, x
    bcc  od_c1
    ld   [door_pg], ac
    inc
    ld   ac, y
od_c1:
    ld   T_DB, [y,x]
od_0:
    ld   [ta_a], ac             ; hit in its lower tile: the upper one is a row up
    and  A_DBOT, ac
    beq  od_top
    ld   [ta_i], ac
    sub  32, ac
    ld   ac, [ta_i]
    bcc  od_top
    ld   [ta_pg], ac
    dec
    ld   ac, [ta_pg]
od_top:
    ld   [ta_pg], ac
    ld   ac, [door_pg]
    ld   ac, y
    ld   [ta_i], ac
    ld   ac, [door_i]
    ld   ac, x
    ld   T_DOT, [y,x]
    add  32, ac
    ld   ac, x
    bcc  od_1
    ld   [door_pg], ac
    inc
    ld   ac, y
od_1:
    ld   T_DOB, [y,x]
    ld   DOOR_FRAMES, ac
    ld   ac, [door_t]
    ld   [door_i], ac
    and  31, ac
    shl
    shl
    shl
    ld   ac, [door_x]
    RET

; ------------------------------------------------------------
; game: jumping and gravity
; ------------------------------------------------------------
.chunk
g_jump:
    ld   [inp], ac
    and  IN_JUMP, ac
    beq  gj_no
    ld   [inp_prev], ac         ; a new press, not crawling
    and  IN_JUMP, ac
    bne  gj_grav
    ld   [crawl], ac
    bne  gj_grav
    ld   [onground], ac
    bne  gj_do
    ld   [items], ac            ; in the air: once, with the Updraft Bellows
    and  IT_BELLOWS, ac
    beq  gj_grav
    ld   [ajump], ac
    bne  gj_grav
    ld   1, ac
    ld   ac, [ajump]
    ld   AIRV_LO, ac
    ld   ac, [vyl]
    ld   AIRV_HI, ac
    ld   ac, [vyh]
    ld   77, ac
    CALL snd_beep
    bra  gj_grav
gj_do:
    ld   [wet], ac
    bne  gj_wet
    ld   JUMPV_LO, ac
    ld   ac, [vyl]
    ld   JUMPV_HI, ac
    ld   ac, [vyh]
    ld   72, ac
    CALL snd_beep
    bra  gj_grav
gj_no:
    ld   [vyh], ac              ; the key let go: a fast rise is cut to 1 cell a frame
    blt  gj_c1
    bra  gj_grav
gj_c1:
    xor  0xFF, ac
    beq  gj_grav
    ld   0xFF, ac
    ld   ac, [vyh]
    clr  ac
    ld   ac, [vyl]
gj_grav:
    GOTO g_grav
gj_wet:
    ld   WETV_LO, ac
    ld   ac, [vyl]
    ld   WETV_HI, ac
    ld   ac, [vyh]
    ld   66, ac
    CALL snd_beep
    GOTO g_grav

.chunk
g_grav:
    ld   [vyl], ac              ; gravity
    add  GRAV, ac
    ld   ac, [vyl]
    ld   [vyh], ac
    bcc  gj_g1
    inc
gj_g1:
    ld   ac, [vyh]
    blt  gj_move
    ld   [items], ac            ; the Ash Sail, the jump key held: a slow fall
    and  IT_SAIL, ac
    beq  gj_cap
    ld   [inp], ac
    and  IN_JUMP, ac
    beq  gj_cap
    ld   [vyh], ac
    bne  gj_sail
    ld   [vyl], ac
    sub  SAILV, ac
    bcs  gj_move
gj_sail:
    clr  ac
    ld   ac, [vyh]
    ld   SAILV, ac
    ld   ac, [vyl]
    bra  gj_move
gj_cap:
    ld   [vyh], ac
    sub  MAXFALL_HI, ac
    bcs  gj_move
    ld   MAXFALL_HI, ac
    ld   ac, [vyh]
    clr  ac
    ld   ac, [vyl]
gj_move:
    ld   [py], ac               ; y += vy
    ld   ac, [tmp2]
    ld   [pyf], ac
    add  [vyl], ac
    ld   ac, [pyf]
    ld   [py], ac
    bcc  gj_m1
    inc
gj_m1:
    add  [vyh], ac
    ld   ac, [py]
    ld   [vyh], ac
    blt  gj_up
    GOTO g_down
gj_up:
    GOTO g_up

.chunk
g_up:
    clr  ac
    ld   ac, [onground]
    ld   [tmp2], ac             ; past the top (py wrapped)?
    sub  [py], ac
    bcs  gu_wrap
    ld   [crawl], ac            ; the head in a solid tile?
    shl
    shl
    shl
    add  [py], ac
    ld   ac, [ta_y]
    ld   [px], ac
    inc
    ld   ac, [ta_x]
    CALL tile_at
    bne  gu_bump
    ld   [px], ac
    add  6, ac
    ld   ac, [ta_x]
    CALL tile_at
    beq  gu_free
gu_bump:
    ld   [ta_y], ac             ; below that half tile
    and  0xF8, ac
    add  8, ac
    ld   ac, [py]
    ld   [crawl], ac
    beq  gu_b1
    ld   [py], ac
    sub  8, ac
    ld   ac, [py]
gu_b1:
    clr  ac
    ld   ac, [pyf]
    ld   ac, [vyl]
    ld   ac, [vyh]
gu_free:
    GOTO g_post
gu_wrap:
    ld   [px], ac               ; an exit above?
    add  4, ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ex_pos]
    ld   EX_U, ac
    ld   ac, [ex_side]
    CALL find_exit
    beq  gu_top
    GOTO do_exit
gu_top:
    clr  ac                     ; none: stop at the top
    ld   ac, [py]
    bra  gu_b1

.chunk
g_down:
    ld   [py], ac               ; at the bottom edge?
    sub  [rhy], ac
    bcs  gd_in
    ld   [px], ac               ; an exit below?
    add  4, ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ex_pos]
    ld   EX_D, ac
    ld   ac, [ex_side]
    CALL find_exit
    beq  gd_floor
    GOTO do_exit
gd_floor:
    ld   [rhy], ac
    ld   ac, [py]
    bra  gd_landed
gd_in:
    ld   [py], ac               ; the feet on a solid half tile?
    add  16, ac
    ld   ac, [ta_y]
    ld   [px], ac
    inc
    ld   ac, [ta_x]
    CALL tile_at
    bne  gd_land
    ld   [px], ac
    add  6, ac
    ld   ac, [ta_x]
    CALL tile_at
    bne  gd_land
    clr  ac
    ld   ac, [onground]
    GOTO g_post
gd_land:
    ld   [ta_y], ac
    and  0xF8, ac
    sub  16, ac
    ld   ac, [py]
gd_landed:
    clr  ac
    ld   ac, [pyf]
    ld   ac, [vyl]
    ld   ac, [vyh]
    ld   ac, [ajump]
    ld   1, ac
    ld   ac, [onground]
    GOTO g_post

; camera: sx, sy from the hero's place
.chunk
camera:
    ld   [px], ac
    sub  CAM_X, ac
    bcc  cm_1
    clr  ac
cm_1:
    ld   ac, [sx]
    ld   [rw], ac
    sub  [sx], ac
    bcc  cm_2
    ld   [rw], ac
    ld   ac, [sx]
cm_2:
    ld   [py], ac
    sub  CAM_Y, ac
    bcc  cm_3
    clr  ac
cm_3:
    ld   ac, [sy]
    ld   [rcy], ac
    sub  [sy], ac
    bcc  cm_4
    ld   [rcy], ac
    ld   ac, [sy]
cm_4:
    RET

; ------------------------------------------------------------
; game: the camera, the shots
; ------------------------------------------------------------
.chunk
g_post:
    CALL camera
    clr  ac
    ld   ac, [o_i]
gs_lp:
    ld   [o_i], ac
    add  SH_T, x
    ld   [x], ac
    bne  gs_live
gs_nx:
    ld   [o_i], ac
    inc
    ld   ac, [o_i]
    xor  3, ac
    bne  gs_lp
    GOTO g_fire
gs_live:
    dec
    ld   ac, [x]
    beq  gs_nx
    ld   [o_i], ac              ; x += dx, y += dy
    add  SH_DX, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [o_i], ac
    add  SH_X, x
    ld   [x], ac
    add  [tmp], ac
    ld   ac, [x]
    ld   ac, [ta_x]
    ld   [o_i], ac
    add  SH_DY, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [o_i], ac
    add  SH_Y, x
    ld   [x], ac
    add  [tmp], ac
    ld   ac, [x]
    ld   ac, [ta_y]
    GOTO gs_test

.chunk
gs_test:
    ld   [ta_x], ac             ; off the screen: gone
    sub  [sx], ac
    sub  80, ac
    bcc  gs_kill
    ld   [ta_y], ac
    sub  [sy], ac
    sub  112, ac
    bcc  gs_kill
    CALL tile_at
    beq  gs_obj
    ld   [ta_a], ac             ; a wall stops it; a door opens
    and  A_DOOR, ac
    beq  gs_soot
    CALL open_door
    ld   8, ac
    ld   ac, [R0]
    ld   10, ac
    ld   ac, [R2]
    ld   6, ac
    ld   ac, [R3]
    ld   60, ac
    CALL snd_noise
gs_kill:
    ld   [o_i], ac
    add  SH_T, x
    ld   0, [x]
gs_keep:
    GOTO gs_nx
gs_obj:
    GOTO gs_hit
gs_soot:
    ld   [ta_a], ac             ; a blast breaks a sooted block
    and  A_SOOT, ac
    beq  gs_kill
    ld   [o_i], ac
    inc
    xor  [blast_i], ac
    bne  gs_kill
    ld   [ta_pg], y
    ld   [ta_i], x
    ld   0, [y,x]
    GOTO gs_soot2

; ... and the sooted block right over it
.chunk
gs_soot2:
    ld   [ta_pg], ac
    ld   ac, [tmp2]
    ld   [ta_i], ac
    sub  32, ac
    ld   ac, [tmp]
    ld   [ta_i], ac
    sub  32, ac
    bcc  gt_1
    ld   [tmp2], ac
    dec
    ld   ac, [tmp2]
gt_1:
    ld   [tmp2], y
    ld   [tmp], x
    ld   [y,x], ac
    ld   ac, x
    ld   ATTR >> 8, y
    ld   [y,x], ac
    and  A_SOOT, ac
    beq  gt_2
    ld   [tmp2], y
    ld   [tmp], x
    ld   0, [y,x]
gt_2:
    GOTO gs_kill

; a shot in the open: does it hit a creature?
.chunk
gs_hit:
    clr  ac
    ld   ac, [ob_i]
sq_lp:
    ld   OBJ >> 8, y
    ld   [ob_i], x
    ld   [y,x], ac
    ld   ac, [ob_k]
    add  SPEC_BEH, x
    ld   SPEC >> 8, y
    ld   [y,x], ac
    sub  B_WALK, ac
    bcs  sq_nx
    ld   OBJ >> 8, y
    ld   [ob_i], ac
    add  O_X, x
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   [ta_x], ac
    sub  [tmp], ac
    ld   ac, [tmp]
    ld   [ob_k], ac
    add  SPEC_W, x
    ld   SPEC >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp2]
    ld   [tmp], ac
    sub  [tmp2], ac
    bcc  sq_nx
    ld   OBJ >> 8, y
    ld   [ob_i], ac
    add  O_Y, x
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   [ta_y], ac
    sub  [tmp], ac
    ld   ac, [tmp]
    ld   [ob_k], ac
    add  SPEC_H, x
    ld   SPEC >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp2]
    ld   [tmp], ac
    sub  [tmp2], ac
    bcc  sq_nx
    ld   OBJ >> 8, y
    ld   [o_i], ac              ; a hit: the shot is gone
    add  SH_T, x
    ld   0, [x]
    GOTO sq_2
sq_nx:
    ld   [ob_i], ac
    inc
    ld   ac, [ob_i]
    xor  MAXOBJ, ac
    beq  sq_x1
    GOTO sq_lp
sq_x1:
    GOTO gs_nx

.chunk
sq_2:
    ld   OBJ >> 8, y
    ld   [ob_i], ac
    add  O_HP, x
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   1, ac                  ; a spark takes 1 hit off it, a blast more
    ld   ac, [tmp2]
    ld   [o_i], ac
    inc
    xor  [blast_i], ac
    bne  sq_p
    ld   BLAST_PW, ac
    ld   ac, [tmp2]
sq_p:
    ld   [tmp], ac
    sub  [tmp2], ac
    bcc  sq_h
    clr  ac
sq_h:
    ld   ac, [tmp]
    ld   [ob_i], ac
    add  O_HP, x
    ld   [tmp], ac
    ld   ac, [y,x]
    bne  sq_snd
    ld   [ob_i], x              ; its last: a puff
    ld   S_PUFF, [y,x]
    ld   [ob_i], ac
    add  O_T, x
    ld   PUFF_FRAMES, [y,x]
    ld   [ob_i], ac
    add  O_D, x
    ld   0, [y,x]
    ld   10, ac
    ld   ac, [R0]
    ld   8, ac
    ld   ac, [R2]
    ld   4, ac
    ld   ac, [R3]
    ld   50, ac
    CALL snd_noise
    bra  sq_x
sq_snd:
    ld   60, ac
    CALL snd_beep
sq_x:
    GOTO gs_nx

.chunk
g_fire:
    clr  ac
    ld   ac, [tmp3]             ; (1: a blast)
    ld   [inp], ac              ; a new press of the fire key, not crawling: a spark
    and  IN_FIRE, ac
    beq  gf_chg
    ld   [inp_prev], ac
    and  IN_FIRE, ac
    bne  gf_chg
    ld   [crawl], ac
    bne  gf_chg
    GOTO gf_find
gf_chg:
    ld   [items], ac            ; the Kiln Charge: the key held fills it; let
    and  IT_KILN, ac            ; go when it is full: a blast
    beq  gf_no
    ld   [inp], ac
    and  IN_FIRE, ac
    beq  gf_rel
    ld   [chg], ac
    xor  CHG_FULL, ac
    beq  gf_no
    ld   [chg], ac
    inc
    ld   ac, [chg]
    xor  CHG_FULL, ac
    bne  gf_no
    ld   91, ac                 ; (full)
    CALL snd_beep
gf_no:
    GOTO g_door
gf_rel:
    ld   [chg], ac
    ld   ac, [tmp]
    clr  ac
    ld   ac, [chg]
    ld   [tmp], ac
    xor  CHG_FULL, ac
    bne  gf_no
    ld   [crawl], ac
    bne  gf_no
    ld   1, ac
    ld   ac, [tmp3]
    GOTO gf_find

.chunk
gf_find:
    clr  ac                     ; a free shot
    ld   ac, [o_i]
gf_lp:
    ld   [o_i], ac
    add  SH_T, x
    ld   [x], ac
    beq  gf_slot
    ld   [o_i], ac
    inc
    ld   ac, [o_i]
    xor  3, ac
    bne  gf_lp
    GOTO g_door
gf_slot:
    ld   SHOT_FRAMES, [x]
    ld   [inp], ac
    and  IN_UP, ac
    bne  gf_up
    ld   [o_i], ac              ; sideways, from the lantern
    add  SH_DY, x
    ld   0, [x]
    ld   [o_i], ac
    add  SH_Y, x
    ld   [py], ac
    add  6, ac
    ld   ac, [x]
    ld   [facing], ac
    bne  gf_left
    ld   [o_i], ac
    add  SH_DX, x
    ld   2, [x]
    ld   [o_i], ac
    add  SH_X, x
    ld   [px], ac
    add  7, ac
    ld   ac, [x]
    bra  gf_snd
gf_left:
    ld   [o_i], ac
    add  SH_DX, x
    ld   0xFE, [x]
    ld   [o_i], ac
    add  SH_X, x
    ld   [px], ac
    ld   ac, [x]
    bra  gf_snd
gf_up:
    ld   [o_i], ac              ; up, from the head
    add  SH_DX, x
    ld   0, [x]
    ld   [o_i], ac
    add  SH_DY, x
    ld   0xFC, [x]
    ld   [o_i], ac
    add  SH_X, x
    ld   [px], ac
    add  3, ac
    ld   ac, [x]
    ld   [o_i], ac
    add  SH_Y, x
    ld   [py], ac
    sub  4, ac
    ld   ac, [x]
gf_snd:
    GOTO gf_wide

; the Wide Flame: a spark each side of it, in the free places
.chunk
gf_wide:
    ld   [tmp3], ac             ; (a blast stays one)
    bne  gw_x
    ld   [items], ac
    and  IT_WIDE, ac
    beq  gw_x
    ld   0xFF, ac               ; the spread: -1, then 1
    ld   ac, [ta_a]
    clr  ac
    ld   ac, [ta_i]
gw_lp:
    ld   [ta_i], ac
    add  SH_T, x
    ld   [x], ac
    bne  gw_nx
    ld   SHOT_FRAMES, [x]
    ld   [o_i], ac
    add  SH_X, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [ta_i], ac
    add  SH_X, x
    ld   [tmp], ac
    ld   ac, [x]
    ld   [o_i], ac
    add  SH_Y, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [ta_i], ac
    add  SH_Y, x
    ld   [tmp], ac
    ld   ac, [x]
    ld   [o_i], ac
    add  SH_DX, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [ta_i], ac
    add  SH_DX, x
    ld   [tmp], ac
    ld   ac, [x]
    ld   [o_i], ac
    add  SH_DY, x
    ld   [x], ac
    ld   ac, [tmp]
    ld   [ta_i], ac
    add  SH_DY, x
    ld   [tmp], ac
    ld   ac, [x]
    ld   [ta_i], ac             ; sideways: up or down a little; upward: left or right
    add  SH_DX, x
    ld   [x], ac
    bne  gw_dy
    ld   [ta_a], ac
    ld   ac, [x]
    bra  gw_bl
gw_dy:
    ld   [ta_i], ac
    add  SH_DY, x
    ld   [ta_a], ac
    ld   ac, [x]
gw_bl:
    ld   [ta_i], ac             ; (it is not the blast that was here)
    inc
    xor  [blast_i], ac
    bne  gw_s
    ld   ac, [blast_i]
gw_s:
    ld   1, ac
    ld   ac, [ta_a]
gw_nx:
    ld   [ta_i], ac
    inc
    ld   ac, [ta_i]
    xor  3, ac
    bne  gw_lp
gw_x:
    GOTO gf_kind

.chunk
gf_kind:
    ld   [o_i], ac              ; which of the shots is the blast
    inc
    ld   ac, [tmp]
    ld   [tmp3], ac
    beq  gf_n
    ld   [tmp], ac
    ld   ac, [blast_i]
    ld   60, ac
    CALL snd_beep
    GOTO g_door
gf_n:
    ld   [tmp], ac
    xor  [blast_i], ac
    bne  gf_b
    ld   ac, [blast_i]
gf_b:
    ld   84, ac
    CALL snd_beep
    GOTO g_door

; ------------------------------------------------------------
; game: the open door shuts again (not on the hero)
; ------------------------------------------------------------
.chunk
g_door:
    ld   [door_t], ac
    beq  gd_x
    dec
    ld   ac, [door_t]
    bne  gd_x
    ld   [px], ac               ; in the doorway: wait
    sub  [door_x], ac
    add  6, ac
    sub  13, ac
    bcs  gd_hold
    ld   [door_pg], y
    ld   [door_i], x
    ld   T_DT, [y,x]
    ld   [door_i], ac
    add  32, ac
    ld   ac, x
    bcc  gd_c1
    ld   [door_pg], ac
    inc
    ld   ac, y
gd_c1:
    ld   T_DB, [y,x]
    bra  gd_x
gd_hold:
    ld   1, ac
    ld   ac, [door_t]
gd_x:
    GOTO g_obj

; ------------------------------------------------------------
; game: the room's things (creatures, items, embers)
; ------------------------------------------------------------
.chunk
g_obj:
    clr  ac
    ld   ac, [ob_i]
ob_lp:
    ld   OBJ >> 8, y
    ld   [ob_i], x
    ld   [y,x], ac
    bne  ob_live
ob_next:
    ld   [ob_i], ac
    inc
    ld   ac, [ob_i]
    xor  MAXOBJ, ac
    bne  ob_lp
    GOTO g_inv
ob_live:
    ld   ac, [ob_k]             ; a copy of it in the zero page
    add  SPEC_BEH, x
    ld   SPEC >> 8, y
    ld   [y,x], ac
    ld   ac, [ob_b]
    ld   OBJ >> 8, y
    ld   [ob_i], ac
    add  O_X, x
    ld   [y,x], ac
    ld   ac, [ob_x]
    ld   [ob_i], ac
    add  O_Y, x
    ld   [y,x], ac
    ld   ac, [ob_y]
    ld   [ob_i], ac
    add  O_D, x
    ld   [y,x], ac
    ld   ac, [ob_d]
    ld   [ob_i], ac
    add  O_T, x
    ld   [y,x], ac
    ld   ac, [ob_t]
    ld   [ob_i], ac
    add  O_HP, x
    ld   [y,x], ac
    ld   ac, [ob_hp]
    ld   [ob_i], ac
    add  O_P, x
    ld   [y,x], ac
    ld   ac, [ob_p]
    GOTO ob_touch

.chunk
ob_touch:
    clr  ac                     ; does it touch Wick?
    ld   ac, [touchf]
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_W, x
    ld   [y,x], ac
    add  3, ac
    ld   ac, [tmp]
    ld   [px], ac
    sub  [ob_x], ac
    add  5, ac
    sub  [tmp], ac
    bcc  ob_go
    ld   [ob_k], ac
    add  SPEC_H, x
    ld   [y,x], ac
    add  13, ac
    ld   ac, [tmp]
    ld   [crawl], ac
    beq  ob_t1
    ld   [tmp], ac
    sub  8, ac
    ld   ac, [tmp]
ob_t1:
    ld   [py], ac
    sub  [ob_y], ac
    add  13, ac
    sub  [tmp], ac
    bcc  ob_go
    ld   1, ac
    ld   ac, [touchf]
ob_go:
    ld   [ob_b], ac             ; what it does
    add  ob_hi & 0xFF, x
    ld   ob_hi >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp2]
    ld   [ob_b], ac
    add  ob_lo & 0xFF, x
    ld   [y,x], ac
    ld   [tmp2], y
    jmp  ac

.chunk
ob_lo: #d8 ob_item & 0xFF, ob_ember & 0xFF, ob_puff & 0xFF, ob_bolt & 0xFF, ob_walk & 0xFF, ob_fly & 0xFF, ob_sit & 0xFF, ob_drop & 0xFF, ob_hop & 0xFF, ob_hover & 0xFF
ob_hi: #d8 ob_item >> 8, ob_ember >> 8, ob_puff >> 8, ob_bolt >> 8, ob_walk >> 8, ob_fly >> 8, ob_sit >> 8, ob_drop >> 8, ob_hop >> 8, ob_hover >> 8
hopdy: #d8 @@HOPDY@@

; ob_store: the copy back to thing ob_i
.chunk
ob_store:
    ld   OBJ >> 8, y
    ld   [ob_i], x
    ld   [ob_k], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_X, x
    ld   [ob_x], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_Y, x
    ld   [ob_y], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_D, x
    ld   [ob_d], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_T, x
    ld   [ob_t], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_HP, x
    ld   [ob_hp], ac
    ld   ac, [y,x]
    ld   [ob_i], ac
    add  O_P, x
    ld   [ob_p], ac
    ld   ac, [y,x]
    RET

.chunk
ob_save:
    CALL ob_store
    GOTO ob_next

; an item: found when Wick touches it
.chunk
ob_item:
    ld   [touchf], ac
    bne  oi_get
    GOTO ob_next
oi_get:
    clr  ac
    ld   ac, [ob_k]
    ld   [ob_p], ac
    and  31, ac
    ld   ac, x
    ld   GOT >> 8, y
    ld   1, [y,x]
    ld   [ob_d], ac             ; its type: 0 an Oil Flask, else a power-up
    bne  oi_pow
    ld   [emax], ac
    add  FLASK, ac
    ld   ac, [emax]
    bra  oi_fill
oi_pow:
    add  (s_bits - 1) & 0xFF, x
    ld   s_bits >> 8, y
    ld   [y,x], ac
    or   [items], ac
    ld   ac, [items]
oi_fill:
    ld   [emax], ac
    ld   ac, [energy]
    ld   1, ac
    ld   ac, [hud_dirty]
    ld   [ob_d], ac
    inc
    CALL msg_set
    ld   79, ac
    CALL snd_beep
    GOTO ob_save

; msg_set: message AC on the third text line, for a while
.chunk
msg_set:
    ld   GOT >> 8, y
    ld   V_MSG, x
    ld   ac, [y,x]
    ld   V_MSG_T, x
    ld   MSG_FRAMES, [y,x]
    ld   V_MSG_D, x
    ld   1, [y,x]
    RET

; an ember: energy when Wick touches it, gone after a while
; a puff: where a creature was; then, every other time, an ember
.chunk
ob_ember:
    ld   [ob_t], ac
    dec
    ld   ac, [ob_t]
    beq  ob_gone
    ld   [touchf], ac
    beq  ob_keep
    ld   [energy], ac
    add  EMBER, ac
    ld   ac, [energy]
    sub  [emax], ac
    bcs  oe_ok
    ld   [emax], ac
    ld   ac, [energy]
oe_ok:
    ld   1, ac
    ld   ac, [hud_dirty]
    ld   81, ac
    CALL snd_beep
ob_gone:
    clr  ac
    ld   ac, [ob_k]
ob_keep:
    GOTO ob_save
ob_puff:
    ld   [ob_t], ac
    dec
    ld   ac, [ob_t]
    bne  ob_keep
    ld   [ob_p], ac             ; what it guarded
    bne  op_item
    ld   [fcnt], ac
    and  1, ac
    beq  ob_gone
    ld   S_EMBER, ac
    ld   ac, [ob_k]
    ld   EMBER_FRAMES, ac
    ld   ac, [ob_t]
    bra  ob_keep
op_item:
    GOTO op_beat

; a walker: a step every other frame; it turns at a wall and at the end
; of its floor
.chunk
ob_walk:
    ld   [fcnt], ac
    and  1, ac
    beq  ow_x
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_H, x
    ld   [y,x], ac
    ld   ac, [tmp2]
    sub  4, ac
    ld   ac, [tmp3]
    CALL ob_front
    bne  ow_turn
    ld   [ob_y], ac             ; (ob_front left ta_x there)
    add  [tmp2], ac
    ld   ac, [ta_y]
    CALL tile_at
    beq  ow_turn
    CALL ob_fwd
    bra  ow_x
ow_turn:
    ld   [ob_d], ac
    xor  2, ac
    ld   ac, [ob_d]
ow_x:
    GOTO ob_spit

; a sitter: it faces Wick
.chunk
ob_sit:
    ld   [px], ac
    sub  [ob_x], ac
    bcs  os_l
    clr  ac
    bra  os_1
os_l:
    ld   2, ac
os_1:
    ld   ac, [ob_d]
    GOTO ob_spit

; ob_spit: a kind that spits: a bolt toward Wick when its timer & the
; kind's mask is 0, in the first free place
.chunk
ob_spit:
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_SPIT, x
    ld   [y,x], ac
    beq  ot_x
    ld   ac, [tmp]
    ld   [ob_k], ac             ; wounded (aim bit 1, under half its hits): twice as often
    add  SPEC_AIM, x
    ld   [y,x], ac
    and  2, ac
    beq  ot_m
    ld   [ob_k], ac
    add  SPEC_HP, x
    ld   [y,x], ac
    shr  ac
    ld   ac, [tmp2]
    ld   [ob_hp], ac
    sub  [tmp2], ac
    bcc  ot_m
    ld   [tmp], ac
    shr  ac
    ld   ac, [tmp]
ot_m:
    ld   [ob_t], ac
    inc
    ld   ac, [ob_t]
    and  [tmp], ac
    bne  ot_x
    clr  ac
    ld   ac, [tmp]
ot_lp:
    ld   OBJ >> 8, y
    ld   [tmp], x
    ld   [y,x], ac
    beq  ot_put
    ld   [tmp], ac
    inc
    ld   ac, [tmp]
    xor  MAXOBJ, ac
    bne  ot_lp
ot_x:
    GOTO ob_enemy
ot_put:
    ld   S_BOLT, [y,x]
    GOTO ot_1

.chunk
ot_1:
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_AIM, x
    ld   [y,x], ac
    beq  ot_side
    ld   [ob_k], ac             ; down: from the middle of its underside
    add  SPEC_W, x
    ld   [y,x], ac
    shr  ac
    sub  2, ac
    add  [ob_x], ac
    ld   ac, [tmp3]
    ld   4, ac
    bra  ot_d
ot_side:
    ld   [px], ac
    sub  [ob_x], ac
    bcs  ot_left
    ld   SPEC >> 8, y           ; to the right: from its right edge
    ld   [ob_k], ac
    add  SPEC_W, x
    ld   [y,x], ac
    add  [ob_x], ac
    ld   ac, [tmp3]
    clr  ac
    bra  ot_d
ot_left:
    ld   [ob_x], ac
    sub  4, ac
    ld   ac, [tmp3]
    ld   2, ac
ot_d:
    ld   ac, [tmp2]
    GOTO ot_2

.chunk
ot_2:
    ld   OBJ >> 8, y
    ld   [tmp], ac
    add  O_D, x
    ld   [tmp2], ac
    ld   ac, [y,x]
    ld   [tmp], ac
    add  O_X, x
    ld   [tmp3], ac
    ld   ac, [y,x]
    ld   [tmp], ac
    add  O_T, x
    ld   BOLT_FRAMES, [y,x]
    ld   [tmp], ac
    add  O_HP, x
    ld   0, [y,x]
    ld   [tmp], ac
    add  O_P, x
    ld   0, [y,x]
    ld   SPEC >> 8, y           ; cell: its top + 4, every other one 16 lower when it is tall
    ld   [ob_k], ac
    add  SPEC_AIM, x
    ld   [y,x], ac
    beq  ot_y1
    ld   [ob_k], ac             ; (down: its underside)
    add  SPEC_H, x
    ld   [y,x], ac
    add  [ob_y], ac
    ld   ac, [tmp2]
    bra  ot_y2
ot_y1:
    ld   [ob_k], ac
    add  SPEC_H, x
    ld   [y,x], ac
    sub  16, ac
    ld   ac, [tmp2]
    ld   [ob_t], ac
    shr  ac
    shr  ac
    and  [tmp2], ac
    add  [ob_y], ac
    add  4, ac
    ld   ac, [tmp2]
ot_y2:
    ld   OBJ >> 8, y
    ld   [tmp], ac
    add  O_Y, x
    ld   [tmp2], ac
    ld   ac, [y,x]
    ld   66, ac
    CALL snd_beep
    GOTO ob_enemy

; a bolt: 2 byte columns a frame until a wall, the room's edge or Wick
.chunk
ob_bolt:
    ld   [ob_t], ac
    dec
    ld   ac, [ob_t]
    beq  ol_gone
    ld   [ob_d], ac
    xor  4, ac
    bne  ol_side
    ld   [ob_x], ac             ; down
    add  2, ac
    ld   ac, [ta_x]
    ld   [ob_y], ac
    add  8, ac
    ld   ac, [ta_y]
    CALL tile_at
    bne  ol_gone
    ld   [ob_y], ac
    add  2, ac
    ld   ac, [ob_y]
    bra  ol_t
ol_side:
    ld   4, ac
    ld   ac, [tmp3]
    CALL ob_front
    bne  ol_gone
    CALL ob_fwd
    CALL ob_fwd
ol_t:
    ld   [touchf], ac
    beq  ol_keep
    CALL hurt
ol_gone:
    clr  ac
    ld   ac, [ob_k]
ol_keep:
    GOTO ob_save

; a hopper: it sits, then hops toward Wick: 16 frames of an arc, then a
; fall until it lands
.chunk
ob_hop:
    ld   [ob_t], ac
    sub  HOP_REST, ac
    bcc  oh_air
    ld   [ob_t], ac
    inc
    ld   ac, [ob_t]
    xor  HOP_REST, ac
    bne  oh_e
    ld   [px], ac
    sub  [ob_x], ac
    bcs  oh_fl
    clr  ac
    bra  oh_fd
oh_fl:
    ld   2, ac
oh_fd:
    ld   ac, [ob_d]
oh_e:
    GOTO ob_enemy
oh_air:
    ld   ac, [tmp2]
    sub  16, ac
    bcc  oh_fall
    ld   [tmp2], ac
    add  hopdy & 0xFF, x
    ld   hopdy >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp2]
    ld   [ob_t], ac
    inc
    ld   ac, [ob_t]
    ld   8, ac
    ld   ac, [tmp3]
    CALL ob_front
    bne  oh_v
    CALL ob_fwd
    bra  oh_v
oh_fall:
    ld   4, ac
    ld   ac, [tmp2]
oh_v:
    GOTO ob_hop2

.chunk
ob_hop2:
    ld   [ob_x], ac
    add  4, ac
    ld   ac, [ta_x]
    ld   [tmp2], ac
    blt  oh_up
    add  [ob_y], ac             ; down: does it land?
    ld   ac, [ob_y]
    add  16, ac
    ld   ac, [ta_y]
    CALL tile_at
    beq  oh_e2
    ld   [ta_y], ac
    and  0xF8, ac
    sub  16, ac
    ld   ac, [ob_y]
    clr  ac
    ld   ac, [ob_t]
    bra  oh_e2
oh_up:
    add  [ob_y], ac             ; up, when nothing is in the way
    ld   ac, [ta_y]
    CALL tile_at
    bne  oh_e2
    ld   [ta_y], ac
    ld   ac, [ob_y]
oh_e2:
    GOTO ob_enemy

; a hoverer: every other frame a step toward the place over Wick
.chunk
ob_hover:
    ld   [fcnt], ac
    and  1, ac
    bne  ov_go
    ld   SPEC >> 8, y           ; (wounded, aim bit 1: every frame)
    ld   [ob_k], ac
    add  SPEC_AIM, x
    ld   [y,x], ac
    and  2, ac
    beq  ov_x
    ld   [ob_k], ac
    add  SPEC_HP, x
    ld   [y,x], ac
    shr  ac
    ld   ac, [tmp]
    ld   [ob_hp], ac
    sub  [tmp], ac
    bcc  ov_x
ov_go:
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_W, x
    ld   [y,x], ac
    shr  ac
    sub  4, ac
    add  [ob_x], ac
    ld   ac, [tmp]
    ld   [px], ac
    sub  [tmp], ac
    beq  ov_x
    bcs  ov_l
    clr  ac
    bra  ov_d
ov_l:
    ld   2, ac
ov_d:
    ld   ac, [ob_d]
    ld   8, ac
    ld   ac, [tmp3]
    CALL ob_front
    bne  ov_x
    CALL ob_fwd
ov_x:
    GOTO ob_spit

; a dropper: it hangs until Wick is under it, falls, and bursts on the floor
.chunk
ob_drop:
    ld   [ob_t], ac
    bne  od_fall
    ld   [px], ac
    sub  [ob_x], ac
    add  DROP_NEAR, ac
    sub  2 * DROP_NEAR + 1, ac
    bcc  od_x
    ld   1, ac
    ld   ac, [ob_t]
    bra  od_x
od_fall:
    ld   [ob_x], ac
    add  4, ac
    ld   ac, [ta_x]
    ld   [ob_y], ac
    add  16, ac
    ld   ac, [ta_y]
    CALL tile_at
    bne  od_burst
    ld   [ob_y], ac
    add  3, ac
    ld   ac, [ob_y]
od_x:
    GOTO ob_enemy
od_burst:
    ld   S_PUFF, ac
    ld   ac, [ob_k]
    ld   PUFF_FRAMES, ac
    ld   ac, [ob_t]
    clr  ac
    ld   ac, [ob_d]
    GOTO ob_save

; a flyer: a step sideways every other frame, turning at a wall; between
; them up for 16 frames, then down for 16
.chunk
ob_fly:
    ld   [ob_t], ac
    inc
    and  63, ac
    ld   ac, [ob_t]
    and  1, ac
    beq  of_vert
    ld   8, ac
    ld   ac, [tmp3]
    CALL ob_front
    bne  of_turn
    CALL ob_fwd
    bra  of_x
of_turn:
    ld   [ob_d], ac
    xor  2, ac
    ld   ac, [ob_d]
    bra  of_x
of_vert:
    ld   [ob_x], ac
    add  4, ac
    ld   ac, [ta_x]
    ld   [ob_t], ac
    and  32, ac
    beq  of_up
    ld   [ob_y], ac
    add  16, ac
    ld   ac, [ta_y]
    CALL tile_at
    bne  of_x
    ld   [ob_y], ac
    inc
    bra  of_sy
of_up:
    ld   [ob_y], ac
    dec
    ld   ac, [ta_y]
    CALL tile_at
    bne  of_x
    ld   [ob_y], ac
    dec
of_sy:
    ld   ac, [ob_y]
of_x:
    GOTO ob_enemy

; ob_front: AC != 0 when the thing cannot step the way it faces: the
; room's edge, or a wall at cell ob_y + tmp3 of the byte column in front
; (which is left in ta_x)
.chunk
ob_front:
    ld   [LINK_LO], ac
    ld   ac, [sv_lo]
    ld   [LINK_HI], ac
    ld   ac, [sv_hi]
    ld   [ob_d], ac
    bne  of_left
    ld   [ob_x], ac
    sub  [rwx], ac
    bcc  of_edge
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_W, x
    ld   [y,x], ac
    add  [ob_x], ac
    bra  of_chk
of_left:
    ld   [ob_x], ac
    sub  2, ac
    bcs  of_edge
    ld   [ob_x], ac
    dec
of_chk:
    ld   ac, [ta_x]
    ld   [ob_y], ac
    add  [tmp3], ac
    ld   ac, [ta_y]
    CALL tile_at
    bra  of_out
of_edge:
    ld   1, ac
of_out:
    ld   ac, [tmp]
    ld   [sv_lo], ac
    ld   ac, [LINK_LO]
    ld   [sv_hi], ac
    ld   ac, [LINK_HI]
    ld   [tmp], ac
    RET

; ob_fwd: a step the way the thing faces
.chunk
ob_fwd:
    ld   [ob_d], ac
    bne  ofw_l
    ld   [ob_x], ac
    inc
    ld   ac, [ob_x]
    RET
ofw_l:
    ld   [ob_x], ac
    dec
    ld   ac, [ob_x]
    RET

; a creature that touches Wick hurts him
.chunk
ob_enemy:
    ld   [touchf], ac
    beq  on_x
    CALL hurt
on_x:
    GOTO ob_save

; hurt: thing ob_k's harm off Wick's energy (not again for a second)
.chunk
hurt:
    ld   [inv], ac
    bne  hu_r
    PUSH_LINK
    ld   INV_FRAMES, ac
    ld   ac, [inv]
    ld   1, ac
    ld   ac, [hud_dirty]
    ld   [ob_k], ac
    add  SPEC_DMG, x
    ld   SPEC >> 8, y
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   [items], ac            ; (the Cinder Coat: half)
    and  IT_COAT, ac
    beq  hu_d
    ld   [tmp], ac
    inc
    shr  ac
    ld   ac, [tmp]
hu_d:
    ld   [energy], ac
    sub  [tmp], ac
    bcc  hu_e
    clr  ac
hu_e:
    ld   ac, [energy]
    ld   [crawl], ac
    bne  hu_s
    ld   HURTV_HI, ac           ; a hop
    ld   ac, [vyh]
    clr  ac
    ld   ac, [vyl]
hu_s:
    ld   12, ac
    ld   ac, [R0]
    ld   10, ac
    ld   ac, [R2]
    ld   3, ac
    ld   ac, [R3]
    ld   30, ac
    CALL snd_noise
    LEAVE
hu_r:
    RET

; after the things: the time Wick cannot be hurt; no energy left: back to
; the landing, with what was found
.chunk
g_inv:
    ld   [inv], ac
    beq  gi_1
    dec
    ld   ac, [inv]
gi_1:
    ld   HDR >> 8, y            ; a hot room without the Cinder Coat
    ld   H_FLAGS, x
    ld   [y,x], ac
    and  HF_HOT, ac
    beq  gi_2
    ld   [items], ac
    and  IT_COAT, ac
    bne  gi_2
    ld   [fcnt], ac
    and  15, ac
    bne  gi_2
    ld   [energy], ac
    beq  gi_2
    dec
    ld   ac, [energy]
    ld   1, ac
    ld   ac, [hud_dirty]
gi_2:
    ld   [energy], ac
    bne  gi_x
    ld   START_ROOM, ac
    ld   ac, [room]
    ld   START_X, ac
    ld   ac, [px]
    ld   START_Y, ac
    ld   ac, [py]
    ld   START_ENERGY, ac
    ld   ac, [energy]
    clr  ac
    ld   ac, [pyf]
    ld   ac, [vyl]
    ld   ac, [vyh]
    ld   ac, [crawl]
    ld   ac, [inv]
    ld   M_DEAD, ac
    CALL msg_set
    CALL load_room
    CALL camera
gi_x:
    GOTO g_spr

; ------------------------------------------------------------
; game: the sprite list
; ------------------------------------------------------------
.chunk
g_spr:
    clr  ac
    ld   ac, [sl_n]
    ld   [crawl], ac            ; the hero's frame
    beq  sp_1
    ld   F_CRAWL, ac
    bra  sp_f
sp_1:
    ld   [onground], ac
    bne  sp_2
    ld   F_JUMP, ac
    bra  sp_f
sp_2:
    ld   [moving], ac
    beq  sp_f
    ld   [fcnt], ac
    shr  ac
    shr  ac
    shr  ac
    and  1, ac
    add  F_RUN1, ac
sp_f:
    ld   ac, [tmp]
    ld   [facing], ac
    beq  sp_3
    ld   [tmp], ac
    add  NPF, ac
    ld   ac, [tmp]
sp_3:
    ld   [inv], ac              ; (hurt: he blinks)
    and  2, ac
    bne  sp_4
    ld   [px], ac
    sub  [sx], ac
    add  8, ac
    ld   ac, [tmp2]
    ld   [py], ac
    sub  [sy], ac
    add  32, ac
    ld   ac, [tmp3]
    CALL sl_add
sp_4:
    GOTO sp_shots

.chunk
sp_shots:
    clr  ac                     ; the shots
    ld   ac, [o_i]
sp_lp:
    ld   [o_i], ac
    add  SH_T, x
    ld   [x], ac
    beq  sp_nx
    ld   [o_i], ac
    inc
    xor  [blast_i], ac
    beq  sp_bl
    ld   F_SHOT, ac
    bra  sp_sf
sp_bl:
    ld   F_BLAST, ac
sp_sf:
    ld   ac, [tmp]
    ld   [o_i], ac
    add  SH_X, x
    ld   [x], ac
    sub  [sx], ac
    add  8, ac
    ld   ac, [tmp2]
    ld   [o_i], ac
    add  SH_Y, x
    ld   [x], ac
    sub  [sy], ac
    add  32, ac
    ld   ac, [tmp3]
    CALL sl_add
sp_nx:
    ld   [o_i], ac
    inc
    ld   ac, [o_i]
    xor  3, ac
    bne  sp_lp
    GOTO sp_obj

.chunk
sp_obj:
    clr  ac                     ; the things on the screen
    ld   ac, [ob_i]
so_lp:
    ld   OBJ >> 8, y
    ld   [ob_i], x
    ld   [y,x], ac
    beq  so_nx
    ld   ac, [ob_k]
    ld   [ob_i], ac
    add  O_X, x
    ld   [y,x], ac
    sub  [sx], ac
    add  8, ac
    ld   ac, [tmp2]
    sub  88, ac
    bcc  so_nx
    ld   [ob_i], ac
    add  O_Y, x
    ld   [y,x], ac
    sub  [sy], ac
    add  32, ac
    ld   ac, [tmp3]
    sub  144, ac
    bcc  so_nx
    ld   [ob_i], ac             ; frame: the kind's + the way it faces + 0 or 1
    add  O_D, x
    ld   [y,x], ac
    ld   ac, [tmp]
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_DIRM, x
    ld   [y,x], ac
    and  [tmp], ac
    ld   ac, [tmp]
    ld   [ob_k], ac
    add  SPEC_ANIM, x
    ld   [y,x], ac
    ld   ac, [T0]
    ld   [fcnt], ac
    shr  ac
    shr  ac
    shr  ac
    and  [T0], ac
    add  [tmp], ac
    ld   ac, [tmp]
    ld   [ob_k], ac
    add  SPEC_FRAME, x
    ld   [y,x], ac
    add  [tmp], ac
    ld   ac, [tmp]
    CALL sl_add
    ld   SPEC >> 8, y           ; 32 pixels wide: its right half
    ld   [ob_k], ac
    add  SPEC_WIDE, x
    ld   [y,x], ac
    beq  so_nx
    add  [tmp], ac
    ld   ac, [tmp]
    ld   [tmp2], ac
    add  8, ac
    ld   ac, [tmp2]
    sub  88, ac
    bcc  so_nx
    CALL sl_add
so_nx:
    ld   [ob_i], ac
    inc
    ld   ac, [ob_i]
    xor  MAXOBJ, ac
    bne  so_lp
    GOTO g_hud

; sl_add: add frame tmp at byte column + 8 tmp2, cell + 32 tmp3 to the list
.chunk
sl_add:
    ld   [tmp], x
    ld   FR >> 8, y
    ld   [y,x], ac
    ld   ac, [T0]
    ld   [tmp], ac
    add  128, x
    ld   [y,x], ac
    ld   ac, [T1]
    ld   SL >> 8, y
    ld   [sl_n], ac
    add  SL_C, x
    ld   [tmp2], ac
    ld   ac, [y,x]
    ld   [sl_n], ac
    add  SL_G, x
    ld   [tmp3], ac
    ld   ac, [y,x]
    ld   [sl_n], ac
    add  SL_LO, x
    ld   [T0], ac
    ld   ac, [y,x]
    ld   [sl_n], ac
    add  SL_HI, x
    ld   [T1], ac
    ld   ac, [y,x]
    ld   [sl_n], ac
    inc
    ld   ac, [sl_n]
    RET

; ------------------------------------------------------------
; the text lines
; ------------------------------------------------------------
.chunk
g_hud:
    ld   [hud_dirty], ac
    beq  hu_x
    clr  ac
    ld   ac, [hud_dirty]
    ld   7, ac
    ld   ac, [CUR_COL]
    ld   1, ac
    ld   ac, [CUR_ROW]
    ld   [energy], ac
    CALL con_dec8
    ld   s_sp & 0xFF, ac
    ld   ac, [R0]
    ld   s_sp >> 8, ac
    ld   ac, [R1]
    CALL con_puts
hu_x:
    GOTO g_msg

.chunk
g_msg:
    ld   GOT >> 8, y            ; the message line: blank again after a while
    ld   V_MSG_T, x
    ld   [y,x], ac
    beq  hu_1
    dec
    ld   ac, [y,x]
    bne  hu_1
    ld   V_MSG, x
    ld   ac, [y,x]
    ld   V_MSG_D, x
    ld   1, [y,x]
hu_1:
    ld   V_MSG_D, x
    ld   [y,x], ac
    beq  hu_2
    ld   0, [y,x]
    clr  ac
    ld   ac, [CUR_COL]
    ld   2, ac
    ld   ac, [CUR_ROW]
    ld   V_MSG, x
    ld   [y,x], ac
    ld   ac, [tmp]
    add  m_lo & 0xFF, x
    ld   m_lo >> 8, y
    ld   [y,x], ac
    ld   ac, [R0]
    ld   [tmp], ac
    add  m_hi & 0xFF, x
    ld   [y,x], ac
    ld   ac, [R1]
    CALL con_puts
hu_2:
    GOTO frame

; ------------------------------------------------------------
; load_room: read LAMP/Rnn.RM (nn = room, hex) to MAP and HDR, and its
; area's tiles when they are not the ones loaded
; ------------------------------------------------------------
.chunk
load_room:
    PUSH_LINK
    CALL fs_root
    ld   s_dir & 0xFF, ac
    ld   ac, [R0]
    ld   s_dir >> 8, ac
    ld   ac, [R1]
    CALL fs_open
    ld   [room], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    add  s_hex & 0xFF, x
    ld   s_hex >> 8, y
    ld   [y,x], ac
    ld   (s_room + 1) & 0xFF, x
    ld   ac, [y,x]
    ld   [room], ac
    and  15, ac
    add  s_hex & 0xFF, x
    ld   [y,x], ac
    ld   (s_room + 2) & 0xFF, x
    ld   ac, [y,x]
    ld   s_room & 0xFF, ac
    ld   ac, [R0]
    ld   s_room >> 8, ac
    ld   ac, [R1]
    CALL fs_open
    beq  lr_ok
    GOTO dos_back
lr_ok:
    clr  ac
    ld   ac, [R4]
    ld   MAP >> 8, ac
    ld   ac, [R5]
    CALL fs_read
    CALL fs_read
    GOTO lr_2

.chunk
lr_2:
    ld   HDR >> 8, y
    ld   H_AREA, x
    ld   [y,x], ac
    xor  [area], ac
    beq  lr_3
    xor  [area], ac
    ld   ac, [area]
    CALL load_area
lr_3:
    ld   HDR >> 8, y
    ld   H_RW, x
    ld   [y,x], ac
    ld   ac, [rw]
    ld   H_RCY, x
    ld   [y,x], ac
    ld   ac, [rcy]
    ld   H_RWX, x
    ld   [y,x], ac
    ld   ac, [rwx]
    ld   H_RHY, x
    ld   [y,x], ac
    ld   ac, [rhy]
    clr  ac
    ld   ac, [door_t]
    ld   ac, [blast_i]
    ld   ac, [SH_T]
    ld   ac, [SH_T + 1]
    ld   ac, [SH_T + 2]
    ld   ac, [CUR_COL]          ; row 0: the room's name
    ld   ac, [CUR_ROW]
    ld   H_NAME, ac
    ld   ac, [R0]
    ld   HDR >> 8, ac
    ld   ac, [R1]
    CALL con_puts
    clr  ac                     ; row 1: the energy
    ld   ac, [CUR_COL]
    ld   1, ac
    ld   ac, [CUR_ROW]
    ld   ac, [hud_dirty]
    ld   s_energy & 0xFF, ac
    ld   ac, [R0]
    ld   s_energy >> 8, ac
    ld   ac, [R1]
    CALL con_puts
    clr  ac                     ; the room's things
    ld   ac, [ob_i]
ls_lp:
    ld   HDR >> 8, y
    ld   [ob_i], ac
    add  HO_KIND, x
    ld   [y,x], ac
    ld   ac, [ob_k]
    ld   [ob_i], ac
    add  HO_X, x
    ld   [y,x], ac
    ld   ac, [ob_x]
    ld   [ob_i], ac
    add  HO_Y, x
    ld   [y,x], ac
    ld   ac, [ob_y]
    ld   [ob_i], ac
    add  HO_P, x
    ld   [y,x], ac
    ld   ac, [ob_p]
    GOTO ls_2

.chunk
ls_2:
    clr  ac
    ld   ac, [ob_d]
    ld   ac, [ob_t]
    ld   SPEC >> 8, y
    ld   [ob_k], ac
    add  SPEC_HP, x
    ld   [y,x], ac
    ld   ac, [ob_hp]
    ld   [ob_p], ac             ; with an item: none when it is found
    beq  ls_put
    and  31, ac
    ld   ac, x
    ld   GOT >> 8, y
    ld   [y,x], ac
    beq  ls_3
    clr  ac
    ld   ac, [ob_k]
    bra  ls_put
ls_3:
    ld   [ob_k], ac             ; an item: its type picks its frame
    xor  S_ITEM, ac
    bne  ls_put
    ld   [ob_p], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ob_d]
ls_put:
    CALL ob_store
    ld   [ob_i], ac
    inc
    ld   ac, [ob_i]
    xor  MAXOBJ, ac
    beq  ls_x
    GOTO ls_lp
ls_x:
    GOTO ls_end

; the end of a room's reading: its seal, its message
.chunk
ls_end:
    CALL seal_check
    ld   [tmp3], ac             ; (no message while the seal is shut)
    beq  le_x
    ld   HDR >> 8, y
    ld   H_MSG, x
    ld   [y,x], ac
    beq  le_x
    CALL msg_set
le_x:
    LEAVE

; the thing that a beaten creature guarded; its keeper is beaten
.chunk
op_beat:
    ld   [ob_p], ac
    and  31, ac
    add  G_BEAT, x
    ld   GOT >> 8, y
    ld   1, [y,x]
    CALL seal_check
    ld   [ob_p], ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    shr  ac
    ld   ac, [ob_d]
    ld   S_ITEM, ac
    ld   ac, [ob_k]
    GOTO ob_keep

; seal_check: the room's seal opens (its tiles become empty) when every
; keeper it names is beaten.  tmp3: 0 when it stays shut
.chunk
seal_check:
    ld   1, ac
    ld   ac, [tmp3]
    ld   HDR >> 8, y
    ld   H_SEALN, x
    ld   [y,x], ac
    beq  sc_x
    ld   ac, [tmp3]
    ld   H_SEAL, ac
    ld   ac, [tmp2]
sc_lp:
    ld   HDR >> 8, y
    ld   [tmp2], x
    ld   [y,x], ac
    add  G_BEAT, x
    ld   GOT >> 8, y
    ld   [y,x], ac
    beq  sc_shut
    ld   [tmp2], ac
    inc
    ld   ac, [tmp2]
    ld   [tmp3], ac
    dec
    ld   ac, [tmp3]
    bne  sc_lp
    ld   MAP >> 8, ac
    ld   ac, [tmp3]
    clr  ac
    ld   ac, [tmp2]
sc_t:
    ld   [tmp3], y
    ld   [tmp2], x
    ld   [y,x], ac
    ld   ac, x
    ld   ATTR >> 8, y
    ld   [y,x], ac
    and  A_SEAL, ac
    beq  sc_n
    ld   [tmp3], y
    ld   [tmp2], x
    ld   0, [y,x]
sc_n:
    ld   [tmp2], ac
    inc
    ld   ac, [tmp2]
    bne  sc_t
    ld   [tmp3], ac
    inc
    ld   ac, [tmp3]
    xor  (MAP >> 8) + 2, ac
    bne  sc_t
sc_x:
    RET
sc_shut:
    ld   ac, [tmp3]
    RET

; load_area: read LAMP/An.TS (n = area): 4 pages of tables to TS_LO on,
; the rest to x6000 on
.chunk
load_area:
    PUSH_LINK
    CALL fs_root
    ld   s_dir & 0xFF, ac
    ld   ac, [R0]
    ld   s_dir >> 8, ac
    ld   ac, [R1]
    CALL fs_open
    ld   [area], ac
    add  0x30, ac
    ld   s_area >> 8, y
    ld   (s_area + 1) & 0xFF, x
    ld   ac, [y,x]
    ld   s_area & 0xFF, ac
    ld   ac, [R0]
    ld   s_area >> 8, ac
    ld   ac, [R1]
    CALL fs_open
    beq  la_ok
    GOTO dos_back
la_ok:
    clr  ac
    ld   ac, [R4]
    ld   TS_LO >> 8, ac
    ld   ac, [R5]
la_rd:
    CALL fs_read
    bne  la_done
    ld   [R5], ac               ; after the tables: the video RAM
    xor  TABLES_END >> 8, ac
    bne  la_rd
    ld   0x60, ac
    ld   ac, [R5]
    bra  la_rd
la_done:
    LEAVE

.chunk
s_dir:    #d "LAMP", 0x00
s_room:   #d "R00.RM", 0x00
s_area:   #d "A0.TS", 0x00
s_hex:    #d "0123456789ABCDEF"
s_energy: #d "ENERGY", 0x00
s_sp:     #d "  ", 0x00
s_bits:   #d8 1, 2, 4, 8, 16, 32, 64, 128

.chunk
@@MTAB@@

.chunk
@@MSGS@@
