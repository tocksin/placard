  (text "/EXP1 goes to slots 1 and 3, /EXP2 to slots 2 and 4.  /RESET = RUN (low while the cartridge loads)." (at 30 209 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 29c903c2-d483-5f21-9d22-01d4e1ccb5fe))
