  (text "SEL: GND on slots 1 and 2, +5 V on slots 3 and 4 (through 1k): the A7 half the card answers." (at 30 205 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 1135dd0e-21de-5510-9073-0e3bf0a26502))
  (text "/EXP1 goes to slots 1 and 3, /EXP2 to slots 2 and 4.  /RESET = RUN (low while the cartridge loads)." (at 30 209 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 609e316c-6c7f-5038-a81d-3af77319c0ae))
  (text "SD7:SD0 = SRC7:SRC0, the source drivers' side of the series resistors (the write data)." (at 30 213 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7b99d844-7bcb-5110-8150-dac179ae3816))
