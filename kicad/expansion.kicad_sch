  (wire (pts (xy 318.77 227.33) (xy 322.58 227.33)) (stroke (width 0) (type default)) (uuid 8b184946-c24f-5b55-a99a-e3b85eddbb98))
  (text "SEL: GND on slots 1 and 2, +5 V on slots 3 and 4 (through 1k): the A7 half the card answers." (at 30 252 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 9b314d46-c2d5-54e0-9e55-0761cc06809f))
  (text "/EXP1 goes to slots 1 and 3, /EXP2 to slots 2 and 4.  /RESET = RUN (low while the cartridge loads)." (at 30 256 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid f97929fc-c91a-5a25-a5f1-9e1ede729884))
  (text "BT1, BT2, BT3, BT5 (boot contacts): slot 1 only, STALL_IN, STALL_OUT, PC_ENABLE, /CART; cards latch DATABUS7:0." (at 30 260 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 10cd1a4a-6394-5ba2-ad21-ddb377c02ffe))
  (text "LOAD_IMM carries the State PLD's /LOAD_IMM (low when the CPU latches the read bus into D)." (at 30 264 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 5792f0bf-67dd-549f-ad2d-d74a53d652ed))
  (text "Molex 87715-9106 since 2026-10-30: ADDR15:0, PIXEL_ENABLE, /HSYNC, /VSYNC on every slot (cards can follow the video);" (at 30 268 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid c256388c-08ee-5413-ade5-9901eee8ace0))
  (text "the contacts a cartridge drives are left open, so a cartridge in the wrong slot is harmless." (at 30 272 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid bb99f2f4-9518-5b12-9eb5-a7df0fd3bab2))
