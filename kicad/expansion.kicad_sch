  (text "/EXP1 goes to slots 1 and 3, /EXP2 to slots 2 and 4.  /RESET = RUN (low while the cartridge loads)." (at 30 209 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 6f742ef6-b5cf-5cdb-a306-c3052d24cc58))
