  (wire (pts (xy 318.77 222.25) (xy 322.58 222.25)) (stroke (width 0) (type default)) (uuid a7ba9773-6c55-51cb-b1aa-3484559c06fd))
  (text "SEL: GND on slots 1 and 2, +5 V on slots 3 and 4 (through 1k): the A7 half the card answers." (at 30 252 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e08d080a-cece-503b-bd7c-4b233305108c))
  (text "/EXP1 goes to slots 1 and 3, /EXP2 to slots 2 and 4.  /RESET = RUN (low while the cartridge loads)." (at 30 256 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 6264d5d8-b627-5c43-a3b9-078457cc9a17))
  (text "BT1-BT8 (boot contacts): slot 1 only, STALL_IN, STALL_OUT, PC_ENABLE, /CART; cards latch DATABUS7:0." (at 30 260 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid cc7e06e3-d5dc-5d19-b165-5f4b517987f2))
  (text "LOAD_IMM carries the State PLD's /LOAD_IMM (low when the CPU latches the read bus into D)." (at 30 264 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid ed1e9396-c9f3-5145-bc0e-9ae589be1f3e))
  (text "Molex 87715-9106 since 2026-10-30: ADDR15:0, PIXEL_ENABLE, /HSYNC, /VSYNC on every slot (cards can follow the video);" (at 30 268 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 167c955a-5da0-587d-95fd-11392a6a2d64))
  (text "the contacts a cartridge drives are left open, so a cartridge in the wrong slot is harmless." (at 30 272 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 2703e263-cc4c-58cb-a70e-f41e512f1bd8))
