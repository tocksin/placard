  (text "BT1-BT8 (boot contacts): slot 1 only, STALL_IN, STALL_OUT, PC_ENABLE, PIXEL_ENABLE, /CART; cards latch DATABUS7:0." (at 30 260 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 708f6ad2-0c5e-5cce-8893-701ded6c560d))
  (text "LOAD_IMM carries the State PLD's /LOAD_IMM (low when the CPU latches the read bus into D)." (at 30 264 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 4f0a66aa-8e3a-56a0-9928-d03e3f014b51))
  (text "A21-B24 = ADDR8-15 and A25 = PIXEL_ENABLE on every slot (2 x 25 since 2026-10-30: cards can follow video reads)." (at 30 268 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7f0f7091-d578-5917-ba1f-163da85c3733))
