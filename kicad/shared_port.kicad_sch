  (junction (at 330.2 121.92) (diameter 0) (color 0 0 0 0) (uuid 46e2e3a9-f5fa-5c5b-ba46-1343a0aef301))
  (text "U38 register (rests at EB): bit 0 = SCK and pad CLOCK, bit 1 = MOSI and pad LATCH, bit 2 = SD /CS (low also holds the mouse CLK)," (at 15 252 0) (effects (font (size 2.2 2.2)) (justify left bottom)) (uuid 8d1b7aa2-6d39-5825-b4ea-6765b053b79c))
  (text "bit 3 = PS/2 DATA hold, bit 4 = K0 (low holds the keyboard CLK).  Reads x5200/x5201: D7 MISO or pad 1, D6 pad 2, D5 RXCLK." (at 15 255.52 0) (effects (font (size 2.2 2.2)) (justify left bottom)) (uuid a072ab10-f9ff-5a5a-9517-102112f9eb65))
  (text "U42 clocks on RXCLK (the free device's clock through D1/D4, 22k down) and holds the byte: read at x5202, ready = x5203 D7 low;" (at 15 259.04 0) (effects (font (size 2.2 2.2)) (justify left bottom)) (uuid c1425600-d88c-52d4-b99f-9f9f9ceea6de))
  (text "after the 11th clock it pulls both clocks low through D19/D5 until a write to x5202 re-arms it.  PS/2 DATA is shared by both sockets." (at 15 262.56 0) (effects (font (size 2.2 2.2)) (justify left bottom)) (uuid 7e75eae5-fb6f-5ef4-bbd6-836c5b8bf185))
  (text "SD lines come down to 3.2 V through 1.8k / 3.3k; MISO (3.3 V) goes straight to the PLD's TTL input." (at 15 266.08 0) (effects (font (size 2.2 2.2)) (justify left bottom)) (uuid a65f9b62-3998-5170-ba3d-27e95e58d985))
  (wire (pts (xy 106.68 106.68) (xy 99.06 106.68)) (stroke (width 0) (type default)) (uuid 37109f2b-0686-5670-9a83-c5d06af15ae6))
