  (symbol (lib_id "Jumper:SolderJumper_3_Bridged12") (at 175.26 228.6 0) (unit 1) (in_bom no) (on_board yes) (dnp no) (uuid 67884f88-049b-5826-aca9-73909ed297a4) (property "Reference" "JP1" (at 170 220 0) (effects (font (size 2.54 2.54) bold) (justify left bottom))) (property "Value" "32K / 64K" (at 185 220 0) (effects (font (size 2 2)) (justify left top))) (property "Footprint" "Jumper:SolderJumper-3_P1.3mm_Bridged12_RoundedPad1.0x1.5mm_NumberLabels" (at 175.26 228.6 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "~" (at 175.26 228.6 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid 4b2aed12-a0bd-5c91-a704-b451da9d83c7)) (pin "2" (uuid a44884eb-866c-54ab-8cc6-d1027ec8213e)) (pin "3" (uuid b00cc404-d24c-56ee-81ab-0f422c21e298)) (instances (project "cartridge" (path "/58e6aaf0-b096-58ec-a49b-041f90960c95" (reference "JP1") (unit 1)))))
  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 22 192 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a952a245-ea72-5497-a929-e450b1922869))
  (text "programmed off the board; their /WE is tied high." (at 22 196 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid c62e334d-b501-5ada-95a8-3967ed5d7a50))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 22 200 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 20b8e076-28f9-5bcc-862d-213c80b11023))
  (text "/CE_LO is the main board's A15." (at 22 204 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 9bc919f0-73db-593b-972e-a9bea56fca23))
  (text "JP1 64K (as made, 1-2): fit U2-U5.  32K: cut" (at 22 208 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 504a91a9-b2f5-5d07-b278-c9705985cfe3))
  (text "1-2, bridge 2-3, fit U3, U5 only; the 32K reads" (at 22 212 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 84dbd2b7-b5e0-5d7e-bd11-f1309ea91545))
  (text "in both halves." (at 22 216 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid bda7615a-6073-5a9c-9d0d-81f44ab12cae))
  (text "U1 stalls the CPU at each PC address" (at 22 220 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 4d27e98e-d30c-5f4e-8406-6a3f5cc96721))
  (text "(STALL_OUT), pulses /SR_WE, lets the CPU" (at 22 224 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 918a55d9-d009-58ea-8f7d-41ce8de7a2e9))
  (text "step, and raises RUN when the PC wraps." (at 22 228 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 0628a274-06d2-54f8-8578-ae5b9412a3ac))
  (text "/CART (B10) is tied to GND: cartridge present." (at 22 232 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 67e4da5d-0115-5ebf-a3e1-ad92e477e0c1))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 22 236 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 881b6be6-b53b-563e-b822-aa48033d9144))
