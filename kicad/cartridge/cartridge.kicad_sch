  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 30 215 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d20c2079-8dc2-51ee-a233-b4d10ee646ae))
  (text "programmed off the board; their /WE is tied high." (at 30 219 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid df2f53a1-5a8a-544a-b61e-2ab8b39d956c))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 30 223 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid ac9d1638-696c-5120-9bf6-3ecca4e82fdf))
  (text "/CE_LO is the main board's A15." (at 30 227 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid bdc76da5-ccb4-5feb-83ba-dee9617b48b5))
  (text "U1 stalls the CPU at each PC address" (at 30 231 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 752ad3eb-a13a-5fc8-a54d-ea7e333326bc))
  (text "(STALL_OUT), pulses /SR_WE, lets the CPU" (at 30 235 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 788180da-02fb-5cbe-8016-885c19b388c7))
  (text "step, and raises RUN when the PC wraps." (at 30 239 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 2906ceb8-177e-5ee7-8f2d-6d72bb5921bc))
  (text "/CART (B10) is tied to GND: cartridge present." (at 30 243 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 5c41c4bc-143f-5845-8c51-5275cd2007a6))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 30 247 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid b0aa8bef-0bae-5861-870e-2cce40ff5a96))
