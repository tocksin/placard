  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 30 215 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 079960e0-e44f-5211-9072-58a80373a94e))
  (text "programmed off the board; their /WE is tied high." (at 30 219 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7e72c250-d753-5677-a3ee-82ece3e6d0fb))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 30 223 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e87c60d0-5873-5806-97f8-87d5f3cafaff))
  (text "/CE_LO is the main board's A15." (at 30 227 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid acd4ea55-a237-55af-8729-cc95e1ea196f))
  (text "U1 holds the board's clock (HOLD), pulses" (at 30 231 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 67b590ec-3de2-53b5-9bb5-1c4cba02ef8c))
  (text "/SR_WE on each fetch, then raises RUN." (at 30 235 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a36fe1b2-9b83-5560-9f9d-0c807afefa81))
  (text "U6 drives 02h (ld ac, ac) for each fetch." (at 30 239 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 625dceb9-d353-5db1-b5bd-00a359a43c7e))
  (text "/CART (B10) is tied to GND: cartridge present." (at 30 243 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 3ee00633-ed2d-576d-98ac-4de31e2ce876))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 30 247 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid ac6258a7-8296-522a-9cf0-55d518f7a501))
