  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 22 192 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 85fa804b-b095-54bb-84c6-ad489e2add94))
  (text "programmed off the board; their /WE is tied high." (at 22 196 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 04260d45-321e-54ae-a098-3f48cd517db1))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 22 200 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d3d8e48c-f399-5c1e-b863-fb9ebff9d96a))
  (text "/CE_LO is the main board's A15." (at 22 204 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 4b2aed12-a0bd-5c91-a704-b451da9d83c7))
  (text "U1 stalls the CPU at each PC address" (at 22 208 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a44884eb-866c-54ab-8cc6-d1027ec8213e))
  (text "(STALL_OUT), pulses /SR_WE, lets the CPU" (at 22 212 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid b00cc404-d24c-56ee-81ab-0f422c21e298))
  (text "step, and raises RUN when the PC wraps." (at 22 216 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 388308ea-9604-58df-96e1-0cbd832ab2cc))
  (text "/CART (B10) is tied to GND: cartridge present." (at 22 220 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a952a245-ea72-5497-a929-e450b1922869))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 22 224 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid c62e334d-b501-5ada-95a8-3967ed5d7a50))
