  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 120 175 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 72f99afb-f4b7-5d72-a2e6-521bc1f080ac))
  (text "programmed off the board; their /WE is tied high." (at 120 179 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid c6fcecc7-a766-5c67-bbb7-fe3bb3d18477))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 120 183 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 0685fdb0-a3db-5d68-a4d6-bc79e699b0e4))
  (text "/CE_LO is the main board's A15." (at 120 187 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 35ae20c3-1bc2-5dd5-97c8-7826e3950119))
  (text "U1 holds the board's clock (HOLD), pulses" (at 120 191 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 15f60cd9-1c8b-5f6a-bc71-5bfba403c9fb))
  (text "/SR_WE on each fetch, then raises RUN." (at 120 195 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid aa23fb7d-5cb9-5807-aa5b-7c50c8ab95c1))
  (text "/CART (B10) is tied to GND: cartridge present." (at 120 199 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid de2068e4-5c4d-57c5-92ae-ebb9677066bf))
