  (text "U2 (lower 32K) and U3 (upper) hold the image," (at 120 175 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid df2f53a1-5a8a-544a-b61e-2ab8b39d956c))
  (text "programmed off the board; their /WE is tied high." (at 120 179 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid ac9d1638-696c-5120-9bf6-3ecca4e82fdf))
  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 120 183 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid bdc76da5-ccb4-5feb-83ba-dee9617b48b5))
  (text "/CE_LO is the main board's A15." (at 120 187 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 752ad3eb-a13a-5fc8-a54d-ea7e333326bc))
  (text "U1 holds the board's clock (HOLD), pulses" (at 120 191 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 788180da-02fb-5cbe-8016-885c19b388c7))
  (text "/SR_WE on each fetch, then raises RUN." (at 120 195 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 2906ceb8-177e-5ee7-8f2d-6d72bb5921bc))
  (text "/CART (B10) is tied to GND: cartridge present." (at 120 199 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 5c41c4bc-143f-5845-8c51-5275cd2007a6))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 120 203 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid b0aa8bef-0bae-5861-870e-2cce40ff5a96))
