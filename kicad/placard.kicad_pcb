  (gr_text "BACK" (at 195 6) (layer "Cmts.User") (tstamp a6f47d47-ec38-460b-beed-3a53e48eed5e)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "Placement test (no routing): every chip socketed (KiCad _Socket footprints); hatched boxes at the socket ends = 2.5 mm chip-puller room, kept clear" (at 50 258) (layer "Cmts.User") (tstamp dfae60d0-0e03-4136-97b0-ef137c00a543)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dashed boxes: expansion bay (cards stand up through the case top) and the cartridge shell around J8" (at 50 254) (layer "Cmts.User") (tstamp e5acc740-1c40-41fe-9184-66296624fa20)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Behind the keyboard: memory under the cartridge slot, video out chips, video/audio passives along the back edge, shared-port protection beside J8; power at the back left" (at 50 266) (layer "Cmts.User") (tstamp f482f986-a9bc-43f3-9bc5-07502673b86d)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
