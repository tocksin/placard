  (gr_text "J9-J12 at 20.32 (0.8\") pitch" (at 92 139) (layer "Dwgs.User") (tstamp e80432ff-7606-43b9-92e3-45a970b8d8fd)
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
  )
  (gr_text "Placement test (no routing): every chip socketed (KiCad _Socket footprints); hatched boxes at the socket ends = 2.5 mm chip-puller room, kept clear" (at 50 258) (layer "Cmts.User") (tstamp 0743eac8-c680-4ad3-b183-16895a631d73)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "H1-H6: M3 mounting holes, 3.2 mm, 5 mm in from the edges: (5,5) (285,5) (5,135) (285,135) (145,135) (240,5)" (at 50 238) (layer "Cmts.User") (tstamp 27fb236e-3ec1-4d1c-8c6c-37c7c1e4dee7)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dimensions in mm from the back left corner to connector centre lines (edge connectors: middle of the face on the edge)" (at 50 234) (layer "Cmts.User") (tstamp 3d6129ef-d844-45ac-859b-cfae4acd4d39)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "SNES ports on the right side toward the back: not settled (the front is under the keyboard)" (at 50 242) (layer "Cmts.User") (tstamp 44b4dc79-5f2e-417d-a65b-5add71d6663b)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "PLACARD main board: 4 layers (In1 GND, In2 +5V), 1.6 mm, 290 x 140 mm, 3 mm corner radius" (at 50 230) (layer "Cmts.User") (tstamp 6802c10d-c452-41fd-98da-e6068f99eb02)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Behind the keyboard: memory under the cartridge slot, video out chips, video/audio passives along the back edge, shared-port protection beside J8; power at the back left" (at 50 266) (layer "Cmts.User") (tstamp 7c29caeb-eacc-48cb-869e-c1a7a5742fb6)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Chip rows, front to back: video timing + data bus resistors and networks | control + ALU + oscillator | PC + address mux | data bus + shared port (J1 between)" (at 50 262) (layer "Cmts.User") (tstamp 7cc96f8a-d226-485b-8a4b-7ad3b7607b1c)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "FRONT (keyboard side)" (at 195 222) (layer "Cmts.User") (tstamp 9805f76a-370d-4848-b185-6647c81c435d)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "PRELIMINARY footprints (check datasheets): J2 J3 J5 J8 J9-J12 SW1 SW2, see src/scripts/gen_kicad_connectors.py" (at 50 246) (layer "Cmts.User") (tstamp 9d918915-e164-493d-a78a-91630e6b2376)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dashed boxes: expansion bay (cards stand up through the case top) and the cartridge shell around J8" (at 50 254) (layer "Cmts.User") (tstamp aa4f6190-c870-4392-a18b-b97bb199bbf7)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dashed line: keyboard's back edge; the keyboard lies over the front 65 mm (low parts only); the back 75 mm is under the flat case top (user connectors, cartridge, cards)" (at 50 250) (layer "Cmts.User") (tstamp c4ee4bc7-d6a5-4c05-bd29-fd381da198ff)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
