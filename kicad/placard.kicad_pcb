  (gr_text "PLACARD main board: 4 layers (In1 GND, In2 +5V), 1.6 mm, 290 x 140 mm, 3 mm corner radius" (at 50 230) (layer "Cmts.User") (tstamp 05b1c8c8-ecbf-42b8-88d6-99a6c0c833ed)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dimensions in mm from the back left corner to connector centre lines (edge connectors: middle of the face on the edge)" (at 50 234) (layer "Cmts.User") (tstamp 0707e0a6-97e3-48c6-8ec4-16205d516650)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "SNES ports on the right side toward the back: not settled (the front is under the keyboard)" (at 50 242) (layer "Cmts.User") (tstamp 1f99b0ce-2c5f-49ae-9263-621a7bac61cd)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "PRELIMINARY footprints (check datasheets): J2 J3 J5 J8 J9-J12 SW1 SW2, see src/scripts/gen_kicad_connectors.py" (at 50 246) (layer "Cmts.User") (tstamp 32f8a611-b427-4363-87d6-c2a57f4b0a44)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "H1-H6: M3 mounting holes, 3.2 mm, 5 mm in from the edges: (5,5) (285,5) (5,135) (285,135) (145,135) (240,5)" (at 50 238) (layer "Cmts.User") (tstamp 393ae2dc-cc24-4706-af8e-30a0bddd4f5e)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "LEFT SIDE" (at 10 120 90) (layer "Cmts.User") (tstamp 4a8ae3eb-55e9-4ee9-a708-4e1c6f28fb8c)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "Dashed line: keyboard's back edge; the keyboard lies over the front 65 mm (low parts only); the back 75 mm is under the flat case top (user connectors, cartridge, cards)" (at 50 250) (layer "Cmts.User") (tstamp 54cd5871-8416-476f-a7df-ad087c655453)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Chip rows, front to back: video timing + data bus resistors and networks | control + ALU + oscillator | PC + address mux | data bus + shared port (J1 between)" (at 50 262) (layer "Cmts.User") (tstamp 644a0d9e-948c-4edd-bc05-6e8e68c1db64)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "RIGHT SIDE" (at 386 120 90) (layer "Cmts.User") (tstamp 7190bcd3-99c8-4051-9462-65d96be65a0b)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "FRONT (keyboard side)" (at 195 222) (layer "Cmts.User") (tstamp a3870095-478a-4f7c-a59f-b4d7d88ba344)
    (effects (font (size 3 3) (thickness 0.449999)))
