  (gr_text "J9-J12 at 20.32 (0.8\") pitch" (at 92 139) (layer "Dwgs.User") (tstamp 8147c88a-fcc2-47c0-be8e-ba2e0e1bf830)
    (effects (font (size 1.2 1.2) (thickness 0.18)) (justify left))
  )
  (gr_text "Chip rows, front to back: video timing + data bus resistors and networks | control + ALU + oscillator | PC + address mux | data bus + shared port (J1 between)" (at 50 262) (layer "Cmts.User") (tstamp 32dcd4c8-356f-457e-a596-551ad1cbd5f4)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "PLACARD main board: 4 layers (In1 GND, In2 +5V), 1.6 mm, 290 x 140 mm, 3 mm corner radius" (at 50 230) (layer "Cmts.User") (tstamp 3c64240e-7339-4da8-8227-f59892c71e44)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dashed boxes: expansion bay (cards stand up through the case top) and the cartridge shell around J8" (at 50 254) (layer "Cmts.User") (tstamp 3c7651e7-e726-43d8-8c92-9d294eac973f)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "LEFT SIDE" (at 10 120 90) (layer "Cmts.User") (tstamp 42212bbf-d1f9-43e1-af98-f0c9f0093637)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "Dashed line: keyboard's back edge; the keyboard lies over the front 65 mm (low parts only); the back 75 mm is under the flat case top (user connectors, cartridge, cards)" (at 50 250) (layer "Cmts.User") (tstamp 43611092-f77b-4cc1-847f-6f1e90483c32)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "PRELIMINARY footprints (check datasheets): J2 J3 J5 J8 J9-J12 SW1 SW2, see src/scripts/gen_kicad_connectors.py" (at 50 246) (layer "Cmts.User") (tstamp 4b9d45ea-347a-4b57-bfca-8c498ba75d56)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "H1-H6: M3 mounting holes, 3.2 mm, 5 mm in from the edges: (5,5) (285,5) (5,135) (285,135) (145,135) (240,5)" (at 50 238) (layer "Cmts.User") (tstamp 56060b35-4360-49b7-97fb-8aa5fda8b546)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "RIGHT SIDE" (at 386 120 90) (layer "Cmts.User") (tstamp 7669ba09-a70b-441c-a583-9d42f131141a)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "FRONT (keyboard side)" (at 195 222) (layer "Cmts.User") (tstamp 84f5e48b-e0c6-4221-9445-4e7dcccdd37d)
    (effects (font (size 3 3) (thickness 0.449999)))
  )
  (gr_text "Behind the keyboard: memory under the cartridge slot, video out chips, video/audio passives along the back edge, shared-port protection beside J8; power at the back left" (at 50 266) (layer "Cmts.User") (tstamp 92b02ca5-68ad-4dc5-a9fc-d0cb961e71cd)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Dimensions in mm from the back left corner to connector centre lines (edge connectors: middle of the face on the edge)" (at 50 234) (layer "Cmts.User") (tstamp aba0ecb9-d90f-421b-9f62-e3bc4e2b3480)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
  )
  (gr_text "Placement test (no routing): every chip socketed (KiCad _Socket footprints); hatched boxes at the socket ends = 2.5 mm chip-puller room, kept clear" (at 50 258) (layer "Cmts.User") (tstamp b0000067-2531-4236-bca7-b8d2881f3893)
    (effects (font (size 2 2) (thickness 0.3)) (justify left))
