  (text "U4, U5 are the ROM the CPU reads (15 ns)." (at 22 200 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 69d7a236-2300-5f42-bca7-b56019c42892))
  (text "/CE_LO is the main board's A15; /CE_HI the upper" (at 22 204 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 989183e5-ab3b-5374-88ca-f591a8393d70))
  (text "32K select.  The 32K cartridge is its own board" (at 22 208 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7c34dcaa-a143-5e81-80d9-fea54ba69c5e))
  (text "(kicad/cartridge_32k)." (at 22 212 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e7dce5b2-abe9-5fb1-b4aa-8301b9f59f81))
  (text "U1 stalls the CPU at each PC address" (at 22 216 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e5dcaab9-85f1-537b-a68f-bb886815574d))
  (text "(STALL_OUT), pulses /SR_WE, lets the CPU" (at 22 220 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 6d8ba885-e9a9-59ce-8215-a3a1fd95d5ff))
  (text "step, and raises RUN when the PC wraps." (at 22 224 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 3fe67119-e080-5c1f-ac81-91b71e9b88f0))
  (text "/CART (B10) is tied to GND: cartridge present." (at 22 228 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 8232c91d-201b-5af6-bb68-b7e1d7b42da8))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 22 232 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d7c5114b-7d1b-5122-a3d6-75cfaabb9d91))
