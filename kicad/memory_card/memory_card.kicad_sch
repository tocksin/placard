  (text "U3 is on the slot as the plain card: /CE = /EXP, /OE = Q0," (at 22 226 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 873bf34c-b67e-5362-9869-f162fdafdc39))
  (text "/WE = /WE, A6:A0 and the data bus.  U1 and U2 are in" (at 22 230 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid ac7721ad-6d0b-589e-9855-b7579ec90893))
  (text "none of its read or write paths (EXPANSION.md, \"Card timing\")." (at 22 234 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 68cd3e5e-b724-5f7e-aae0-115dae3074c0))
  (text "They hold U3's A18:A7 as the page, 0-4095, clock on the" (at 22 238 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d0857ffd-c455-57ef-9231-9c8c688a52ca))
  (text "rising edge of /WE and clear at power-up.  A write to the" (at 22 242 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7c9eb0eb-d626-59ca-bece-84aabbb1f029))
  (text "card's offset 7Eh loads page bits 7:0 (U2, selected by U1's" (at 22 246 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid df2dd880-7eaa-53b5-9806-851fe85f59f5))
  (text "/PGLO) and one to 7Fh loads bits 11:8 (U1, from D3:D0)." (at 22 250 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid f05a0f30-5108-5cf3-aae7-ba95a0f535c6))
  (text "Offsets 00h-7Dh of each page are memory (516096 bytes);" (at 22 254 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d4b46156-a78c-5d78-8bfe-c2a3d54df20b))
  (text "7Eh and 7Fh are reserved (the page write lands there too)." (at 22 258 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 2d0fa99e-9e2d-5415-880f-64b4c1eec900))
