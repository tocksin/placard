  (pad "" np_thru_hole circle (at -11 7) (size 3 3) (drill 3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 11 7) (size 3 3) (drill 3) (layers "*.Cu" "*.Mask"))
