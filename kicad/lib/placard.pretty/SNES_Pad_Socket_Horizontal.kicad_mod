  (pad "3" thru_hole circle (at -2.54 14) (size 1.6 1.6) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at 0 14) (size 1.6 1.6) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "5" thru_hole circle (at 2.54 14) (size 1.6 1.6) (drill 1) (layers "*.Cu" "*.Mask"))
  (pad "6" thru_hole circle (at 5.08 14) (size 1.6 1.6) (drill 1) (layers "*.Cu" "*.Mask"))
