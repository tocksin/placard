  (symbol (lib_id "placard_std:C") (at 247.65 157.48 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid b3fe1094-1f19-554a-ad8e-ef1f087445a4) (property "Reference" "C3" (at 249.65 156.98 0) (effects (font (size 2.54 2.54) bold) (justify left bottom))) (property "Value" "100n" (at 249.65 160.08 0) (effects (font (size 2 2)) (justify left top))) (property "Footprint" "placard:C_Disc_D5.0mm_W2.5mm_P5.00mm" (at 247.65 157.48 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "~" (at 247.65 157.48 0) (effects (font (size 1.27 1.27)) hide)) (property "Manufacturer" "TDK" (at 247.65 157.48 0) (effects (font (size 1.27 1.27)) hide)) (property "MPN" "FG28X7R1H104KNT00" (at 247.65 157.48 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid 3f5688cf-02a3-5989-b878-5454e81e3209)) (pin "2" (uuid dc87d024-410a-58dd-bf78-de5460dc5757)) (instances (project "cartridge_32k" (path "/7406a4ab-9e40-5a47-bfe2-c7a63f89be7c" (reference "C3") (unit 1)))))
  (text "U2 holds the 32K image, programmed off the board;" (at 22 192 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 6638955f-12ec-5c2e-9557-94be59c1bc0e))
  (text "its /WE is tied high.  U3 is the ROM the CPU" (at 22 196 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 86990465-8aa9-5c88-815d-47e98e071b5b))
  (text "reads (15 ns).  Both /CE are tied to GND: the" (at 22 200 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 994a5235-8feb-5f2c-8168-f7b476331861))
  (text "32K is seen in both halves (x0000 = x8000), and" (at 22 204 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid eb252d36-2332-5410-a60b-84cd0882299d))
  (text "the loader copies it twice.  /CE_HI (B16) is" (at 22 208 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 27eb4374-3d57-5a6b-90d8-d6edd46948b0))
  (text "not used.  The 64K cartridge is its own board" (at 22 212 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid dc4f8d7a-f60d-59af-8ccf-a3f1b0c01b03))
  (text "(kicad/cartridge_64k)." (at 22 216 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 62a11df8-3cdd-519a-ba3a-37bc94221080))
  (text "U1 stalls the CPU at each PC address" (at 22 220 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e84d1576-2c1d-518c-979f-25a3b0fe9398))
  (text "(STALL_OUT), pulses /SR_WE, lets the CPU" (at 22 224 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid a3508c50-0108-5a29-96b4-3fdbe930f90f))
  (text "step, and raises RUN when the PC wraps." (at 22 228 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d500cfd7-b50d-5cd3-bb9b-83565e82e7b1))
  (text "/CART (B10) is tied to GND: cartridge present." (at 22 232 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid b6e31653-3746-5b89-8dc1-741038c84938))
  (text "Spare contacts are unassigned (EXPANSION.md)." (at 22 236 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 87b018ac-fe93-5f83-988f-3e22c99624d4))
