  (text "U1 State: FETCH / LOAD / EXEC, register loads (active low, F377 /E), RW (1 = read)." (at 40 209 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid d7a9888e-8773-55ca-a9d7-a8e38b07d60f))
