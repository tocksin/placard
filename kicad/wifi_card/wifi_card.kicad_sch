  (symbol (lib_id "placard_std:GND") (at 182.88 264.16 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid 71b37f5e-2e0c-5a2e-be9a-b5210cf24e17) (property "Reference" "#PWR0119" (at 182.88 264.16 0) (effects (font (size 1.27 1.27)) hide)) (property "Value" "GND" (at 182.88 270.51 0) (effects (font (size 2 2)) hide)) (property "Footprint" "" (at 182.88 264.16 0) (effects (font (size 1.27 1.27)) hide)) (property "Datasheet" "" (at 182.88 264.16 0) (effects (font (size 1.27 1.27)) hide)) (pin "1" (uuid 1d47f379-0c88-5a73-ad91-46b9683b0750)) (instances (project "wifi_card" (path "/dee9916b-90c8-5219-8b20-45942dae2bef" (reference "#PWR0119") (unit 1)))))
  (text "U1 is the card's SPI port (ATF22V10_WIFI.pld), at the card's" (at 22 226 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid da549eaa-d423-58d1-a6cf-5f2138c6847c))
  (text "offsets 60h-7Fh.  A write there loads bit 0 SCK, bit 1 MOSI," (at 22 230 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid eac08494-c4f4-5227-b6c8-6ff8375091be))
  (text "bit 2 /CS, bit 3 run (0 holds U2 in reset); a read gives" (at 22 234 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 7600e716-4014-5e07-be7a-5054206725bb))
  (text "D7 = MISO, D6 = READY and fixed bits on D5:D2.  It powers up" (at 22 238 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 3667a7a2-43cc-5f27-9636-5bd68e42d0ae))
  (text "with SCK, MOSI and /CS high and the reset pin off." (at 22 242 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 639a240d-3173-5ceb-9e7b-ff31b6e1c25e))
  (text "U2 is a 3.3 V board with its own regulator: SCK, MOSI and /CS" (at 22 246 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid f03f7dcc-497e-5221-ab66-908633752f0a))
  (text "come down through 1.8k / 3.3k dividers (as the SD card's)," (at 22 250 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 048dab48-05a5-5e7e-9ece-42a2b4e94628))
  (text "MISO and READY go straight to U1 (TTL inputs).  U1 pin 17" (at 22 254 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid e367f2b5-fa61-5a3c-98d2-8efc313fab16))
  (text "only pulls RST low (U2 has the pull-up and a capacitor)." (at 22 258 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 5199a78c-696b-5b1c-97ea-513d15f0eecc))
  (text "U2 is soldered in on its own pin headers.  Flash it through" (at 22 262 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 87b2aac7-c0ca-5d92-8027-29cb9a23cb08))
  (text "its USB socket with the card out of the machine." (at 22 266 0) (effects (font (size 2.5 2.5)) (justify left bottom)) (uuid 0bf0f4ad-b4e3-5f9e-885e-72d363a8bee3))
